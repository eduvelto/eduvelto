rules_version = '2';

// Eduvelto — Firestore Security Rules (Phase 2).
// Implements database-schema.md §5 + blueprint §4.7 principles.
// Governing idea: the client is untrusted; the rule is the enforcement.
// Deny by default: every match below allows explicitly, and anything not
// matched is denied. All writes require auth. No client may write
// reviewStatus "Published", a role, or a verificationStatus directly.
// NOTE: rules cannot strip fields from a read. The quiz answer key is
// therefore NEVER stored in the `quizzes` document a student fetches:
// the student projection (quizzes/{id}) carries questions + options
// only. The key lives in `quizKeys/{quizId}` (below), readable by a
// student only through a fresh submission receipt (quizReceipts) — the
// app creates the receipt at submit time and deletes it right after
// scoring. Honest limit (no server on the free Spark plan): the receipt
// gate stops casual access; a determined user with console access could
// forge a receipt. True server-side verification needs a Cloud Function
// (Blaze) — flagged for Phase 3.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function isOwner(id) { return signedIn() && uid() == id; }

    // Role is read from the caller's own users doc. `.data.get('role', '')`
    // (not `.data.role`): dot-access ERRORS when the doc/field is missing,
    // which turns a clean deny into a rules EVALUATION error — the client
    // then gets an opaque error instead of permission-denied, and lib code
    // that reads-then-checks (e.g. confirmParentLink's 'not-the-child')
    // can never run. A missing doc/field now yields '' (never a role).
    function callerRole() {
      return get(/databases/$(database)/documents/users/$(uid())).data.get('role', '');
    }
    // Suspension is enforced SERVER-side, not just in the UI (review
    // 20 Nov 2026: suspension used to hide the app only — a suspended
    // admin/moderator/teacher kept full Firestore powers via direct
    // calls). A suspended account is not active: every privileged
    // helper below, and every content create, requires it.
    // Missing isActive = active (only an explicit false suspends).
    function callerActive() {
      return get(/databases/$(database)/documents/users/$(uid())).data.get('isActive', true) != false;
    }
    function isAdmin() {
      // One callerRole() call (not two ==): every get() on the users
      // doc costs expression budget, and the jobExams Admin rule was
      // already near Firestore's 1000-expression limit (22 Nov 2026).
      return signedIn() && callerActive() && callerRole() in ['admin', 'owner'];
    }
    // The Owner is the highest role (spec §3). isAdmin()/isModerator()/
    // isTeacher() already include 'owner' — the owner bypasses every admin
    // gate. isOwnerRole() is for OWNER-ONLY actions (owner-doc protection,
    // audit-log reads).
    function isOwnerRole() {
      return signedIn() && callerRole() == 'owner';
    }
    function isModerator() {
      return signedIn() && callerActive() && (callerRole() in ['moderator', 'admin', 'owner']);
    }
    function isTeacher() {
      return signedIn() && callerActive() && (callerRole() in ['teacher', 'admin', 'moderator', 'owner']);
    }
    // NU-4 (§19.3): a VERIFIED teacher — the CURRENT verificationStatus,
    // not the role alone. A teacher who loses verification loses these
    // powers immediately (NU-T20). Role 'teacher' without
    // verificationStatus 'verified' (pending / rejected / revoked) is
    // NOT a verified teacher. Never used for a student access decision.
    function isVerifiedTeacher() {
      return signedIn() && callerActive() && callerRole() == 'teacher'
        && get(/databases/$(database)/documents/users/$(uid())).data.get('verificationStatus', '') == 'verified';
    }
    // Verified-teacher gate (Step 7, bank only): a teacher may author
    // bank questions ONLY while their verificationStatus is
    // 'verified' (Step 3 §2.7 — Owner + approved Admin/Verified
    // Teacher only). Admin/Moderator/Owner are verified by role.
    // This is STRICTER than Step 6's isTeacher() content authoring
    // (a deliberate difference: the bank carries answers, so the
    // author gate is tighter; aligning Step 6 is a Step 17
    // security-testing candidate, NOT changed silently here). A
    // teacher whose verification lapses keeps READ on their own
    // drafts (isTeacher read rule) but can no longer edit them; a
    // Moderator may still verify/reject/publish the draft.
    // Single-get form (Step 17, 23 Nov 2026): callerActive() +
    // callerRole() each fetch the users doc separately (4 gets),
    // which pushed the jobTopics/jobLessons creates over
    // Firestore's 1000-expression evaluation limit. One fetch,
    // then pure field reads — cheaper than the old isTeacher()
    // gate (2 gets). (callerVerificationStatus() was removed
    // 24 Nov 2026 — defined but never called; ~200 bytes.)
    function isVerifiedJobBankAuthor() {
      return signedIn()
        && isVerifiedJobBankAuthorFor(get(/databases/$(database)/documents/users/$(uid())).data);
    }
    function isVerifiedJobBankAuthorFor(d) {
      return d.get('isActive', true) != false
        && (d.get('role', '') in ['admin', 'moderator', 'owner']
            || (d.get('role', '') == 'teacher' && d.get('verificationStatus', '') == 'verified'));
    }
    // DASHBOARDS (Step 5/8, branch draft — NOT deployed): a guardian may
    // read a linked child's progress/bookmarks/results ONLY while the
    // parentLink is 'verified'. The link id is deterministic
    // `{guardianUid}_{childUid}`, so this is one exists() + one get().
    // exists() short-circuits: a missing link denies without erroring.
    // A guardian NEVER reads the child's users doc (email lives there)
    // and NEVER reads quizAttempts (detailed answers stay with the child).
    function isLinkedGuardian(studentId) {
      return signedIn() && callerActive()
        && exists(/databases/$(database)/documents/parentLinks/$(uid() + '_' + studentId))
        && get(/databases/$(database)/documents/parentLinks/$(uid() + '_' + studentId)).data.status == 'verified';
    }

    // ---------- validation helpers ----------
    function isStr(v, max) { return v is string && v.size() > 0 && v.size() <= max; }
    function isReqStr(v) { return v is string && v.size() > 0; }
    function isOptStr(v, max) { return v == null || (v is string && v.size() <= max); }
    // Range checks (compaction 27 Nov 2026): the default in the
    // >= / <= legs is unobservable — the is int / is number leg
    // short-circuits first when the field is missing, and returns
    // the stored value (never the default) when present.
    function isIntRange(d, f, lo, hi) { return d.get(f, null) is int && d.get(f, 0) >= lo && d.get(f, 0) <= hi; }
    function isNumRange(d, f, lo, hi) { return d.get(f, null) is number && d.get(f, 0) >= lo && d.get(f, 0) <= hi; }
    function isPosInt(d, f) { return d.get(f, null) is int && d.get(f, 0) >= 1; }
    function isNonNegInt(d, f) { return d.get(f, null) is int && d.get(f, -1) >= 0; }
    // (map, field) abbreviations (compaction 27 Nov 2026): each wraps
    // the identical d.get() expression, so the call is exactly
    // equivalent to the inline form it replaces.
    function isStrF(d, f, max) { return isStr(d.get(f, null), max); }
    function isOptStrF(d, f, max) { return isOptStr(d.get(f, null), max); }
    function isStrType(d, f) { return d.get(f, null) is string; }
    function isIntType(d, f) { return d.get(f, null) is int; }
    function isListType(d, f) { return d.get(f, null) is list; }
    function isTsType(d, f) { return d.get(f, null) is timestamp; }
    function isOptList(d, f) { return d.get(f, null) == null || d.get(f, null) is list; }
    // Null-or-empty-list, takes the VALUE so a 3x d.get() collapses to one call.
    function isNullOrEmptyList(v) { return v == null || (v is list && v.size() == 0); }
    function isOptMap(d, f) { return d.get(f, null) == null || d.get(f, null) is map; }
    function isOptNum(d, f) { return d.get(f, null) == null || d.get(f, null) is number; }
    function isOptPosInt(d, f) { return d.get(f, null) == null || (d.get(f, null) is int && d.get(f, 0) >= 1); }
    function isOptNonNegInt(d, f) { return d.get(f, null) == null || (d.get(f, null) is int && d.get(f, -1) >= 0); }
    function isOptIntRange(d, f, lo, hi) { return d.get(f, null) == null || (d.get(f, null) is int && d.get(f, 0) >= lo && d.get(f, 0) <= hi); }
    // changedKeys — extracted 23 Nov 2026 (rules-size refactor): the
    // diff().affectedKeys() expression appeared verbatim at 62 call
    // sites. One function, identical semantics (pure expression, no
    // reads), far fewer compiled bytes.
    function changedKeys() { return request.resource.data.diff(resource.data).affectedKeys(); }
    // S2: keys().hasOnly on the incoming doc (22 call sites).
    function onlyKeys(keys) { return request.resource.data.keys().hasOnly(keys); }
    // S4: bundle existence for the incoming doc's bundleId (6 call sites).
    function reqBundleExists() { return exists(/databases/$(database)/documents/jobQuestionBundles/$(request.resource.data.get('bundleId', ''))); }
    // S3: optional timestamp field — absent/null, or a timestamp (12 call sites).
    function isOptTs(d, f) { return d.get(f, null) == null || d.get(f, null) is timestamp; }
    // S5: optional string field with NO length bound (15 call sites).
    // Deliberately NOT isOptStr(v, max): that helper adds a size()
    // <= max check, which would STRENGTHEN validation and deny
    // previously-allowed long strings. This one is the exact
    // null-or-string shape, factored.
    function isOptStrNoMax(d, f) { return d.get(f, null) == null || d.get(f, null) is string; }
    // S6: repeated allow-condition fragments, factored verbatim (27 call sites).
    function sameCreator() { return request.resource.data.createdBy == resource.data.createdBy; }
    function adminOrOwnTeacher() { return isAdmin() || (isVerifiedTeacher() && resource.data.createdBy == uid()); }
    function ownCreate() { return signedIn() && callerActive() && request.resource.data.userId == uid(); }
    function ownExisting() { return signedIn() && callerActive() && resource.data.userId == uid(); }
    function reviewKeys() { return ['status', 'reviewStatus', 'verifiedBy', 'verifiedAt', 'updatedAt']; }
    // Semver-ish version: digits only, "x", "x.y" or "x.y.z".
    function isVersionStr(v) { return v is string && v.matches('^[0-9]+(\\.[0-9]+){0,2}$'); }
    function isDraftStatus(s) { return s in ['Not Started', 'In Progress', 'Under Review']; }
    function isPublished(d) { return d.get('reviewStatus', '') == 'Published'; }
    // S7: repeated allow-condition fragments, factored verbatim
    // (compaction 24 Nov 2026 — same pattern as S1–S6 above).
    function publishedOrMod() { return isPublished(resource.data) || isModerator(); }
    function publishedAuthorRead() { return publishedOrMod() || (signedIn() && resource.data.authorId == uid()); }
    function ownUnderReviewCreate() { return signedIn() && callerActive() && request.resource.data.authorId == uid() && request.resource.data.reviewStatus == 'Under Review'; }
    function jobTeacherDraftUpdate() { return isTeacher() && resource.data.get('authorId', '') == uid() && isDraftStatus(resource.data.get('reviewStatus', '')) && isDraftStatus(request.resource.data.get('reviewStatus', '')) && resource.data.get('status', '') == 'draft' && request.resource.data.get('status', '') == 'draft'; }

    // ---------- Job exams (Step 5 closure — ChatGPT review P0/P1) ----------
    // The 10 canonical Job categories (same list as jobProfile.ts
    // JOB_CATEGORY_SLUGS and the users enrolledCategories allowlist —
    // rules cannot import TypeScript; keep the three in sync, pinned
    // by the taxonomy unit test).
    function jobCategoryIds() {
      return ['bcs-bpsc', 'govt', 'bank', 'primary-teacher',
              'ntrca-teacher', 'defence-police', 'autonomous',
              'ngo-private', 'it-professional', 'other-competitive'];
    }
    // The 15 exam hub slugs (same list as jobProfile.ts
    // TARGET_EXAM_SLUGS).
    function jobExamSlugs() {
      return ['bcs', 'bank', 'primary-teacher', 'ntrca', 'dgfood',
              'bpsc-non-cadre', 'cag', 'bfsa', 'others', 'ministries',
              'defence', 'autonomous', 'private-ngo', 'it-professional',
              'grade-11-20'];
    }
    // Exam-slug gate shared by the job validators (compaction 24 Nov 2026).
    function jobExamSlugOk(d) { return d.get('examSlug', null) in jobExamSlugs() && d.get('examSlug', null) != 'it-professional'; }
    // The 23 CANONICAL subject doc IDs (Step 6 fold-in, ChatGPT P1-02):
    // subjects are derived from the verified rulesConfig, never
    // invented — so the rules allowlist the exact 23 IDs (same list as
    // JOB_SUBJECTS in src/lib/jobContent.ts; pinned by the jobContent
    // unit test that reads this function). A teacher or moderator can
    // never create a subject; only Admin/Owner can, and only one of
    // these 23. The seed (Admin SDK) bypasses rules.
    function canonicalJobSubjectIds() {
      return ['bcs__bangla', 'bcs__english', 'bcs__bangladesh-affairs',
              'bcs__international-affairs', 'bcs__geography',
              'bcs__general-science', 'bcs__computer-ict',
              'bcs__mathematical-reasoning', 'bcs__mental-ability',
              'bcs__ethics',
              'bank__bangla', 'bank__english', 'bank__math',
              'bank__general-knowledge', 'bank__computer',
              'primary-teacher__bangla', 'primary-teacher__english',
              'primary-teacher__math-science',
              'primary-teacher__general-knowledge',
              'ntrca__bangla', 'ntrca__english', 'ntrca__math',
              'ntrca__general-knowledge'];
    }
    function isJobExamReviewState(s) {
      return s in ['Not Started', 'In Progress', 'Under Review', 'Published'];
    }
    // STATUS vs REVIEWSTATUS (Step 3 §2.2, clarified in Step 5):
    // `status` is the PUBLICATION state ('draft' | 'published',
    // Admin-owned); `reviewStatus` is the REVIEW WORKFLOW
    // ('Not Started' | 'In Progress' | 'Under Review' | 'Published').
    // They are two fields for one fact, so the rules enforce that they
    // agree: published ⟺ reviewStatus 'Published'. A doc that says
    // one thing in one field and another in the other is denied.
    function jobExamStatesConsistent(d) {
      return (d.get('status', '') == 'published') == (d.get('reviewStatus', '') == 'Published');
    }
    // Pattern-verification states (Step 5 closure, P1-3): null used to
    // mean five different things; patternStatus says which one.
    function jobPatternStatuses() {
      return ['verified', 'last_verified', 'not_verified', 'not_applicable', 'scope_pending'];
    }
    // Full rulesConfig validation (Step 5 closure, P0-1 + P1-3/P1-4):
    // types AND semantics. An unverified penalty may NEVER sit in
    // `negativeMarking` — it lives in `provisionalNegativeMarking`
    // (Bank) — so a config whose patternStatus is 'verified' cannot
    // carry negativeMarkingVerified == false.
    function validJobRulesConfig(c) {
      return c == null || (c is map
        && isOptPosInt(c, 'questionCount')
        && isOptPosInt(c, 'timeMinutes')
        && isOptPosInt(c, 'marksPerQuestion')
        && (c.get('negativeMarking', null) == null
            || (c.get('negativeMarking', null) is number && c.get('negativeMarking', null) >= 0
                && (c.get('marksPerQuestion', null) == null
                    || c.get('negativeMarking', null) < c.get('marksPerQuestion', null))))
        && (c.get('provisionalNegativeMarking', null) == null
            || (c.get('provisionalNegativeMarking', null) is number
                && c.get('provisionalNegativeMarking', null) >= 0))
        && (c.get('negativeMarkingVerified', null) == null
            || c.get('negativeMarkingVerified', null) is bool)
        && (c.get('negativeMarkingVerified', null) != false
            || c.get('negativeMarking', null) == null)
        && isOptNonNegInt(c, 'passMark')
        && isOptIntRange(c, 'passPercent', 0, 100)
        && isOptList(c, 'subjects')
        && (c.get('patternLabel', null) == null
            || c.get('patternLabel', null) in ['verified', 'last-verified-18th', 'circular-based'])
        && (c.get('patternStatus', null) == null
            || c.get('patternStatus', null) in jobPatternStatuses())
        && (c.get('patternStatus', null) != 'verified'
            || c.get('negativeMarkingVerified', null) != false)
        && (c.get('applicableCycle', null) == null || isStrType(c, 'applicableCycle'))
        && (c.get('patternSource', null) == null || isStrType(c, 'patternSource'))
        && (c.get('patternVerifiedAt', null) == null || isTsType(c, 'patternVerifiedAt')));
    }
    // rulesConfigHistory integrity (Step 5 closure, P0-2 — this is the
    // fix for the Step 3 draft's "history enforced in admin-UI code"
    // gap: a Moderator could bypass the UI and rewrite rulesConfig +
    // clear the history with a direct write. Now the RULES enforce it:
    // config unchanged → history byte-identical; config changed →
    // exactly ONE entry appended (old entries all still present, new
    // entry links before→after, actor is the caller, timestamp +
    // reason recorded). History is never edited in place.
    //
    // Two Firestore-rules facts shape this function (22 Nov 2026,
    // rules tests a3/b6):
    //   * `list + list` is NOT a supported operation — the first
    //     version's `newHist == oldHist + [last]` raised
    //     "Unsupported operation error. Received: list + list", so the
    //     old entries are proven intact with a SET check instead:
    //     newHist.toSet().hasAll(oldHist.toSet()) (every old entry is
    //     still present, as a set member) plus the size check
    //     (exactly one entry added). Reordering is the only thing the
    //     set check cannot see — entries keep their timestamps, so a
    //     reorder changes nothing a reader can act on.
    //   * The 1000-expression budget: the first version repeated the
    //     `history[size - 1]` index chain nine times; this version
    //     reads the last entry through a helper so the index is
    //     computed once per call, and branch 1 checks the HISTORY
    //     first (for a config change the histories differ in size,
    //     so it fails in ~2 expressions instead of paying for a deep
    //     config comparison). The size check runs before any
    //     last-entry call, so an empty new history fails cleanly
    //     instead of indexing -1. (A `let`-bound version was tried
    //     first: this rules compiler rejects chained `let`s.)
    function lastHistoryEntry(hist) {
      return hist[hist.size() - 1];
    }
    function validJobRulesConfigHistoryChange(oldDoc, newDoc) {
      return isListType(newDoc, 'rulesConfigHistory')
        && ((newDoc.get('rulesConfigHistory', null) == oldDoc.get('rulesConfigHistory', null)
              && newDoc.get('rulesConfig', null) == oldDoc.get('rulesConfig', null))
            || (newDoc.get('rulesConfigHistory', null).size()
                  == oldDoc.get('rulesConfigHistory', []).size() + 1
                && newDoc.get('rulesConfigHistory', null).toSet()
                     .hasAll(oldDoc.get('rulesConfigHistory', []).toSet())
                && lastHistoryEntry(newDoc.get('rulesConfigHistory', null)) is map
                && lastHistoryEntry(newDoc.get('rulesConfigHistory', null))
                     .get('changedAt', null) is timestamp
                && lastHistoryEntry(newDoc.get('rulesConfigHistory', null))
                     .get('changedBy', null) == uid()
                && lastHistoryEntry(newDoc.get('rulesConfigHistory', null))
                     .get('reason', null) is string
                && lastHistoryEntry(newDoc.get('rulesConfigHistory', null))
                     .get('before', null) == oldDoc.get('rulesConfig', null)
                && lastHistoryEntry(newDoc.get('rulesConfigHistory', null))
                     .get('after', null) == newDoc.get('rulesConfig', null)
                && (lastHistoryEntry(newDoc.get('rulesConfigHistory', null))
                     .get('sourceCircular', null) == null
                    || lastHistoryEntry(newDoc.get('rulesConfigHistory', null))
                     .get('sourceCircular', null) is string)));
    }

    // NU-6 (§19.2.3, §19.3.4): syllabus-structure validators — mirrors
    // of lib/nuSyllabus.ts validateNuSyllabus*Doc. Every doc: status
    // draft/published, circularVersion + createdBy non-empty strings.
    // Subjects carry no `order` field; common subjects are 20 marks
    // (bangla/english/general-knowledge), group-40 blocks are 40 marks
    // (slug group-*). `&&` short-circuits, so the `.size()` / `.hasOnly()`
    // calls below only run after the `is list` / `is string` checks.
    function isValidNuSubject(data) {
      return isReqStr(data.slug)
        && isReqStr(data.nameBn)
        && isReqStr(data.syllabusSource)
        && data.status in ['draft', 'published']
        && isReqStr(data.circularVersion)
        && isReqStr(data.createdBy)
        && data.groupIds is list
        && data.groupIds.size() >= 1 && data.groupIds.size() <= 3
        && data.groupIds.hasOnly(['humanities', 'science', 'business'])
        && data.marks is int
        && data.isGroupBlock is bool
        && !('order' in data)
        && ((data.isGroupBlock == true && data.marks == 40
            && data.slug in ['group-humanities', 'group-science', 'group-business'])
          || (data.isGroupBlock == false && data.marks == 20
            && data.slug in ['bangla', 'english', 'general-knowledge']));
    }
    function isValidNuChapter(data) {
      return isReqStr(data.subjectId)
        && isReqStr(data.slug)
        && isReqStr(data.nameBn)
        && data.order is int && data.order >= 1
        && isReqStr(data.syllabusSource)
        && data.syllabusVerified is bool
        && data.status in ['draft', 'published']
        && isReqStr(data.circularVersion)
        && isReqStr(data.createdBy);
    }
    // A topic is a chapter plus its own chapterId + detailBn
    // (compaction 24 Nov 2026 — the chapter checks are shared).
    function isValidNuTopic(data) {
      return isValidNuChapter(data)
        && isReqStr(data.chapterId)
        && isReqStr(data.detailBn);
    }
    function isValidNuLesson(data) {
      return isReqStr(data.subjectId)
        && isReqStr(data.chapterId)
        && isReqStr(data.topicId)
        && isReqStr(data.slug)
        && isReqStr(data.titleBn)
        && isReqStr(data.bodyBn)
        && data.order is int && data.order >= 1
        && data.status in ['draft', 'published']
        && isReqStr(data.circularVersion)
        && isReqStr(data.createdBy);
    }

    // NU-7 (§11.2, §19.2.4, §19.6.1): the question shape. Mirrors
    // lib/nuQuestions.ts validateNuQuestionDoc. The correct answer is
    // NEVER in this doc (it lives in nuQuestionDraftKeys). Only the 3
    // common subjects may carry questions — a group-40 block subject
    // (group-*) is rejected (Blocker B: no chapters exist for it).
    // examYear is required ONLY for official_previous_year.
    function isValidNuQuestion(data) {
      return data.subjectId in ['bangla', 'english', 'general-knowledge']
        && isReqStr(data.chapterId)
        && isReqStr(data.topicId)
        && data.groupIds is list && data.groupIds.size() >= 1 && data.groupIds.size() <= 3
        && data.groupIds.toSet().size() == data.groupIds.size()
        && data.groupIds.toSet().hasOnly(['humanities', 'science', 'business'])
        && isReqStr(data.questionText) && data.questionText.size() <= 2000
        && data.questionLang in ['bn', 'en']
        && data.options is list && data.options.size() == 4
        && data.options[0] is string && data.options[0].size() > 0
        && data.options[1] is string && data.options[1].size() > 0
        && data.options[2] is string && data.options[2].size() > 0
        && data.options[3] is string && data.options[3].size() > 0
        && data.options.toSet().size() == 4
        && data.difficulty in ['easy', 'medium', 'hard']
        && isReqStr(data.explanation)
        && data.sourceType in ['original_practice', 'official_previous_year', 'adapted_hsc', 'unverified_source', 'imported_academic']
        && isReqStr(data.provenance)
        && isReqStr(data.circularVersion)
        && data.version is int && data.version >= 1
        && data.status in ['draft', 'submitted_for_review', 'under_review', 'approved', 'published', 'rejected', 'changes_requested', 'withdrawn']
        && !('correctOptionIndex' in data)
        && (!('examYear' in data) || (data.examYear is int && data.examYear >= 1900 && data.examYear <= 2100))
        && (data.sourceType == 'official_previous_year' || !('examYear' in data))
        && (data.sourceType != 'official_previous_year' || ('examYear' in data && data.examYear is int));
    }

    // NU-7 (§19.2.6): the draft correct answer. One doc per question
    // (id == questionId), version-locked to the question's version.
    function isValidNuQuestionDraftKey(data) {
      return isReqStr(data.questionId)
        && data.version is int && data.version >= 1
        && data.correctOptionIndex is int
        && data.correctOptionIndex >= 0 && data.correctOptionIndex <= 3
        && isReqStr(data.createdBy)
        && data.subjectId in ['bangla', 'english', 'general-knowledge']
        && data.groupIds is list && data.groupIds.size() >= 1
        && data.groupIds.toSet().hasOnly(['humanities', 'science', 'business']);
    }

    // NU-7 (§19.2.5): the bundle shape. The per-kind config snapshot
    // pins the NU marking (correct 1 / incorrect 0 / unanswered 0 /
    // NO negative marking) and the sizes (mock exactly 100Q / 3600s /
    // pass 35; daily 20–30Q / 1200–1800s; topic = questionCount).
    // Per-entry validation (every question's id/version/text/options)
    // is code-level (lib validateNuQuestionBundleDoc) — rules cannot
    // iterate a list, so they check size, count, the first entry, and
    // the config snapshot.
    function isValidNuBundle(data) {
      return data.kind in ['topic', 'mock', 'daily']
        && data.groupId in ['humanities', 'science', 'business']
        && data.questions is list && data.questions.size() >= 1
        && data.questionCount is int && data.questionCount == data.questions.size()
        && data.questions[0] is map
        && data.questions[0].questionId is string
        && data.questions[0].version is int && data.questions[0].version >= 1
        && data.questions[0].options is list && data.questions[0].options.size() == 4
        && data.configSnapshot is map
        && data.configSnapshot.marking is map
        && data.configSnapshot.marking.correct == 1
        && data.configSnapshot.marking.incorrect == 0
        && data.configSnapshot.marking.unanswered == 0
        && data.configSnapshot.marking.negativeMarking == false
        && data.configSnapshot.totalQuestions is int
        && data.configSnapshot.totalQuestions == data.questionCount
        && data.status in ['draft', 'published', 'withdrawn']
        && data.version is int && data.version >= 1
        && data.sourceQuestionIds is list && data.sourceQuestionIds.size() == data.questionCount
        && ((data.kind == 'mock'
            && data.configSnapshot.totalQuestions == 100
            && data.configSnapshot.durationSeconds == 3600
            && data.configSnapshot.passMark == 35)
          || (data.kind == 'daily'
            && data.configSnapshot.totalQuestions >= 20
            && data.configSnapshot.totalQuestions <= 30
            && data.configSnapshot.durationSeconds is int
            && data.configSnapshot.durationSeconds >= 1200
            && data.configSnapshot.durationSeconds <= 1800)
          || (data.kind == 'topic'
            && data.configSnapshot.get('durationSeconds', null) == null
            && data.configSnapshot.get('passMark', null) == null));
    }

    // NU-7 (§19.6.1): the publication state machine. Rejected and
    // withdrawn are terminal; approved publishes only through the
    // publish gate; a draft may be withdrawn by an Admin.
    function isNuQuestionTransitionAllowed(from, to) {
      return (from == 'draft' && to in ['submitted_for_review', 'withdrawn'])
        || (from == 'submitted_for_review' && to == 'under_review')
        || (from == 'under_review' && to in ['approved', 'rejected', 'changes_requested'])
        || (from == 'changes_requested' && to == 'submitted_for_review')
        || (from == 'approved' && to == 'published')
        || (from == 'published' && to == 'withdrawn');
    }

    // NU-7 (§19.6.1): who may take each edge. Submit = the author (or
    // an Admin); claim + decide = a reviewer who is NOT the author,
    // and a decision may only be taken by the reviewer who claimed
    // the question (reviewedBy == uid); publish / withdraw = Admin.
    function isNuQuestionTransitionActorOk(to) {
      return (to == 'submitted_for_review' && (isAdmin() || resource.data.createdBy == uid()))
        || (to == 'under_review' && (isAdmin() || isVerifiedTeacher())
            && resource.data.createdBy != uid()
            && request.resource.data.reviewedBy == uid())
        || (to in ['approved', 'rejected', 'changes_requested'] && (isAdmin() || isVerifiedTeacher())
            && resource.data.createdBy != uid()
            && resource.data.reviewedBy == uid()
            && request.resource.data.reviewedBy == uid())
        || (to == 'published' && isAdmin())
        || (to == 'withdrawn' && isAdmin());
    }
    // ---------- Job content: subjects / chapters / topics / lessons (Step 6) ----------
    // Step 3 §2.3–§2.6 + §3.2/§3.4, as OVERRIDDEN by the Step 6 spec
    // (parent coordinator, 22 Nov 2026). Deviations from the draft are
    // recorded in the match-block comment below; the big ones:
    //   * reviewStatus vocabulary is 'Not Started' | 'In Progress' |
    //     'Under Review' | 'Published' (Step 5 P1-1). The draft's
    //     'draft' / 'in-review' / 'verified' / 'published' values do
    //     NOT exist — the draft's isJobDraftStatus() / jobContentRead()
    //     / jobContentCreate() / jobContentUpdate() helpers are NOT
    //     reused here (their names would collide with the Step 5
    //     meanings, so new names are used throughout).
    //   * publication is gated on `status` (P1-1 / e5 lesson), not
    //     reviewStatus — a list query filters on status, and Firestore
    //     can only allow a query it can prove from the query's own
    //     filters.
    //   * the author MAY edit their own draft (the draft's
    //     jobContentUpdate allowed it; Step 5's jobExams rule did NOT
    //     — content collections follow the draft here, not jobExams).
    //   * Moderator AND Admin may publish/return (Step 5's Admin-only
    //     publish was about protecting rulesConfig, which these
    //     collections do not have). The second-eye rule is the guard
    //     instead: the verifier is never the author.
    //   * 'it-professional' is excluded: scopeStatus 'scope_pending'
    //     (Step 5 P1-5) + Step 6 handover constraint 4 — no syllabus
    //     may be built from it until the owner fixes its scope.
    // (Compaction 24 Nov 2026: isJobContentReviewState /
    // jobContentStatesConsistent were byte-identical to the Exam
    // helpers below — one invariant, one definition. Call sites use
    // isJobExamReviewState / jobExamStatesConsistent.)
    // Shared create-time facts: draft-only start, author pinned to
    // the caller (or absent), no verifier yet (a new draft has never
    // been verified — verifiedBy/verifiedAt must be absent or null,
    // so a creator cannot bake in a self-verification), timestamps
    // absent or real timestamps.
    // Shared create-time core (compaction 24 Nov 2026): the
    // question + content create-common checks are the same 10
    // facts (P1-04 createdBy provenance, P1-05 no baked-in publish
    // metadata). jobQuestionCreateCommon adds reviewerId +
    // rejectionReason on top.
    function jobCreateCommonCore(d) {
      return d.get('status', '') == 'draft'
        && d.get('reviewStatus', '') == 'Not Started'
        && (d.get('authorId', null) == null || d.get('authorId', null) == uid())
        && (d.get('createdBy', null) == null || d.get('createdBy', null) == uid())
        && d.get('verifiedBy', null) == null
        && d.get('verifiedAt', null) == null
        && !('publishedAt' in d)
        && !('publishedBy' in d)
        && (isOptTs(d, 'createdAt'))
        && (isOptTs(d, 'updatedAt'));
    }
    function jobContentCreateCommon(d) {
      return jobCreateCommonCore(d);
    }
    // SECOND-EYE RULE (Step 3 §2.7 / §3.4): the verifier is never the
    // author. verifiedBy may stay as it is, be cleared (a return), or
    // be set to the CALLER — and only when the caller is not the
    // author. Publishing additionally requires a real verifier (a
    // non-null verifiedBy that is not the author) plus a verification
    // timestamp: nothing is Published without a second eye on it.
    // NOTE: the rule constrains the VERIFIER, not the publisher — an
    // Admin/Moderator who authored a doc may still publish it once a
    // DIFFERENT person has verified it (verifiedBy != authorId).
    function jobContentSecondEye(oldDoc, newDoc) {
      return (newDoc.get('verifiedBy', null) == oldDoc.get('verifiedBy', null)
          || newDoc.get('verifiedBy', null) == null
          || (newDoc.get('verifiedBy', null) == uid()
              && uid() != oldDoc.get('authorId', '')))
        && (newDoc.get('status', '') != 'published'
            || (isStrType(newDoc, 'verifiedBy')
                && newDoc.get('verifiedBy', null) != oldDoc.get('authorId', '')
                && isTsType(newDoc, 'verifiedAt')));
    }
    // PUBLISH-TRANSITION GUARD (Step 6 fold-in, ChatGPT P1-03): the
    // publication fields (status / reviewStatus / verifiedBy /
    // verifiedAt) may change only on a draft, or when the doc LEAVES
    // published (unpublish / return). On a doc that STAYS published
    // they are frozen: a verifier cannot be silently swapped on a
    // live doc — unpublish, re-verify, re-publish instead. Content
    // fixes on a published doc (Admin typo fix, Step 6 decision 10)
    // are unaffected: they change content fields only.
    function jobContentPublishTransition(oldDoc, newDoc) {
      return oldDoc.get('status', '') != 'published'
        || newDoc.get('status', '') != 'published'
        || (newDoc.get('status', '') == oldDoc.get('status', '')
            && newDoc.get('reviewStatus', '') == oldDoc.get('reviewStatus', '')
            && newDoc.get('verifiedBy', null) == oldDoc.get('verifiedBy', null)
            && newDoc.get('verifiedAt', null) == oldDoc.get('verifiedAt', null));
    }
    // Slug shapes (Step 3 §2.3–§2.5 doc IDs). Parent references must
    // look like the doc IDs they point at, so a chapter cannot claim a
    // parent subject that could never exist. Parent EXISTENCE is not
    // checked here (that would cost a get() per write; Step 5 P1-6 did
    // reference validation in the taxonomy code, not in the rules).
    function isJobSubjectId(s) {
      return s is string && s.matches('^[a-z0-9-]+__[a-z0-9-]+$');
    }
    function isJobChapterId(s) {
      return s is string && s.matches('^[a-z0-9-]+__[a-z0-9-]+__[a-z0-9-]+$');
    }
    // Topic doc IDs extend their chapter (Step 6 fold-in — resolves a
    // Step 6 core inconsistency: the Step 3 draft §2.5 and the Step 6
    // report wrote `{exam}__{subject}__{topic}`, but the implemented
    // create rule + tests pin the 4-segment form
    // `{exam}__{subject}__{chapter}__{topic}`. The 4-segment form
    // stands: it follows the ID-extends-parent pattern and lets two
    // chapters hold same-slug topics.
    function isJobTopicId(s) {
      return s is string && s.matches('^[a-z0-9-]+__[a-z0-9-]+__[a-z0-9-]+__[a-z0-9-]+$');
    }
    // Full new-doc validation, shared by create and both update rules
    // (the update rules pin the unchangeable fields with affectedKeys,
    // so re-validating the whole new doc is safe: pinned fields are
    // unchanged from an already-valid doc).
    function validJobSubject(d) {
      return jobExamSlugOk(d)
        && isStrF(d, 'nameBn', 100)
        && isStrF(d, 'nameEn', 100)
        && isPosInt(d, 'order')
        && isOptNonNegInt(d, 'marks')
        && isOptStrF(d, 'syllabusSource', 500)
        // Step 6 fold-in: the seed carries `slug` and `applicableCycle`
        // — validate them instead of ignoring them (a slug that is not
        // kebab, or an applicableCycle that is not a string, is denied).
        && (d.get('slug', null) == null
            || (isStrType(d, 'slug') && d.get('slug', null).matches('^[a-z0-9-]+$')))
        && (isOptStrNoMax(d, 'applicableCycle'))
        // Step 6 fold-in, ChatGPT P2-02: configVersion is an optional
        // string when present (the seed stamps it; a rules-created
        // subject may carry it too). It is outside every update
        // rule's affected-keys allowlist, so it is immutable once set.
        && (isOptStrNoMax(d, 'configVersion'))
        && jobContentStateOk(d);
    }
    function validJobChapter(d) {
      return jobExamSlugOk(d)
        && isJobSubjectId(d.get('subjectId', null))
        && isStrF(d, 'nameBn', 200)
        && isStrF(d, 'nameEn', 200)
        && isOptStrF(d, 'descriptionBn', 1000)
        && isOptStrF(d, 'descriptionEn', 1000)
        && isPosInt(d, 'order')
        && jobContentStateOk(d);
    }
    function validJobTopic(d) {
      return jobExamSlugOk(d)
        && isJobSubjectId(d.get('subjectId', null))
        && isJobChapterId(d.get('chapterId', null))
        && isStrF(d, 'nameBn', 200)
        && isStrF(d, 'nameEn', 200)
        && isPosInt(d, 'order')
        && d.get('isCommon', null) is bool
        && (d.get('commonExams', null) == null
            || (isListType(d, 'commonExams')
                && d.get('commonExams', null).toSet().hasOnly(jobExamSlugs())))
        // BINDING (Step 3 §2.5): common means in at least 3 of the 4
        // Tier-1 exams — counted on DISTINCT slugs, so
        // ['bcs', 'bcs', 'bcs'] does not pass.
        && (d.get('isCommon', null) != true
            || (isListType(d, 'commonExams')
                && d.get('commonExams', null).toSet().size() >= 3))
        && d.get('commonStatus', null) in ['preliminary', 'verified']
        && isOptNonNegInt(d, 'questionTarget')
        && isNonNegInt(d, 'publishedQuestionCount')
        && jobContentStateOk(d);
    }
    function validJobLesson(d) {
      return jobExamSlugOk(d)
        && d.get('lessonType', null) in ['lesson', 'viva-question', 'viva-guide',
                                          'career-guide', 'cv-guide']
        // A 'lesson' lives under a topic: all three parent refs are
        // required. Viva/career/CV guides (Step 16) sit under the exam
        // instead, so their refs stay string-or-null (checked below).
        // Step 6 fold-in, ChatGPT P0-04: for a 'lesson' the refs are
        // not free strings — they must be well-formed parent IDs
        // (subject 2 segments, chapter 3, topic 4); the prefix chain
        // itself is pinned in the create rule.
        && (d.get('lessonType', null) != 'lesson'
            || (isJobSubjectId(d.get('subjectId', null))
                && isJobChapterId(d.get('chapterId', null))
                && isJobTopicId(d.get('topicId', null))))
        && (isOptStrNoMax(d, 'subjectId'))
        && (isOptStrNoMax(d, 'chapterId'))
        && (isOptStrNoMax(d, 'topicId'))
        && isStrF(d, 'titleBn', 200)
        && isStrF(d, 'titleEn', 200)
        && isStrF(d, 'body', 100000)
        && isOptStrF(d, 'bodyEn', 100000)
        && isPosInt(d, 'order')
        && jobContentStateOk(d);
    }

    // ---------- Step 7: question bank + verification ----------
    // Two-tier bank (Step 3 §2.7–§2.9, §4): jobQuestions (bank
    // record, correct answer + explanation + verification history)
    // is NEVER readable by a student; jobQuestionBundles (student
    // tier, questions + options ONLY) is readable when Published;
    // jobQuestionKeys (answer key) is receipt-gated (§4.2) with the
    // Step 6 fold-in P0-06 anchor: a receipt alone proves nothing —
    // it must reference a real SUBMITTED attempt (users/{uid}/
    // jobAttempts/{attemptId}) for the same bundle and UID.
    function isJobQuestionReviewState(s) {
      return s in ['Not Started', 'In Progress', 'Under Review',
                   'Published', 'Rejected', 'Archived'];
    }
    // Publication state machine: status published ⟺ reviewStatus
    // 'Published'. 'Rejected'/'Archived' extend the Step 5/6
    // two-field vocabulary for the bank (see lib jobQuestions.ts).
    // (Compaction 24 Nov 2026: jobQuestionStatesConsistent was
    // byte-identical to jobExamStatesConsistent — call sites use it.)
    // Facts every new bank question carries: created as a draft in
    // 'Not Started', no verifier, no rejection, no publish fields,
    // author is the caller when present.
    function jobQuestionCreateCommon(d) {
      return jobCreateCommonCore(d)
        && d.get('reviewerId', null) == null
        && d.get('rejectionReason', null) == null;
    }
    // Second-eye rule (Step 7 fold-in, ChatGPT P1-01): a
    // publisher/verifier is never the author, AND the publisher
    // IS the verifier — verifiedBy must be the caller on
    // publication (a prior verification by another moderator does
    // not publish; the publisher re-verifies in the same update).
    // verifiedAt is an audit timestamp, not an access proof: when
    // it changes it must be a real timestamp no later than now and
    // no older than 5 minutes (a moderator cannot backdate last
    // week's verification into a publish, nor future-date one).
    // Backdating inside the window stays possible — the timestamp
    // is audit evidence only; the access decision is verifiedBy
    // != author.
    function jobQuestionSecondEye(oldDoc, newDoc) {
      return (newDoc.get('verifiedBy', null) == oldDoc.get('verifiedBy', null)
          || newDoc.get('verifiedBy', null) == null
          || (newDoc.get('verifiedBy', null) == uid()
              && uid() != oldDoc.get('authorId', '')))
        && (newDoc.get('verifiedAt', null) == oldDoc.get('verifiedAt', null)
            || (newDoc.get('verifiedAt', null) is timestamp
                && newDoc.get('verifiedAt', null) <= request.time
                && newDoc.get('verifiedAt', null) > request.time - duration.value(5, 'm')))
        && (newDoc.get('status', '') != 'published'
            || (newDoc.get('verifiedBy', null) == uid()
                && newDoc.get('verifiedBy', null) != oldDoc.get('authorId', '')
                && newDoc.get('verifiedAt', null) is timestamp
                && newDoc.get('verifiedAt', null) <= request.time));
    }
    // Allowed reviewStatus moves (Moderator/Admin). Same-state is
    // a content-only edit. Publish only from 'Under Review' — a
    // draft never jumps to published. Reject needs a reason ≥10
    // chars. Version: +1 exactly when a Published doc returns to
    // draft (Not Started); unchanged on every other update.
    function jobQuestionTransition(oldDoc, newDoc) {
      return (newDoc.get('reviewStatus', '') == oldDoc.get('reviewStatus', '')
          || (oldDoc.get('reviewStatus', '') in ['Not Started', 'In Progress']
              && newDoc.get('reviewStatus', '') in ['Under Review', 'Rejected', 'Archived'])
          || (oldDoc.get('reviewStatus', '') == 'Under Review'
              && newDoc.get('reviewStatus', '') in ['Published', 'Rejected', 'Archived', 'Not Started'])
          || (oldDoc.get('reviewStatus', '') == 'Published'
              && newDoc.get('reviewStatus', '') in ['Not Started', 'Archived'])
          || (oldDoc.get('reviewStatus', '') == 'Rejected'
              && newDoc.get('reviewStatus', '') in ['Not Started', 'Archived'])
          || (oldDoc.get('reviewStatus', '') == 'Archived'
              && newDoc.get('reviewStatus', '') == 'Not Started'))
        && (newDoc.get('reviewStatus', '') != 'Published'
            || oldDoc.get('reviewStatus', '') == 'Under Review')
        // Central Bank §4.3 gate 3: publish needs an EMPTY
        // duplicateCandidates list — the review decision lives in
        // duplicateReview; the list is cleared when reviewed (the
        // lib validator enforces the same rule).
        && (newDoc.get('reviewStatus', '') != 'Published'
            || newDoc.get('duplicateCandidates', null) == null
            || (newDoc.get('duplicateCandidates', null) is list
                && newDoc.get('duplicateCandidates', null).size() == 0))
        && (newDoc.get('reviewStatus', '') != 'Rejected'
            || (newDoc.get('rejectionReason', null) is string
                && newDoc.get('rejectionReason', '').size() >= 10))
        && (oldDoc.get('status', '') != 'published'
            || newDoc.get('status', '') != 'draft'
            || newDoc.get('version', 0) == oldDoc.get('version', 0) + 1)
        && ((oldDoc.get('status', '') == 'published' && newDoc.get('status', '') == 'draft')
            || newDoc.get('version', 0) == oldDoc.get('version', 0));
    }
    // S8: job-content state fragments, factored verbatim (compaction
    // 24 Nov 2026). jobContentStateOk covers the exam/content
    // 4-state vocabulary; jobQuestionStateOk the bank 7-state one.
    function jobContentStateOk(d) { return d.get('status', null) in ['draft', 'published'] && isJobExamReviewState(d.get('reviewStatus', null)) && jobExamStatesConsistent(d); }
    function jobQuestionStateOk(d) { return d.get('status', null) in ['draft', 'published'] && isJobQuestionReviewState(d.get('reviewStatus', null)) && jobExamStatesConsistent(d); }
    function jobContentChecks() { return jobContentSecondEye(resource.data, request.resource.data) && jobContentPublishTransition(resource.data, request.resource.data); }
    // Field-shape of a bank question. Per-item option checks (each
    // option's letter + text) are NOT possible in rules — lists have
    // no indexing — so rules enforce the 4-option count and the lib
    // validator (jobQuestions.ts) enforces the rest. Previous-year
    // questions need exam + year + source proof (Step 3 §2.7).
    // Central Bank v2 shape (design-central-bank.md §1.1/§6.4).
    // TRIMMED 24 Nov 2026 — the full version (ID regexes, the
    // 15-subject enum, the exam-key vocabulary, the
    // syllabusMappings key check) blew Firestore's 1000-expression
    // evaluation limit on moderator updates (emulator-proved:
    // cb-r14 hit it; cb-r12 passed by a hair). The dropped checks
    // are enforced by the lib validator (jobCentralBank.ts) and
    // cross-checked by the migration test (seed == lib) — the
    // rules keep the checks that are cheap AND load-bearing:
    // shape dispatch, verificationStatus consistency, the
    // previous-year proof, the publish gate (in the transition),
    // schemaVersion pinning. The subject-weights sum-check is
    // likewise unimplementable in rules (no list iteration).
    function validJobQuestionV2(d) {
      return !('examSlug' in d) && !('chapterId' in d)
        && !('questionText' in d) && !('correctLetter' in d)
        && !('isPreviousYear' in d) && !('sourceUrl' in d)
        && !('bundleId' in d)
        && d.get('questionId', null) is string
        && d.get('subjectId', null) is string
        && d.get('topicId', null) is string
        && (d.get('subtopicId', null) == null || d.get('subtopicId', null) is string)
        && d.get('difficulty', null) in ['easy', 'medium', 'hard']
        && d.get('questionType', null) == 'mcq'
        && isStr(d.get('question', null), 2000)
        && d.get('options', null) is list && d.get('options', null).size() == 4
        && d.get('correctAnswer', null) in ['A', 'B', 'C', 'D']
        && isStr(d.get('explanation', null), 2000)
        && (d.get('whyWrong', null) == null || d.get('whyWrong', null) is map)
        && d.get('examMappings', null) is list
        && d.get('examMappings', null).size() >= 1
        && d.get('syllabusMappings', null) is map
        && d.get('verificationStatus', null) in ['draft', 'reviewed', 'verified', 'rejected', 'disputed']
        && (d.get('verificationStatus', null) == 'verified')
             == (d.get('status', null) == 'published')
        && d.get('isActive', null) is bool
        && d.get('origin', null) in ['admin-practice', 'verified-previous',
             'ai-generated-practice', 'teacher-submitted', 'imported']
        && d.get('source', null) is map
        && d.get('source', null).get('type', null) in ['original-practice',
             'previous-year', 'ai-generated', 'teacher-submitted', 'imported']
        && (d.get('origin', null) == 'verified-previous')
             == (d.get('source', null).get('type', null) == 'previous-year')
        && (d.get('origin', null) != 'verified-previous'
            || (d.get('examYear', null) is int
                && d.get('examYear', null) >= 1900 && d.get('examYear', null) <= 2100
                && d.get('source', null).get('url', null) is string))
        && d.get('tags', null) is list
        && (d.get('passageId', null) == null || d.get('passageId', null) is string)
        && isStr(d.get('duplicateHash', null), 200)
        && d.get('duplicateHashV2', null) is string
        && d.get('duplicateHashV2', null).size() == 16
        && (d.get('stemHash', null) == null || d.get('stemHash', null) is string)
        && (d.get('duplicateOf', null) == null || d.get('duplicateOf', null) is string)
        && (d.get('duplicateCandidates', null) == null
            || d.get('duplicateCandidates', null) is list)
        && (d.get('duplicateReview', null) == null || d.get('duplicateReview', null) is map)
        && d.get('status', null) in ['draft', 'published']
        && isJobQuestionReviewState(d.get('reviewStatus', null))
        && jobExamStatesConsistent(d)
        && d.get('version', null) is int && d.get('version', null) >= 1
        && d.get('schemaVersion', null) is int && d.get('schemaVersion', null) == 2
        && (isOptStrNoMax(d, 'legacyId'))
        && (isOptStrNoMax(d, 'rejectionReason'))
        && (isOptStrNoMax(d, 'reviewerId'))
        && (isOptStrNoMax(d, 'configVersion'));
    }
    // Dispatch: v2 docs carry questionId; v1 docs do not. The
    // legacy branch additionally rejects any v2 marker field, so
    // a mixed-shape doc validates under NEITHER branch (§5.1:
    // the migration window stays safe).
    function validJobQuestion(d) {
      return ('questionId' in d)
        ? validJobQuestionV2(d) : validJobQuestionLegacy(d);
    }
    function validJobQuestionLegacy(d) {
      return !('questionId' in d) && !('duplicateHashV2' in d)
        && !('examMappings' in d) && !('syllabusMappings' in d)
        && !('verificationStatus' in d) && !('schemaVersion' in d)
        && d.get('examSlug', null) in jobExamSlugs()
        && d.get('examSlug', null) != 'it-professional'
        && isJobSubjectId(d.get('subjectId', null))
        && isJobChapterId(d.get('chapterId', null))
        && isJobTopicId(d.get('topicId', null))
        && d.get('subjectId', '').matches('^' + d.get('examSlug', '') + '__[a-z0-9-]+$')
        && d.get('chapterId', '').matches('^' + d.get('subjectId', '') + '__[a-z0-9-]+$')
        && d.get('topicId', '').matches('^' + d.get('chapterId', '') + '__[a-z0-9-]+$')
        && isStrF(d, 'questionText', 2000)
        && isListType(d, 'options') && d.get('options', null).size() == 4
        && d.get('correctLetter', null) in ['A', 'B', 'C', 'D']
        && isStrF(d, 'explanation', 2000)
        && isOptMap(d, 'whyWrong')
        && d.get('difficulty', null) in ['easy', 'medium', 'hard']
        && d.get('isPreviousYear', null) is bool
        && (d.get('isPreviousYear', null) != true
            || (isIntRange(d, 'examYear', 1900, 2100)
                && isStrType(d, 'sourceUrl')))
        && isStrF(d, 'source', 500)
        && (isOptStrNoMax(d, 'sourceUrl'))
        && jobQuestionStateOk(d)
        && isStrF(d, 'duplicateHash', 200)
        && isPosInt(d, 'version')
        && (isOptStrNoMax(d, 'rejectionReason'))
        && (isOptStrNoMax(d, 'reviewerId'))
        && (isOptStrNoMax(d, 'configVersion'))
        && (isOptStrNoMax(d, 'bundleId'))
        && (isOptStrNoMax(d, 'duplicateOf'));
    }
    // Field-shape of a student bundle. The key-leak ban (no
    // correctLetter/explanation/correctText anywhere in the doc) is
    // enforced in the match rule — the validator checks shape only.
    // Per-item key-leak checks inside `questions` are NOT possible
    // in rules (no list indexing); buildJobBundle() in the lib is
    // the constructor, and only Moderators build bundles — a
    // Moderator can already read keys, so the student threat model
    // is unaffected.
    function validJobQuestionBundle(d) {
      return d.get('kind', null) in ['topic', 'mock', 'daily', 'weekly', 'previous']
        && d.get('examSlug', null) in jobExamSlugs()
        && d.get('examSlug', null) != 'it-professional'
        && (d.get('kind', null) != 'topic' || isStrType(d, 'topicId'))
        && (d.get('kind', null) != 'mock' || isStrType(d, 'mockId'))
        && (d.get('kind', null) != 'daily' || isStrType(d, 'mockId'))
        && (d.get('kind', null) != 'weekly' || isStrType(d, 'mockId'))
        && (d.get('kind', null) != 'previous' || isIntType(d, 'year'))
        && isStrF(d, 'titleBn', 200)
        && isStrF(d, 'titleEn', 200)
        && isListType(d, 'questions')
        && d.get('questions', null).size() <= 200
        && isIntRange(d, 'questionCount', 1, 200)
        && d.get('questionCount', null) == d.get('questions', null).size()
        && isListType(d, 'sourceQuestionIds')
        && jobQuestionStateOk(d)
        && (isOptStrNoMax(d, 'configVersion'))
        // Step 8 fold-in (finding 5): the bundle generation an
        // attempt binds to — optional here (older bundles may lack
        // it) but validated when present; the ATTEMPT rule requires
        // the bundle to carry it and match.
        && isOptPosInt(d, 'bundleVersion');
    }
    // Field-shape of an answer key. Per-answer checks are NOT
    // possible in rules (no list indexing); buildJobBundle() in the
    // lib is the constructor. The bundleId must equal the doc ID.
    // The key must answer at least one question (an empty key opens
    // nothing and scores nothing).
    function validJobQuestionKey(d, bundleId) {
      return d.get('bundleId', null) == bundleId
        && isListType(d, 'answers')
        && d.get('answers', null).size() >= 1
        && d.get('answers', null).size() <= 200
        && (isOptStrNoMax(d, 'configVersion'))
        && (isOptTs(d, 'createdAt'))
        && (isOptTs(d, 'updatedAt'));
    }
    // Key↔bundle consistency (Step 7 fold-in, ChatGPT P1-06): a
    // key is valid only against its own bundle — the key answers
    // exactly the bundle's questions (same count) and carries the
    // same configVersion (a stale key from an older config cannot
    // score a newer bundle). The bundle must exist.
    function jobKeyMatchesBundle(d, bundleId, bundle) {
      return bundle.questionCount == d.get('answers', []).size()
        && isStrType(d, 'configVersion')
        && bundle.get('configVersion', null) == d.get('configVersion', null);
    }
    // A practice (topic) bundle's key is readable signed-in for
    // immediate feedback — but ONLY when the bundle is Published
    // (Step 3 §3.6 draft let anyone read any topic key; adapted).
    // The bundle map is passed in by the caller (fetched once at
    // the jobQuestionKeys read rule).
    function isPracticeJobBundle(bundle) {
      return signedIn() && callerActive()
        && bundle.kind == 'topic'
        && bundle.status == 'published';
    }
    // Fresh-receipt key access (Step 3 §4.2 + Step 6 fold-in P0-06
    // + Step 7 fold-in, ChatGPT P0-01 Option A): a receipt is a
    // TEN-MINUTE, ATTEMPT-BOUND AUTHORIZATION WINDOW — it is NOT
    // one-use. Firestore read rules cannot atomically consume a
    // receipt as a side effect of a read, so repeat reads inside
    // the window are possible BY DESIGN (same browser, another
    // session — all succeed while the window is open). The old
    // "single-use" claim is REMOVED everywhere it described
    // jobReceipts; never claim one-use again. A receipt opens a
    // key ONLY if it is ≤10 minutes old AND not from the future
    // AND it anchors to a real SUBMITTED attempt owned by the
    // caller for this bundle — OR (Step 9, Design G) to a real
    // SUBMITTED mock SESSION for this bundle (the scoring window:
    // session submitted, attempt not yet created). A bare/forged
    // receipt without a submission opens nothing. Honest residual limit (Step 3
    // §4.3, stands): a determined student can still forge a
    // submitted attempt + receipt in the console and read a key —
    // on Spark this cannot be fully closed; scores are therefore
    // NEVER shown as "Verified" (every result page is labelled
    // "অনুশীলন ফলাফল"). The window CAN be re-issued, but only by
    // an anchored re-issue (Step 9 closure, open question 1): a new
    // submission re-anchors the receipt with a fresh createdAt;
    // without a new submission the window never refreshes.
    // NOTE: rules have no `let` — the receipt/bundle maps are
    // fetched ONCE by the caller and passed in as plain maps (the
    // exists-guards at the call site run first, so a missing doc
    // never errors the rule into a deny-by-exception); the anchor
    // attempt/session is fetched per branch below, keyed by
    // receipt.attemptId (each anchor helper takes the ID, not the
    // bundle — one get() per anchor check, not two).
    function jobReceiptData(bundleId) {
      return get(/databases/$(database)/documents/jobReceipts/$(uid() + '_' + bundleId)).data;
    }
    function jobReceiptAttemptData(attemptId) {
      return get(/databases/$(database)/documents/users/$(uid())/jobAttempts/$(attemptId)).data;
    }
    // Step 9 (Design G): the receipt may ALSO anchor to a
    // SUBMITTED mock SESSION (same doc-ID as the future attempt).
    // The session anchor is what makes honest mock scoring
    // possible at all: the key is read AFTER the session is
    // submitted (answers frozen, terminal) but BEFORE the attempt
    // exists. An in-progress session anchors NOTHING (q66/q75
    // still deny it) — the P0-06 hole stays closed.
    // ChatGPT fold-in (H.1, CRITICAL): the receipt carries a
    // PURPOSE — 'practice_review' or 'exam_review' — and the key
    // read checks the purpose against the bundle's kind, so a
    // practice receipt can NEVER unlock an exam key (and vice
    // versa). The purpose is bound at receipt CREATE (see the
    // jobReceipts match below): practice_review anchors to a
    // submitted PRACTICE attempt; exam_review anchors to a
    // submitted EXAM session (the scoring window, Design G) or a
    // submitted EXAM attempt. The exam anchors live in the
    // SEPARATE exam collections (H.2) — jobExamSessions /
    // jobExamAttempts — never in jobSessions / jobAttempts.
    function jobReceiptExamAttemptData(attemptId) {
      return get(/databases/$(database)/documents/users/$(uid())/jobExamAttempts/$(attemptId)).data;
    }
    function jobReceiptExamSessionData(attemptId) {
      return get(/databases/$(database)/documents/users/$(uid())/jobExamSessions/$(attemptId)).data;
    }
    function hasFreshJobReceipt(bundleId, receipt, bundle) {
      return signedIn() && callerActive()
        && receipt.createdAt > request.time - duration.value(10, 'm')
        // Upper bound with a 5-minute skew tolerance (Step 9
        // fold-in, a5 debug 22 Nov): the receipt must not be
        // dated more than 5 minutes in the future. A bare
        // `createdAt <= request.time` BREAKS legitimate fresh
        // receipts — the emulator's request.time lags the minting
        // clock by seconds, and in production a device clock
        // ahead of the server would do the same. The strict upper
        // bound still lives at CREATE (P0-03); this read-time
        // tolerance only weakens the defense-in-depth against a
        // SEEDED future-dated receipt by 5 minutes (a10b's +1h
        // receipt still denies) — such a receipt cannot be minted
        // through the rules at all.
        && receipt.createdAt <= request.time + duration.value(5, 'm')
        && receipt.attemptId is string
        && ((bundle.kind in ['mock', 'daily', 'weekly']
              && receipt.purpose == 'exam_review'
              && ((exists(/databases/$(database)/documents/users/$(uid())/jobExamAttempts/$(receipt.attemptId))
                    && jobReceiptExamAttemptData(receipt.attemptId).status == 'submitted'
                    && jobReceiptExamAttemptData(receipt.attemptId).bundleId == bundleId
                    && jobReceiptExamAttemptData(receipt.attemptId).userId == uid()
                    && jobReceiptExamAttemptData(receipt.attemptId).kind == 'mock')
                  || (exists(/databases/$(database)/documents/users/$(uid())/jobExamSessions/$(receipt.attemptId))
                    && jobReceiptExamSessionData(receipt.attemptId).status == 'submitted'
                    && jobReceiptExamSessionData(receipt.attemptId).bundleId == bundleId
                    && jobReceiptExamSessionData(receipt.attemptId).kind == 'mock')))
            || (bundle.kind in ['topic', 'previous']
              && receipt.purpose == 'practice_review'
              && exists(/databases/$(database)/documents/users/$(uid())/jobAttempts/$(receipt.attemptId))
              && jobReceiptAttemptData(receipt.attemptId).status == 'submitted'
              && jobReceiptAttemptData(receipt.attemptId).bundleId == bundleId
              && jobReceiptAttemptData(receipt.attemptId).userId == uid()
              && jobReceiptAttemptData(receipt.attemptId).kind == 'practice'));
    }

    // Step 9 closure (open question 1 — anchored receipt RE-ISSUE):
    // the anchor check for a receipt doc, shared by create and by
    // the re-issue update. The purpose decides the anchor.
    // practice_review: a SUBMITTED practice attempt for this bundle
    // (kind 'practice', matching generation). exam_review: a
    // SUBMITTED exam attempt for this bundle (kind 'mock') — OR a
    // SUBMITTED exam session for this bundle (the scoring window:
    // the session is submitted, answers frozen, and the attempt
    // does not exist yet — the receipt's attemptId IS the session
    // ID; the session carries the bundle generation). An
    // in-progress session anchors nothing. `data` is the WOULD-BE
    // doc (request.resource.data on create and on update); the
    // caller checks the shape, freshness and identity separately.
    // A re-issue does NOT extend a window silently: the new doc
    // must re-anchor to a NEWLY submitted session/attempt and carry
    // a fresh createdAt, so each submission opens exactly one new
    // 10-minute window.
    // Anchor-field checks on an already-fetched attempt/session
    // map (the caller exists-guards first, then passes the map
    // in — one get() per anchor instead of one per field).
    function validJobPracticeAttemptAnchor(data, a) {
      return a.status == 'submitted'
        && a.bundleId == data.get('bundleId', '')
        && a.userId == uid()
        && a.kind == 'practice'
        && a.bundleVersion == data.get('bundleVersion', null);
    }
    function validJobExamAttemptAnchor(data, a) {
      return a.status == 'submitted'
        && a.bundleId == data.get('bundleId', '')
        && a.userId == uid()
        && a.kind == 'mock'
        && a.bundleVersion == data.get('bundleVersion', null);
    }
    function validJobExamSessionAnchor(data, s) {
      return s.status == 'submitted'
        && s.bundleId == data.get('bundleId', '')
        && s.kind == 'mock'
        && s.bundleVersion == data.get('bundleVersion', null);
    }
    function validJobReceiptAnchor(data) {
      return (((data.get('purpose', '') == 'practice_review')
              && exists(/databases/$(database)/documents/users/$(uid())/jobAttempts/$(data.get('attemptId', '')))
              && validJobPracticeAttemptAnchor(data, get(/databases/$(database)/documents/users/$(uid())/jobAttempts/$(data.get('attemptId', ''))).data))
            || ((data.get('purpose', '') == 'exam_review')
              && ((exists(/databases/$(database)/documents/users/$(uid())/jobExamAttempts/$(data.get('attemptId', '')))
                    && validJobExamAttemptAnchor(data, get(/databases/$(database)/documents/users/$(uid())/jobExamAttempts/$(data.get('attemptId', ''))).data))
                  || (exists(/databases/$(database)/documents/users/$(uid())/jobExamSessions/$(data.get('attemptId', '')))
                    && validJobExamSessionAnchor(data, get(/databases/$(database)/documents/users/$(uid())/jobExamSessions/$(data.get('attemptId', ''))).data)))));
    }

    // ---------- Step 8: practice engine (jobAttempts + jobSessions) ----------
    // Helpers for the Step 8 validators below. Same no-`let` shape as
    // the Step 7 helpers: each call is a fresh get(); the exists()
    // guards in the validators run first, so a missing doc never
    // errors the rule into a deny-by-exception.
    function jobBundleData(bundleId) {
      return get(/databases/$(database)/documents/jobQuestionBundles/$(bundleId)).data;
    }
    // Post-write session state (Step 8 fold-in, ChatGPT finding 1):
    // getAfter() reads the session AS WRITTEN BY THIS BATCH — so a
    // batched submit (session → submitted + attempt create together)
    // validates against the submitted state, not the pre-batch
    // in-progress one. When the session is NOT in the batch,
    // getAfter() reads the stored doc, so the old sequential flow
    // (submit session, then create attempt) still passes the gate.
    function jobSessionDataAfter(userId, sessionId) {
      return getAfter(/databases/$(database)/documents/users/$(userId)/jobSessions/$(sessionId)).data;
    }
    // Bundle-kind consistency (Step 8 decision, narrowed by the
    // Step 9 ChatGPT fold-in H.2): a practice attempt / session runs
    // on a topic bundle (or a previous-year set, which is practised
    // topic-style) and NOTHING else. Mock bundles (mock / daily /
    // weekly) belong to the SEPARATE exam collections
    // (jobExamSessions / jobExamAttempts) — a practice attempt can
    // never ride on a mock bundle, and the mock branch that used to
    // live here is gone.
    function jobBundleKindFitsAttemptKind(bundleKind, kind) {
      return kind == 'practice' && bundleKind in ['topic', 'previous'];
    }
    // ---------- Step 9: full-exam engine (jobExamSessions / jobExamAttempts) ----------
    // Helpers for the exam validators below. Same no-`let` shape:
    // each call is a fresh get(); the exists() guards run first.
    // The exam definition (jobExamDefinitions) doc-ID is derived
    // from the bundle kind + the session's bare mockId: a full mock
    // carries its doc-ID as its mockId, a daily/weekly mock carries
    // the bare date/week key.
    function jobExamDefinitionData(definitionId) {
      return get(/databases/$(database)/documents/jobExamDefinitions/$(definitionId)).data;
    }
    function jobManifestData(questionSetId) {
      return get(/databases/$(database)/documents/jobQuestionSetManifests/$(questionSetId)).data;
    }
    function jobExamSessionDataAfter(userId, sessionId) {
      return getAfter(/databases/$(database)/documents/users/$(userId)/jobExamSessions/$(sessionId)).data;
    }
    // Full-attempt create validation (Step 3 §2.11 + §3.8, Step 8).
    // The attempt doc is created ONCE at submit with status
    // 'submitted' and the full fields (Step 8 design decision: the
    // Step 7 minimal anchor's create-in-progress + update-to-submit
    // lifecycle is GONE — a second submit is an update, and updates
    // are denied, so the doc-ID stays the idempotency key and no
    // orphan in-progress attempt can ever be stranded, since deletes
    // are forbidden for everyone including Admin).
    // HONEST LIMITS — what the rules CANNOT check, and why:
    //  - Per-answer shape: rules have NO list indexing, so the
    //    per-answer {topicId, subjectId, correct, marks, ...} shape
    //    cannot be validated here (Step 7 decision #7 stands). The
    //    per-answer topicId + correct mandate is enforced by the
    //    engine lib validator (jobEngine.ts, Step 8 UI agent); the
    //    rules enforce the aggregates instead: counts sum to
    //    answers.size(), answers non-empty and <= the bundle's
    //    questionCount, and the marks/counts sanity checks below.
    //  - Exact score formula: score == correct*marksPerQuestion -
    //    wrong*negativeMarking needs the exam pattern, which the
    //    rules do NOT look up (no jobExams read — keeps the rule
    //    inside the get() budget). Enforceable binding (Step 8
    //    fold-in, findings 2/5): the attempt DECLARES the marking
    //    it was scored under (`negativeMarkingUsed` in {0, 0.25,
    //    0.5} + `markingSchemeVersion`), and the rule enforces
    //    negativeDeduction == wrongCount * negativeMarkingUsed —
    //    so a claimed deduction always matches a declared scheme
    //    (Bank: 0 — its penalty is unverified and disabled, never
    //    the provisional 0.25). The exact formula is lib-level.
    //  - Float division: accuracy/percentage formulas cannot be
    //    verified (rules cannot reliably check float division), so
    //    only ranges are enforced (accuracy 0..100, percentage
    //    -100..100); the values are client-computed + range-checked.
    //  - examSlug allowlist is the canonical 14 hub slugs from
    //    jobExamSlugs() (same list as jobProfile.ts
    //    TARGET_EXAM_SLUGS). 'common' is NOT in it: /jobs/common is
    //    a cross-exam hub/route, not an exam — common-topic practice
    //    carries the underlying exam's slug.
    //  - Session gate: the attempt may only be created when the
    //    session with the same doc-ID exists and is already
    //    'submitted' (the client marks the session submitted in the
    //    same submit flow, then creates the attempt). Kind /
    //    examSlug / mockId equality between session and attempt is
    //    NOT re-checked here: it follows transitively, because both
    //    the session create and the attempt create bind kind +
    //    examSlug + mockId to the SAME bundle (a mock session cannot
    //    exist on a topic bundle, and vice versa).
    // Shared attempt-core validation (practice + mock attempts,
    // unified 22 Nov 2026 for the compiled-size limit): the scalar
    // checks on a submitted attempt are identical for both kinds.
    // Only the kind-specific headers (kind / mockId / subjectId /
    // topicId / questionSetId / key lists) and the bundle+session
    // gates differ — those stay in each caller. The deduction is
    // bound to the DECLARED scheme (Step 8 fold-in, findings
    // 2/5/9): negativeDeduction == wrongCount * negativeMarkingUsed,
    // and the score is range-checked, never recomputed (§4.4).
    // H.3: immutable does NOT mean truthful — the score is
    // client-calculated, and the attempt says so explicitly; no
    // student can ever write a 'server_verified' integrity label,
    // and serverVerifiedScore must be absent or null (a future
    // server scorer would be its only writer).
    function validJobAttemptCore(d, attemptId) {
        return isListType(d, 'answers')
        && d.get('answers', []).size() >= 1
        && d.get('score', null) is number
        && d.get('totalMarks', null) is number && d.get('totalMarks', 0) > 0
        && d.get('score', 0) <= d.get('totalMarks', 0)
        && d.get('score', 0) >= -d.get('totalMarks', 0)
        && d.get('clientCalculatedScore', null) == d.get('score', null)
        && d.get('negativeDeduction', null) is number
        && d.get('negativeDeduction', -1) >= 0
        && d.get('negativeMarkingUsed', null) is number
        && (d.get('negativeMarkingUsed', -1) == 0
            || d.get('negativeMarkingUsed', -1) == 0.25
            || d.get('negativeMarkingUsed', -1) == 0.5)
        && d.get('negativeDeduction', -1)
             == d.get('wrongCount', 0) * d.get('negativeMarkingUsed', -1)
        && isStrF(d, 'markingSchemeVersion', 100)
        && isPosInt(d, 'bundleVersion')
        && isNonNegInt(d, 'correctCount')
        && isNonNegInt(d, 'wrongCount')
        && isNonNegInt(d, 'unansweredCount')
        && d.get('correctCount', 0) + d.get('wrongCount', 0) + d.get('unansweredCount', 0)
             == d.get('answers', []).size()
        && isNumRange(d, 'accuracy', 0, 100)
        && isNumRange(d, 'percentage', -100, 100)
        && d.get('timeSpentSeconds', null) is number
        && d.get('timeSpentSeconds', -1) >= 0
        && isTsType(d, 'startedAt')
        && isTsType(d, 'submittedAt')
        && d.get('startedAt', null) <= d.get('submittedAt', null)
        && d.get('submittedAt', null) <= request.time
        && d.get('status', '') == 'submitted'
        && d.get('markingStatus', '') == 'auto'
        && d.get('resultLabel', '') == 'practice'
        && d.get('trustLevel', '') == 'unverified'
        && d.get('resultType', '') == 'practice'
        && d.get('submissionIntegrity', '') == 'client_calculated'
        && d.get('serverVerifiedScore', null) == null
        && isOptMap(d, 'audit')
        && isOptList(d, 'answerHashes')
        && isOptList(d, 'anomalyFlags')
        && d.get('sessionId', '') == attemptId;
    }
    function validJobAttemptCreate(d, userId, attemptId, bundle, sessAfter) {
      return d.keys().hasOnly(['userId', 'kind', 'mockId', 'bundleId',
             'examSlug', 'subjectId', 'topicId', 'answers', 'score',
             'totalMarks', 'negativeDeduction', 'negativeMarkingUsed',
             'markingSchemeVersion', 'bundleVersion', 'correctCount',
             'wrongCount', 'unansweredCount', 'accuracy', 'percentage',
             'timeSpentSeconds', 'startedAt', 'submittedAt', 'status',
             'markingStatus', 'resultLabel', 'clientCalculatedScore',
             'serverVerifiedScore', 'trustLevel', 'resultType',
             'sessionId', 'audit', 'answerHashes', 'anomalyFlags',
             'submissionIntegrity'])
        && d.keys().hasAll(['userId', 'kind', 'mockId', 'bundleId',
             'examSlug', 'subjectId', 'topicId', 'answers', 'score',
             'totalMarks', 'negativeDeduction', 'negativeMarkingUsed',
             'markingSchemeVersion', 'bundleVersion', 'correctCount',
             'wrongCount', 'unansweredCount', 'accuracy', 'percentage',
             'timeSpentSeconds', 'startedAt', 'submittedAt', 'status',
             'markingStatus', 'resultLabel', 'clientCalculatedScore',
             'trustLevel', 'resultType', 'sessionId',
             'submissionIntegrity'])
        && d.get('userId', '') == userId
        // Step 9 (ChatGPT fold-in, H.2): practice attempts live
        // ONLY here (jobAttempts). A mock attempt belongs to
        // jobExamAttempts (validJobExamAttemptCreate) — kind 'mock'
        // is no longer valid in this collection.
        && d.get('kind', null) == 'practice'
        && d.get('mockId', null) == null
        && isStrType(d, 'bundleId')
        && (d.get('subjectId', null) == null
            || (isStrType(d, 'subjectId') && d.get('subjectId', '').size() <= 200))
        && (d.get('topicId', null) == null
            || (isStrType(d, 'topicId') && d.get('topicId', '').size() <= 200))
                && validJobAttemptCore(d, attemptId)
        // The bundle must exist, be Published, and match the attempt
        // (same exam, fitting kind, same mock when a mock) — and the
        // attempt must be bound to the bundle's CURRENT generation
        // (Step 8 fold-in, finding 5: a republished bundle cannot
        // silently reinterpret an old attempt).
        && bundle.status == 'published'
        && bundle.examSlug == d.get('examSlug', null)
        && jobBundleKindFitsAttemptKind(bundle.kind, d.get('kind', null))
        && d.get('answers', []).size() <= bundle.questionCount
        && bundle.get('bundleVersion', null) == d.get('bundleVersion', null)
        // Session gate (Step 8 decision, strengthened by the fold-in,
        // ChatGPT finding 1): the session with the same ID must exist
        // and be 'submitted' AFTER this write (getAfter — the batched
        // submit's own transition counts). An in-progress or abandoned
        // session — or no session — cannot anchor an attempt. The
        // attempt is also bound to the session's IDENTITY: same kind,
        // exam, mock, bundle, and the same number of questions as the
        // session's stored order — so a forged attempt cannot ride on
        // an unrelated session.
        && sessAfter.status == 'submitted'
        && sessAfter.bundleId == d.get('bundleId', '')
        && sessAfter.kind == d.get('kind', null)
        && sessAfter.examSlug == d.get('examSlug', null)
        && sessAfter.mockId == d.get('mockId', null)
        && sessAfter.questionRefs.size() == d.get('answers', []).size();
    }
    // Session create validation (Step 3 §2.12). A PRACTICE session
    // starts 'in-progress' with endsAt null — practice never has a
    // timer (no endsAt, no clientEndsAtMillis). PAUSED is NOT a
    // session-doc status: it exists only as a client-side practice
    // state (Step 2 §4.5), so it is deliberately absent here.
    // Step 9 (ChatGPT fold-in, H.2): this validator is PRACTICE
    // ONLY. A mock session belongs to jobExamSessions
    // (validJobExamSessionCreate) — kind 'mock' is no longer valid
    // in this collection.
    function validJobSessionCreate(d, bundle) {
      return d.keys().hasOnly(['kind', 'mockId', 'bundleId', 'examSlug',
             'status', 'startedAt', 'endsAt', 'questionRefs', 'answers',
             'currentQuestion', 'lastSyncedAt', 'clientEndsAtMillis',
             'submittedAt', 'createdAt', 'updatedAt', 'revision'])
        && d.keys().hasAll(['kind', 'mockId', 'bundleId', 'examSlug',
             'status', 'startedAt', 'endsAt', 'questionRefs', 'answers',
             'currentQuestion', 'lastSyncedAt', 'clientEndsAtMillis',
             'submittedAt', 'createdAt', 'updatedAt', 'revision'])
        && d.get('kind', null) == 'practice'
        && d.get('mockId', null) == null
        && isStrType(d, 'bundleId')
        && d.get('status', '') == 'in-progress'
        && isTsType(d, 'startedAt')
        && d.get('endsAt', null) == null
        && isListType(d, 'questionRefs')
        && d.get('questionRefs', []).size() >= 1
        && d.get('answers', null) is map
        // Step 8 fold-in (finding 6): the answers map is exactly one
        // entry per stored question (keys = questionRefs n values);
        // currentQuestion is inside the stored order.
        // Step 13: the bound is MEMBERSHIP in the answers keys,
        // not `<= refs.size()` — a subset session's first n can
        // exceed the subset size (e.g. a 1-question subset of
        // bundle n=9), and the old proxy rejected it. The answers
        // keys ARE the refs' n values (see the size check above),
        // so membership is exactly "inside the stored order".
        && d.get('answers', {}).size() == d.get('questionRefs', []).size()
        && isPosInt(d, 'currentQuestion')
        && string(d.get('currentQuestion', 0)) in d.get('answers', {}).keys()
        && isTsType(d, 'lastSyncedAt')
        // Step 8 fold-in (finding 6): revision starts at 1 and is
        // bumped by exactly 1 per write (see validJobSessionUpdate)
        // — a stale client write is rejected, so two tabs/devices
        // cannot silently overwrite each other's answers.
        && isIntType(d, 'revision') && d.get('revision', 0) == 1
        && isTsType(d, 'lastSyncedAt')
        && d.get('clientEndsAtMillis', null) == null
        && d.get('submittedAt', null) == null
        && isTsType(d, 'createdAt')
        && isTsType(d, 'updatedAt')
        && bundle.status == 'published'
        && bundle.examSlug == d.get('examSlug', null)
        && jobBundleKindFitsAttemptKind(bundle.kind, d.get('kind', null));
    }
    // Session update validation (d = new doc, old = existing doc).
    // PRACTICE ONLY (H.2). Only called while old.status ==
    // 'in-progress' (enforced in the match) and only for the
    // autosave/transition keys (enforced by affectedKeys in the
    // match). submittedAt is set exactly on the in-progress ->
    // submitted transition; endsAt NEVER exists on a practice
    // session (a practice update that sets one is denied).
    // Shared session-update core (practice + exam sessions,
    // unified 22 Nov 2026 for the compiled-size limit): the status
    // transition, answers/currentQuestion bounds, revision+1 and
    // timestamp checks are identical. The endsAt / deadline logic
    // (exam only) and the practice endsAt/clientEndsAtMillis null
    // checks stay in each caller. The autosave bound (finding 6)
    // lives here: answers never grow past the stored question list
    // and a write carries exactly old.revision + 1.
    // Step 13: currentQuestion is MEMBERSHIP in the new answers
    // keys, not `<= old refs.size()` — a subset session's n can
    // exceed the subset size (see validJobSessionCreate).
    function validJobSessionUpdateCore(d, old) {
      return d.get('status', '') in ['in-progress', 'submitted', 'abandoned']
        && ((d.get('status', '') == 'submitted' && isTsType(d, 'submittedAt'))
            || (d.get('status', '') != 'submitted' && d.get('submittedAt', null) == null))
        && d.get('answers', null) is map
        && d.get('answers', {}).size() <= old.get('questionRefs', []).size()
        && isPosInt(d, 'currentQuestion')
        && string(d.get('currentQuestion', 0)) in d.get('answers', {}).keys()
        && isIntType(d, 'revision')
        && d.get('revision', -1) == old.get('revision', 0) + 1
        && isTsType(d, 'lastSyncedAt')
        && isTsType(d, 'updatedAt');
    }
    function validJobSessionUpdate(d, old) {
      return validJobSessionUpdateCore(d, old)
        && d.get('endsAt', null) == null
        && d.get('clientEndsAtMillis', null) == null;
    }

    // ---------- Step 9: full-exam sessions + attempts ----------
    // Exam session create (Step 9, ChatGPT fold-in §1(a)/§1(b)/
    // H.2/H.6/H.7). The exam session lives in jobExamSessions — a
    // SEPARATE collection from practice sessions, with exam-only
    // rules. The timer is server-time-derived:
    //  - startedAt MUST be the server timestamp (== request.time —
    //    a literal client Date is a few ms off and fails, so the
    //    client must write the serverTimestamp sentinel; verified
    //    in the emulator, scratch test 22 Nov 2026).
    //  - endsAt starts null and is set ONCE by a later update to
    //    EXACTLY startedAt + the definition's frozen duration
    //    (see validJobExamSessionUpdate) — the client cannot
    //    compute request.time + duration at create (it does not
    //    know the server time until it reads back startedAt), so
    //    the exact-equality check lives on the update, not here.
    //  - the question set is FROZEN by whole-equality against the
    //    published manifest (jobQuestionSetManifests): the
    //    session's questionRefs must BE the manifest's refs, and
    //    the manifest must be the definition's CURRENT one.
    //  - one active session per user per exam pattern (H.7): the
    //    create is a batch with the lock doc jobExamUserLocks/
    //    {uid}_{examSlug} — the rule requires the post-batch lock
    //    to exist and point at this session (getAfter).
    // Budget note (Step 9 fold-in, H.6 + the M1 lesson): Firestore
    // rules have NO let bindings and a 1000-expression budget PER
    // REQUEST — a batched session+lock create evaluates BOTH
    // validators together. Every referenced doc is therefore
    // fetched ONCE, in the match below, and passed in as a plain
    // map (bundle / manifest / def / lockAfter). Re-reading the
    // same doc at several call sites (the original shape) blew the
    // budget on the batch (verified 22 Nov, scratch a5–a5h).
    function validJobExamSessionCreate(d, sessionId, bundle, manifest, def, lockAfter) {
      return d.keys().hasOnly(['kind', 'mockId', 'bundleId', 'examSlug',
             'definitionId', 'questionSetId', 'bundleVersion', 'status',
             'startedAt', 'endsAt', 'questionRefs', 'answers',
             'currentQuestion', 'lastSyncedAt', 'clientEndsAtMillis',
             'submittedAt', 'createdAt', 'updatedAt', 'revision'])
        && d.keys().hasAll(['kind', 'mockId', 'bundleId', 'examSlug',
             'definitionId', 'questionSetId', 'bundleVersion', 'status',
             'startedAt', 'endsAt', 'questionRefs', 'answers',
             'currentQuestion', 'lastSyncedAt', 'clientEndsAtMillis',
             'submittedAt', 'createdAt', 'updatedAt', 'revision'])
        && d.get('kind', null) == 'mock'
        && isStrType(d, 'mockId') && d.get('mockId', '').size() > 0
        && isStrType(d, 'bundleId')
        && isStrType(d, 'definitionId') && d.get('definitionId', '').size() > 0
        && isStrType(d, 'questionSetId') && d.get('questionSetId', '').size() > 0
        && isPosInt(d, 'bundleVersion')
        && d.get('status', '') == 'in-progress'
        && d.get('startedAt', null) == request.time
        && d.get('endsAt', null) == null
        && isListType(d, 'questionRefs')
        && d.get('questionRefs', []).size() >= 1
        && d.get('answers', null) is map
        && d.get('answers', {}).size() == d.get('questionRefs', []).size()
        && isPosInt(d, 'currentQuestion')
        && d.get('currentQuestion', 0) <= d.get('questionRefs', []).size()
        && isIntType(d, 'revision') && d.get('revision', 0) == 1
        && isTsType(d, 'lastSyncedAt')
        && isOptNum(d, 'clientEndsAtMillis')
        && d.get('submittedAt', null) == null
        && isTsType(d, 'createdAt')
        && isTsType(d, 'updatedAt')
        // The bundle must be Published and match the session
        // (same exam, mock-type kind, same mock) — and the
        // session runs the bundle's CURRENT generation.
        && bundle.get('status', null) == 'published'
        && bundle.get('examSlug', null) == d.get('examSlug', null)
        && bundle.get('kind', null) in ['mock', 'daily', 'weekly']
        && bundle.get('mockId', null) == d.get('mockId', null)
        && bundle.get('bundleVersion', null) == d.get('bundleVersion', null)
        // The manifest must be Published, belong to this mock,
        // and BE the session's question set — whole-equality (the
        // only loop-free way to validate 200 refs in rules).
        && manifest.get('status', null) == 'published'
        && manifest.get('mockId', null) == d.get('mockId', null)
        && manifest.get('examSlug', null) == d.get('examSlug', null)
        && manifest.get('questionRefs', null) == d.get('questionRefs', null)
        && manifest.get('questionCount', null) == d.get('questionRefs', []).size()
        // The definition must be Published, point at this bundle
        // AND at this manifest (the session runs the definition's
        // CURRENT question set — resume reads the session's stored
        // questionSetId, never the definition).
        && def.get('status', null) == 'published'
        && def.get('bundleId', null) == d.get('bundleId', '')
        && def.get('questionSetId', null) == d.get('questionSetId', '')
        && def.get('examSlug', null) == d.get('examSlug', null)
        // The lock (H.7): the post-batch lock must exist, belong
        // to this user + pattern, be in_progress, and point at
        // this session. A session created without its lock (a
        // single write, no batch) reads the STORED lock via
        // getAfter — absent — and is denied.
        && lockAfter.get('activeSessionId', '') == sessionId
        && lockAfter.get('status', '') == 'in_progress'
        && lockAfter.get('definitionId', '') == d.get('definitionId', '');
    }
    // Exam session update (d = new doc, old = existing doc). Only
    // called while old.status == 'in-progress' (match) and only
    // for the autosave/transition keys (affectedKeys in the match).
    // Timer (ChatGPT §1(a) A.2 + audit M1, tightened to EXACT):
    //  - endsAt is set ONCE, from null, to EXACTLY startedAt +
    //    the definition's frozen duration (rulesSnapshot.
    //    timeMinutes) — not a range: a shorter deadline would let
    //    a client shorten its own exam, a longer one would stretch
    //    it. The chain runs ONLY when endsAt is actually being
    //    set (short-circuit), so autosaves never pay for it.
    //  - answers may change ONLY while the exam is still running:
    //    if the answers map changed, the stored deadline must be
    //    unset (not yet stored) or still in the future. The
    //    in-progress -> submitted transition is deadline-checked
    //    the same way (F7, 23 Nov 2026): a submit is allowed only
    //    while request.time < the stored endsAt, so a late client
    //    can no longer flip the session to 'submitted' while the
    //    attempt create is denied by M1-b (orphan submitted
    //    session). The check is folded into the answers clause
    //    (no new top-level condition) to stay inside the
    //    compiled-rules size budget: a non-submit update keeps
    //    the old behaviour (answers unchanged, or deadline unset
    //    or in the future), so abandon-after-deadline and
    //    autosave keep working. A submit with endsAt still unset
    //    is still allowed here — the attempt create denies it
    //    (M1-b), so no late attempt is ever created; the residual
    //    is only the orphan-session UX, not a security hole.
    //    Boundary is strict `< endsAt`, matching the answer-write
    //    gate in this function; M1-b uses `submittedAt <= endsAt`
    //    on the attempt's server timestamp, so the session gate
    //    is the binding one for the batched submit. No grace
    //    window: the client already auto-submits at <=10s
    //    remaining, and a server grace would double-count that
    //    latency budget.
    //  - startedAt / definitionId / questionSetId / bundleVersion /
    //    bundleId / examSlug / mockId / questionRefs / kind are
    //    immutable — they are not in the match's affectedKeys.
    function jobExamEndsAtIsExact(old, d, def) {
      return def.get('rulesSnapshot', null) is map
        && isIntType(def.rulesSnapshot, 'timeMinutes')
        && isTsType(d, 'endsAt')
        && isTsType(old, 'startedAt')
        && d.get('endsAt', null) == old.get('startedAt', null)
             + duration.value(def.rulesSnapshot.timeMinutes * 60, 's');
    }
    function validJobExamSessionUpdate(d, old) {
      return validJobSessionUpdateCore(d, old)
        && ((old.get('endsAt', null) == null
              && (d.get('endsAt', null) == null
                  || (exists(/databases/$(database)/documents/jobQuestionBundles/$(old.get('bundleId', '')))
                      && exists(/databases/$(database)/documents/jobExamDefinitions/$(old.get('definitionId', '')))
                      && jobExamEndsAtIsExact(old, d, jobExamDefinitionData(old.get('definitionId', ''))))))
            || (old.get('endsAt', null) != null && d.get('endsAt', null) == old.get('endsAt', null)))
        && ((d.get('status', '') != 'submitted' && d.get('answers', {}) == old.get('answers', {}))
            || old.get('endsAt', null) == null
            || request.time < old.get('endsAt', null))
        && isOptNum(d, 'clientEndsAtMillis');
    }
    // Exam attempt create (Step 9, Design G + ChatGPT fold-in
    // §1(c)/§1(e)/H.3/H.4). Created ONCE at submit with status
    // 'submitted' and the full fields; the in-progress lifecycle
    // lives in jobExamSessions. The doc-ID (= session ID) is the
    // idempotency key; updates and deletes are denied. The attempt
    // is bound to the submitted exam session (gate below) AND to
    // the stored deadline (audit M1-b): submittedAt must be ≤ the
    // session's STORED endsAt — a mock whose deadline was never
    // stored cannot be submitted at all. The attempt carries the
    // session's bundleVersion + questionSetId, so a forged attempt
    // cannot ride on an unrelated session.
    // HONEST LIMITS (same as practice, §4.4): per-answer shape
    // cannot be validated in rules (no list indexing — Step 7
    // decision #7 stands); the exact score formula is lib-level
    // (the rules bind the deduction to the DECLARED scheme);
    // accuracy/percentage are range-checked only; and the
    // attempt's answers cannot be compared element-wise with the
    // session's answers (list vs map shapes) — the lib builds the
    // attempt from the fresh-read session, and the counts + size
    // checks below are the enforceable part.
    // Budget note (same as validJobExamSessionCreate): the bundle
    // + the post-write session are fetched ONCE in the match below
    // and passed in as plain maps (bundle / sessAfter). The
    // original shape re-read the session at NINE getAfter call
    // sites and the bundle at SIX get() sites, which blew the
    // 1000-expression budget on the attempt create (verified 22
    // Nov, a5). The M1-b deadline check reads sessAfter.endsAt:
    // the submit never changes endsAt, so the post-write value IS
    // the stored deadline (no separate get() call site needed).
    function validJobExamAttemptCreate(d, userId, attemptId, bundle, sessAfter) {
      return d.keys().hasOnly(['userId', 'kind', 'mockId', 'bundleId',
             'examSlug', 'subjectId', 'topicId', 'questionSetId',
             'answers', 'score', 'totalMarks', 'negativeDeduction',
             'negativeMarkingUsed', 'markingSchemeVersion',
             'bundleVersion', 'correctCount', 'wrongCount',
             'unansweredCount', 'accuracy', 'percentage',
             'timeSpentSeconds', 'startedAt', 'submittedAt', 'status',
             'markingStatus', 'resultLabel', 'clientCalculatedScore',
             'serverVerifiedScore', 'trustLevel', 'resultType',
             'sessionId', 'audit', 'answerHashes', 'anomalyFlags',
             'submissionIntegrity'])
        && d.keys().hasAll(['userId', 'kind', 'mockId', 'bundleId',
             'examSlug', 'subjectId', 'topicId', 'questionSetId',
             'answers', 'score', 'totalMarks', 'negativeDeduction',
             'negativeMarkingUsed', 'markingSchemeVersion',
             'bundleVersion', 'correctCount', 'wrongCount',
             'unansweredCount', 'accuracy', 'percentage',
             'timeSpentSeconds', 'startedAt', 'submittedAt', 'status',
             'markingStatus', 'resultLabel', 'clientCalculatedScore',
             'serverVerifiedScore', 'trustLevel', 'resultType', 'sessionId',
             'submissionIntegrity'])
        && d.get('userId', '') == userId
        && d.get('kind', null) == 'mock'
        && isStrType(d, 'mockId') && d.get('mockId', '').size() > 0
        && isStrType(d, 'bundleId')
        && d.get('subjectId', null) == null
        && d.get('topicId', null) == null
        && isStrType(d, 'questionSetId') && d.get('questionSetId', '').size() > 0
                && validJobAttemptCore(d, attemptId)
        && bundle.get('status', null) == 'published'
        && bundle.get('examSlug', null) == d.get('examSlug', null)
        && bundle.get('kind', null) in ['mock', 'daily', 'weekly']
        && bundle.get('mockId', null) == d.get('mockId', null)
        && d.get('answers', []).size() <= bundle.get('questionCount', 0)
        && bundle.get('bundleVersion', null) == d.get('bundleVersion', null)
        // Session gate: the exam session with the same ID must
        // exist and be 'submitted' AFTER this write (getAfter —
        // the batched submit's own transition counts; in the
        // sequential Design G flow getAfter reads the stored,
        // already-submitted session). The attempt is bound to the
        // session's IDENTITY: same mock, exam, bundle, question
        // set, bundle generation, start time, and the same number
        // of questions as the session's stored order.
        && sessAfter.get('status', '') == 'submitted'
        && sessAfter.get('bundleId', '') == d.get('bundleId', '')
        && sessAfter.get('kind', null) == d.get('kind', null)
        && sessAfter.get('examSlug', null) == d.get('examSlug', null)
        && sessAfter.get('mockId', null) == d.get('mockId', null)
        && sessAfter.get('questionSetId', null) == d.get('questionSetId', null)
        && sessAfter.get('bundleVersion', null) == d.get('bundleVersion', null)
        && sessAfter.get('startedAt', null) == d.get('startedAt', null)
        && sessAfter.get('questionRefs', []).size() == d.get('answers', []).size()
        // Audit M1-b (moved here from the practice validator by
        // the H.2 split): submittedAt must be ≤ the session's
        // STORED deadline (endsAt) — read from sessAfter (the
        // submit never changes endsAt, so post-write == stored).
        // When endsAt is null (deadline never stored) the
        // comparison errors and the allow denies — which is the
        // correct outcome.
        && d.get('submittedAt', null) <= sessAfter.get('endsAt', null);
    }

    // ---------- users.verificationStatus ----------
    // OWNER DECISION 21 Nov 2026 — student identity verification is
    // REMOVED entirely. `users.verificationStatus` is ONLY the mirror of
    // a teacherVerifications record (teacher verification); it is NEVER
    // a student-verification state, and NO access decision for a student
    // may ever read it. The transitions below are exactly the four
    // writes admin.ts performs for the teacher flow:
    //   approve: absent/'pending' -> 'verified' (+ role becomes 'teacher')
    //   reject:  absent/'pending' -> 'rejected' (role stays student)
    //   revoke:  'verified' -> 'revoked' (+ role returns to 'student')
    //   reopen:  'rejected'/'revoked'/'verified' -> 'pending'
    // Anything else — in particular putting a fresh student into
    // 'pending' or 'verified' — is denied, so a student can never be
    // gated by a verification state again. Called from both the admin
    // and the owner update rules on /users/{userId} below.
    function validVerificationTransition() {
      return !('verificationStatus' in changedKeys())
        || (request.resource.data.verificationStatus == 'verified'
            && request.resource.data.role == 'teacher')
        || (request.resource.data.verificationStatus == 'pending'
            && (request.resource.data.role == 'teacher'
                || resource.data.get('verificationStatus', '') in ['rejected', 'revoked', 'verified']))
        || (request.resource.data.verificationStatus == 'rejected'
            && resource.data.get('verificationStatus', '') in ['pending', ''])
        || (request.resource.data.verificationStatus == 'revoked'
            && resource.data.get('verificationStatus', '') == 'verified');
    }

    // validJobProfileFields — extracted 22 Nov 2026 (public-IDs rules refactor):
    // the same field validation appeared verbatim in several users
    // rules (CREATE / self-UPDATE / owner-UPDATE). One function,
    // several call sites — identical semantics, far fewer bytes.
    function validJobProfileFields(d) {
      return (!('enrolledCategories' in d)
            || d.enrolledCategories == null
            || (d.enrolledCategories is list
                && d.enrolledCategories.size() <= 10
                && d.enrolledCategories.toSet().size()
                     == d.enrolledCategories.size()
                && d.enrolledCategories.toSet().hasOnly(
                     ['bcs-bpsc', 'govt', 'bank', 'primary-teacher',
                      'ntrca-teacher', 'defence-police', 'autonomous',
                      'ngo-private', 'it-professional', 'other-competitive'])))
        && (!('targetExam' in d)
            || d.targetExam == null
            || d.targetExam in
               ['bcs', 'bank', 'primary-teacher', 'ntrca', 'dgfood',
                'bpsc-non-cadre', 'cag', 'bfsa', 'others', 'ministries',
                'defence', 'autonomous', 'private-ngo'])
        && (!('dailyGoalQuestions' in d)
            || d.dailyGoalQuestions == null
            || (d.dailyGoalQuestions is int
                && d.dailyGoalQuestions >= 0
                && d.dailyGoalQuestions <= 500))
        && (!('dailyGoalMinutes' in d)
            || d.dailyGoalMinutes == null
            || (d.dailyGoalMinutes is int
                && d.dailyGoalMinutes >= 0
                && d.dailyGoalMinutes <= 600))
        && (!('jobOnboarded' in d)
            || d.jobOnboarded == null
            || d.jobOnboarded is bool);
    }

    // validNuProfileFields — extracted 22 Nov 2026 (public-IDs rules refactor):
    // the same field validation appeared verbatim in the users CREATE
    // and self-UPDATE rules. One function, two call sites — identical
    // semantics, far fewer bytes.
    function validNuProfileFields(d) {
      return (!('admissionTargetInstitution' in d)
            || d.admissionTargetInstitution == null
            || d.admissionTargetInstitution == 'national-university')
        && (!('admissionTargetGroup' in d)
            || d.admissionTargetGroup == null
            || d.admissionTargetGroup in ['humanities', 'science', 'business'])
        && (!('admissionMode' in d)
            || d.admissionMode in ['beginner', 'advanced'])
        && (!('admissionOnboarded' in d)
            || d.admissionOnboarded is bool);
    }

    // ---------- users ----------
    // A user reads/writes only their own doc. Role and verificationStatus
    // can NEVER be changed by the owner of the doc — only Admin/Owner.
    // isActive is also admin-only (suspension must not be self-reversible).
    // READ (review 20 Nov 2026): moderators no longer read every user's
    // email + education details in bulk — full records are owner/admin
    // only. Moderator access to user data is re-scoped when moderators
    // are onboarded (minimal per-case projection, audit-logged).
    // validUsersCreate(d, userId) — compaction 27 Nov 2026: the create allow below, extracted verbatim with request.resource.data -> d (pure substitution; semantics identical).
    function validUsersCreate(d, userId) {
      return isOwner(userId)
        // CHATGPT STEP 4 REVIEW (P0 — permitted-key allowlist): the
        // create rule previously validated known fields but did not
        // restrict the key set — a student could smuggle arbitrary
        // fields (e.g. verifiedBy, suspendedReason, junk) into their
        // own new document. Only the keys the app legitimately writes
        // at creation (profile.ts ensureUserProfile) are allowed.
        && onlyKeys(['displayName', 'email',
             'role', 'verificationStatus', 'language', 'createdAt', 'updatedAt',
             'lastActiveAt',
             // Public user IDs (owner order 22 Nov 2026): the sequential
             // display number, allocated by transaction against the
             // counters/publicUserIds counter (see the binding below).
             'publicIdNumber',
             'educationType', 'board', 'institution', 'academicYear',
             'program', 'department', 'classLevel', 'semester',
             'academicSession', 'curriculum', 'phone', 'teachingLevel',
             'subjects', 'qualifications', 'experienceYears', 'jobMode',
             'enrolledCategories', 'targetExam', 'dailyGoalQuestions',
             'dailyGoalMinutes', 'jobOnboarded',
             // NU-4 (§19.2.15): the four NU profile fields — a create
             // carrying them must pass the allowlist (their values are
             // pinned by the clauses below).
             'admissionTargetInstitution', 'admissionTargetGroup',
             'admissionMode', 'admissionOnboarded'])
        // 'verificationStatus' is in the allowlist because teacher /
        // guardian registration writes it — but its VALUE is pinned by
        // the clause below: absent, or teacher/parent + 'pending' only.
        && d.role in ['student', 'teacher', 'parent']
        && (!('verificationStatus' in d)
            || (d.role in ['teacher', 'parent']
                && d.verificationStatus == 'pending'))
        && !('isActive' in d)
        && isStr(d.displayName, 100)
        // Public user IDs (owner order 22 Nov 2026): a profile may
        // carry publicIdNumber ONLY equal to the counter's current
        // `next` — the number the allocation transaction claims.
        // Absent = fallback (no number yet); the clause short-circuits
        // so a missing counter never blocks a plain create. A claimed
        // number with a missing counter is denied (get() yields 0).
        && (!('publicIdNumber' in d)
            || (d.publicIdNumber is int
                && d.publicIdNumber >= 1
                && d.publicIdNumber
                     == get(/databases/$(database)/documents/counters/publicUserIds).data.get('next', 0)))
        && d.email is string
        && d.language in ['bn', 'en']
        && isOptStrF(d, 'board', 200)
        && isOptStrF(d, 'institution', 200)
        && isOptStrF(d, 'academicSession', 50)
        && isOptStrF(d, 'curriculum', 200)
        && isOptStrF(d, 'classLevel', 100)
        && isOptStrF(d, 'department', 100)
        && isOptStrF(d, 'semester', 50)
        && isOptStrF(d, 'phone', 20)
        && isOptStrF(d, 'teachingLevel', 100)
        && isOptStrF(d, 'qualifications', 500)
        && (!('jobMode' in d)
            || d.jobMode in ['beginner', 'advanced'])
        // Step 4 — Job profile fields (Step 3 §2.25/§3.1): same
        // validations as the self-update rule below, so no invalid
        // value can sneak in at creation either.
        // CHATGPT STEP 4 REVIEW (P0): uniqueness — a list of
        // duplicates (["bank","bank",...]) must fail; integers only —
        // 12.5 / "30" / true must fail (rules `is int`, not `is number`).
        // MISSING-vs-NULL (deliberate, all five fields): optional on
        // create; absent or null = undecided; removable (delete → absent
        // = undecided); 0 is an EXPLICIT zero goal, never "unset".
        && validJobProfileFields(d)
        && (!('subjects' in d)
            || (d.subjects is list
                && d.subjects.size() <= 20))
        && (!('experienceYears' in d)
            || (d.experienceYears is number
                && d.experienceYears >= 0
                && d.experienceYears <= 60))
        // NU-4 (§19.2.15, §12.3): the four NU profile fields. Each is
        // optional; a present value must be in its allowlist. role /
        // verificationStatus / isActive stay excluded (above) — an NU
        // field can never smuggle a role escalation in (NU-T1/T2).
        && validNuProfileFields(d);
    }
    // validUsersUpdateOwner(d, userId) — compaction 27 Nov 2026: the update allow below, extracted verbatim with request.resource.data -> d (pure substitution; semantics identical).
    function validUsersUpdateOwner(d, userId) {
      return isOwner(userId)
        // The update may touch ONLY these fields; role, verificationStatus
        // and isActive are excluded, so they cannot change here.
        // DASHBOARDS (Step 5): the academic fields added are semester,
        // academicSession, curriculum, phone and experienceYears.
        // subjects / teachingLevel / qualifications are DELIBERATELY
        // absent: a teacher's approved subjects change ONLY through the
        // admin-decided change request (teacherChangeRequests) — a
        // teacher must never silently rewrite their own approved set.
        && changedKeys()
             .hasOnly(['displayName', 'educationType', 'board', 'institution',
                       'academicYear', 'academicSession', 'curriculum',
                       'program', 'department', 'classLevel', 'semester',
                       'phone', 'experienceYears', 'jobMode',
                       'enrolledCategories', 'targetExam',
                       'dailyGoalQuestions', 'dailyGoalMinutes', 'jobOnboarded',
                       // NU-4 (§19.2.15): the four NU profile fields.
                       'admissionTargetInstitution', 'admissionTargetGroup',
                       'admissionMode', 'admissionOnboarded',
                       'language', 'lastActiveAt', 'updatedAt'])
        && isOptStr(d.displayName, 100)
        && isOptStrF(d, 'phone', 20)
        && (!('jobMode' in d)
            || d.jobMode in ['beginner', 'advanced'])
        // Step 4 — Job profile fields (Step 3 §3.1, exact spec):
        // enrolledCategories ≤10 UNIQUE slugs from the 10-category
        // enum (duplicates fail); targetExam null or one of the 14 hub
        // slugs; daily goals null or an INTEGER in range (12.5 / "30" /
        // true fail); jobOnboarded bool. role / verificationStatus /
        // isActive are NOT in this allowlist — they stay
        // Admin/Owner-only. The update may touch ONLY the allowlisted
        // fields (affectedKeys().hasOnly, above) — no unexpected field
        // can ride in on a Job update. MISSING-vs-NULL: all five
        // fields optional, nullable, removable; 0 = explicit zero goal.
        && validJobProfileFields(d)
        && (!('experienceYears' in d)
            || (d.experienceYears is number
                && d.experienceYears >= 0
                && d.experienceYears <= 60))
        // NU-4: per-field allowlists on self-update (same as create).
        && validNuProfileFields(d);
    }
    // validUsersUpdateAdmin(d, old) — compaction 27 Nov 2026: the update allow below, extracted verbatim with request.resource.data -> d and resource.data -> old (pure substitution; semantics identical).
    function validUsersUpdateAdmin(d, old) {
      return isAdmin()
        && old.role != 'owner'
        // L4 (Step 17, 23 Nov 2026): an admin could update a FELLOW
        // admin's doc — demote them, suspend them. Staff docs are
        // now owner-only: an admin manages students / teachers /
        // parents, never another admin or moderator.
        && (!(old.role in ['admin', 'moderator']) || isOwnerRole())
        && changedKeys()
             .hasOnly(['role', 'verificationStatus', 'isActive', 'suspendedReason',
                       'verifiedBy', 'verifiedAt', 'updatedAt'])
        && (!('role' in d)
            || d.role in ['admin', 'moderator', 'teacher', 'student', 'parent'])
        && (!('verificationStatus' in d)
            || d.verificationStatus in ['pending', 'verified', 'rejected', 'revoked'])
        && validVerificationTransition()
        && (!('isActive' in d) || d.isActive is bool)
        && (!('suspendedReason' in d)
            || d.suspendedReason is string
            || d.suspendedReason == null)
        && (!('verificationStatus' in changedKeys())
            || d.verifiedBy == uid());
    }
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      // DASHBOARDS (Step 5, branch draft): self-service roles are
      // student / teacher / parent ONLY — admin / moderator / owner can
      // never be self-assigned (the old rule allowed student only, so
      // teacher + guardian registration was impossible). A teacher or
      // guardian profile is created with verificationStatus 'pending'
      // (verification is a human Admin decision afterwards); a student
      // NEVER carries verificationStatus (no student verification exists
      // — owner decision 21 Nov 06:53 + 07:02, 100% free, manual only).
      // isActive is still never set at creation (missing = active).
      allow create: if validUsersCreate(request.resource.data, userId);
      allow update: if validUsersUpdateOwner(request.resource.data, userId);
      // Admin/Owner change role / verificationStatus / isActive, and only
      // they may do so — and only to valid enum values.
      // OWNER PROTECTION (spec §3): a users doc whose role is 'owner' is
      // EXCLUDED here. No admin or moderator can change the owner's role,
      // isActive, email, or downgrade the owner account — only the owner
      // themselves may touch their own doc (owner rule below).
      // (Review 20 Nov 2026 — B1/S4 fixed:) the admin update has a field
      // allowlist now: an admin can touch ONLY role / verificationStatus /
      // isActive / suspendedReason / verifiedBy / verifiedAt / updatedAt.
      // 'owner' is REMOVED from the assignable role enum — no admin can
      // create a second owner by direct Firestore call (client code alone
      // never enforced this). Email, displayName and education fields
      // cannot be overwritten by an admin. verificationStatus may change
      // ONLY together with verifiedBy == the caller (the decision path in
      // admin.ts sets it) — an admin cannot silently verify anyone.
      allow update: if validUsersUpdateAdmin(request.resource.data, resource.data);
      // DASHBOARDS (Step 7, branch draft): applying an APPROVED teacher
      // change request. An Admin may set a teacher's approved subjects /
      // teachingLevel / classLevel — ONLY those three fields, and only on
      // a teacher's doc. The change-request document + the audit entry
      // are written in the SAME batch by admin.ts (decideTeacherChange-
      // Request); the rules permit the field change, the code enforces
      // the batch + audit. A teacher can never set these fields
      // themselves (the self-update allowlist excludes them).
      allow update: if isAdmin()
        && resource.data.role == 'teacher'
        && changedKeys()
             .hasOnly(['subjects', 'teachingLevel', 'classLevel', 'updatedAt'])
        && (!('subjects' in request.resource.data)
            || (request.resource.data.subjects is list
                && request.resource.data.subjects.size() > 0
                && request.resource.data.subjects.size() <= 20))
        && isOptStrF(request.resource.data, 'teachingLevel', 100)
        && isOptStrF(request.resource.data, 'classLevel', 100);
      // The owner updates ANY user's doc (highest authority — this is
      // what lets the owner rename a user, test (i1)). The owner may
      // touch profile fields + the admin fields, but may NEVER create a
      // second owner: role 'owner' is excluded here too. Exactly one
      // Owner exists; a second owner is created only in the Firebase
      // console by the owner himself, never by a client rule.
      allow update: if isOwnerRole()
        && changedKeys()
             .hasOnly(['displayName', 'educationType', 'board', 'institution',
                       'academicYear', 'program', 'department', 'classLevel',
                       'language', 'lastActiveAt', 'role', 'verificationStatus',
                       'isActive', 'suspendedReason', 'verifiedBy', 'verifiedAt',
                       'jobMode', 'enrolledCategories', 'targetExam',
                       'dailyGoalQuestions', 'dailyGoalMinutes', 'jobOnboarded',
                       // Public user IDs (owner order 22 Nov 2026): the
                       // owner assigns missing numbers (the backfill).
                       'publicIdNumber',
                       'updatedAt'])
        // Role may NEVER be *changed to* 'owner' — but the owner's own doc
        // already carries role 'owner', and request.resource.data is the
        // FULL post-update document, so 'role' in request.resource.data is
        // always true. Only check the enum when role is actually in the
        // affected keys (i.e. being changed). Same for verificationStatus.
        && (!('role' in changedKeys())
            || request.resource.data.role in ['admin', 'moderator', 'teacher', 'student', 'parent'])
        && (!('verificationStatus' in changedKeys())
            || request.resource.data.verificationStatus in ['pending', 'verified', 'rejected', 'revoked'])
        && validVerificationTransition()
        && (!('isActive' in request.resource.data) || request.resource.data.isActive is bool)
        && isOptStr(request.resource.data.displayName, 100)
        // Public user IDs (owner order 22 Nov 2026): the owner may set
        // publicIdNumber ONLY on a doc that lacks it (the backfill) —
        // an existing number is never changed.
        && (!('publicIdNumber' in changedKeys())
            || (request.resource.data.publicIdNumber is int
                && request.resource.data.publicIdNumber >= 1
                && !('publicIdNumber' in resource.data)))
        // Step 4 — the owner may set a user's Job fields too, under the
        // same §3.1 validations as the self-update rule (unique
        // categories, integer-only goals — ChatGPT Step 4 review P0).
        && validJobProfileFields(request.resource.data);
      allow delete: if false; // accounts are suspended (isActive=false), never deleted by clients
    }

    // ---------- counters ----------
    // Public user IDs (owner order 22 Nov 2026): the allocation
    // counter `counters/publicUserIds` ({ next, updatedAt }). Any
    // signed-in user may READ it (the value is not secret — it is
    // only "the next number"); only the owner may CREATE it; any
    // signed-in user may increment `next` by exactly 1 (the
    // allocation transaction). Nothing else may touch it.
    match /counters/{counterId} {
      // OPTION A (Step 18 deploy, 23 Nov 2026): `allow read` DENIED
      // list/count — in list context the {counterId} wildcard is
      // unbound (null), so `counterId == 'publicUserIds'` errors and
      // the whole list is denied. That broke the /admin/backup
      // in-app export preflight (one count query per collection).
      // Split: `get` keeps the id check; `list` needs no wildcard
      // (only `publicUserIds` can ever exist — create restricts the
      // id — so the list returns exactly that doc).
      allow get: if signedIn() && counterId == 'publicUserIds';
      allow list: if signedIn();
      allow create: if isOwnerRole()
        && counterId == 'publicUserIds'
        && request.resource.data.keys().hasOnly(['next', 'updatedAt'])
        && request.resource.data.next is int
        && request.resource.data.next >= 1;
      allow update: if signedIn()
        && counterId == 'publicUserIds'
        && changedKeys()
             .hasOnly(['next', 'updatedAt'])
        && request.resource.data.next is int
        && request.resource.data.next == resource.data.next + 1;
      allow delete: if false;
    }

    // ---------- quizAttempts (sub-collection under the user) ----------
    // Immutable after submit: create only, never update/delete by anyone
    // except an Admin delete for support. Readable by the owner +
    // Moderator/Admin (a moderator must read a written attempt to mark it).
    // EXCEPTION (Step 4, written exams): a Moderator/Admin may update ONLY
    // the marking fields of a PENDING written attempt (markingStatus ==
    // 'pending') — that is how a teacher marks typed answers (per-question
    // marks + correct flags inside `answers`, and the totals). An MCQ
    // attempt (markingStatus 'auto') can never be rewritten, and no one
    // may touch quizId or the submitted answer text once submitted.
    // validQuizAttemptCreate(d, userId) — compaction 27 Nov 2026: the create allow below, extracted verbatim with request.resource.data -> d (pure substitution; semantics identical).
    function validQuizAttemptCreate(d, userId) {
      return isOwner(userId) && callerActive()
        && d.quizId is string
        && d.userId == uid()
        && d.status == 'submitted'
        && d.markingStatus in ['auto', 'pending']
        && d.scored is bool
        && ((d.markingStatus == 'auto' && d.scored == false)
            || (d.markingStatus == 'pending' && d.scored == true))
        && d.answers is list
        && d.score is number
        && d.score >= 0
        && d.totalMarks is number
        && d.totalMarks > 0
        && d.score <= d.totalMarks
        && d.percentage is number
        && d.percentage >= 0
        && d.percentage <= 100
        && exists(/databases/$(database)/documents/quizzes/$(d.quizId))
        && d.answers.size() <= get(/databases/$(database)/documents/quizzes/$(d.quizId)).data.questions.size()
        && ((get(/databases/$(database)/documents/quizzes/$(d.quizId)).data.totalMarks is number
            && get(/databases/$(database)/documents/quizzes/$(d.quizId)).data.totalMarks > 0
            && d.totalMarks == get(/databases/$(database)/documents/quizzes/$(d.quizId)).data.totalMarks)
          || (!(get(/databases/$(database)/documents/quizzes/$(d.quizId)).data.totalMarks is number
              && get(/databases/$(database)/documents/quizzes/$(d.quizId)).data.totalMarks > 0)
            && d.totalMarks <= d.answers.size() * 10));
    }
    match /users/{userId}/quizAttempts/{attemptId} {
      // Readable by the owner, and by Moderator/Admin — a moderator must
      // be able to read a written attempt to mark it (Step 4).
      allow read: if isOwner(userId) || isModerator();
      // H1 + C1 (security audit 22 Nov 2026): a self-asserted attempt is
      // BOUND to the quiz it names — score ≤ totalMarks, percentage 0–100,
      // totalMarks equal to the quiz's totalMarks (or, for a quiz doc with
      // no totalMarks, at most 10 marks per answered question), answers no
      // longer than the quiz's question list. The attempt is always created
      // in status 'submitted' with its owner recorded; an MCQ attempt is
      // created UNSCORED (scored == false) and is scored by the owner
      // update below, a written attempt is created scored (scored == true)
      // and is marked only by a moderator.
      allow create: if validQuizAttemptCreate(request.resource.data, userId);
      allow update: if isModerator()
        && resource.data.markingStatus == 'pending'
        && changedKeys()
            .hasOnly(['answers', 'marks', 'score', 'percentage', 'markingStatus', 'markedBy', 'markedAt'])
        // C1 (security audit 22 Nov 2026): the owner may update ONLY the
        // unscored → scored transition of their own MCQ attempt — the
        // step the app performs after reading the key with a fresh
        // receipt. No other owner update is possible (a scored attempt
        // can never be rewritten by its owner).
        || (isOwner(userId) && callerActive()
            && resource.data.markingStatus == 'auto'
            && resource.data.scored == false
            && changedKeys()
                .hasOnly(['answers', 'score', 'percentage', 'scored', 'updatedAt'])
            && request.resource.data.scored == true
            && request.resource.data.score is number
            && request.resource.data.score >= 0
            && request.resource.data.score <= resource.data.totalMarks
            && request.resource.data.percentage is number
            && request.resource.data.percentage >= 0
            && request.resource.data.percentage <= 100
            && request.resource.data.answers is list
            && request.resource.data.answers.size() == resource.data.answers.size());
      allow delete: if false;
    }

    // ---------- quizKeys + quizReceipts (Step 4 answer-key protection) ----------
    // The key is readable by Moderator/Admin any time, and by a student
    // ONLY while a fresh submission receipt exists for them + this quiz
    // (created by the app at submit time, deleted right after scoring;
    // a receipt older than 10 minutes no longer opens the key).
    // C1 (security audit 22 Nov 2026): a receipt opens the key ONLY
    // while it is fresh (≤10 min old, never future-dated) AND it names a
    // real attempt that is submitted for THIS quiz by the caller. A bare
    // receipt (no attempt) or a receipt for an unsubmitted / other-quiz
    // attempt opens nothing — mirroring hasFreshJobReceipt.
    function quizReceiptData(quizId) {
      return get(/databases/$(database)/documents/quizReceipts/$(uid() + '_' + quizId)).data;
    }
    function quizReceiptAttemptData(attemptId) {
      return get(/databases/$(database)/documents/users/$(uid())/quizAttempts/$(attemptId)).data;
    }
    // The receipt map is passed in by the caller (quizKeys
    // read): the exists-guard at the call site short-circuits
    // before the get(). The anchor attempt is fetched per check
    // below, keyed by receipt.attemptId.
    function hasFreshReceipt(quizId, receipt) {
      return signedIn() && callerActive()
        && receipt.createdAt > request.time - duration.value(10, 'm')
        && receipt.createdAt <= request.time
        && receipt.attemptId is string
        && exists(/databases/$(database)/documents/users/$(uid())/quizAttempts/$(receipt.attemptId))
        && quizReceiptAttemptData(receipt.attemptId).status == 'submitted'
        && quizReceiptAttemptData(receipt.attemptId).quizId == quizId
        && quizReceiptAttemptData(receipt.attemptId).userId == uid();
    }
    match /quizKeys/{quizId} {
      // The receipt is fetched ONCE here and passed in (same
      // budget pattern as hasFreshJobReceipt): the exists-guard
      // short-circuits before the get(), so a missing receipt
      // denies cleanly instead of erroring the get.
      allow read: if isModerator()
        || (signedIn() && callerActive()
            && exists(/databases/$(database)/documents/quizReceipts/$(uid() + '_' + quizId))
            && hasFreshReceipt(quizId, quizReceiptData(quizId)));
      allow create, update: if isModerator();
      allow delete: if isAdmin();
    }
    // The attempt behind a quiz receipt, fetched once by the
    // caller and checked as a plain map (same budget pattern as
    // the job receipt anchor).
    function quizReceiptAttemptMatches(data, a) {
      return a.status == 'submitted'
        && a.quizId == data.get('quizId', '')
        && a.userId == uid();
    }
    // Receipt id is `{uid}_{quizId}` — one per student per quiz. Only the
    // owning student may create/delete their own receipt; nobody may
    // update one (a receipt is single-use by design).
    match /quizReceipts/{receiptId} {
      allow read: if isOwner(receiptId.split('_')[0]) || isAdmin();
      // C1 (security audit 22 Nov 2026): a receipt is single-use proof of
      // a REAL submission — it may be created only within 5 minutes of a
      // submitted attempt for this quiz (never future-dated, never without
      // the attempt), mirroring the jobReceipts create rule.
      allow create: if signedIn() && callerActive()
        && receiptId == uid() + '_' + request.resource.data.quizId
        && onlyKeys(['userId', 'quizId', 'attemptId', 'createdAt'])
        && request.resource.data.userId == uid()
        && request.resource.data.quizId is string
        && request.resource.data.quizId.size() <= 200
        && request.resource.data.attemptId is string
        && request.resource.data.attemptId.size() <= 200
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdAt <= request.time
        && request.resource.data.createdAt > request.time - duration.value(5, 'm')
        && exists(/databases/$(database)/documents/users/$(uid())/quizAttempts/$(request.resource.data.attemptId))
        && quizReceiptAttemptMatches(request.resource.data, get(/databases/$(database)/documents/users/$(uid())/quizAttempts/$(request.resource.data.attemptId)).data)
        && exists(/databases/$(database)/documents/quizzes/$(request.resource.data.quizId));
      allow update: if false;
      allow delete: if isOwner(receiptId.split('_')[0]);
    }

    // ---------- studyPlans / progressSummaries (owner only) ----------
    match /studyPlans/{planId} {
      allow read: if signedIn() && (resource.data.userId == uid() || isAdmin());
      allow create: if ownCreate()
        && isStr(request.resource.data.title, 200);
      allow update, delete: if ownExisting();
    }
    match /progressSummaries/{summaryId} {
      // DASHBOARDS (Step 8): a guardian with a VERIFIED link reads the
      // linked child's summaries (weak/strong subjects, results).
      allow read: if signedIn() && (resource.data.userId == uid() || isAdmin()
        || isLinkedGuardian(resource.data.userId));
      // H1+M4 (security audit 22 Nov 2026): self-asserted progress is
      // BOUND — attemptsCount is a whole number 0–10000, averagePercentage
      // is 0–100. A student can no longer claim 999 attempts or 500%.
      allow create, update: if ownCreate()
        && request.resource.data.attemptsCount is int
        && request.resource.data.attemptsCount >= 0
        && request.resource.data.attemptsCount <= 10000
        && request.resource.data.averagePercentage is number
        && request.resource.data.averagePercentage >= 0
        && request.resource.data.averagePercentage <= 100;
      allow delete: if isAdmin();
    }

    // ---------- bookmarks / progress (Step 3) — owner-scoped only ----------
    // One bookmark = one write; unbookmark = one delete. One progress
    // document per student per subject (lessons read + practice counts).
    // userId can never be spoofed: every write must carry the caller's
    // own uid, and updates may not move the doc to another user.
    match /bookmarks/{bookmarkId} {
      // DASHBOARDS (Step 8): a guardian with a VERIFIED link reads the
      // linked child's bookmarks (learning history).
      allow read: if signedIn() && (resource.data.userId == uid() || isAdmin()
        || isLinkedGuardian(resource.data.userId));
      allow create: if ownCreate()
        && isStr(request.resource.data.lessonId, 200)
        && isStr(request.resource.data.title, 200);
      allow update: if ownExisting()
        && request.resource.data.userId == uid();
      allow delete: if ownExisting();
    }
    match /progress/{progressId} {
      // DASHBOARDS (Step 8): a guardian with a VERIFIED link reads the
      // linked child's progress (lessons read, practice counts).
      allow read: if signedIn() && (resource.data.userId == uid() || isAdmin()
        || isLinkedGuardian(resource.data.userId));
      allow create: if ownCreate()
        && isStr(request.resource.data.subject, 100);
      allow update: if ownExisting()
        && request.resource.data.userId == uid();
      allow delete: if isAdmin();
    }

    // ---------- public content: directory, books, chapters, lessons, quizzes ----------
    // Public reads ONLY where reviewStatus == "Published". Teachers/Admins
    // may read their own drafts; moderators read all. Teachers create
    // drafts only; only Moderator/Admin can publish / remove / send back.
    //
    // AUTH GATING (owner instruction 22 Nov 2026 ~10:33, BINDING — this
    // overrides the Step 5 anonymous-access adoption for exams/reading,
    // see the addendum in team/job-categories-exams-step5.md):
    //   - quizzes: SIGNED-IN ONLY. A quiz document embeds its questions,
    //     so any anonymous read would send questions to a signed-out
    //     browser. Guests never list, open, or submit exams.
    //   - chapters/lessons: SIGNED-IN, except a Published chapter/lesson
    //     flagged isPreview == true (the book's first chapter, set by
    //     the loader) is public — the guest preview. Missing isPreview
    //     means NOT a preview (live rows lack the field until the loader
    //     re-runs, so guests read no chapters at all until then).
    //   - books + educationDirectory stay public metadata (titles,
    //     descriptions, book info) — guests browse the library.
    function contentRead(d) {
      return isPublished(d)
        || isModerator()
        || (signedIn() && callerActive() && d.get('authorId', '') == uid())
        || (signedIn() && callerActive() && d.get('createdBy', '') == uid());
    }
    // M2 (Step 17, security testing 23 Nov 2026): a PENDING teacher
    // could author drafts — isTeacher() admits ANY teacher-role user,
    // including one whose verification is still pending. The bank's
    // gate is reused (staff, or a teacher whose verificationStatus
    // is 'verified'); same semantics, zero new helpers — the compiled
    // rules margin is ~80 bytes. This function is shared by books,
    // chapters, lessons, quizzes and games: the same hole existed in
    // each, and the fix applies uniformly.
    function contentCreate() {
      return isVerifiedJobBankAuthor()
        && isDraftStatus(request.resource.data.reviewStatus)
        && isStr(request.resource.data.title, 200);
    }
    function contentUpdate(d) {
      // Moderator/Admin may move any status (publish, correct, remove).
      // An author may edit only their own draft, and may not publish it.
      return isModerator()
        || (signedIn() && callerActive() && d.get('authorId', '') == uid()
            && isDraftStatus(d.reviewStatus)
            && isDraftStatus(request.resource.data.reviewStatus))
        || (signedIn() && callerActive() && d.get('createdBy', '') == uid()
            && isDraftStatus(d.reviewStatus)
            && isDraftStatus(request.resource.data.reviewStatus));
    }

    // AUTH GATING (owner instruction 22 Nov 2026): a guest reads a
    // chapter ONLY when it is Published AND the book's preview
    // (isPreview == true). Signed-in readers keep the old rule
    // (Published, or own draft, or moderator).
    function isPreviewContent(d) { return d.get('isPreview', false) == true; }
    function gatedContentRead(d) {
      return contentRead(d) && (signedIn() || isPreviewContent(d));
    }

    match /educationDirectory/{docId} {
      allow read: if contentRead(resource.data);
      allow create: if isVerifiedJobBankAuthor() && isDraftStatus(request.resource.data.reviewStatus);
      allow update: if contentUpdate(resource.data);
      allow delete: if isAdmin();
    }
    match /books/{bookId} {
      allow read: if contentRead(resource.data);
      allow create: if contentCreate() && isStr(request.resource.data.sourceUrl, 2000);
      allow update: if contentUpdate(resource.data);
      allow delete: if isAdmin();
    }
    match /chapters/{chapterId} {
      allow read: if gatedContentRead(resource.data);
      allow create: if contentCreate();
      allow update: if contentUpdate(resource.data);
      allow delete: if isAdmin();
    }
    match /lessons/{lessonId} {
      allow read: if gatedContentRead(resource.data);
      allow create: if contentCreate() && isStr(request.resource.data.body, 100000);
      allow update: if contentUpdate(resource.data);
      allow delete: if isAdmin();
    }
    match /quizzes/{quizId} {
      // AUTH GATING (owner instruction 22 Nov 2026): quizzes are
      // SIGNED-IN ONLY — the doc embeds its questions, so no anonymous
      // read of any kind (single doc or list query) is allowed. The
      // staff paths (moderator, own draft) are all signed-in already.
      allow read: if contentRead(resource.data) && signedIn();
      allow create: if contentCreate() && request.resource.data.questions is list;
      allow update: if contentUpdate(resource.data);
      allow delete: if isAdmin();
    }

    // ---------- contact form messages ----------
    // Any signed-in, active user may send a message (their own userId,
    // bounded fields). Only owner/admin may read messages; the client
    // can never update or delete one (append-only; admins reply from
    // the dashboard by creating a new record).

    // ---------- newsletter subscribers (homepage redesign, 24 Nov 2026)
    // Footer signup writes here. Anyone (signed out included) may
    // subscribe with a validated email + fixed fields only; the
    // address is readable by owner/admin only (export list for
    // updates), never by other users; nobody may edit or delete
    // through the client. No email is sent by subscribing yet — the
    // form says the address is kept for Eduvelto updates.
    match /newsletterSubscribers/{subscriberId} {
      allow read: if isAdmin();
      allow create: if onlyKeys(['email', 'source', 'status', 'createdAt'])
        && request.resource.data.email is string
        && request.resource.data.email.size() >= 4
        && request.resource.data.email.size() <= 200
        && request.resource.data.email.matches('^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$')
        && request.resource.data.source == 'footer'
        && request.resource.data.status == 'subscribed'
        && request.resource.data.createdAt is timestamp;
      allow update, delete: if false;
    }

    // ---------- quiz referrals (28 Nov 2026 — /free-quiz share)
    // Anyone (signed out included) may create a referral doc
    // {code, name, createdAt, firstSeen, lastSeen, count: 0} and may
    // bump the counter (count +1 and lastSeen only). Read is
    // owner/admin only; delete is never allowed client-side. Counts
    // are a guide, not fraud-proof — no CAPTCHA/rate-limit exists
    // on the free Spark plan.
    match /quizReferrals/{code} {
      allow read: if isAdmin();
      allow create: if code.size() == 6
        && onlyKeys(['code', 'name', 'createdAt', 'firstSeen', 'lastSeen', 'count'])
        && request.resource.data.code == code
        && isStr(request.resource.data.name, 100)
        && request.resource.data.count == 0
        && request.resource.data.createdAt is timestamp
        && request.resource.data.firstSeen is timestamp
        && request.resource.data.lastSeen is timestamp;
      allow update: if changedKeys().hasOnly(['count', 'lastSeen'])
        && request.resource.data.count == resource.data.count + 1
        && request.resource.data.lastSeen is timestamp;
      allow delete: if false;
    }

    // ---------- donations (Phase 3, 25 Nov 2026 — "Support Eduvelto")
    // Anyone (signed out included) may record a donation with
    // exactly {name, amount, trxId, createdAt} — name 1–100 chars,
    // amount a positive number up to ৳10,000,000, TrxID 1–50 chars.
    // No phone/email/extra field is accepted (a phone field is
    // denied by onlyKeys). The wall is PUBLIC read (name + amount
    // only — the UI never renders the TrxID). Nobody may edit or
    // delete through the client; the owner removes spam from the
    // console. No CAPTCHA/rate-limit exists on the free Spark plan
    // — the fixed shape + fixed keys are the whole defence.
    match /donations/{donationId} {
      allow read: if true;
      allow create: if onlyKeys(['name', 'amount', 'trxId', 'createdAt'])
        && isStr(request.resource.data.name, 100)
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.amount <= 10000000
        && isStr(request.resource.data.trxId, 50)
        && request.resource.data.createdAt is timestamp;
      allow update, delete: if false;
    }

    // ---------- orders (Phase 3, 25 Nov 2026 — ৳149 suggestion PDF)
    // Signed-in ONLY: an order ties to a buyer account
    // (userId == uid, caller must be active). Exactly
    // {userId, productId, amount, trxId, status, createdAt}:
    // productId is ALWAYS 'suggestion-pdf', amount is ALWAYS 149,
    // status is ALWAYS 'pending' at create (only the owner changes
    // it, off-client), TrxID 1–50 chars. NO public read — a buyer
    // reads only their own orders; owner/admin read all (backup
    // preflight included). Nobody may edit or delete through the
    // client. SALES GATE: the UI keeps sales off until verified PDF
    // content exists (see lib/orders.ts) — the rules only define
    // what a valid order looks like when sales open.
    match /orders/{orderId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == uid());
      allow create: if signedIn() && callerActive()
        && request.resource.data.userId == uid()
        && onlyKeys(['userId', 'productId', 'amount', 'trxId', 'status', 'createdAt'])
        && request.resource.data.productId == 'suggestion-pdf'
        && request.resource.data.amount == 149
        && request.resource.data.status == 'pending'
        && isStr(request.resource.data.trxId, 50)
        && request.resource.data.createdAt is timestamp;
      allow update, delete: if false;
    }

    // ---------- community posts / comments / questions / answers ----------
    // Create with reviewStatus forced to "Under Review". Authors edit only
    // their own while still unreviewed. Only Moderator/Admin publish/remove.
    match /posts/{postId} {
      allow read: if publishedAuthorRead();
      allow create: if ownUnderReviewCreate()
        && isStr(request.resource.data.title, 200)
        && isStr(request.resource.data.body, 5000);
      allow update: if isModerator()
        || (signedIn() && callerActive() && resource.data.authorId == uid()
            && resource.data.reviewStatus == 'Under Review'
            && request.resource.data.reviewStatus == 'Under Review');
      allow delete: if isAdmin();
    }
    match /posts/{postId}/comments/{commentId} {
      allow read: if publishedAuthorRead();
      allow create: if ownUnderReviewCreate()
        && isStr(request.resource.data.body, 1000);
      allow update, delete: if isModerator();
    }
    match /questions/{questionId} {
      allow read: if publishedAuthorRead();
      allow create: if ownUnderReviewCreate()
        && isStr(request.resource.data.title, 200)
        && isStr(request.resource.data.body, 5000);
      allow update: if isModerator()
        || (signedIn() && callerActive() && resource.data.authorId == uid()
            && resource.data.reviewStatus == 'Under Review'
            && request.resource.data.reviewStatus == 'Under Review');
      allow delete: if isAdmin();
    }
    match /questions/{questionId}/answers/{answerId} {
      allow read: if publishedAuthorRead();
      allow create: if ownUnderReviewCreate()
        && isStr(request.resource.data.body, 5000);
      // isAccepted may be set only by the question author or a moderator.
      // H2 (security audit 22 Nov 2026): the author may change ONLY
      // isAccepted (+ updatedAt) — the answer body, upvotes and every
      // other field are immutable for the author once written.
      allow update: if isModerator()
        || (signedIn() && callerActive() && get(/databases/$(database)/documents/questions/$(questionId)).data.authorId == uid()
            && changedKeys().hasOnly(['isAccepted', 'updatedAt']));
      allow delete: if isAdmin();
    }

    // ---------- reports / moderationQueue ----------
    // (Review 20 Nov 2026 — F17:) the queue used to be an unvalidated
    // free-for-all — any moderator could delete a genuine abuse report.
    // Queue items now have a shape, a status enum, and no delete.

    // ---------- teacherVerifications ----------
    // Applicant creates their own PENDING record only. Status, checkedBy and
    // checkedAt changeable ONLY by Admin/Owner after the human check.
    // (Review 20 Nov 2026 — child safety F1–F3, security S1 — hardened:)
    // - Decisions are ADMIN/OWNER only now (moderators cannot mint
    //   verified teachers alone; the dashboard is owner-only).
    // - Only a PENDING record can be decided; a moderator/admin can never
    //   decide their OWN application (userId != uid).
    // - Only the decision fields may change (affectedKeys) — userId,
    //   fullName, institution and createdAt cannot be rewritten.
    // - A reason (min 10 chars) is REQUIRED for every decision.
    // - Approving (status 'verified') additionally requires the human
    //   checklist: checks.identity + checks.institution +
    //   checks.subject + checks.adult all true (identity checked,
    //   institution checked, subject/qualification checked, applicant is
    //   an adult). A one-tap approve of a fake teacher is impossible.
    // - Re-opening a decided record (back to 'pending') is a separate,
    //   explicit path with its own reason — decided records cannot be
    //   silently flipped back and forth.
    match /teacherVerifications/{recordId} {
      // `resource == null` first: a first-time applicant has NO record
      // yet, and the form/lib must be able to read that absence
      // (getMyTeacherApplication returns null). Without the guard,
      // `resource.data.userId` on a missing doc throws a Null value
      // error and the read is DENIED — no data leaks either way, since
      // a missing doc returns nothing.
      allow read: if signedIn() && (resource == null || resource.data.userId == uid() || isModerator());
      allow create: if signedIn() && callerActive()
        && recordId == 'tv_' + uid()
        && request.resource.data.userId == uid()
        && request.resource.data.status == 'pending'
        && isStr(request.resource.data.fullName, 100)
        && isStr(request.resource.data.institution, 200)
        && isOptStrF(request.resource.data, 'post', 100)
        && isOptStrF(request.resource.data, 'institutionContact', 100)
        // L1 (Step 17, 23 Nov 2026): the create had NO key allowlist,
        // so a forged application could smuggle `checks`, `verifiedAt`
        // or `decision` past the form. Exactly the 18 keys admin.ts
        // submitTeacherApplication writes (createdAt only on first
        // filing; the re-apply merge path is covered by the update
        // rule below). The decision fields (checkedBy, reason, checks)
        // are written only by the admin update path.
        && onlyKeys(['id', 'userId', 'fullName', 'teachingLevel',
             'subjects', 'classes', 'institution', 'post', 'institutionContact',
             'qualifications', 'experienceYears', 'verificationReason', 'evidenceRef',
             'status', 'verificationStatus', 'submittedAt', 'updatedAt', 'createdAt']);
      // DASHBOARDS (Step 5): a REJECTED teacher may re-apply — the
      // applicant re-files their own record as 'pending' again (same
      // deterministic id). Only the application fields may change, and
      // the record must have been 'rejected'.
      allow update: if signedIn() && callerActive()
        && resource.data.userId == uid()
        && resource.data.status == 'rejected'
        && request.resource.data.status == 'pending'
        && changedKeys()
             .hasOnly(['teachingLevel', 'subjects', 'classes', 'institution',
                       'post', 'institutionContact',
                       'qualifications', 'experienceYears', 'verificationReason',
                       'evidenceRef', 'status', 'verificationStatus',
                       'submittedAt', 'updatedAt'])
        && isStr(request.resource.data.fullName, 100)
        && isStr(request.resource.data.institution, 200);
      allow update: if isAdmin()
        && resource.data.status == 'pending'
        && resource.data.userId != uid()
        && changedKeys()
             .hasOnly(['status', 'checkedBy', 'checkedAt', 'reason', 'checks', 'updatedAt'])
        && request.resource.data.status in ['pending', 'verified', 'rejected', 'revoked']
        && request.resource.data.checkedBy == uid()
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 10
        && (request.resource.data.status != 'verified'
            || (request.resource.data.checks is map
                && request.resource.data.checks.get('identity', false) == true
                && request.resource.data.checks.get('institution', false) == true
                && request.resource.data.checks.get('subject', false) == true
                && request.resource.data.checks.get('adult', false) == true));
      allow update: if isAdmin()
        && resource.data.status == 'verified'
        && resource.data.userId != uid()
        && request.resource.data.status == 'revoked'
        && changedKeys()
             .hasOnly(['status', 'checkedBy', 'checkedAt', 'reason', 'updatedAt'])
        && request.resource.data.checkedBy == uid()
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 10;
      allow update: if isAdmin()
        && resource.data.status in ['verified', 'rejected', 'revoked']
        && resource.data.userId != uid()
        && request.resource.data.status == 'pending'
        && changedKeys()
             .hasOnly(['status', 'checkedBy', 'checkedAt', 'reason', 'updatedAt'])
        && request.resource.data.checkedBy == uid()
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 10;
      allow delete: if isAdmin();
    }

    // ---------- teacherChangeRequests (Dashboards Step 7, branch draft) ----------
    // A verified teacher's subject/class change goes through here — the
    // request is PENDING until an Admin approves it, and the dashboard
    // keeps showing the OLD approved subjects until then.
    // - CREATE: the teacher files their own request (teacherUid == uid,
    //   status 'pending', ≥1 subject + ≥1 class, reason ≥10 chars).
    // - READ: the teacher + Admin/Owner (the admin dashboard decides it).
    // - UPDATE: Admin ONLY, pending -> approved / rejected, with a reason
    //   (≥10 chars) and decidedBy == the caller. The profile update
    //   (subjects/teachingLevel/classLevel) + this decision + the audit
    //   entry are ONE batch in admin.ts — the rules permit each half.
    // - DELETE: never (a decided request stays as the audit trail).
    match /teacherChangeRequests/{requestId} {
      allow read: if signedIn() && (resource.data.teacherUid == uid() || isAdmin());
      allow create: if signedIn() && callerActive()
        && request.resource.data.teacherUid == uid()
        && request.resource.data.status == 'pending'
        && request.resource.data.requestedSubjects is list
        && request.resource.data.requestedSubjects.size() > 0
        && request.resource.data.requestedSubjects.size() <= 20
        && request.resource.data.requestedClasses is list
        && request.resource.data.requestedClasses.size() > 0
        && request.resource.data.requestedClasses.size() <= 20
        && isOptStrF(request.resource.data, 'requestedTeachingLevel', 100)
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 10;
      allow update: if isAdmin()
        && resource.data.status == 'pending'
        && resource.data.teacherUid != uid()
        && request.resource.data.status in ['approved', 'rejected']
        && changedKeys()
             .hasOnly(['status', 'decidedBy', 'decidedAt', 'decisionReason', 'updatedAt'])
        && request.resource.data.decidedBy == uid()
        && request.resource.data.decisionReason is string
        && request.resource.data.decisionReason.size() >= 10;
      allow delete: if false;
    }

    // ---------- health (Health v1, owner brief 20 Nov 23:51) ----------
    // Eduvelto Health: medicines, diseases, doctors, hospitals/pharmacies.
    // Safety (Blueprint v4, binding): the AI Doctor is NOT a doctor; no
    // diagnosis, no prescribing, no invented dosages. ALL health content
    // needs qualified professional review before it is Published — so
    // students read ONLY Published records, and a moderator may edit
    // drafts only, never publish. Publishing is an ADMIN action (the
    // dashboard's publish step confirms professional review happened).
    // A medicine record may NEVER carry a dosage field — the loader and
    // the rules both refuse it.
    function healthRead(d) {
      return isPublished(d) || isModerator();
    }
    function healthDraftCreate() {
      return isModerator() && isDraftStatus(request.resource.data.reviewStatus);
    }
    function healthUpdate(d) {
      // Moderator: edit own drafts only, never publish.
      // Admin: edit + publish (publish = review-confirmed step).
      return (isModerator()
              && isDraftStatus(d.reviewStatus)
              && isDraftStatus(request.resource.data.reviewStatus))
        || isAdmin();
    }
    function noDosage() { return !('dosage' in request.resource.data); }

    match /medicines/{medicineId} {
      allow read: if healthRead(resource.data);
      allow create: if healthDraftCreate() && noDosage()
        && isStr(request.resource.data.title, 100)
        && isStr(request.resource.data.titleBn, 100)
        && isStr(request.resource.data.useBn, 2000)
        && isStr(request.resource.data.useEn, 2000)
        && isStr(request.resource.data.formBn, 200)
        && isStr(request.resource.data.formEn, 200)
        && isStr(request.resource.data.sideEffectsBn, 2000)
        && isStr(request.resource.data.sideEffectsEn, 2000)
        && isStr(request.resource.data.warningsBn, 2000)
        && isStr(request.resource.data.warningsEn, 2000)
        && isStr(request.resource.data.source, 200)
        && request.resource.data.prescriptionOnly is bool;
      allow update: if healthUpdate(resource.data) && noDosage();
      allow delete: if isAdmin();
    }
    match /diseases/{diseaseId} {
      allow read: if healthRead(resource.data);
      allow create: if healthDraftCreate()
        && isStr(request.resource.data.title, 100)
        && isStr(request.resource.data.titleBn, 100)
        && isStr(request.resource.data.symptomsBn, 2000)
        && isStr(request.resource.data.symptomsEn, 2000)
        && isStr(request.resource.data.preventionBn, 2000)
        && isStr(request.resource.data.preventionEn, 2000)
        && isStr(request.resource.data.seeDoctorBn, 2000)
        && isStr(request.resource.data.seeDoctorEn, 2000)
        && isStr(request.resource.data.source, 200);
      allow update: if healthUpdate(resource.data);
      allow delete: if isAdmin();
    }
    match /facilities/{facilityId} {
      allow read: if healthRead(resource.data);
      allow create: if healthDraftCreate()
        && isStr(request.resource.data.title, 200)
        && isStr(request.resource.data.titleBn, 200)
        && request.resource.data.kind in ['hospital', 'clinic', 'pharmacy']
        && isStr(request.resource.data.areaBn, 100)
        && isStr(request.resource.data.areaEn, 100)
        && isStr(request.resource.data.source, 200);
      allow update: if healthUpdate(resource.data);
      allow delete: if isAdmin();
    }
    // Doctors: a doctor is visible to students ONLY when BOTH
    // verificationStatus == 'verified' AND reviewStatus == 'Published'.
    // Verification is a human check, ADMIN-only, mirroring
    // teacherVerifications: only a PENDING record can be decided, never
    // the verifier's own application (userId != uid), a reason (>= 10
    // chars) is required, and 'verified' additionally requires the
    // checklist identity + qualification + adult all true. Moderators
    // may edit pending drafts but may never verify or publish.
    match /doctors/{doctorId} {
      allow read: if (isPublished(resource.data)
              && resource.data.verificationStatus == 'verified')
        || isModerator();
      allow create: if healthDraftCreate()
        && request.resource.data.verificationStatus == 'pending'
        && isStr(request.resource.data.title, 100)
        && isStr(request.resource.data.titleBn, 100)
        && isStr(request.resource.data.qualificationBn, 500)
        && isStr(request.resource.data.qualificationEn, 500)
        && isStr(request.resource.data.specialityBn, 200)
        && isStr(request.resource.data.specialityEn, 200)
        && isStr(request.resource.data.workplaceBn, 200)
        && isStr(request.resource.data.workplaceEn, 200);
      // Moderator draft edit: pending + stays pending, stays a draft.
      allow update: if isModerator()
        && resource.data.verificationStatus == 'pending'
        && request.resource.data.verificationStatus == 'pending'
        && isDraftStatus(resource.data.reviewStatus)
        && isDraftStatus(request.resource.data.reviewStatus);
      // Admin verification decision (pending -> verified / rejected).
      allow update: if isAdmin()
        && resource.data.verificationStatus == 'pending'
        && resource.data.get('userId', '') != uid()
        && changedKeys()
             .hasOnly(['verificationStatus', 'verifiedBy', 'verifiedAt', 'reason', 'checks', 'updatedAt'])
        && request.resource.data.verificationStatus in ['verified', 'rejected']
        && request.resource.data.verifiedBy == uid()
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 10
        && (request.resource.data.verificationStatus != 'verified'
            || (request.resource.data.checks is map
                && request.resource.data.checks.get('identity', false) == true
                && request.resource.data.checks.get('qualification', false) == true
                && request.resource.data.checks.get('adult', false) == true));
      // Admin revoke (verified -> revoked) with a reason.
      allow update: if isAdmin()
        && resource.data.verificationStatus == 'verified'
        && resource.data.get('userId', '') != uid()
        && request.resource.data.verificationStatus == 'revoked'
        && changedKeys()
             .hasOnly(['verificationStatus', 'verifiedBy', 'verifiedAt', 'reason', 'updatedAt'])
        && request.resource.data.verifiedBy == uid()
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 10;
      // Admin general edit + publish (verification untouched here).
      allow update: if isAdmin()
        && !('verificationStatus' in changedKeys());
      allow delete: if isAdmin();
    }

    // ---------- social (design gated: Phase 3, only after moderator + consent gates) ----------
    match /notices/{noticeId} {
      allow read: if publishedOrMod();
      allow create: if isModerator()
        && request.resource.data.reviewStatus == 'Under Review'
        && isStr(request.resource.data.title, 200) && isStr(request.resource.data.body, 2000);
      allow update: if isModerator();
      allow delete: if isAdmin();
    }

    // ---------- games / competitions (Phase 3) ----------
    match /games/{gameId} {
      allow read: if publishedOrMod();
      allow create: if contentCreate();
      allow update: if contentUpdate(resource.data);
      allow delete: if isAdmin();
    }
    match /leaderboardSnapshots/{snapshotId} {
      allow read: if true;
      allow write: if isModerator();
    }

    // ---------- rewards / certificates / passport (Phases 3–4) ----------
    // rewardBalances: NO direct client write to points, ever. The document
    // is read-only for the owner; balances are computed on read from the
    // user's own attempts until a safe server-side rule is proven in Phase 2.
    // userAchievements only — passportEntries was never built, so the
    // guard narrows to the one live collection (26 Nov 2026). The guard
    // is load-bearing — no other /users/{userId}/* subcollection is
    // granted anything here.
    match /users/{userId}/{achColl}/{key} {
      allow read: if achColl == 'userAchievements'
        && (isOwner(userId) || isAdmin());
      allow create: if achColl == 'userAchievements'
        && isOwner(userId) && callerActive();
      allow update, delete: if false;
    }

    // ---------- career / opportunities (Phase 4) ----------
    match /careerPaths/{pathId} {
      allow read: if publishedOrMod();
      allow create: if isVerifiedJobBankAuthor() && isDraftStatus(request.resource.data.reviewStatus);
      allow update: if contentUpdate(resource.data);
      allow delete: if isAdmin();
    }
    match /opportunities/{oppId} {
      allow read: if publishedOrMod();
      allow create: if isModerator() && isDraftStatus(request.resource.data.reviewStatus);
      allow update: if isModerator();
      allow delete: if isAdmin();
    }

    // ---------- parent links / invites (Phase 4, gated on consent design G7) ----------
    // DASHBOARDS (Step 8, branch draft): the full link lifecycle.
    // - CREATE: the guardian creates the link (parentId must be their own
    //   uid; the id is deterministic `{guardianUid}_{childUid}` — one
    //   link per guardian+child; status starts 'pending').
    // - CONFIRM: the CHILD confirms (pending -> confirmed). Only the
    //   child may do this, and only from 'pending'.
    // - SNAPSHOT: the CHILD keeps the denormalized academic snapshot in
    //   sync when their class changes (ProfilePage) — only the snapshot
    //   fields, status untouched. This is how the guardian dashboard
    //   updates automatically WITHOUT reading the child's users doc.
    // - REVOKE: either party may revoke at any time (status 'revoked').
    // - ACTIVATE: ONLY an Admin activates (pending/confirmed ->
    //   'verified') after cross-checking the written information; the
    //   admin sets verifiedBy/At + the decision reason.
    // - REJECT: ONLY an Admin rejects (pending/confirmed -> 'rejected')
    //   with a reason >= 10 chars; a rejected link is a dead end — the
    //   guardian may request again (a new link overwrites it).
    //   A guardian NEVER reads the child's users doc or messages through
    //   this collection — the snapshot carries only name + academic
    //   fields, and the rules tests prove the users-doc read is denied.
    // validParentLinkCreate(d, linkId) — compaction 27 Nov 2026: the create allow below, extracted verbatim with request.resource.data -> d (pure substitution; semantics identical).
    function validParentLinkCreate(d, linkId) {
      return signedIn() && callerActive()
        && linkId == uid() + '_' + d.studentId
        && d.parentId == uid()
        && d.studentId is string
        && d.studentId != uid()
        && d.status == 'pending'
        && isStr(d.guardianDisplayName, 100)
        && isStr(d.relationship, 50)
        && isOptStrF(d, 'guardianContact', 20)
        && isStr(d.childDisplayName, 100)
        && isStr(d.childClassLevel, 100)
        && isOptStrF(d, 'childInstitution', 200)
        && isOptStrF(d, 'childEducationType', 50)
        && isOptStrF(d, 'childDepartment', 100)
        && isOptStrF(d, 'childProgram', 100)
        && isOptStrF(d, 'childBoard', 200);
    }
    match /parentLinks/{linkId} {
      // `resource == null` first: reading a link that does not exist
      // (e.g. a stale id) must return "not found", not a permission
      // error — same Null-value guard as teacherVerifications above.
      allow read: if signedIn()
        && (resource == null || resource.data.parentId == uid() || resource.data.studentId == uid() || isAdmin());
      allow create: if validParentLinkCreate(request.resource.data, linkId);
      allow update: if signedIn() && callerActive()
        && resource.data.studentId == uid()
        && resource.data.status == 'pending'
        && request.resource.data.status == 'confirmed'
        && changedKeys()
             .hasOnly(['status', 'confirmedAt', 'updatedAt']);
      // Child REJECTS the request (pending -> revoked) — the child may
      // also reject by using the revoke clause below; this clause is
      // the same path, kept separate for clarity in tests.
      allow update: if signedIn() && callerActive()
        && resource.data.studentId == uid()
        && request.resource.data.status == resource.data.status
        && changedKeys()
             .hasOnly(['childClassLevel', 'childDisplayName', 'childEducationType',
                       'childDepartment', 'childProgram', 'childBoard', 'updatedAt'])
        && isStr(request.resource.data.childDisplayName, 100)
        && isStr(request.resource.data.childClassLevel, 100);
      allow update: if signedIn() && callerActive()
        && (resource.data.parentId == uid() || resource.data.studentId == uid())
        && request.resource.data.status == 'revoked'
        && changedKeys()
             .hasOnly(['status', 'revokedAt', 'updatedAt']);
      allow update: if isAdmin()
        && resource.data.status in ['pending', 'confirmed']
        && request.resource.data.status == 'verified'
        && changedKeys()
             .hasOnly(['status', 'verifiedBy', 'verifiedAt', 'decidedBy', 'decisionReason', 'updatedAt'])
        && request.resource.data.verifiedBy == uid()
        && (request.resource.data.get('decidedBy', null) == null || request.resource.data.decidedBy == uid())
        && isOptStrF(request.resource.data, 'decisionReason', 500);
      allow update: if isAdmin()
        && resource.data.status in ['pending', 'confirmed']
        && request.resource.data.status == 'rejected'
        && changedKeys()
             .hasOnly(['status', 'decidedBy', 'decisionReason', 'rejectedAt', 'updatedAt'])
        && request.resource.data.decidedBy == uid()
        && isStr(request.resource.data.decisionReason, 500);
      allow update: if isAdmin()
        && resource.data.status in ['pending', 'confirmed', 'verified']
        && request.resource.data.status == 'revoked'
        && changedKeys()
             .hasOnly(['status', 'revokedAt', 'updatedAt']);
      allow delete: if isAdmin();
    }

    // ---------- gift catalogue / partnerships: empty / owner-only until funded ----------

    // ---------- adminActions (append-only audit log, spec §3) ----------
    // Admins/Owners record their own actions (actorId must be their own
    // uid). Readable by the owner ONLY. Entries are never updated or
    // deleted by anyone — the log is append-only.
    // (Review 20 Nov 2026 — security S3:) the action is now a fixed enum
    // (no forged "action" strings), only the known fields may be present,
    // and createdAt must be a real timestamp (no backdating). The client
    // writes the action + its audit entry in ONE batch (admin.ts), so an
    // action cannot happen with no audit trail.
    match /adminActions/{actionId} {
      allow create: if isAdmin()
        && request.resource.data.actorId == uid()
        && request.resource.data.action in [
             'user-suspend', 'user-reactivate', 'user-role-change',
             'teacher-verification-approved', 'teacher-verification-rejected',
             'teacher-verification-revoked', 'teacher-verification-reopened',
             'teacher-change-approved', 'teacher-change-rejected',
             'guardian-link-approved', 'guardian-link-rejected', 'guardian-link-revoked',
             'feature-enabled', 'feature-disabled',
             'backup-exported', 'nu-structure-applied', 'nu-syllabus-applied',
             'nu-question-published', 'nu-question-withdrawn',
             // Step 6 fold-in, ChatGPT P2-01: content publish / verify
             // audit actions — the Step 15 admin UI (and Step 7 flows)
             // must append one of these on every publish / unpublish /
             // verify / return of a Job content doc.
             'job-content-published', 'job-content-unpublished',
             'job-content-verified', 'job-content-returned',
             // Step 15: circular deletes are Admin-only and must
             // leave an audit entry (a delete without a trail would
             // be invisible). Probe-measured with the circulars
             // delete line + 3 keys: +125 stripped bytes total,
             // release-create PASSES.
             'job-content-deleted',
             'user-profile-viewed', 'user-messages-viewed',
             'support-message-sent', 'message-reported', 'message-blocked']
        && onlyKeys(
             ['actorId', 'action', 'details', 'targetId', 'before', 'after', 'reason', 'createdAt'])
        && request.resource.data.createdAt is timestamp;
      // DASHBOARDS (Step 5): a user appends ONLY their own profile-change
      // audit entry (action 'profile-changed', actorId == targetId ==
      // their own uid), written in the SAME batch as the profile update
      // by profile.ts — the change and its audit trail succeed or fail
      // together. The log stays append-only: nobody may update or
      // delete an entry, and a user can never forge another action or
      // another user's entry.
      allow create: if signedIn() && callerActive()
        && request.resource.data.actorId == uid()
        && request.resource.data.targetId == uid()
        && request.resource.data.action == 'profile-changed'
        && onlyKeys(
             ['actorId', 'action', 'details', 'targetId', 'before', 'after', 'createdAt'])
        && request.resource.data.details is string
        && request.resource.data.createdAt is timestamp;
      // DASHBOARDS (Step 8): guardian-link audit entries written by the
      // guardian / child themselves, in the SAME batch as the link
      // change (guardian.ts) — request, child confirmation, and a
      // guardian/child revoke each append one entry. actorId must be the
      // caller; targetId must be the parentLinks document id
      // (`{guardianUid}_{childUid}`), so an entry always names the link
      // it belongs to and nobody can forge another family's entry. The
      // admin's decision entries (approved/rejected/revoked) go through
      // the admin clause above.
      allow create: if signedIn() && callerActive()
        && request.resource.data.actorId == uid()
        && request.resource.data.action in [
             'guardian-link-requested', 'guardian-link-confirmed', 'guardian-link-revoked']
        && request.resource.data.targetId is string
        && request.resource.data.targetId.matches('^[^_]+_[^_]+$')
        && onlyKeys(
             ['actorId', 'action', 'details', 'targetId', 'before', 'after', 'createdAt'])
        && request.resource.data.details is string
        && request.resource.data.createdAt is timestamp;
      allow read: if isOwnerRole();
      allow update, delete: if false;
    }

    // ---------- settings (dashboard-controlled toggles) ----------
    // (Review 20 Nov 2026 — security B4, cost F9, child safety F13:)
    // there was NO settings rule at all, so every feature toggle failed
    // with permission-denied. The dashboard could not work.
    // - settings/features: read by any signed-in user (plain booleans —
    //   NEVER put secrets, API keys or AdSense IDs in this doc); write by
    //   the OWNER ONLY, field allowlist = the 11 known flags + updatedAt,
    //   every flag value must be a boolean. Category C flags
    //   (live-classes, video-ads, paid-subscriptions) are additionally
    //   hard-blocked in admin.ts — the code refuses them, so even the
    //   owner cannot flip one by accident from the dashboard; enabling
    //   one needs a separate, explicitly-approved owner decision.
    // - settings/ads: the future home of the ad placement toggles
    //   (today they are localStorage-only — see lib/ads.ts). The
    //   bottom-banner is DELIBERATELY absent from this allowlist: the
    //   persistent banner can never be turned off (owner brief
    //   20 Nov 21:52), so there is no field for it to be stored in.
    // validSettingsFeaturesCreate(d) — compaction 27 Nov 2026: the create allow below, extracted verbatim with request.resource.data -> d (pure substitution; semantics identical).
    function validSettingsFeaturesCreate(d) {
      return isOwnerRole()
        && d.keys().toSet().hasOnly(
             ['ai-teacher', 'video-uploads', 'comments', 'social', 'games',
              'health', 'career', 'offline-downloads', 'live-classes',
              'video-ads', 'paid-subscriptions', 'updatedAt'])
        && d.get('ai-teacher', false) is bool
        && d.get('video-uploads', false) is bool
        && d.get('comments', false) is bool
        && d.get('social', false) is bool
        && d.get('games', false) is bool
        && d.get('health', false) is bool
        && d.get('career', false) is bool
        && d.get('offline-downloads', false) is bool
        && d.get('live-classes', false) is bool
        && d.get('video-ads', false) is bool
        && d.get('paid-subscriptions', false) is bool
        && d.updatedAt is timestamp;
    }
    // validSettingsFeaturesUpdate(d) — compaction 27 Nov 2026: the update allow below, extracted verbatim with request.resource.data -> d (pure substitution; semantics identical).
    function validSettingsFeaturesUpdate(d) {
      return isOwnerRole()
        && changedKeys()
             .hasOnly(['ai-teacher', 'video-uploads', 'comments', 'social', 'games',
                       'health', 'career', 'offline-downloads', 'live-classes',
                       'video-ads', 'paid-subscriptions', 'updatedAt'])
        && d.get('ai-teacher', false) is bool
        && d.get('video-uploads', false) is bool
        && d.get('comments', false) is bool
        && d.get('social', false) is bool
        && d.get('games', false) is bool
        && d.get('health', false) is bool
        && d.get('career', false) is bool
        && d.get('offline-downloads', false) is bool
        && d.get('live-classes', false) is bool
        && d.get('video-ads', false) is bool
        && d.get('paid-subscriptions', false) is bool;
    }
    match /settings/features {
      allow read: if signedIn();
      allow create: if validSettingsFeaturesCreate(request.resource.data);
      allow update: if validSettingsFeaturesUpdate(request.resource.data);
      allow delete: if false;
    }
    match /settings/ads {
      allow read: if signedIn();
      allow create, update: if isOwnerRole()
        && request.resource.data.keys().toSet().hasOnly(['in-feed', 'in-feed-2', 'updatedAt'])
        && request.resource.data.get('in-feed', true) is bool
        && request.resource.data.get('in-feed-2', true) is bool;
      allow delete: if false;
    }

    // ---------- messenger (owner decision 20 Nov 23:25 — private messaging
    // IS in the product, staged, with mandatory safeguards) ----------
    // Phase 1a — support messaging (owner/admin <-> any user): a user
    // opens their own support thread; owner/admin read and reply.
    // Messages are TEXT ONLY in Phase 1 (kind == 'text' — no voice/video
    // calls). Every message is logged; the owner can view any thread
    // (audit-logged from the dashboard). The rules below are LIVE.
    match /supportMessages/{threadId} {
      allow read: if signedIn() && (resource.data.userId == uid() || isAdmin());
      allow create: if signedIn() && callerActive()
        && request.resource.data.userId == uid()
        && request.resource.data.status in ['open', 'closed'];
      allow update: if isAdmin()
        && changedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['open', 'closed'];
      allow delete: if false;
    }
    match /supportMessages/{threadId}/messages/{messageId} {
      allow read: if signedIn()
        && (get(/databases/$(database)/documents/supportMessages/$(threadId)).data.userId == uid() || isAdmin());
      allow create: if signedIn() && callerActive()
        && request.resource.data.senderId == uid()
        && request.resource.data.kind == 'text'
        && isStr(request.resource.data.body, 2000);
      allow update, delete: if false;
    }
    // Phase 1b — direct messages (student <-> student, teacher <->
    // student): RULES SCAFFOLD ONLY — client writes are DENIED until the
    // six mandatory safeguards from the 23:25 decision exist in code, AND
    // the privacy + messaging design proposal is explicitly approved by
    // the owner. PRIVACY BRIEF 21 Nov 00:17 (binding, supersedes the
    // 23:25 access model): NO routine access to private message content
    // for ANYONE — not the owner, not admins, not moderators, not
    // teachers, not guardians. Guardians must NOT read their children's
    // private messages; teachers must NOT read students' private
    // messages. That is why the read rule below is participants ONLY —
    // isAdmin() was deliberately REMOVED: no routine admin/owner read of
    // private DM content is possible, even at the rules level.
    // Exceptional access is allowed ONLY for a serious safety incident,
    // via a clearly documented, auditable process with Owner approval,
    // time-boxed, scoped, read-only, every read logged — never hidden or
    // unrestricted. No inbox-viewing feature is built until the design is
    // approved. Until the safeguards + approval land, DMs stay OFF and
    // this match proves it in the emulator tests.
    // The 23:25 decision SUPERSEDES the 13:19 "moderated groups only"
    // decision (DMs exist); the 00:17 brief supersedes the 23:25 ACCESS
    // model (nobody routinely reads them). Blueprint v4 §2.1 + the Phase
    // 2 plan social section must be updated to match both.
    match /directMessages/{threadId} {
      allow read: if signedIn() && uid() in resource.data.get('participants', []);
      allow create, update, delete: if false;
    }

    // ---------- Job Preparation — categories + exams (Step 5, Step 3 §3.3) ----------
    // jobCategories: public structure (anyone reads the category list);
    // only Admin writes; NEVER deleted (historical data) — only
    // deactivated via status 'inactive' (Step 3 §2.1).
    match /jobCategories/{categoryId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && isStr(request.resource.data.nameBn, 100)
        && isStr(request.resource.data.nameEn, 100)
        && request.resource.data.order is int
        && request.resource.data.order >= 1
        && request.resource.data.order <= 10
        && request.resource.data.hubSlugs is list
        && request.resource.data.hubSlugs.size() >= 1
        // P1-6: every listed hub must be a real exam slug — a category
        // can never point at an unknown exam.
        && request.resource.data.hubSlugs.toSet().hasOnly(jobExamSlugs())
        && isStr(request.resource.data.accent, 20)
        && request.resource.data.status in ['active', 'inactive'];
      allow delete: if false;
    }
    // jobExams: students read Published docs only; moderators read
    // drafts; the author reads their own draft. Create is draft-only
    // (Step 3 §3.3 draft says reviewStatus == 'draft' — but §2.2's enum
    // is 'Not Started' | 'In Progress' | 'Under Review' | 'Published',
    // so the draft-only intent is enforced with isDraftStatus instead
    // of the literal 'draft', which matches no enum value). The doc ID
    // must equal the slug (§2.2).
    //
    // STEP 5 CLOSURE (ChatGPT review P0 — the Step 3 draft's update
    // rule let ANY Moderator rewrite rulesConfig, publish, wipe the
    // history and change authorId with a direct write, because it
    // only type-checked rulesConfig. Field permissions are now split
    // in the rules themselves:
    //   Moderator — CONTENT fields only (names, org, steps, accents,
    //     description, syllabusSource, updatedAt) + advancing the
    //     review workflow between DRAFT states. Everything else is
    //     outside the affected-keys allowlist and therefore cannot
    //     change here: rulesConfig, rulesConfigHistory, status,
    //     categoryId, tier, slug, authorId, createdBy, scopeStatus,
    //     patternStatus, applicableCycle. A Moderator can NEVER
    //     publish (reviewStatus must stay a draft state) and can NEVER
    //     touch a Published doc at all.
    //   Admin — everything, WITH the history rule: a rulesConfig
    //     change must append exactly one history entry (old entries
    //     kept, before→after linked, actor == caller); an unchanged
    //     config keeps the history byte-identical. Publication is an
    //     Admin act: status and reviewStatus must agree
    //     (published ⟺ reviewStatus 'Published').
    //   Provenance (authorId, createdBy, createdAt) is immutable —
    //     even for Admin. The author exception on read applies only
    //     because create pins authorId to the creator (or leaves it
    //     absent); a student can never create an author identity —
    //     create requires Moderator.
    // validJobExamCreate(d, examSlug) — compaction 27 Nov 2026: the create allow below, extracted verbatim with request.resource.data -> d (pure substitution; semantics identical).
    function validJobExamCreate(d, examSlug) {
      return isModerator()
        && d.slug == examSlug
        && d.categoryId in jobCategoryIds()
        && d.tier in [1, 2, 3]
        && isDraftStatus(d.reviewStatus)
        && d.status == 'draft'
        && isStr(d.nameBn, 100)
        && validJobRulesConfig(d.rulesConfig)
        // A new draft starts with an empty history — no fabricated entries.
        && (!('rulesConfigHistory' in d)
            || d.rulesConfigHistory == [])
        // The creator is the author (or the doc has no author yet —
        // the seed carries createdBy 'seed' and no authorId).
        && (!('authorId' in d)
            || d.authorId == uid())
        && (!('createdBy' in d)
            || d.createdBy is string)
        && d.patternStatus in jobPatternStatuses()
        && (d.applicableCycle == null
            || d.applicableCycle is string)
        && d.get('scopeStatus', 'defined') in ['defined', 'scope_pending']
        && (!('createdAt' in d) || d.createdAt is timestamp)
        && (!('updatedAt' in d) || d.updatedAt is timestamp);
    }
    // validJobExamUpdateModerator(d, old) — compaction 27 Nov 2026: the update allow below, extracted verbatim with request.resource.data -> d and resource.data -> old (pure substitution; semantics identical).
    function validJobExamUpdateModerator(d, old) {
      return isModerator()
        // Protected config pinned FIRST: a config-change write fails
        // here on one equality instead of paying for a full diff()
        // of two big docs (expression budget — rules tests a3/b6).
        && d.get('rulesConfig', null) == old.get('rulesConfig', null)
        && d.get('rulesConfigHistory', null) == old.get('rulesConfigHistory', null)
        && changedKeys()
             .hasOnly(['nameBn', 'nameEn', 'fullBn', 'fullEn', 'orgBn', 'orgEn',
                       'stepsBn', 'stepsEn', 'officialUrl', 'accent', 'accentSoft',
                       'accentDeep', 'descriptionBn', 'descriptionEn',
                       'syllabusSource', 'reviewStatus', 'updatedAt'])
        // Draft stays a draft — workflow may advance between draft
        // states, but a Moderator can never publish, and a Published
        // doc cannot be touched by a Moderator at all.
        && isDraftStatus(old.reviewStatus)
        && isDraftStatus(d.reviewStatus)
        && d.status == 'draft'
        && isStr(d.nameBn, 100)
        && isOptStrF(d, 'nameEn', 100)
        && isOptStrF(d, 'fullBn', 200)
        && isOptStrF(d, 'fullEn', 200)
        && isOptStrF(d, 'orgBn', 200)
        && isOptStrF(d, 'orgEn', 200)
        && isOptStrF(d, 'stepsBn', 200)
        && isOptStrF(d, 'stepsEn', 200)
        && (d.get('officialUrl', null) == null
            || isStrType(d, 'officialUrl'))
        && isOptStrF(d, 'accent', 20)
        && isOptStrF(d, 'accentSoft', 20)
        && isOptStrF(d, 'accentDeep', 20)
        && isOptStrF(d, 'descriptionBn', 500)
        && isOptStrF(d, 'descriptionEn', 500)
        && (d.get('syllabusSource', null) == null
            || isStrType(d, 'syllabusSource'))
        && (!('updatedAt' in d) || d.updatedAt is timestamp);
    }
    // validJobExamUpdateAdminConfig(d, old) — compaction 27 Nov 2026: the update allow below, extracted verbatim with request.resource.data -> d and resource.data -> old (pure substitution; semantics identical).
    function validJobExamUpdateAdminConfig(d, old) {
      return isAdmin()
        && d.get('rulesConfig', null) != old.get('rulesConfig', null)
        && validJobRulesConfig(d.rulesConfig)
        && validJobRulesConfigHistoryChange(old, d)
        && isListType(d, 'rulesConfigHistory')
        && d.status == old.status
        && d.reviewStatus == old.reviewStatus
        && d.slug == old.slug
        && d.categoryId == old.categoryId
        && d.tier == old.tier
        && d.get('authorId', null) == old.get('authorId', null)
        && d.get('createdBy', null) == old.get('createdBy', null)
        && d.get('createdAt', null) == old.get('createdAt', null)
        && d.get('scopeStatus', 'defined') == old.get('scopeStatus', 'defined')
        && d.get('patternStatus', null) == old.get('patternStatus', null)
        && d.get('applicableCycle', null) == old.get('applicableCycle', null)
        && (!('updatedAt' in d) || d.updatedAt is timestamp);
    }
    // validJobExamUpdateAdmin(d, old, examSlug) — compaction 27 Nov 2026: the update allow below, extracted verbatim with request.resource.data -> d and resource.data -> old (pure substitution; semantics identical).
    function validJobExamUpdateAdmin(d, old, examSlug) {
      return isAdmin()
        && d.get('rulesConfig', null) == old.get('rulesConfig', null)
        && d.get('rulesConfigHistory', null) == old.get('rulesConfigHistory', null)
        && d.slug == examSlug
        && d.categoryId in jobCategoryIds()
        && d.tier in [1, 2, 3]
        && isJobExamReviewState(d.reviewStatus)
        && d.status in ['draft', 'published']
        && jobExamStatesConsistent(d)
        && d.get('authorId', null) == old.get('authorId', null)
        && d.get('createdBy', null) == old.get('createdBy', null)
        && d.get('createdAt', null) == old.get('createdAt', null)
        && (!('patternStatus' in d)
            || d.patternStatus in jobPatternStatuses())
        && (d.get('applicableCycle', null) == null
            || isStrType(d, 'applicableCycle'))
        && d.get('scopeStatus', 'defined') in ['defined', 'scope_pending']
        && isStr(d.nameBn, 100)
        && isOptStrF(d, 'nameEn', 100)
        && isOptStrF(d, 'fullBn', 200)
        && isOptStrF(d, 'fullEn', 200)
        && isOptStrF(d, 'orgBn', 200)
        && isOptStrF(d, 'orgEn', 200)
        && isOptStrF(d, 'stepsBn', 200)
        && isOptStrF(d, 'stepsEn', 200)
        && (d.get('officialUrl', null) == null
            || isStrType(d, 'officialUrl'))
        && isOptStrF(d, 'accent', 20)
        && isOptStrF(d, 'accentSoft', 20)
        && isOptStrF(d, 'accentDeep', 20)
        && isOptStrF(d, 'descriptionBn', 500)
        && isOptStrF(d, 'descriptionEn', 500)
        && (d.get('syllabusSource', null) == null
            || isStrType(d, 'syllabusSource'))
        && (!('updatedAt' in d) || d.updatedAt is timestamp);
    }
    match /jobExams/{examSlug} {
      // Read order is deliberate (22 Nov 2026 — rules test e5): the
      // get()-free checks come first, so a list query over Published
      // docs short-circuits before the role lookup touches the users
      // doc at all. The published check reads `status` — the
      // PUBLICATION state (P1-1) — NOT reviewStatus: a list query
      // filters on status, and Firestore can only allow a query it
      // can prove from the query's own filters; the write rules
      // guarantee status ⟺ reviewStatus (jobExamStatesConsistent),
      // so a doc with status 'published' IS published. The shared
      // isPublished() helper checks reviewStatus and is correct for
      // the other collections, whose queries filter on reviewStatus —
      // it is the wrong check here.
      allow read: if resource.data.get('status', '') == 'published'
        || (signedIn() && resource.data.get('authorId', '') == uid())
        || isModerator();
      allow create: if validJobExamCreate(request.resource.data, examSlug);
      // Moderator: content fields only (see the block comment above).
      // NO keys().hasOnly() here: checking the whole 29-key set costs
      // ~29x29 pairwise comparisons and blows the 1000-expression
      // budget (rules tests a3/b6, 22 Nov 2026). diff() reports only
      // the CHANGED keys, so its hasOnly is cheap — and the draft /
      // status pins below stop any publish or Published-doc touch.
      allow update: if validJobExamUpdateModerator(request.resource.data, resource.data);
      // Admin, rule A — config change. A config write may change ONLY
      // rulesConfig, rulesConfigHistory and updatedAt: status,
      // reviewStatus, slug, category and all content fields stay exactly
      // as they are (a publish or a content edit is a separate write,
      // rule B below). Content fields are not re-typed here — they are
      // pinned equal to the old doc, which was valid when written. A
      // config can be REPLACED (with a history entry) but not cleared to
      // null: validJobRulesConfig(null) is false, so clearing is denied;
      // mark it not_verified via rule B instead (the old config stays in
      // history). Splitting the Admin update in two keeps each
      // evaluation well inside the 1000-expression budget: the
      // config-change path pays for validJobRulesConfig + the history
      // rule, and the content path pays for neither.
      allow update: if validJobExamUpdateAdminConfig(request.resource.data, resource.data);
      // Admin, rule B — content / status change. Config and history are
      // pinned unchanged here; a config change goes through rule A with
      // its history entry. Provenance stays immutable.
      allow update: if validJobExamUpdateAdmin(request.resource.data, resource.data, examSlug);
      allow delete: if isAdmin();
    }

    // ---------- National University admission (NU-4, §19.3) ----------
    // Shared engine + explicit NU config layer: the NU collections below
    // are separate from Job's (no `if (isNU)` branches in shared code).
    // Students can NEVER create/submit/edit/publish questions or
    // answers — only Owner + approved Admin / Verified Teacher.
    // NO `verified: true` flag can be written by any client (§19.4):
    // a verified result exists only through a reviewer's separate,
    // access-controlled process (Release 3+), so no match below allows
    // a client to write one.
    //
    // SPEC CORRECTION (NU-4): §19.3.3 wrote the receipt-owner check as
    // `receiptId.split('_')[0]` — Firestore rules have NO String.split,
    // so that expression cannot compile. The checks below use the
    // receipt document's `userId` field (and `uid() + '_' + bundleId`
    // equality on create) instead. Same enforcement, valid rules.
    function isPracticeNuBundle(bundleId) {
      return exists(/databases/$(database)/documents/nuQuestionBundles/$(bundleId))
        && get(/databases/$(database)/documents/nuQuestionBundles/$(bundleId)).data.get('kind', '') == 'topic';
    }
    // The 7 receipt conditions (§18 (b)-2, §19.3.3): own receipt, a
    // real attempt that belongs to the caller, submitted (once),
    // attemptId matches, server timestamp present, fresh (10 min),
    // bundleId matches the attempt. Honest limit (§19.3.8): the
    // receipt proves a submission record exists — it does NOT prove
    // the score was independently calculated (§19.4).
    function hasFreshNuReceipt(bundleId) {
      return exists(/databases/$(database)/documents/nuReceipts/$(uid() + '_' + bundleId))
        && get(/databases/$(database)/documents/nuReceipts/$(uid() + '_' + bundleId)).data.userId == uid()
        && get(/databases/$(database)/documents/nuReceipts/$(uid() + '_' + bundleId)).data.attemptId is string
        && exists(/databases/$(database)/documents/users/$(uid())/nuAttempts/$(get(/databases/$(database)/documents/nuReceipts/$(uid() + '_' + bundleId)).data.attemptId))
        && get(/databases/$(database)/documents/users/$(uid())/nuAttempts/$(get(/databases/$(database)/documents/nuReceipts/$(uid() + '_' + bundleId)).data.attemptId)).data.status == 'submitted'
        && get(/databases/$(database)/documents/users/$(uid())/nuAttempts/$(get(/databases/$(database)/documents/nuReceipts/$(uid() + '_' + bundleId)).data.attemptId)).data.bundleId == bundleId
        && get(/databases/$(database)/documents/users/$(uid())/nuAttempts/$(get(/databases/$(database)/documents/nuReceipts/$(uid() + '_' + bundleId)).data.attemptId)).data.userId == uid()
        && get(/databases/$(database)/documents/nuReceipts/$(uid() + '_' + bundleId)).data.createdAt is timestamp
        // L2 (Step 17, 23 Nov 2026): the read gate had NO lower bound
        // on createdAt — a future-dated receipt opened the key for a
        // year. Mirrors hasFreshReceipt (createdAt <= request.time).
        && get(/databases/$(database)/documents/nuReceipts/$(uid() + '_' + bundleId)).data.createdAt <= request.time
        && request.time < get(/databases/$(database)/documents/nuReceipts/$(uid() + '_' + bundleId)).data.createdAt + duration.value(10, 'm');
    }

    // nuExamConfigs (§19.1.2, §19.3.4): versioned, rules-validated.
    // The verified values (100 MCQ / 60 min / no negative marking /
    // pass 35 display-only / sections 20+20+20+40 / no viva / no rank)
    // are enforced here so a wrong config can never be published by a
    // direct write. Students read published configs only.
    // validNuExamConfigCreateUpdate(d) — compaction 27 Nov 2026: the create allow below, extracted verbatim with request.resource.data -> d (pure substitution; semantics identical).
    function validNuExamConfigCreateUpdate(d) {
      return isAdmin()
        && d.examType in ['NU_ADMISSION', 'NU_DAILY']
        && d.questionMode == 'MCQ'
        && d.marking is map
        && d.marking.correct == 1
        && d.marking.incorrect == 0
        && d.marking.unanswered == 0
        && d.marking.negativeMarking == false
        && d.vivaEnabled == false
        && d.officialRankEnabled == false
        && d.configVersion is int
        && d.configVersion >= 1
        && d.circularVersion is string
        && d.status in ['draft', 'published', 'withdrawn']
        && ((d.examType == 'NU_ADMISSION'
            && d.totalQuestions == 100
            && d.durationSeconds == 3600
            && d.sections is map
            && d.sections.bangla == 20
            && d.sections.english == 20
            && d.sections.generalKnowledge == 20
            && d.sections.groupSubjects == 40
            && d.sections.groupSubjectsDetail == null)
          || (d.examType == 'NU_DAILY'
            && d.totalQuestions is int
            && d.totalQuestions >= 20
            && d.totalQuestions <= 30
            && d.durationSeconds is int
            && d.durationSeconds >= 1200
            && d.durationSeconds <= 1800));
    }
    match /nuExamConfigs/{configId} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow create, update: if validNuExamConfigCreateUpdate(request.resource.data);
      allow delete: if false;
    }

    // nuCircularConfigs (§19.2.1): a new circular never overwrites an
    // old one — the old doc becomes 'superseded', never deleted.
    // The 2025-26 doc is 'historical' today (window closed 31 Dec
    // 2025); no 2026-27 doc exists until that circular is verified.
    match /nuCircularConfigs/{admissionId} {
      allow read: if resource.data.status in ['published', 'historical', 'superseded'] || isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.status in ['draft', 'verified', 'published', 'historical', 'superseded']
        && request.resource.data.academicSession is string
        && request.resource.data.sourceType == 'official_circular';
      allow delete: if false;
    }

    // nuInstitutions / nuGroups (§19.2.2): public reference data.
    match /nuInstitutions/{institutionId} {
      allow read: if resource.data.status == 'active' || isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.slug is string
        && request.resource.data.officialUrl is string;
      allow delete: if false;
    }
    match /nuGroups/{groupId} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.slug in ['humanities', 'science', 'business']
        && request.resource.data.institutionId is string
        && request.resource.data.examConfigId is string
        && request.resource.data.circularVersion is string;
      allow delete: if false;
    }

    // nuSubjects / nuChapters / nuTopics / nuLessons (§19.2.3,
    // §19.3.4; NU-6): the syllabus structure. Read — Published for
    // everyone; a verified teacher may also read a draft they created.
    // Write — Owner/Admin or a verified teacher (own Draft only, and
    // createdBy must be their own uid). Publish (draft → published) —
    // Owner/Admin only. Published docs are never edited in place (a
    // correction is a new version, NU-7). Field checks mirror
    // lib/nuSyllabus.ts — the group-40 block stays ONE doc per group.
    // nuSubjects / nuChapters / nuTopics / nuLessons share identical
    // rules except the validator (compaction 24 Nov 2026): one
    // wildcard match with a collection guard. The guard is
    // load-bearing — no other top-level collection is granted
    // anything here — and the BRT-08 drift test parses it.
    function validNuContent(coll, d) {
      return coll == 'nuSubjects' ? isValidNuSubject(d)
        : coll == 'nuChapters' ? isValidNuChapter(d)
        : coll == 'nuTopics' ? isValidNuTopic(d)
        : isValidNuLesson(d);
    }
    match /{nuColl}/{docId} {
      allow read: if nuColl.matches('^nu(Subjects|Chapters|Topics|Lessons)$')
        && signedIn() && (resource.data.status == 'published' || isAdmin()
        || (isVerifiedTeacher() && resource.data.createdBy == uid()));
      allow create: if nuColl.matches('^nu(Subjects|Chapters|Topics|Lessons)$')
        && (isAdmin() || (isVerifiedTeacher() && request.resource.data.createdBy == uid()))
        && request.resource.data.status == 'draft'
        && validNuContent(nuColl, request.resource.data);
      allow update: if nuColl.matches('^nu(Subjects|Chapters|Topics|Lessons)$')
        && adminOrOwnTeacher()
        && resource.data.status != 'published'
        && !(request.resource.data.status == 'published' && !isAdmin())
        && sameCreator()
        && validNuContent(nuColl, request.resource.data);
      allow delete: if false;
    }

    // nuQuestions (§19.3.2): the bank. Students cannot even READ it.
    // The correct answer is NEVER in this document (it lives in
    // nuQuestionKeys). Published questions are never edited in place —
    // a correction is a new version (NU-7).
    match /nuQuestions/{questionId} {
      allow read: if isAdmin() || (isVerifiedTeacher() && resource.data.createdBy == uid());
      allow create: if (isAdmin() || isVerifiedTeacher())
        && request.resource.data.status == 'draft'
        && request.resource.data.version == 1
        && request.resource.data.createdBy == uid()
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdAt == request.time
        && isValidNuQuestion(request.resource.data);
      // (A) Content edit — author-or-Admin, only while draft or
      // changes_requested, status + version + author unchanged, and
      // only content keys may change. The state machine lives in (B).
      allow update: if adminOrOwnTeacher()
        && resource.data.status in ['draft', 'changes_requested']
        && request.resource.data.status == resource.data.status
        && request.resource.data.version == resource.data.version
        && sameCreator()
        && changedKeys().hasOnly(
             ['questionText', 'questionLang', 'options', 'difficulty',
              'explanation', 'sourceType', 'provenance', 'examYear',
              'groupIds', 'subjectId', 'chapterId', 'topicId',
              'circularVersion', 'updatedAt'])
        && isValidNuQuestion(request.resource.data);
      // (B) State transition — graph edges only (§19.6.1), actor per
      // edge, only status + review/publish bookkeeping keys change.
      // Submit additionally requires the draft key to exist and match
      // the question version (1 rules read); publish additionally
      // requires the full publish gate (reviewer + review time +
      // valid shape — an unverified question can never publish).
      allow update: if isNuQuestionTransitionAllowed(resource.data.status, request.resource.data.status)
        && isNuQuestionTransitionActorOk(request.resource.data.status)
        && request.resource.data.version == resource.data.version
        && sameCreator()
        && changedKeys().hasOnly(
             ['status', 'reviewedBy', 'reviewedAt', 'publishedAt', 'updatedAt'])
        && (request.resource.data.status != 'submitted_for_review'
            || (exists(/databases/$(database)/documents/nuQuestionDraftKeys/$(questionId))
                && get(/databases/$(database)/documents/nuQuestionDraftKeys/$(questionId)).data.version == resource.data.version))
        && (request.resource.data.status != 'under_review'
            || (request.resource.data.reviewedBy == uid() && request.resource.data.reviewedAt is timestamp))
        && (request.resource.data.status != 'published'
            || (isValidNuQuestion(request.resource.data)
                && request.resource.data.reviewedBy is string
                && request.resource.data.reviewedAt is timestamp));
      allow delete: if false;
    }

    // nuQuestionDraftKeys (NU-7, §19.2.6): the draft correct answer.
    // One doc per question (id == questionId), version-locked to the
    // question. Readable only by Admins and the question's author —
    // a reviewer reads it while the question is under review only
    // through the Admin path (subject-scoped key reads are the
    // §19.3.8 honest limit: `subjects` on the teacher profile is
    // free text, rules have no string-case functions). A key can
    // only be created while its question is a draft, and only
    // changed while the question is still a draft. Never deleted.
    match /nuQuestionDraftKeys/{questionId} {
      allow read: if isAdmin() || (isVerifiedTeacher() && resource.data.createdBy == uid())
        || (isVerifiedTeacher()
            && exists(/databases/$(database)/documents/nuQuestions/$(questionId))
            && get(/databases/$(database)/documents/nuQuestions/$(questionId)).data.status == 'under_review'
            && get(/databases/$(database)/documents/nuQuestions/$(questionId)).data.reviewedBy == uid());
      allow create: if (isAdmin() || isVerifiedTeacher())
        && request.resource.data.questionId == questionId
        && request.resource.data.createdBy == uid()
        && isValidNuQuestionDraftKey(request.resource.data)
        && exists(/databases/$(database)/documents/nuQuestions/$(questionId))
        && get(/databases/$(database)/documents/nuQuestions/$(questionId)).data.status == 'draft'
        && get(/databases/$(database)/documents/nuQuestions/$(questionId)).data.version == request.resource.data.version;
      allow update: if adminOrOwnTeacher()
        && request.resource.data.questionId == questionId
        && request.resource.data.version == resource.data.version
        && sameCreator()
        && isValidNuQuestionDraftKey(request.resource.data)
        && exists(/databases/$(database)/documents/nuQuestions/$(questionId))
        && get(/databases/$(database)/documents/nuQuestions/$(questionId)).data.status == 'draft'
        && get(/databases/$(database)/documents/nuQuestions/$(questionId)).data.version == request.resource.data.version;
      allow delete: if false;
    }

    // nuQuestionBundles (§19.3.3): the student-facing layer (questions
    // + options only — no correct answers, no explanations). Only
    // published bundles are readable; drafts are Admin-only so an
    // Admin can read what they are about to publish.
    match /nuQuestionBundles/{bundleId} {
      allow read: if (signedIn() && resource.data.status == 'published') || isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.bundleId == bundleId
        && isValidNuBundle(request.resource.data);
      allow delete: if false;
    }

    // nuQuestionKeys (§19.3.3): receipt-gated. Practice ('topic')
    // bundles are readable without a receipt (learning); mock/daily
    // bundles need a fresh receipt (hasFreshNuReceipt, 7 conditions).
    // NOTE (NU-7 gap): the key doc carries no subjectId, so the
    // matrix's "verified teacher reads own-subject keys" cannot be
    // enforced yet — teachers read keys only via the Admin path until
    // NU-7 adds subject scoping.
    match /nuQuestionKeys/{bundleId} {
      allow read: if isAdmin()
        || (signedIn() && isPracticeNuBundle(bundleId))
        || (signedIn() && hasFreshNuReceipt(bundleId));
      allow create, update: if isAdmin()
        && request.resource.data.bundleId == bundleId
        && request.resource.data.questionVersion is int && request.resource.data.questionVersion >= 1
        && request.resource.data.keys is list && request.resource.data.keys.size() >= 1
        && request.resource.data.keys[0] is map
        && request.resource.data.keys[0].questionId is string
        && request.resource.data.keys[0].version is int && request.resource.data.keys[0].version >= 1
        && request.resource.data.keys[0].correctOptionIndex is int
        && request.resource.data.keys[0].correctOptionIndex >= 0 && request.resource.data.keys[0].correctOptionIndex <= 3
        && exists(/databases/$(database)/documents/nuQuestionBundles/$(bundleId))
        && request.resource.data.questionVersion == get(/databases/$(database)/documents/nuQuestionBundles/$(bundleId)).data.version;
      allow delete: if false;
    }

    // nuReceipts (§19.3.3): one-use, 10 minutes, immutable. Created
    // only at submit time; a broken/expired receipt is deleted first
    // and a new one created. The receipt id is `{uid}_{bundleId}`.
    match /nuReceipts/{receiptId} {
      allow read: if (signedIn() && resource.data.userId == uid()) || isAdmin();
      // L2 (Step 17, 23 Nov 2026): the create was the weak copy — no
      // signedIn/callerActive, no key allowlist, no createdAt bounds,
      // no attempt check at all (a receipt for a nonexistent or
      // unsubmitted attempt passed). Now mirrors jobReceipts: the
      // anchor attempt must exist, be submitted, and match this
      // bundle and this user; createdAt within 5 minutes, never in
      // the future. Single-use is kept (!exists on the id).
      allow create: if signedIn() && callerActive()
        && receiptId == uid() + '_' + request.resource.data.bundleId
        && onlyKeys(['userId', 'bundleId', 'attemptId', 'createdAt'])
        && request.resource.data.userId == uid()
        && request.resource.data.bundleId is string
        && request.resource.data.bundleId.size() <= 200
        && request.resource.data.attemptId is string
        && request.resource.data.attemptId.size() <= 200
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdAt <= request.time
        && request.resource.data.createdAt > request.time - duration.value(5, 'm')
        && exists(/databases/$(database)/documents/users/$(uid())/nuAttempts/$(request.resource.data.attemptId))
        && get(/databases/$(database)/documents/users/$(uid())/nuAttempts/$(request.resource.data.attemptId)).data.status == 'submitted'
        && get(/databases/$(database)/documents/users/$(uid())/nuAttempts/$(request.resource.data.attemptId)).data.bundleId == request.resource.data.bundleId
        // NOTE: no separate attempt.userId == uid() check — the attempt
        // is fetched from the CALLER's own subcollection
        // (/users/$(uid())/nuAttempts/...), so the path itself enforces
        // ownership; a redundant field check would only cost compiled
        // bytes (the rules margin is ~80 bytes before the refactor).
        && !exists(/databases/$(database)/documents/nuReceipts/$(receiptId));
      allow update: if false;
      allow delete: if resource.data.userId == uid();
    }

    // users/{uid}/nuAttempts (§19.3.5): the attempt is immutable once
    // submitted; late writes (after deadlineAt) are rejected; the
    // question set and config snapshot can never change mid-attempt.
    // Full mock = 100 questions / 3600s; daily = 20–30 questions /
    // 1200–1800s; practice = 1–100 questions (no fixed config).
    // startedAt must be the server timestamp (request.time) — a
    // client clock can never anchor a deadline.
    // validNuAttemptCreate(d, uid) — compaction 27 Nov 2026: the create allow below, extracted verbatim with request.resource.data -> d (pure substitution; semantics identical).
    function validNuAttemptCreate(d, uid) {
      return isOwner(uid)
        && d.userId == uid
        && d.status == 'not_started'
        && d.kind in ['practice', 'mock', 'daily']
        && d.questionIds is list
        && d.startedAt == request.time
        && d.configSnapshot is map
        && ((d.kind == 'mock'
            && d.questionIds.size() == 100
            && d.configSnapshot.totalQuestions == 100
            && d.configSnapshot.durationSeconds == 3600
            // NU-4 correction to the §19.3.5 sketch: deadlineAt CANNOT
            // be required to equal request.time + 3600s exactly — a
            // client can never know request.time to the millisecond, so
            // exact equality would fail legitimate creates. The deadline
            // is BOUNDED instead: after now, at most the config
            // duration. (The update rule still rejects any write after
            // deadlineAt, so a forged longer deadline buys nothing —
            // the attempt simply cannot be written to after the
            // deadline the student themself set... see the honest-limit
            // note in the NU-4 report: a client-set deadline is
            // enforced only as an upper bound by the rules.)
            && d.deadlineAt is timestamp
            && d.deadlineAt > request.time
            && d.deadlineAt <= request.time + duration.value(3600, 's'))
          || (d.kind == 'daily'
            && d.questionIds.size() >= 20
            && d.questionIds.size() <= 30
            && d.configSnapshot.totalQuestions >= 20
            && d.configSnapshot.totalQuestions <= 30
            && d.configSnapshot.durationSeconds >= 1200
            && d.configSnapshot.durationSeconds <= 1800
            && d.deadlineAt is timestamp
            && d.deadlineAt > request.time
            && d.deadlineAt <= request.time + duration.value(d.configSnapshot.durationSeconds, 's'))
          || (d.kind == 'practice'
            && d.questionIds.size() >= 1
            && d.questionIds.size() <= 100));
    }
    match /users/{uid}/nuAttempts/{attemptId} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if validNuAttemptCreate(request.resource.data, uid);
      allow update: if isOwner(uid)
        && resource.data.status != 'submitted'
        && request.time <= resource.data.deadlineAt
        && request.resource.data.questionIds == resource.data.questionIds
        && request.resource.data.configSnapshot == resource.data.configSnapshot
        && (request.resource.data.status != 'submitted'
            || request.resource.data.submittedAt == request.time)
        // C2 (security audit 22 Nov 2026): only the autosave / submit
        // fields may change — deadlineAt and startedAt can NEVER be
        // rewritten, so a mock deadline can no longer be extended.
        && changedKeys().hasOnly(
            ['answers', 'score', 'percentage', 'correctCount', 'wrongCount',
             'unansweredCount', 'status', 'submittedAt', 'updatedAt']);
      allow delete: if false;
    }

    // users/{uid}/nuSessions (§19.2.9): the running-exam state
    // (autosave / recovery copy). Only the owner; deleted after submit.
    // L3 (Step 17, 23 Nov 2026): the match had NO field restrictions
    // at all — any owner could smuggle `score`, rewrite attemptId /
    // startedAt / deadlineAt, or invent fields. Create now allows
    // exactly the design-doc fields (attemptId, status, startedAt,
    // deadlineAt, lastSavedAt, answers, deviceInfo, updatedAt) with
    // a status enum and timestamp types; updates may touch only the
    // autosave fields — attemptId, startedAt and deadlineAt are
    // frozen. The session is NOT tied to an existing attempt here:
    // no client writes nuSessions yet (NU-8 engine not built) and
    // the create order (attempt-first vs session-first) is undecided
    // — that linkage is a post-NU-8 follow-up, not a silent break.
    match /users/{uid}/nuSessions/{sessionId} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && onlyKeys(['attemptId', 'status', 'startedAt',
             'deadlineAt', 'lastSavedAt', 'answers', 'deviceInfo', 'updatedAt'])
        && request.resource.data.attemptId is string
        && request.resource.data.status in ['in_progress', 'submitted']
        && request.resource.data.startedAt is timestamp
        && request.resource.data.deadlineAt is timestamp
        && request.resource.data.updatedAt is timestamp;
      allow update: if isOwner(uid)
        && changedKeys()
             .hasOnly(['status', 'lastSavedAt', 'answers', 'deviceInfo', 'updatedAt'])
        && request.resource.data.status in ['in_progress', 'submitted'];
      allow delete: if isOwner(uid) && resource.data.status == 'submitted';
    }

    // nuReviews / nuPublications (§19.2.11, §19.6.1): the publication
    // state machine (draft → submitted_for_review → under_review →
    // approved → published; rejected / changes_requested /
    // withdrawn). Immutable once written; a reviewer can never review
    // their own question, and can only review a question they claimed
    // (reviewedBy == uid) while it is under_review; a rejection /
    // return needs a reason (≥10 chars). The state transitions
    // themselves are enforced by the question update Rule B (NU-7);
    // the rules below pin who may write the records and that they
    // can never change.
    // validNuReviewCreate(d) — compaction 27 Nov 2026: the create allow below, extracted verbatim with request.resource.data -> d (pure substitution; semantics identical).
    function validNuReviewCreate(d) {
      return (isAdmin() || isVerifiedTeacher())
        && d.reviewerId == uid()
        && d.questionId is string
        && d.decision in ['approved', 'rejected', 'changes_requested']
        && (!('reason' in d)
            || d.reason is string)
        && (d.decision == 'approved'
            || d.get('reason', '').size() >= 10)
        && exists(/databases/$(database)/documents/nuQuestions/$(d.questionId))
        && get(/databases/$(database)/documents/nuQuestions/$(d.questionId)).data.createdBy != uid()
        && d.questionVersion is int
        && d.questionVersion == get(/databases/$(database)/documents/nuQuestions/$(d.questionId)).data.version
        && get(/databases/$(database)/documents/nuQuestions/$(d.questionId)).data.status == 'under_review'
        && get(/databases/$(database)/documents/nuQuestions/$(d.questionId)).data.reviewedBy == uid()
        && d.checks is map
        && d.checks.questionCorrect is bool
        && d.checks.correctAnswerCorrect is bool
        && d.checks.explanationCorrect is bool
        && d.checks.sourceCorrect is bool
        && d.reviewedAt is timestamp
        && d.reviewedAt == request.time;
    }
    match /nuReviews/{reviewId} {
      allow read: if isAdmin() || (signedIn() && resource.data.reviewerId == uid());
      allow create: if validNuReviewCreate(request.resource.data);
      allow update, delete: if false;
    }
    match /nuPublications/{publicationId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.action in ['published', 'withdrawn']
        && request.resource.data.actorId == uid()
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdAt == request.time
        && request.resource.data.questionId is string
        && request.resource.data.questionVersion is int
        && exists(/databases/$(database)/documents/nuQuestions/$(request.resource.data.questionId))
        && request.resource.data.questionVersion == get(/databases/$(database)/documents/nuQuestions/$(request.resource.data.questionId)).data.version
        && ((request.resource.data.action == 'published'
             && get(/databases/$(database)/documents/nuQuestions/$(request.resource.data.questionId)).data.status == 'published')
            || (request.resource.data.action == 'withdrawn'
             && get(/databases/$(database)/documents/nuQuestions/$(request.resource.data.questionId)).data.status == 'withdrawn'));
      allow update, delete: if false;
    }

    // nuNotices / nuCalendarEvents (§19.2.12): published notices only.
    // An event with no verified date is never created (NU-14).
    match /nuNotices/{noticeId} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow create, update: if isAdmin();
      allow delete: if false;
    }
    match /nuCalendarEvents/{eventId} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.eventDate is timestamp;
      allow delete: if false;
    }

    // nuFacts (§19.2.14): the fact records behind every important
    // admission fact (pass mark, fee, thresholds, distribution).
    // Public read — the verificationStatus field on each doc says
    // whether the fact is verified; the UI shows verified facts only.
    match /nuFacts/{factId} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // nuReports / nuCorrections (§19.2.13): a student reports a wrong
    // answer / explanation / fact, or asks for a correction. Own
    // reports only; status changes are Admin-only.
    match /nuReports/{reportId} {
      allow read: if (signedIn() && resource.data.userId == uid()) || isAdmin();
      allow create: if signedIn()
        && request.resource.data.userId == uid()
        && request.resource.data.status == 'open';
      allow update: if isAdmin()
        && changedKeys()
             .hasOnly(['status', 'resolvedNote', 'updatedAt'])
        && request.resource.data.status in ['open', 'investigating', 'resolved', 'dismissed'];
      allow delete: if false;
    }
    match /nuCorrections/{correctionId} {
      allow read: if (signedIn() && resource.data.userId == uid()) || isAdmin();
      allow create: if signedIn()
        && request.resource.data.userId == uid()
        && request.resource.data.status == 'open';
      allow update: if isAdmin()
        && changedKeys()
             .hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['open', 'approved', 'rejected'];
      allow delete: if false;
    }
    // NOTE (NU-12/NU-13): nuNotifications, nuWrongAnswers, nuFavorites,
    // nuPlanner, nuRevisionSchedule and nuAnalyticsAggregates are
    // specified in §19.2.13/§19.2.15 but their document paths are not
    // fixed in §19 — their rules land with the step that builds them
    // (NU-12 planner, NU-13 wrong-answers/favourites, NU-15 admin).
    // Until then the deny-all catch below denies them: no student data
    // is readable or writable there by accident.
    // ---------- Job Preparation — subjects / chapters / topics / lessons (Step 6, Step 3 §2.3–§2.6 + §3.4) ----------
    // Shared pattern for all four collections (deviations from the
    // Step 3 draft are called out inline):
    //   READ — signed-in ONLY (owner instruction 22 Nov 2026 ~10:33,
    //     BINDING — no exam / no extensive reading without login):
    //     `signedIn() && status == 'published'` first (e5 lesson: a
    //     list query filters on status, so the published check must be
    //     provable from the query's own filters — it is get()-free and
    //     comes before the role lookup), OR the author reads their own
    //     draft, OR a Moderator reads anything. Students read Published
    //     only; ANONYMOUS READS NOTHING — not even Published docs
    //     (this partially revokes Step 5 P2-2, which had allowed
    //     anonymous reads of published content; the published
    //     METADATA of jobCategories/jobExams stays anonymous-readable,
    //     but these four content collections do not).
    //   CREATE — isTeacher() only (role in teacher/admin/moderator/
    //     owner + active; students can NEVER create). Draft-only:
    //     status 'draft' + reviewStatus 'Not Started' (the draft's
    //     literal 'draft' reviewStatus is REJECTED — no such enum
    //     value, Step 5 P1-1). authorId pinned to the caller or
    //     absent; no verifier yet. Doc ID must extend the parent
    //     (subject `{examSlug}__{subjectSlug}`, chapter appends
    //     `__{chapterSlug}`, topic appends `__{topicSlug}`); lessons
    //     are auto-ID. Chapter names must be real syllabus chapter
    //     names — the rules CANNOT check that; it is a content rule
    //     for the admin/teacher flow (Step 3 §2.4).
    //   UPDATE, author — the author edits ONLY their own draft, and
    //     moves reviewStatus only within draft states. They can NEVER
    //     publish (status stays 'draft'), NEVER touch a Published doc
    //     (old reviewStatus must be a draft state), and NEVER touch
    //     verifiedBy/verifiedAt, parent refs, lessonType, or the
    //     published-question counter. The author rule ALSO checks
    //     isTeacher() (not just signedIn + active): a teacher whose
    //     role was revoked to student loses the author-edit right too
    //     — the Step 3 draft's author rule checked authorId only, but
    //     Step 5's live-role-check convention governs here (coordinator
    //     hardening, 22 Nov 2026, test o13).
    //   UPDATE, Moderator/Admin — content + status/reviewStatus
    //     (publish/return/reject) + the verifier fields, under the
    //     second-eye rule (jobContentSecondEye): verifiedBy is never
    //     the author, and publishing requires a real verifier plus a
    //     verification timestamp. Unlike jobExams there is no
    //     rulesConfig to protect, so no Rule A / Rule B split for the
    //     EXPRESSION budget was needed — a single Moderator/Admin
    //     update rule stays well inside it (measured by the Step 6
    //     rules tests). The split that DOES exist is a PERMISSION
    //     split, mirroring Step 5 P0-4: a Moderator may return or
    //     unpublish a Published doc (status/reviewStatus/verifier
    //     fields only) but may NOT silently edit its content; an
    //     Admin may edit published content too.
    //   Provenance (authorId / createdBy / createdAt) is immutable —
    //     even for Admin: it is outside all update rules'
    //     affected-keys allowlists. Parent refs and (for lessons)
    //     lessonType are pinned the same way.
    //   DELETE — Admin only.
    //   Lesson types (Step 3 §2.6): the enum has five values, but
    //     Step 6 create allows ONLY 'lesson' — viva-question /
    //     viva-guide / career-guide / cv-guide content is Step 16.
    //     lessonType is pinned on update, so a 'lesson' doc cannot be
    //     converted into Step 16 content by an update either.
    // jobSubjects / jobChapters / jobTopics / jobLessons share one
    // structure (compaction 24 Nov 2026): one wildcard match with a
    // collection guard. The guard is load-bearing — no other
    // top-level collection is granted anything here — and the
    // BRT-08 drift test parses it. The per-collection differences
    // (validator, key lists, create actor, ID/parent checks) live in
    // the jobContent* dispatchers; each allow below is the exact
    // conjunction the four separate blocks enforced. Notes carried
    // over: subjects are canonical metadata (Admin-only create, one
    // of the 23 IDs, slug agrees with the doc ID); a Moderator may
    // return/unpublish a Published doc but may NOT silently edit its
    // content (P0-4 published-content guard); an Admin may fix a typo
    // in a Published doc without unpublishing it first.
    function validJobContent(coll, d) {
      return coll == 'jobSubjects' ? validJobSubject(d)
        : coll == 'jobChapters' ? validJobChapter(d)
        : coll == 'jobTopics' ? validJobTopic(d)
        : validJobLesson(d);
    }
    function jobContentTeacherKeys(coll) {
      return coll == 'jobSubjects' ? ['nameBn', 'nameEn', 'order', 'marks', 'syllabusSource', 'reviewStatus', 'updatedAt']
        : coll == 'jobChapters' ? ['nameBn', 'nameEn', 'descriptionBn', 'descriptionEn', 'order', 'reviewStatus', 'updatedAt']
        : coll == 'jobTopics' ? ['nameBn', 'nameEn', 'order', 'isCommon', 'commonExams', 'commonStatus', 'questionTarget', 'reviewStatus', 'updatedAt']
        : ['titleBn', 'titleEn', 'body', 'bodyEn', 'order', 'reviewStatus', 'updatedAt'];
    }
    function jobContentModKeys(coll) {
      return coll == 'jobSubjects' ? ['nameBn', 'nameEn', 'order', 'marks', 'syllabusSource', 'status', 'reviewStatus', 'verifiedBy', 'verifiedAt', 'updatedAt']
        : coll == 'jobChapters' ? ['nameBn', 'nameEn', 'descriptionBn', 'descriptionEn', 'order', 'status', 'reviewStatus', 'verifiedBy', 'verifiedAt', 'updatedAt']
        : coll == 'jobTopics' ? ['nameBn', 'nameEn', 'order', 'isCommon', 'commonExams', 'commonStatus', 'questionTarget', 'publishedQuestionCount', 'status', 'reviewStatus', 'verifiedBy', 'verifiedAt', 'updatedAt']
        : ['titleBn', 'titleEn', 'body', 'bodyEn', 'order', 'status', 'reviewStatus', 'verifiedBy', 'verifiedAt', 'updatedAt'];
    }
    function jobContentIdOk(coll, docId, d) {
      return coll == 'jobSubjects'
        ? (docId in canonicalJobSubjectIds()
           && docId.matches('^' + d.get('examSlug', '') + '__[a-z0-9-]+$')
           && (d.get('slug', null) == null || docId == d.get('examSlug', '') + '__' + d.get('slug', '')))
        : coll == 'jobChapters'
        ? (docId.matches('^' + d.get('subjectId', '') + '__[a-z0-9-]+$')
           && d.get('subjectId', '').matches('^' + d.get('examSlug', '') + '__[a-z0-9-]+$')
           && exists(/databases/$(database)/documents/jobSubjects/$(d.get('subjectId', ''))))
        : coll == 'jobTopics'
        ? (docId.matches('^' + d.get('chapterId', '') + '__[a-z0-9-]+$')
           && d.get('subjectId', '').matches('^' + d.get('examSlug', '') + '__[a-z0-9-]+$')
           && d.get('chapterId', '').matches('^' + d.get('subjectId', '') + '__[a-z0-9-]+$')
           && exists(/databases/$(database)/documents/jobChapters/$(d.get('chapterId', ''))))
        : (d.get('lessonType', '') == 'lesson'
           && d.get('subjectId', '').matches('^' + d.get('examSlug', '') + '__[a-z0-9-]+$')
           && d.get('chapterId', '').matches('^' + d.get('subjectId', '') + '__[a-z0-9-]+$')
           && d.get('topicId', '').matches('^' + d.get('chapterId', '') + '__[a-z0-9-]+$')
           && exists(/databases/$(database)/documents/jobTopics/$(d.get('topicId', ''))));
    }
    match /{jobColl}/{docId} {
      allow read: if jobColl.matches('^job(Subjects|Chapters|Topics|Lessons)$')
        && (signedIn() && resource.data.get('status', '') == 'published'
        || (signedIn() && resource.data.get('authorId', '') == uid())
        || isModerator());
      allow create: if jobColl.matches('^job(Subjects|Chapters|Topics|Lessons)$')
        && (jobColl == 'jobSubjects' ? isAdmin() : isVerifiedJobBankAuthor())
        && jobContentCreateCommon(request.resource.data)
        && validJobContent(jobColl, request.resource.data)
        && jobContentIdOk(jobColl, docId, request.resource.data);
      // One combined update (compaction 24 Nov 2026, expression-limit
      // fix): the teacher / moderator / admin rules were three separate
      // allows, each re-evaluating the collection guard — and the guard
      // is evaluated for EVERY top-level write, because this wildcard
      // match also matches jobQuestions (whose moderator-publish path
      // sits ~30 expressions under Firestore's 1000-expression limit).
      // Each disjunct is the full original condition minus the shared
      // guard + validJobContent (evaluated once, after the disjunction);
      // the moderator keeps the published-content guard, the admin does
      // not — semantics unchanged, verified by the emulator suite.
      allow update: if jobColl.matches('^job(Subjects|Chapters|Topics|Lessons)$')
        && ((jobTeacherDraftUpdate()
             && changedKeys().hasOnly(jobContentTeacherKeys(jobColl)))
            || (isModerator()
                && changedKeys().hasOnly(jobContentModKeys(jobColl))
                && (resource.data.get('status', '') != 'published'
                    || changedKeys().hasOnly(reviewKeys()))
                && jobContentChecks())
            || (isAdmin()
                && changedKeys().hasOnly(jobContentModKeys(jobColl))
                && jobContentChecks()))
        && validJobContent(jobColl, request.resource.data);
      allow delete: if jobColl.matches('^job(Subjects|Chapters|Topics|Lessons)$')
        && isAdmin();
    }


    // ---------- Step 9: full exam + model tests (jobExamDefinitions) ----------
    // jobExamDefinitions — the mock definition (Step 3 §2.10's
    // `jobMocks`, renamed by the ChatGPT fold-in to ChatGPT's
    // jobExamDefinitions name). One doc per mock event: full
    // (doc-ID `full__{examSlug}__{n}`), daily (doc-ID
    // `daily__{YYYY-MM-DD}`), weekly (doc-ID `weekly__{YYYY-Www}`).
    // The rulesSnapshot is the exam-pattern copy taken at creation —
    // a later rulesConfig change never changes a running mock's
    // rules, and a published mock's snapshot is frozen (correct it
    // by unpublishing first, or make a new mock). Published mocks
    // are PUBLIC catalog metadata (anyone may read them — title /
    // schedule / pattern, no answers), like the Step 6 decision that
    // subject names + marks stay public; STARTING a mock still needs
    // sign-in (the session/attempt rules). No get() calls here.
    // Doc-ID patterns (enforced at create): daily == 'daily__' +
    // scheduleDate; weekly matches ^weekly__YYYY-Www$; full matches
    // ^full__{examSlug}__N$. The bare mockId a session/attempt
    // carries is the date / weekId / full__{examSlug}__{n} (see
    // jobMocks.ts) — the bundle's mockId must equal it (Step 8
    // rule: bundle.mockId == attempt.mockId).
    // Daily standard (ChatGPT §1(d) + the Step 9 brief): a daily
    // mock is 20–30 MCQ in 20–30 minutes (editorial standard 25Q /
    // 25min); the weekly mock is the FULL length of the rotated
    // pattern (BCS 200Q/120min, Bank 100Q/60min, Primary 90Q/90min,
    // NTRCA 100Q/60min). The definition points at its CURRENT
    // question-set manifest (questionSetId) — new sessions use it;
    // running sessions keep their stored questionSetId.
    function validJobExamDefinitionRulesSnapshot(s, kind) {
      return s is map
        && isIntRange(s, 'questionCount', 1, 200)
        && isIntRange(s, 'timeMinutes', 1, 600)
        && (kind != 'daily'
            || (s.get('questionCount', 0) >= 20 && s.get('questionCount', 0) <= 30
                && s.get('timeMinutes', 0) >= 20 && s.get('timeMinutes', 0) <= 30))
        && s.get('marksPerQuestion', null) == 1
        && (s.get('negativeMarking', null) == null
            || s.get('negativeMarking', null) == 0
            || s.get('negativeMarking', null) == 0.25
            || s.get('negativeMarking', null) == 0.5)
        && s.get('negativeMarkingVerified', null) is bool
        && (s.get('passPercent', null) == null
            || (isNumRange(s, 'passPercent', 0, 100)))
        && isStrF(s, 'scoringConfigVersion', 100);
    }
    function validJobExamDefinition(d, mockId) {
      return jobExamSlugOk(d)
        && isStrF(d, 'titleBn', 200)
        && isStrF(d, 'titleEn', 200)
        && d.get('kind', null) in ['daily', 'weekly', 'full']
        && isStrF(d, 'bundleId', 200)
        && isStrF(d, 'questionSetId', 200)
        && validJobExamDefinitionRulesSnapshot(d.get('rulesSnapshot', null), d.get('kind', null))
        && ((d.get('kind', null) == 'daily'
              && isStrType(d, 'scheduleDate')
              && mockId == 'daily__' + d.get('scheduleDate', ''))
            || (d.get('kind', null) == 'weekly'
              && isStrType(d, 'scheduleDate')
              && mockId.matches('^weekly__[0-9]{4}-W[0-9]{2}$'))
            || (d.get('kind', null) == 'full'
              && d.get('scheduleDate', null) == null
              && mockId.matches('^full__' + d.get('examSlug', '') + '__[0-9]+$')))
        && ((d.get('kind', null) == 'weekly'
              && d.get('examSlugCycle', null) in ['bcs', 'bank', 'primary-teacher', 'ntrca'])
            || (d.get('kind', null) != 'weekly' && d.get('examSlugCycle', null) == null))
        && d.get('status', null) in ['draft', 'published', 'archived']
        && d.get('retakeAllowed', null) is bool
        && isOptPosInt(d, 'maxAttempts')
        && (isOptTs(d, 'publishedAt'))
        && (isOptStrNoMax(d, 'publishedBy'))
        && (isOptTs(d, 'createdAt'))
        && (isOptTs(d, 'updatedAt'));
    }
    match /jobExamDefinitions/{mockId} {
      allow read: if resource.data.get('status', '') == 'published' || isModerator();
      allow create: if isModerator()
        && onlyKeys(['examSlug', 'titleBn', 'titleEn',
             'kind', 'bundleId', 'questionSetId', 'rulesSnapshot', 'scheduleDate', 'examSlugCycle',
             'status', 'retakeAllowed', 'maxAttempts', 'publishedAt', 'publishedBy',
             'createdAt', 'updatedAt'])
        && request.resource.data.get('status', '') == 'draft'
        && validJobExamDefinition(request.resource.data, mockId);
      // Update: a DRAFT mock edits freely (same validity as create);
      // a PUBLISHED mock's rules are frozen — only titles, status,
      // retake policy, the CURRENT manifest pointer (questionSetId)
      // and publish metadata move (a correction needs unpublish
      // first, or a new mock — and a manifest change only affects
      // NEW sessions; running sessions keep their stored
      // questionSetId); an ARCHIVED mock reopens only back to
      // draft. Status moves: draft -> published / archived;
      // published -> archived; archived -> draft.
      allow update: if isModerator()
        && onlyKeys(['examSlug', 'titleBn', 'titleEn',
             'kind', 'bundleId', 'questionSetId', 'rulesSnapshot', 'scheduleDate', 'examSlugCycle',
             'status', 'retakeAllowed', 'maxAttempts', 'publishedAt', 'publishedBy',
             'createdAt', 'updatedAt'])
        && validJobExamDefinition(request.resource.data, mockId)
        && ((resource.data.get('status', '') == 'draft'
              && request.resource.data.get('status', '') in ['draft', 'published', 'archived'])
            || (resource.data.get('status', '') == 'published'
              && request.resource.data.get('status', '') in ['published', 'archived']
              && changedKeys()
                   .hasOnly(['titleBn', 'titleEn', 'status', 'retakeAllowed',
                             'maxAttempts', 'questionSetId', 'publishedAt', 'publishedBy', 'updatedAt']))
            || (resource.data.get('status', '') == 'archived'
              && request.resource.data.get('status', '') in ['archived', 'draft']));
      allow delete: if isAdmin();
    }
    // ---------- Step 9: question-set manifests (jobQuestionSetManifests) ----------
    // The frozen question set for one mock generation (ChatGPT
    // §1(f)). One doc per manifest version: questionSetId, e.g.
    // `full__bcs__1_v1`. It carries ONLY the question references
    // (bundleId + n + questionId, in exam order) — the same shape
    // the exam session stores — so the session-create rule can
    // validate the whole set by whole-equality (the only loop-free
    // way to check 200 refs in rules). The BUNDLE holds the
    // question text/options for display; the MANIFEST is the
    // rules' authority for what the exam contains. A published
    // manifest is immutable: to correct it, unpublish, edit as a
    // draft, republish as a NEW version (new questionSetId), and
    // point the definition at it — running sessions keep their
    // stored questionSetId and are unaffected.
    function validJobQuestionSetManifest(d) {
      return jobExamSlugOk(d)
        && isStrF(d, 'mockId', 200)
        && isPosInt(d, 'version')
        && isIntRange(d, 'questionCount', 1, 200)
        && isListType(d, 'questionRefs')
        && d.get('questionRefs', []).size() == d.get('questionCount', 0)
        && isStrF(d, 'markingSchemeVersion', 100)
        && d.get('status', null) in ['draft', 'published', 'archived']
        && (isOptTs(d, 'publishedAt'))
        && (isOptStrNoMax(d, 'publishedBy'))
        && (isOptTs(d, 'createdAt'))
        && (isOptTs(d, 'updatedAt'));
    }
    match /jobQuestionSetManifests/{questionSetId} {
      allow read: if resource.data.get('status', '') == 'published' || isModerator();
      allow create: if isModerator()
        && onlyKeys(['examSlug', 'mockId', 'version',
             'questionCount', 'questionRefs', 'markingSchemeVersion', 'status',
             'publishedAt', 'publishedBy', 'createdAt', 'updatedAt'])
        && request.resource.data.get('status', '') == 'draft'
        && validJobQuestionSetManifest(request.resource.data);
      allow update: if isModerator()
        && onlyKeys(['examSlug', 'mockId', 'version',
             'questionCount', 'questionRefs', 'markingSchemeVersion', 'status',
             'publishedAt', 'publishedBy', 'createdAt', 'updatedAt'])
        && validJobQuestionSetManifest(request.resource.data)
        && ((resource.data.get('status', '') == 'draft'
              && request.resource.data.get('status', '') in ['draft', 'published', 'archived'])
            || (resource.data.get('status', '') == 'published'
              && request.resource.data.get('status', '') in ['published', 'archived']
              && changedKeys()
                   .hasOnly(['status', 'publishedAt', 'publishedBy', 'updatedAt']))
            || (resource.data.get('status', '') == 'archived'
              && request.resource.data.get('status', '') in ['archived', 'draft']));
      allow delete: if isAdmin();
    }
    // ---------- Step 9: exam user locks (jobExamUserLocks) ----------
    // One active exam session per user per exam pattern (ChatGPT
    // H.7). Doc-ID `{uid}_{examSlug}`. The lock is created
    // ATOMICALLY with the exam session (one client batch) and
    // released ATOMICALLY with the session's terminal transition
    // (submit/abandon batch). A second session while one is active
    // is denied (the stored lock is in_progress and fresh); a new
    // session after submit/abandon is allowed (lock terminal); a
    // crashed session's lock goes STALE 15 minutes after the exam's
    // deadline (createdAt + durationSeconds + 900s) — staleness is
    // the crash backstop, so a student is never locked out forever
    // by a tab that died mid-exam. durationSeconds is verified
    // against the definition's frozen duration (the lock carries
    // the definitionId) — a client cannot shorten its own lock to
    // go stale early. The lock does NOT rate-limit globally and
    // does NOT prove one attempt per exam per student (a student
    // who finishes one exam may start another — retakes are a
    // policy of the definition's retakeAllowed/maxAttempts, not
    // of the lock).
    // Budget note (same as validJobExamSessionCreate): the
    // definition is fetched ONCE in the match below and passed in
    // as a plain map (def). The lock create does NOT verify the
    // session: the rules engine cannot read a session doc's fields
    // from a lock-create evaluation (verified empirically 22 Nov,
    // scratch a5–a5v — the same getAfter read SUCCEEDS from the
    // lock-update and session-create evaluations, but ERRORS from
    // the lock-create one). The binding is enforced where it
    // matters instead — the SESSION create (validJobExamSession-
    // Create) requires the post-batch lock to point at it — and a
    // lock without a session only strands its own creator until
    // the stale-lock recovery below.
    function validJobExamUserLock(d, lockId, def) {
      return d.keys().hasOnly(['uid', 'examSlug', 'mockId', 'definitionId',
             'activeSessionId', 'status', 'durationSeconds', 'createdAt', 'updatedAt'])
        && d.keys().hasAll(['uid', 'examSlug', 'mockId', 'definitionId',
             'activeSessionId', 'status', 'durationSeconds', 'createdAt', 'updatedAt'])
        && d.get('uid', '') == uid()
        && lockId == uid() + '_' + d.get('examSlug', '')
        && d.get('examSlug', null) in jobExamSlugs()
        && isStrType(d, 'mockId') && d.get('mockId', '').size() > 0
        && isStrType(d, 'definitionId') && d.get('definitionId', '').size() > 0
        && isStrType(d, 'activeSessionId') && d.get('activeSessionId', '').size() > 0
        && d.get('status', '') == 'in_progress'
        && isIntRange(d, 'durationSeconds', 60, 7200)
        && isTsType(d, 'createdAt')
        && d.get('createdAt', null) <= request.time
        && d.get('createdAt', null) > request.time - duration.value(5, 'm')
        && isTsType(d, 'updatedAt')
        && def.get('status', null) == 'published'
        && def.get('rulesSnapshot', null) is map
        && def.get('rulesSnapshot', null).get('timeMinutes', null) is int
        && d.get('durationSeconds', 0)
             == def.rulesSnapshot.timeMinutes * 60
        && def.get('examSlug', null) == d.get('examSlug', null);
    }
    // The stored lock behind a create/re-arm check, fetched once
    // by the caller and checked as a plain map: a live lock is
    // releasable only when terminal or stale (past createdAt +
    // duration + 15 min grace).
    function jobExamUserLockIsReleasable(lock) {
      return lock.status == 'terminal'
        || request.time > lock.createdAt
             + duration.value(lock.durationSeconds, 's')
             + duration.value(15, 'm');
    }
    match /jobExamUserLocks/{lockId} {
      allow read: if (signedIn() && resource.data.get('uid', '') == uid()) || isModerator();
      // The definition is fetched ONCE here and passed in
      // (budget note on validJobExamUserLock): the exists-guard
      // short-circuits before the definition get(), so a missing
      // definition denies cleanly.
      allow create: if signedIn() && callerActive()
        && exists(/databases/$(database)/documents/jobExamDefinitions/$(request.resource.data.get('definitionId', '')))
        && validJobExamUserLock(request.resource.data, lockId,
             jobExamDefinitionData(request.resource.data.get('definitionId', '')))
        // No live lock may already exist for this pattern: the
        // stored lock must be absent, terminal, or stale
        // (past createdAt + duration + 15 min grace).
        && (!exists(/databases/$(database)/documents/jobExamUserLocks/$(lockId))
            || jobExamUserLockIsReleasable(get(/databases/$(database)/documents/jobExamUserLocks/$(lockId)).data));
      // Release: in_progress -> terminal ONLY, and ONLY together
      // with the session's terminal transition (the post-batch
      // session must be submitted or abandoned — a lock released
      // while its session is still in progress would let the
      // student start a second concurrent exam).
      // Re-arm (Step 9 fold-in fix, 22 Nov): a TERMINAL lock — or
      // a STALE in_progress lock (past createdAt + duration +
      // 15 min grace) — may be re-armed for a NEW session. Without
      // this, setDoc on the existing lock doc is an UPDATE, and
      // the student could never start a second exam for the
      // pattern (the create rule's stale escape only applies when
      // the doc does not exist at all). The new doc must pass the
      // FULL lock validator (fresh createdAt, duration ==
      // definition duration, published definition); a LIVE
      // in_progress lock can never be re-armed. The session
      // binding is enforced at session create (the post-batch
      // lock must point at the new session).
      allow update: if signedIn() && callerActive()
        && resource.data.get('uid', '') == uid()
        && ((changedKeys().hasOnly(['status', 'updatedAt'])
             && resource.data.get('status', '') == 'in_progress'
             && request.resource.data.get('status', '') == 'terminal'
             && getAfter(/databases/$(database)/documents/users/$(uid())/jobExamSessions/$(resource.data.get('activeSessionId', ''))).data.status in ['submitted', 'abandoned'])
            || ((resource.data.get('status', '') == 'terminal'
                 || (resource.data.get('status', '') == 'in_progress'
                     && isTsType(resource.data, 'createdAt')
                     && isIntType(resource.data, 'durationSeconds')
                     && request.time > resource.data.get('createdAt', null)
                          + duration.value(resource.data.get('durationSeconds', 0), 's')
                          + duration.value(15, 'm')))
                && exists(/databases/$(database)/documents/jobExamDefinitions/$(request.resource.data.get('definitionId', '')))
                && validJobExamUserLock(request.resource.data, lockId,
                     jobExamDefinitionData(request.resource.data.get('definitionId', '')))));
      allow delete: if false;
    }

    // ---------- Step 7: question bank + verification ----------
    // jobQuestions — the bank record. Students can NEVER read it:
    // there is deliberately NO student read rule here, so a UI bug
    // cannot leak correct answers or explanations. A verified
    // teacher reads only their OWN questions; Moderator/Admin read
    // all. The verification queue is a query (reviewStatus ==
    // 'Under Review'), not a collection — see lib
    // jobReviewQueueConstraints() (no admin UI until Step 15).
    match /jobQuestions/{questionId} {
      allow read: if isModerator()
        || (isTeacher() && resource.data.get('authorId', '') == uid());
      // Create: verified teacher only, draft only — and ONLY
      // the fields the app writes (Step 7 fold-in, ChatGPT P1-03:
      // no smuggled privileged/junk fields at creation). The
      // list is the UNION of the v1 and v2 (Central Bank) key
      // sets; validJobQuestion() dispatches on 'questionId' and
      // each branch rejects the other shape's marker fields, so
      // a mixed-shape doc cannot be created.
      allow create: if isVerifiedJobBankAuthor()
        && onlyKeys(['examSlug', 'subjectId',
             'chapterId', 'topicId', 'questionText', 'options',
             'correctLetter', 'explanation', 'whyWrong', 'difficulty',
             'isPreviousYear', 'examYear', 'source', 'sourceUrl',
             'status', 'reviewStatus', 'reviewerId', 'verifiedBy',
             'verifiedAt', 'rejectionReason', 'duplicateHash',
             'duplicateOf', 'bundleId', 'version', 'configVersion',
             'authorId', 'createdBy', 'createdAt', 'updatedAt',
             'questionId', 'question', 'correctAnswer',
             'examMappings', 'syllabusMappings', 'verificationStatus',
             'isActive', 'origin', 'tags', 'passageId',
             'duplicateHashV2', 'stemHash', 'duplicateCandidates',
             'duplicateReview', 'legacyId', 'schemaVersion',
             'subtopicId', 'questionType', 'reviewContentPassed'])
        && jobQuestionCreateCommon(request.resource.data)
        && validJobQuestion(request.resource.data);
      // Author: own draft only, content fields only, may submit
      // (Not Started/In Progress -> Under Review). Never publish,
      // never verify, never touch a non-draft doc.
      allow update: if isVerifiedJobBankAuthor()
        && resource.data.get('authorId', '') == uid()
        && resource.data.get('status', '') == 'draft'
        && request.resource.data.get('status', '') == 'draft'
        && resource.data.get('reviewStatus', '') in ['Not Started', 'In Progress']
        && request.resource.data.get('reviewStatus', '') in ['Not Started', 'In Progress', 'Under Review']
        && changedKeys()
             .hasOnly(['questionText', 'options', 'correctLetter',
                       'explanation', 'whyWrong', 'difficulty', 'source',
                       'sourceUrl', 'examYear', 'isPreviousYear',
                       'duplicateHash', 'duplicateOf', 'reviewStatus', 'updatedAt',
                       'question', 'correctAnswer', 'examMappings',
                       'syllabusMappings', 'origin', 'tags', 'passageId',
                       'duplicateHashV2', 'stemHash', 'duplicateCandidates',
                       'subtopicId', 'questionType'])
        && request.resource.data.get('version', 0) == resource.data.get('version', 0)
        && validJobQuestion(request.resource.data);
      // Moderator/Admin: verification + publication under the
      // second-eye rule + the transition guard (no direct draft ->
      // published, rejection needs a reason, version +1 on
      // published -> draft return).
      allow update: if isModerator()
        && changedKeys()
             .hasOnly(['questionText', 'options', 'correctLetter',
                       'explanation', 'whyWrong', 'difficulty', 'source',
                       'sourceUrl', 'examYear', 'isPreviousYear',
                       'duplicateHash', 'duplicateOf', 'bundleId',
                       'status', 'reviewStatus', 'reviewerId',
                       'verifiedBy', 'verifiedAt', 'rejectionReason',
                       'version', 'updatedAt',
                       'question', 'correctAnswer', 'examMappings',
                       'syllabusMappings', 'verificationStatus',
                       'isActive', 'origin', 'tags', 'passageId',
                       'duplicateHashV2', 'stemHash', 'duplicateCandidates',
                       'duplicateReview', 'legacyId', 'schemaVersion',
                       'subtopicId', 'questionType', 'reviewContentPassed'])
        && jobQuestionSecondEye(resource.data, request.resource.data)
        && jobQuestionTransition(resource.data, request.resource.data)
        && validJobQuestion(request.resource.data);
      allow delete: if isAdmin();
    }
    // jobQuestionBundles — the student tier: questions + options
    // ONLY. Any key material (correctLetter / explanation /
    // correctText) in the doc is refused outright, at the top level
    // (§3.6). Bundle IDs are deterministic: topic__{topicId} /
    // mock__{mockId} / daily__{date} / weekly__{weekId} /
    // previous__{examSlug}__{year}; the topic/mock/daily/weekly
    // patterns are enforced here, 'previous' in the lib (rules
    // cannot convert the year int to a string).
    // validJobQuestionBundleCreate(d, bundleId) — compaction 27 Nov 2026: the create allow below, extracted verbatim with request.resource.data -> d (pure substitution; semantics identical).
    function validJobQuestionBundleCreate(d, bundleId) {
      return isModerator()
        && !('correctLetter' in d)
        && !('explanation' in d)
        && !('correctText' in d)
        && (d.get('kind', '') != 'topic'
            || bundleId == 'topic__' + d.get('topicId', ''))
        && (d.get('kind', '') != 'mock'
            || bundleId == 'mock__' + d.get('mockId', ''))
        && (d.get('kind', '') != 'daily'
            || bundleId == 'daily__' + d.get('mockId', ''))
        && (d.get('kind', '') != 'weekly'
            || bundleId == 'weekly__' + d.get('mockId', ''))
        && onlyKeys(['kind', 'examSlug',
             'topicId', 'mockId', 'year', 'titleBn', 'titleEn',
             'questions', 'questionCount', 'status', 'reviewStatus',
             'publishedAt', 'publishedBy', 'sourceQuestionIds',
             'configVersion', 'bundleVersion', 'createdAt', 'updatedAt'])
        && validJobQuestionBundle(d);
    }
    // validJobQuestionBundleUpdate(d, old, bundleId) — compaction 27 Nov 2026: the update allow below, extracted verbatim with request.resource.data -> d and resource.data -> old (pure substitution; semantics identical).
    function validJobQuestionBundleUpdate(d, old, bundleId) {
      return isModerator()
        && !('correctLetter' in d)
        && !('explanation' in d)
        && !('correctText' in d)
        && (d.get('kind', '') != 'topic'
            || bundleId == 'topic__' + d.get('topicId', ''))
        && (d.get('kind', '') != 'mock'
            || bundleId == 'mock__' + d.get('mockId', ''))
        && (d.get('kind', '') != 'daily'
            || bundleId == 'daily__' + d.get('mockId', ''))
        && (d.get('kind', '') != 'weekly'
            || bundleId == 'weekly__' + d.get('mockId', ''))
        && validJobQuestionBundle(d)
        && (old.get('status', '') != 'published'
            || changedKeys()
                 .hasOnly(['titleBn', 'titleEn', 'status', 'reviewStatus',
                           'publishedAt', 'publishedBy', 'updatedAt']));
    }
    match /jobQuestionBundles/{bundleId} {
      allow read: if (signedIn() && resource.data.get('status', '') == 'published')
        || isModerator();
      allow create: if validJobQuestionBundleCreate(request.resource.data, bundleId);
      // Update: a PUBLISHED bundle is content-frozen (Step 7
      // fold-in, ChatGPT P1-06) — its questions are the snapshot
      // live attempts were scored against, so questions /
      // sourceQuestionIds / questionCount / kind / examSlug /
      // topicId / mockId / year / configVersion cannot change while
      // published; only titles, status/reviewStatus and publish
      // metadata move. To correct a published bundle, unpublish it
      // first (status draft), edit as a draft, republish. A draft
      // bundle edits freely (same conditions as create).
      allow update: if validJobQuestionBundleUpdate(request.resource.data, resource.data, bundleId);
      allow delete: if isAdmin();
    }

    // ---------- Central Bank new collections (design §6.4) ----------
    // jobPassages — shared reading passages (§1.4/§5.3). Content,
    // not answers: any signed-in user may read (the bundle render
    // joins passageId at display time); only Moderators write.
    match /jobPassages/{passageId} {
      allow read: if signedIn();
      allow create, update: if isModerator()
        && isStr(request.resource.data.text, 5000)
        && request.resource.data.questionIds is list
        && onlyKeys(['text', 'questionIds', 'createdAt', 'updatedAt']);
      allow delete: if isAdmin();
    }
    // jobExamSelectionRules — per-exam selection config (§3.3),
    // copied from the verified JOB_RULES_CONFIGS. Readable by any
    // signed-in user (the weights are public exam information);
    // written by Moderators only. The weights-sum check (= the
    // exam's questionCount) is unimplementable in rules language
    // — the lib (jobBankSelection.ts) enforces it and the
    // migration test cross-checks seed == lib.
    match /jobExamSelectionRules/{examId} {
      allow read: if signedIn();
      allow create, update: if isModerator()
        && (request.resource.data.totalQuestions == null
            || (request.resource.data.totalQuestions is int
                && request.resource.data.totalQuestions >= 1))
        && request.resource.data.durationMinutes is int
        && request.resource.data.negativeMarking is number
        && request.resource.data.subjectWeights is list
        && request.resource.data.verificationStatus in ['verified', 'last-verified', 'draft']
        && isStr(request.resource.data.syllabusVersion, 200)
        && isStr(request.resource.data.scoringConfigVersion, 200);
      allow delete: if isAdmin();
    }
    // examQuestionPools — selection aid, NOT source of truth
    // (§3.5). Written by the migration/selection scripts via the
    // Admin SDK only: NO client write is allowed here, ever.
    // Moderators may read a pool for debugging.
    match /examQuestionPools/{poolId} {
      allow read: if isModerator();
      allow create, update, delete: if false;
    }
    // jobQuestionBankStats / jobBankCoverage / topicAnalytics —
    // precomputed quality metrics (§7). Written by scripts via
    // the Admin SDK only: no client write. Readable by any
    // signed-in user (dashboards show them).
    match /jobQuestionBankStats/{statId} {
      allow read: if signedIn();
      allow create, update, delete: if false;
    }
    match /jobBankCoverage/{rowId} {
      allow read: if signedIn();
      allow create, update, delete: if false;
    }
    match /topicAnalytics/{topicId} {
      allow read: if signedIn();
      allow create, update, delete: if false;
    }
    // historicalQuestions — the verified previous-year store
    // (§6.3). A student reads ONLY a Verified record; Moderators
    // read all. Writes are Moderator only (Admin-SDK import).
    // The auditTrail is append-only by lib convention
    // (appendHistoricalAuditTrail) — rules cannot prove list
    // growth without iteration, so the trail is NOT enforced
    // here; deletes are Admin only.
    match /historicalQuestions/{historicalId} {
      allow read: if isModerator()
        || (signedIn() && callerActive()
            && resource.data.get('verificationStatus', '') == 'Verified');
      allow create, update: if isModerator()
        && request.resource.data.verificationStatus in ['Verified', 'Partially verified', 'Unverified']
        && isStr(request.resource.data.sourceReference, 500);
      allow delete: if isAdmin();
    }

    // ---------- job written system + 11–20 configs (24 Nov 2026,
    // design §2.7/§1.4) — COMPACT by design: the compiled-rules
    // margin was ~100 bytes at Step 17, so these blocks carry only
    // the load-bearing checks (owner-only submissions, no update
    // ever, published-only reads, moderator writes). The lib
    // validators (jobWritten.ts / jobWrittenContent.ts) enforce the
    // field-level rules the rules language cannot afford.
    // writtenQuestions — students read Published only; Moderators
    // read/write (second-eye + version+1 are lib + admin-UI
    // enforced; a Published doc needs reviewStatus 'Published').
    match /writtenQuestions/{questionId} {
      allow read: if isModerator()
        || (signedIn() && callerActive()
            && resource.data.get('status', '') == 'published');
      allow create, update: if isModerator()
        && request.resource.data.status in ['draft', 'published']
        && request.resource.data.reviewStatus in ['Not Started', 'In Progress', 'Under Review', 'Published', 'Rejected', 'Archived'];
      allow delete: if isAdmin();
    }
    // writtenSubmissions — IMMUTABLE: create-only, never update.
    // Only the owner reads their own writing (Moderators read for
    // the teacher-review path). No submission text leaves the
    // device without the student's consent (client-enforced).
    match /writtenSubmissions/{submissionId} {
      allow read: if isModerator()
        || (signedIn() && resource.data.get('uid', '') == request.auth.uid);
      allow create: if signedIn() && callerActive()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status in ['submitted', 'self-checked'];
      allow update, delete: if false;
    }
    // writtenFeedback — one doc per feedback event, linked to the
    // exact immutable submission version. Owner reads their own
    // (uid on the doc); Moderators read/write; students create
    // 'self' feedback only.
    match /writtenFeedback/{feedbackId} {
      allow read: if isModerator()
        || (signedIn() && resource.data.get('uid', '') == request.auth.uid);
      allow create: if isModerator()
        || (signedIn() && callerActive()
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.evaluationType == 'self');
      allow update: if isModerator();
      allow delete: if isAdmin();
    }
    // modelTests — published tests are readable signed-in (a test
    // is published when publishedAt is set); Moderators write.
    match /modelTests/{modelTestId} {
      allow read: if isModerator()
        || (signedIn() && callerActive()
            && resource.data.get('publishedAt', null) != null);
      allow create, update: if isModerator();
      allow delete: if isAdmin();
    }
    // grade1120Configs — the verified 11–20 pattern configs
    // (§1.4). Signed-in read; Moderator writes (Admin-SDK import
    // in release 1 — configs enter only with their source checked).
    match /grade1120Configs/{configId} {
      allow read: if signedIn();
      allow create, update: if isModerator();
      allow delete: if isAdmin();
    }

    // ---------- job circulars (Step 14) ----------
    // Public read of PUBLISHED circulars only (lowercase
    // 'published' — the Job convention; do NOT use isPublished(),
    // which checks capital-'Published'); moderators read drafts
    // too. Moderators create/update within the §2.18 key
    // allowlist; reviewStatus is an enum, so a draft can never
    // read as published. applicationStatus is NOT stored — it is
    // computed client-side from applicationDeadline (§2.18 note).
    // applyUrl is the SEPARATE official application-portal link
    // (a circular PDF is not necessarily the apply destination —
    // no Apply button without a confirmed apply link).
    // deadlinePrecision 'date_only' | 'datetime' stops the UI
    // inventing a closing time when the notice gives only a date
    // (conservative: date-only deadlines close at end of day,
    // Asia/Dhaka).
    // Size trims (measured: the compiled-rules margin is ~1,132
    // bytes, and this block must fit inside it): no copyStatus
    // enum (UI falls back to 'link-only' for unknown values),
    // no lastCheckedAt (updatedAt is the last-checked display),
    // no delete rule — a wrong circular is unpublished via
    // reviewStatus='rejected'; delete comes with Step 15 admin.
    // No jobNotifications collection ships: the margin fits ONE
    // minimal block — notifications are derived client-side from
    // published circulars + mocks (src/lib/jobNotifications.ts).
    //
    // Step 15: delete lands here (Admin only — a wrongly created
    // doc is removed by the Admin, never by an editor; moderators
    // unpublish via reviewStatus='rejected'). Three new allowlist
    // keys: 'verificationChecklist' (one map — the 7 verification
    // checklist results + notes + checkedBy + checkedAt; shape is
    // enforced by the client validator, as with every other field
    // in this block), 'reviewNote' (the verifier's return reason, readable
    // by the editor on the doc — adminActions is owner-read-only,
    // so the note cannot live there), 'lastEditedBy' (who last
    // edited the doc — the no-self-approval check needs it).
    // Measured by release-create probe 23 Nov ~02:30: delete +
    // these 3 keys = +89 stripped bytes, PASSES (compiled margin
    // after them ≈ 100 bytes). The four new Step 15 collections
    // below were DEPLOY-BLOCKED on that margin at the time — but
    // the public-ID refactor has since landed and Step 15 deployed
    // them live on 23 Nov 2026, so this note is history only.
    match /circulars/{circularId} {
      allow read: if resource.data.get('reviewStatus', '') == 'published' || isModerator();
      allow create, update: if isModerator()
        && onlyKeys(['examSlug', 'postTitleBn', 'postTitleEn', 'circularNumber', 'publishedDate', 'applicationDeadline', 'deadlinePrecision', 'totalPosts', 'eligibilitySummaryBn', 'eligibilitySummaryEn', 'officialUrl', 'applyUrl', 'copyStatus', 'copyTextExcerpt', 'reviewStatus', 'verifiedBy', 'verifiedAt', 'examDate', 'applicationStartDate', 'authorId', 'createdAt', 'updatedAt', 'verificationChecklist', 'reviewNote', 'lastEditedBy'])
        && request.resource.data.get('reviewStatus', '') in ['draft', 'in-review', 'verified', 'published', 'rejected'];
      allow delete: if isAdmin();
    }

    // ---------- Step 15 admin collections (DEPLOYED live 23 Nov 2026) ----------
    // These four blocks were written and emulator-verified in the
    // Step 15 branch but were deploy-blocked at the time: release-create
    // probes 23 Nov ~02:24 measured each one OVER the 256,000-byte
    // compiled limit on its own (jobReports 257,315; jobCorrections
    // 257,507; circularHistory 256,671; approvedDomains 256,328;
    // all four + the circulars delete = 260,502, i.e. 4,502 over).
    // Baseline compiled ≈ 255,791 (margin ≈ 209 bytes). The block
    // lifted once the public-ID rules refactor landed on main and
    // freed ~4,992 compiled bytes; Step 15 deployed these rules live
    // on 23 Nov 2026 (ruleset 6c0fb8af-4451-4b06-8a4a-3c1da1690f66).
    match /jobReports/{reportId} {
      allow read: if signedIn() && (resource.data.reporterId == uid() || isModerator());
      allow create: if signedIn() && callerActive()
        && request.resource.data.reporterId == uid()
        && request.resource.data.status == 'open'
        && request.resource.data.reason in ['wrong-answer', 'wrong-explanation', 'wrong-info', 'wrong-deadline', 'wrong-post-count', 'broken-link', 'new-extension', 'wrong-organization', 'duplicate', 'other']
        && request.resource.data.targetType in ['jobQuestion', 'jobLesson', 'jobCircular', 'jobMock']
        && request.resource.data.targetId is string
        && request.resource.data.targetAuthorId is string
        && isOptStr(request.resource.data.details, 2000)
        && onlyKeys(['reporterId', 'targetType', 'targetId', 'targetAuthorId', 'reason', 'details', 'suggestedValue', 'evidenceUrl', 'status', 'priority', 'resolvedBy', 'resolvedAt', 'resolutionNote', 'createdAt', 'updatedAt']);
      allow update: if isModerator()
        // k15a (Step 17, 23 Nov 2026): the decide update had NO
        // affectedKeys — a moderator deciding a report could rewrite
        // reporterId / targetId / targetAuthorId along the way.
        // Only the decide fields may change.
        && changedKeys()
             .hasOnly(['status', 'priority', 'resolvedBy', 'resolvedAt', 'resolutionNote', 'updatedAt'])
        && request.resource.data.status in ['open', 'investigating', 'resolved', 'dismissed'];
      allow delete: if false;
    }
    match /jobCorrections/{correctionId} {
      allow read: if signedIn() && (resource.data.requesterId == uid() || isModerator());
      allow create: if signedIn() && callerActive()
        && request.resource.data.requesterId == uid()
        && request.resource.data.status == 'pending'
        && request.resource.data.targetType in ['jobQuestion', 'jobLesson', 'jobCircular', 'jobMock']
        && isStr(request.resource.data.whatsWrong, 2000)
        && isStr(request.resource.data.proposedFix, 2000)
        && isStr(request.resource.data.source, 500)
        && onlyKeys(['requesterId', 'targetType', 'targetId', 'whatsWrong', 'proposedFix', 'source', 'status', 'decidedBy', 'decidedAt', 'decisionReason', 'createdAt', 'updatedAt']);
      allow update: if isModerator()
        && resource.data.status == 'pending'
        && request.resource.data.status in ['accepted', 'rejected']
        // k15b (Step 17, 23 Nov 2026): the decide update had NO
        // affectedKeys — a moderator deciding a correction could
        // rewrite whatsWrong / proposedFix / source along the way.
        // Only the decide fields may change.
        && changedKeys()
             .hasOnly(['status', 'decidedBy', 'decidedAt', 'decisionReason', 'updatedAt'])
        && request.resource.data.decidedBy == uid()
        && request.resource.data.decisionReason is string
        && request.resource.data.decisionReason.size() >= 10;
      allow delete: if false;
    }
    // Per-field audit trail for circulars (ChatGPT circularHistory):
    // one doc per sensitive change — never updated, never deleted.
    // The admin-action audit (who approved/published) already
    // lives in adminActions (job-content-* actions, zero new
    // rules); this collection is the FIELD-level trail a verifier
    // reads on the circular (what changed, old → new, from which
    // source). Gemini's subcollection jobCirculars/{id}/auditLogs
    // is ADAPTED to this top-level collection so the admin queue
    // can read recent changes across ALL circulars in one query.
    match /circularHistory/{historyId} {
      allow read: if isModerator();
      allow create: if isModerator()
        && onlyKeys(['circularId', 'fieldChanged', 'previousValue', 'newValue', 'sourceId', 'changedBy', 'changedAt', 'note'])
        && request.resource.data.fieldChanged in ['applicationDeadline', 'officialUrl', 'applyUrl', 'totalPosts', 'reviewStatus', 'examDate', 'applicationStartDate', 'duplicateOf', 'correctionOf', 'extensionOf', 'relatedTo']
        && request.resource.data.changedBy == uid()
        && request.resource.data.circularId is string
        && request.resource.data.changedAt is timestamp;
      allow update, delete: if false;
    }
    // Admin-managed approved official domains (ChatGPT; Gemini's
    // config/officialDomains single doc is ADAPTED to one doc per
    // domain so a domain can be added/deprecated without rewriting
    // a shared doc — the read cost is the same for the admin UI,
    // which loads the list once).
    match /approvedDomains/{domainId} {
      allow read: if isModerator();
      allow create, update: if isAdmin()
        && onlyKeys(['domain', 'organization', 'examSlugs', 'addedBy', 'createdAt', 'updatedAt', 'status'])
        && isStr(request.resource.data.domain, 200)
        && isStr(request.resource.data.organization, 200)
        // 'status' is optional on create (defaults to active);
        // setApprovedDomainStatus writes it on update (suspend =
        // soft action — history preserved, never hard-deleted).
        // The pre-compaction block omitted 'status' from hasOnly,
        // which would have denied every status write; fixed here
        // (Step 15 build, 23 Nov ~03:00) and re-measured.
        && request.resource.data.get('status', 'active') in ['active', 'watch', 'deprecated'];
      allow delete: if isAdmin();
    }

    // jobQuestionKeys — the answer key, one doc per bundle.
    // Moderator/Admin any time; a student only with a fresh
    // receipt anchored to a submitted attempt (hasFreshJobReceipt,
    // P0-06 — a 10-minute window, NOT one-use, see above) or for a
    // Published practice (topic) bundle (isPracticeJobBundle).
    // Mock keys are NEVER readable before submission.
    match /jobQuestionKeys/{bundleId} {
      // The receipt + bundle are fetched ONCE here and passed in
      // (same budget pattern as the attempt validators): the
      // exists-guards short-circuit before any get(), so a missing
      // doc denies cleanly instead of erroring the get.
      allow read: if isModerator()
        || (signedIn() && callerActive()
            && ((exists(/databases/$(database)/documents/jobReceipts/$(uid() + '_' + bundleId))
                 && exists(/databases/$(database)/documents/jobQuestionBundles/$(bundleId))
                 && hasFreshJobReceipt(bundleId, jobReceiptData(bundleId), jobBundleData(bundleId)))
                || (exists(/databases/$(database)/documents/jobQuestionBundles/$(bundleId))
                 && isPracticeJobBundle(jobBundleData(bundleId)))));
      // Create: Moderator only, and only against its own bundle
      // (Step 7 fold-in, ChatGPT P1-06 — the key answers exactly
      // the bundle's questions, same count and same configVersion,
      // so a key can never score a different bundle generation).
      allow create: if isModerator()
        && onlyKeys(['bundleId', 'answers',
             'configVersion', 'createdAt', 'updatedAt'])
        && validJobQuestionKey(request.resource.data, bundleId)
        && exists(/databases/$(database)/documents/jobQuestionBundles/$(bundleId))
        && jobKeyMatchesBundle(request.resource.data, bundleId,
             jobBundleData(bundleId));
      // Update: NEVER — a key is an immutable snapshot of its
      // bundle's answers. To correct a key, an Admin deletes it
      // and a Moderator recreates it (the bundle is republished
      // from the corrected question in the same flow).
      allow update: if false;
      allow delete: if isAdmin();
    }
    // jobReceipts — access grants (Eduvelto is 100% FREE; a receipt
    // is an access grant, never a payment record). ID is
    // `{uid}_{bundleId}`. Only the owning student creates their own
    // receipt, and only when it anchors to a real SUBMITTED attempt
    // for that bundle — or (Step 9, Design G) to a real SUBMITTED
    // mock session for that bundle (the scoring window) — on a
    // PUBLISHED bundle (P0-06 + Step 7 fold-in, ChatGPT P0-03). The receipt is a 10-minute window,
    // NOT one-use (P0-01 Option A). Step 9 closure (open question 1
    // — retakes): the window CAN be re-issued, but ONLY as an
    // anchored re-issue — an update whose new doc re-anchors to a
    // NEWLY submitted session/attempt for the SAME bundle with a
    // fresh createdAt. A student can never extend a window without
    // a new submission, and can never move a receipt to another
    // bundle or another student. Only an Admin deletes a receipt.
    // After a window closes with no new submission, the key stays
    // unreadable for that bundle. Stale receipts are harmless —
    // they simply stop opening keys.
    // ChatGPT fold-in (H.1, CRITICAL): the receipt carries a
    // PURPOSE — 'practice_review' or 'exam_review' — and a
    // bundleVersion bound to the anchor's generation. A practice
    // receipt anchors ONLY to a submitted PRACTICE attempt; an
    // exam receipt anchors ONLY to a submitted EXAM session (the
    // scoring window) or a submitted EXAM attempt. The key-read
    // rule (hasFreshJobReceipt) checks the purpose against the
    // bundle's kind, so a practice receipt can never unlock an
    // exam key. Never issue an exam receipt while the exam is in
    // progress: both exam anchors require status 'submitted'.
    // validJobReceiptCreate(d, receiptId) — compaction 27 Nov 2026: the create allow below, extracted verbatim with request.resource.data -> d (pure substitution; semantics identical).
    function validJobReceiptCreate(d, receiptId) {
      return signedIn() && callerActive()
        && receiptId == uid() + '_' + d.get('bundleId', '')
        && onlyKeys(['userId', 'bundleId',
             'attemptId', 'createdAt', 'purpose', 'bundleVersion'])
        && d.get('userId', '') == uid()
        && isStrType(d, 'bundleId')
        && d.get('bundleId', '').size() <= 200
        && isStrType(d, 'attemptId')
        && d.get('attemptId', '').size() <= 200
        && d.get('purpose', null) in ['practice_review', 'exam_review']
        && isPosInt(d, 'bundleVersion')
        // Trusted timestamp (P0-03): createdAt must be a real
        // timestamp no later than now and no older than 5 minutes
        // — a client cannot future-date a receipt to stretch its
        // window, nor backdate one to hide its age.
        && isTsType(d, 'createdAt')
        && d.get('createdAt', null) <= request.time
        && d.get('createdAt', null) > request.time - duration.value(5, 'm')
        // Anchor (Step 7 P0-06 + Step 9 Design G + H.1): the
        // purpose decides the anchor — see validJobReceiptAnchor
        // (shared by create and by the re-issue update below).
        && validJobReceiptAnchor(d)
        && reqBundleExists()
        && get(/databases/$(database)/documents/jobQuestionBundles/$(d.get('bundleId', ''))).data.status == 'published';
    }
    // validJobReceiptUpdate(d, old, receiptId) — compaction 27 Nov 2026: the update allow below, extracted verbatim with request.resource.data -> d and resource.data -> old (pure substitution; semantics identical).
    function validJobReceiptUpdate(d, old, receiptId) {
      return signedIn() && callerActive()
        && receiptId == uid() + '_' + d.get('bundleId', '')
        && d.get('userId', '') == uid()
        && old.get('userId', '') == uid()
        && old.get('bundleId', '') == d.get('bundleId', '')
        && onlyKeys(['userId', 'bundleId',
             'attemptId', 'createdAt', 'purpose', 'bundleVersion'])
        && isStrType(d, 'bundleId')
        && d.get('bundleId', '').size() <= 200
        && isStrType(d, 'attemptId')
        && d.get('attemptId', '').size() <= 200
        && d.get('purpose', null) in ['practice_review', 'exam_review']
        && isPosInt(d, 'bundleVersion')
        // Trusted timestamp (P0-03, same as create): the re-issued
        // receipt must carry a fresh createdAt — an old timestamp
        // re-issued would reopen an expired window.
        && isTsType(d, 'createdAt')
        && d.get('createdAt', null) <= request.time
        && d.get('createdAt', null) > request.time - duration.value(5, 'm')
        && validJobReceiptAnchor(d)
        && reqBundleExists()
        && get(/databases/$(database)/documents/jobQuestionBundles/$(d.get('bundleId', ''))).data.status == 'published';
    }
    match /jobReceipts/{receiptId} {
      allow read: if (signedIn() && resource.data.get('userId', '') == uid()) || isAdmin();
      allow create: if validJobReceiptCreate(request.resource.data, receiptId);
      // Anchored re-issue (Step 9 closure, open question 1): a
      // retake's setDoc on the existing receipt doc-ID is an UPDATE
      // — allowed only when the new doc re-anchors to a newly
      // submitted session/attempt for the SAME bundle, with a fresh
      // createdAt. userId and bundleId are immutable (the receipt
      // can never change owner or bundle); attemptId, purpose,
      // bundleVersion and createdAt move with the new submission.
      allow update: if validJobReceiptUpdate(request.resource.data, resource.data, receiptId);
      allow delete: if isAdmin();
    }
    // users/{uid}/jobAttempts — FULL attempt (Step 8, Step 3 §2.11).
    // Created ONCE at submit with status 'submitted' and the full
    // fields; the in-progress lifecycle lives in jobSessions (below).
    // The Step 7 minimal anchor (create in-progress, update once to
    // submitted) is REPLACED, not extended: a second submit is an
    // update, and updates are denied, so the doc-ID (= session ID)
    // stays the idempotency key and no orphan in-progress attempt can
    // ever be stranded (deletes are forbidden for everyone, even
    // Admin — submitted attempts are immutable, §4.4). An attempt may
    // only be created when its session is already 'submitted' (the
    // session gate in validJobAttemptCreate).
    match /users/{userId}/jobAttempts/{attemptId} {
      allow read: if isOwner(userId) || isModerator();
      allow create: if isOwner(userId) && callerActive()
        // The bundle + the post-write session are fetched ONCE
        // here and passed in (same budget pattern as the exam
        // attempt below): the exists-guards short-circuit before
        // any get(), so a missing doc denies cleanly instead of
        // erroring the get.
        && reqBundleExists()
        && exists(/databases/$(database)/documents/users/$(userId)/jobSessions/$(attemptId))
        && validJobAttemptCreate(request.resource.data, userId, attemptId,
             jobBundleData(request.resource.data.get('bundleId', '')),
             jobSessionDataAfter(userId, attemptId));
      allow update, delete: if false;
    }

    // users/{uid}/jobSessions — live session (Step 8, Step 3 §2.12).
    // Created in-progress, autosaved while in-progress, then exactly
    // one terminal transition (submitted or abandoned) — after that
    // the doc is frozen. Deletes are forbidden for everyone, even
    // Admin: an abandoned session is the audit trail (a student who
    // abandons a mock leaves a record; the attempt is simply never
    // created for it).
    match /users/{userId}/jobSessions/{sessionId} {
      allow read: if isOwner(userId) || isModerator();
      allow create: if isOwner(userId) && callerActive()
        && reqBundleExists()
        && validJobSessionCreate(request.resource.data,
             jobBundleData(request.resource.data.get('bundleId', '')));
      allow update: if isOwner(userId) && callerActive()
        && resource.data.get('status', '') == 'in-progress'
        && changedKeys()
             .hasOnly(['answers', 'currentQuestion', 'lastSyncedAt',
                       'updatedAt', 'status', 'submittedAt', 'revision'])
        && validJobSessionUpdate(request.resource.data, resource.data);
      allow delete: if false;
    }

    // users/{uid}/jobExamAttempts — FULL exam attempt (Step 9,
    // ChatGPT fold-in H.2). Created ONCE at submit with status
    // 'submitted' and the full fields; the in-progress lifecycle
    // lives in jobExamSessions. The doc-ID (= session ID) is the
    // idempotency key; a second submit is an update, and updates
    // are denied. Deletes are forbidden for everyone, even Admin —
    // submitted attempts are immutable, §4.4. An attempt may only
    // be created when its exam session is already 'submitted'
    // (the session gate in validJobExamAttemptCreate).
    match /users/{userId}/jobExamAttempts/{attemptId} {
      allow read: if isOwner(userId) || isModerator();
      // The bundle + the post-write session are fetched ONCE
      // here and passed in (budget note on
      // validJobExamAttemptCreate): the exists-guards
      // short-circuit before any get(), so a missing doc denies
      // cleanly instead of erroring the get.
      allow create: if isOwner(userId) && callerActive()
        && reqBundleExists()
        && exists(/databases/$(database)/documents/users/$(userId)/jobExamSessions/$(attemptId))
        && validJobExamAttemptCreate(request.resource.data, userId, attemptId,
             jobBundleData(request.resource.data.get('bundleId', '')),
             jobExamSessionDataAfter(userId, attemptId));
      allow update, delete: if false;
    }

    // users/{uid}/jobExamSessions — live exam session (Step 9).
    // Created in-progress (with its lock), autosaved while
    // in-progress and before the stored deadline, then exactly
    // one terminal transition (submitted or abandoned) — after
    // that the doc is frozen. The deadline (endsAt) is set ONCE
    // after read-back to exactly startedAt + the definition's
    // duration. Deletes are forbidden for everyone, even Admin:
    // an abandoned session is the audit trail.
    match /users/{userId}/jobExamSessions/{sessionId} {
      allow read: if isOwner(userId) || isModerator();
      // Each referenced doc is fetched ONCE here and passed in
      // (budget note on validJobExamSessionCreate above): the
      // exists-guards short-circuit before any get(), so a
      // missing doc denies cleanly instead of erroring the get.
      allow create: if isOwner(userId) && callerActive()
        && reqBundleExists()
        && exists(/databases/$(database)/documents/jobQuestionSetManifests/$(request.resource.data.get('questionSetId', '')))
        && exists(/databases/$(database)/documents/jobExamDefinitions/$(request.resource.data.get('definitionId', '')))
        && validJobExamSessionCreate(request.resource.data, sessionId,
             jobBundleData(request.resource.data.get('bundleId', '')),
             jobManifestData(request.resource.data.get('questionSetId', '')),
             jobExamDefinitionData(request.resource.data.get('definitionId', '')),
             getAfter(/databases/$(database)/documents/jobExamUserLocks/$(uid() + '_' + request.resource.data.get('examSlug', ''))).data);
      allow update: if isOwner(userId) && callerActive()
        && resource.data.get('status', '') == 'in-progress'
        && changedKeys()
             .hasOnly(['answers', 'currentQuestion', 'lastSyncedAt',
                       'updatedAt', 'endsAt', 'clientEndsAtMillis',
                       'status', 'submittedAt', 'revision'])
        && validJobExamSessionUpdate(request.resource.data, resource.data);
      allow delete: if false;
    }

    // users/{uid}/jobExamAuditLogs — mock-exam audit trail (Step 9
    // closure, checklist item 11). One best-effort entry per mock
    // lifecycle transition (started / submitted / abandoned /
    // submit-failed), written by the student's own client next to
    // the transition — never blocking it. The rules bound the SHAPE
    // (owner only, fixed fields, trusted timestamp) so the trail
    // cannot be rewritten into another student's record, backdated,
    // or padded with free text; they do NOT make the trail
    // tamper-proof — a determined client can write a false entry,
    // exactly as it can forge an attempt (§4.3 residual limit).
    // The trail is operational (who took which mock, when, and
    // whether the submit failed) for the owner/Moderator — never a
    // basis for a "Verified" score. Entries are immutable: no
    // update, Admin-only delete.
    function validJobExamAuditLog(d, userId) {
      return d.keys().hasOnly(['uid', 'event', 'examSlug', 'mockId',
              'sessionId', 'bundleId', 'createdAt', 'detail'])
        && d.get('uid', '') == userId
        && d.get('event', '') in ['mock_started', 'mock_submitted',
             'mock_abandoned', 'mock_submit_failed']
        && isStrType(d, 'examSlug')
        && d.get('examSlug', '').size() > 0
        && d.get('examSlug', '').size() <= 200
        && isStrType(d, 'mockId')
        && d.get('mockId', '').size() > 0
        && d.get('mockId', '').size() <= 200
        && isStrType(d, 'sessionId')
        && d.get('sessionId', '').size() > 0
        && d.get('sessionId', '').size() <= 200
        && isStrType(d, 'bundleId')
        && d.get('bundleId', '').size() > 0
        && d.get('bundleId', '').size() <= 200
        && (d.get('detail', null) == null
            || (isStrType(d, 'detail')
                && d.get('detail', '').size() <= 500))
        // Trusted timestamp (P0-03): no future-dating, no backdating.
        && isTsType(d, 'createdAt')
        && d.get('createdAt', null) <= request.time
        && d.get('createdAt', null) > request.time - duration.value(5, 'm');
    }
    match /users/{userId}/jobExamAuditLogs/{logId} {
      allow read: if isOwner(userId) || isModerator();
      allow create: if isOwner(userId) && callerActive()
        && validJobExamAuditLog(request.resource.data, userId);
      allow update: if false;
      allow delete: if isAdmin();
    }

    // users/{uid}/examHistory — per-student, per-exam exposure
    // history for repetition control (§3.6). Owner-only, bounded
    // to 500 question IDs (the lib merges with a 300–500 cap);
    // lastAttemptNo only ever increases. Moderators read for
    // support. No delete: history IS the repetition control.
    match /users/{userId}/examHistory/{examId} {
      allow read: if isOwner(userId) || isModerator();
      allow create, update: if isOwner(userId) && callerActive()
        && request.resource.data.recentQuestionIds is list
        && request.resource.data.recentQuestionIds.size() <= 500
        && request.resource.data.lastAttemptNo is int
        && request.resource.data.lastAttemptNo >= 0
        && (resource == null
            || request.resource.data.lastAttemptNo >= resource.data.get('lastAttemptNo', 0))
        && onlyKeys(['recentQuestionIds', 'lastAttemptNo', 'updatedAt']);
      allow delete: if false;
    }

    // ---------- config/appVersion (forced app update, 22 Nov 2026) ----------
    // Public read: the version gate runs on app load, BEFORE sign-in, so
    // even a signed-out visitor must be able to read it. Writes are
    // admin/owner only, appVersion doc only, fixed key set, semver-ish
    // versions, downloadUrl a site path or https URL, updatedAt a real
    // timestamp. Any other config docId is denied by the docId check.
    match /config/{docId} {
      allow read: if docId == 'appVersion';
      allow create, update: if isAdmin() && docId == 'appVersion'
        && request.resource.data.keys().toSet().hasOnly(['latestVersion', 'minVersion', 'releaseNotes', 'downloadUrl', 'updatedAt'])
        && isVersionStr(request.resource.data.latestVersion)
        && isVersionStr(request.resource.data.minVersion)
        && request.resource.data.releaseNotes is string
        && request.resource.data.releaseNotes.size() <= 2000
        && request.resource.data.downloadUrl is string
        && request.resource.data.downloadUrl.size() > 0
        && request.resource.data.downloadUrl.size() <= 500
        && request.resource.data.downloadUrl.matches('^(/|https://).*$')
        && request.resource.data.updatedAt is timestamp;
      allow delete: if false;
    }

    // ---------- ownerSecurity (owner 2FA, 23 Nov 2026, staging) ----------
    // The owner's own security records: login history + salted
    // backup-code hashes. OWNER-ONLY and only the owner's own doc
    // (uid == doc id). No plaintext secret, password or backup code is
    // ever stored here — backup codes live as salted SHA-256 hashes
    // only (lib/ownerMfa.ts); the codes themselves live only with the
    // owner. List on the top-level collection is denied by design (the
    // doc id is the owner's UID — read it by ID); subcollections are
    // listable by the owner for his own history / code count.
    function isValidOwnerSecurityDoc(d) {
      return onlyKeys(['lastLoginAt', 'knownDeviceIds', 'mfaEnrolledAt', 'backupCodesUpdatedAt', 'updatedAt'])
        && isOptTs(d, 'lastLoginAt')
        && isOptTs(d, 'mfaEnrolledAt')
        && isOptTs(d, 'backupCodesUpdatedAt')
        && isOptTs(d, 'updatedAt')
        && isOptList(d, 'knownDeviceIds');
    }
    match /ownerSecurity/{ownerId} {
      allow get, delete: if isOwnerRole() && isOwner(ownerId);
      allow list: if false;
      allow create, update: if isOwnerRole() && isOwner(ownerId)
        && isValidOwnerSecurityDoc(request.resource.data);
      // Append-only login history (update never: a record is written
      // once at sign-in and never edited).
      match /loginHistory/{entryId} {
        allow get, list, delete: if isOwnerRole() && isOwner(ownerId);
        allow create: if isOwnerRole() && isOwner(ownerId)
          && request.resource.data.keys().toSet().hasOnly(['createdAt', 'deviceId', 'userAgent', 'isNewDevice'])
          && request.resource.data.createdAt is timestamp
          && isStr(request.resource.data.deviceId, 40)
          && request.resource.data.userAgent is string
          && request.resource.data.userAgent.size() <= 300
          && request.resource.data.isNewDevice is bool;
        allow update: if false;
      }
      // Backup-code hashes: created at generation, deleted on consume
      // or regenerate. Never updated (a hash is immutable by design).
      match /backupCodes/{codeHash} {
        allow get, list, delete: if isOwnerRole() && isOwner(ownerId);
        allow create: if isOwnerRole() && isOwner(ownerId)
          && request.resource.data.keys().toSet().hasOnly(['salt', 'createdAt'])
          && isStr(request.resource.data.salt, 64)
          && request.resource.data.createdAt is timestamp;
        allow update: if false;
      }
    }

    // ---------- Question Paper Generator (Milestone 2.5, 25 Nov 2026) ----------
    // BRANCH ONLY — these rules are NOT deployed in the MVP (no deploy,
    // no live writes). The client enforces the free quota against a
    // local demo stand-in today; these rules are the designed
    // enforcement for the Firestore path. All three collections join
    // BACKUP_COLLECTIONS (src/lib/backup.ts) + the REST exporter.
    //
    // qpgUsage/{uid}_{yyyyMM}: per-teacher per-month free downloads.
    // The doc id embeds the owner uid + month; the data repeats them
    // so the rules can check ownership without parsing the id.
    match /qpgUsage/{usageId} {
      allow read: if signedIn() && (resource.data.uid == uid() || isModerator());
      allow create: if signedIn() && callerActive()
        && request.resource.data.uid == uid()
        && isStr(request.resource.data.month, 7)
        && request.resource.data.freeDownloads == 0
        && request.resource.data.updatedAt is timestamp
        && onlyKeys(['uid', 'month', 'freeDownloads', 'updatedAt']);
      // Owner may only increment the counter by exactly 1 (one free
      // download); a moderator never writes usage. The 3/month cap is
      // enforced client-side against the counter; the rules guarantee
      // the counter itself cannot be forged down or jumped.
      allow update: if signedIn() && callerActive()
        && resource.data.uid == uid()
        && request.resource.data.uid == uid()
        && request.resource.data.month == resource.data.month
        && request.resource.data.freeDownloads == resource.data.freeDownloads + 1
        && request.resource.data.freeDownloads <= 3
        && request.resource.data.updatedAt is timestamp
        && changedKeys().hasOnly(['freeDownloads', 'updatedAt']);
      allow delete: if false;
    }
    // qpgProOrders/{orderId}: bKash/Nagad TrxID upgrade orders.
    // Created as pending-review ONLY; the amount must match the plan
    // exactly — PRICING FINAL (owner 25 Nov 09:34): per-paper 49 /
    // monthly 199 / annual tiers 300, 450, 390, 75, 210, 750, 1050,
    // 1350 (30% of the reference price, i.e. 70% off, rounded to the
    // nearest ৳10 — owner 25 Nov 17:28: no other website's name
    // appears anywhere on the site).
    // Only a moderator may decide an order — and only the decide fields.
    // Phase 2 (25 Nov 2026): the buyer also sends the last 3 digits
    // of the sender's number (senderLast3, exactly 3 chars — the
    // admin matches them in the bKash/Nagad app), the order source
    // (onsite form vs WhatsApp-linked), and an optional contribution
    // coupon (verified by the admin at review, never self-applied).
    // The unlock window (proStart/proEnd) and the single-paper
    // credit (remainingUses) are set by the moderator AT APPROVAL —
    // a new order must not carry them (they are NOT in the create
    // onlyKeys). The buyer may decrement remainingUses on their OWN
    // approved single-paper order by exactly 1 (one clean download),
    // only while > 0 and unexpired — the rules enforce the shape.
    // validQpgProOrderCreate(d) — compaction 27 Nov 2026: the create allow below, extracted verbatim with request.resource.data -> d (pure substitution; semantics identical).
    function validQpgProOrderCreate(d) {
      return signedIn() && callerActive()
        && d.uid == uid()
        && d.plan in ['per-paper', 'monthly',
          'class-6-8', 'class-9-10', 'class-11-12',
          'per-subject', 'subject-teacher',
          'bundle-6-8', 'bundle-6-10',
          'coaching-6-12']
        && ((d.plan == 'per-paper' && d.amountBdt == 49)
          || (d.plan == 'monthly' && d.amountBdt == 199)
          || (d.plan == 'class-6-8' && d.amountBdt == 300)
          || (d.plan == 'class-9-10' && d.amountBdt == 450)
          || (d.plan == 'class-11-12' && d.amountBdt == 390)
          || (d.plan == 'per-subject' && d.amountBdt == 75)
          || (d.plan == 'subject-teacher' && d.amountBdt == 210)
          || (d.plan == 'bundle-6-8' && d.amountBdt == 750)
          || (d.plan == 'bundle-6-10' && d.amountBdt == 1050)
          || (d.plan == 'coaching-6-12' && d.amountBdt == 1350))
        && d.paymentMethod in ['bkash', 'nagad']
        && isStr(d.trxId, 30)
        && d.trxId.size() >= 6
        && isStr(d.senderLast3, 3)
        && d.senderLast3.size() == 3
        && isOptStrF(d, 'senderWhatsapp', 20)
        && isOptStrF(d, 'couponCode', 20)
        && d.source in ['onsite', 'whatsapp']
        && d.status == 'pending-review'
        && d.createdAt is timestamp
        && onlyKeys(['uid', 'plan', 'amountBdt', 'paymentMethod', 'trxId', 'senderLast3', 'senderWhatsapp', 'couponCode', 'status', 'source', 'createdAt']);
    }
    // validQpgProOrderUpdate(d, old) — compaction 27 Nov 2026: the update allow below, extracted verbatim with request.resource.data -> d and resource.data -> old (pure substitution; semantics identical).
    function validQpgProOrderUpdate(d, old) {
      return isModerator()
        && old.status == 'pending-review'
        && d.status in ['approved', 'rejected']
        && d.decidedBy == uid()
        && d.decidedAt is timestamp
        && isOptTs(d, 'proStart')
        && isOptTs(d, 'proEnd')
        // An approval MUST carry the unlock window (and one credit
        // for a single-paper order) — otherwise the buyer paid and
        // got nothing. A rejection carries neither.
        && (d.status == 'rejected'
          || (d.proStart is timestamp
            && d.proEnd is timestamp
            && (d.plan != 'per-paper' || d.remainingUses == 1)))
        && changedKeys().hasOnly(['status', 'decidedBy', 'decidedAt', 'decisionNote', 'proStart', 'proEnd', 'remainingUses']);
    }
    match /qpgProOrders/{orderId} {
      allow read: if signedIn() && (resource.data.uid == uid() || isModerator());
      allow create: if validQpgProOrderCreate(request.resource.data);
      allow update: if validQpgProOrderUpdate(request.resource.data, resource.data);
      // Buyer single-paper credit decrement (one clean download).
      allow update: if signedIn() && callerActive()
        && resource.data.uid == uid()
        && resource.data.status == 'approved'
        && resource.data.plan == 'per-paper'
        && resource.data.remainingUses > 0
        && resource.data.proEnd is timestamp
        && resource.data.proEnd > request.time
        && request.resource.data.remainingUses == resource.data.remainingUses - 1
        && changedKeys().hasOnly(['remainingUses']);
      allow delete: if false;
    }
    // qpgReports/{reportId}: "Report Typo/Error" on a generator
    // question. A report NEVER auto-publishes or auto-edits anything:
    // only a moderator may decide it (decide fields only), and the
    // question docs themselves are untouched by this flow.
    // REWARD (Turn 32): a VALID correction earns 7 free Pro days —
    // ONLY after admin validation, never automatic. A new report
    // carries no reward (rewardStatus 'none'); only the moderator
    // may move it to pending/granted, and rewardDays is always 7.
    match /qpgReports/{reportId} {
      allow read: if signedIn() && (resource.data.reporterId == uid() || isModerator());
      allow create: if signedIn() && callerActive()
        && request.resource.data.reporterId == uid()
        && request.resource.data.status == 'open'
        && request.resource.data.reason in ['typo', 'wrong-answer', 'wrong-explanation', 'unclear-question', 'other']
        && request.resource.data.targetType == 'qpgQuestion'
        && isStr(request.resource.data.questionId, 200)
        && isStr(request.resource.data.chapterId, 200)
        && isOptStr(request.resource.data.details, 2000)
        && request.resource.data.createdAt is timestamp
        && request.resource.data.get('rewardStatus', 'none') == 'none'
        && onlyKeys(['reporterId', 'targetType', 'questionId', 'chapterId', 'reason', 'details', 'status', 'createdAt', 'resolvedBy', 'resolvedAt', 'resolutionNote', 'rewardStatus', 'rewardDays', 'rewardGrantedAt', 'rewardExpiresAt']);
      allow update: if isModerator()
        && resource.data.status in ['open', 'investigating']
        && request.resource.data.status in ['open', 'investigating', 'resolved', 'dismissed']
        && request.resource.data.get('rewardStatus', 'none') in ['none', 'pending', 'granted']
        && request.resource.data.get('rewardDays', 7) == 7
        && changedKeys().hasOnly(['status', 'resolvedBy', 'resolvedAt', 'resolutionNote', 'rewardStatus', 'rewardDays', 'rewardGrantedAt', 'rewardExpiresAt']);
      allow delete: if false;
    }

    // qpgBoards/{boardId}: Smartboard boards (Phase 2, spec §2).
    // A board is a paper turned into slides + Canvas 2D annotations.
    // Owner-only write; a share link (shareEnabled) grants READ-ONLY
    // access to any signed-in user (spec §8.14 proposal: logged-in
    // students only — never public). The owner is a moderator under
    // the rules, so the backup export's owner list-read works (the
    // isModerator() tail). Board use is free; PDF export + share link
    // are Pro-gated in the UI (spec §8.13 proposal) — the rules are
    // the outer bound, the Pro check is a product rule.

    // ---------- unified feedback (26 Nov 2026) ----------
    // ONE collection replaces three: questionReports (question-error
    // reports, Day 3) + contactMessages (Contact page) + reports
    // (general moderation reports), distinguished by `type`.
    // questionReports never shipped, so no migration was needed;
    // contactMessages + reports were empty in the last good backup
    // (24 Nov 2026) and write-only / read-only-in-admin, so their
    // writers were repointed instead of migrated. Contact read
    // widened from admin-only to moderator (one team queue).
    function validFeedbackQuestionError(d) {
      return d.get('status', '') == 'pending'
        && d.get('errorType', '') in ['wrong-answer', 'wrong-explanation', 'typo', 'out-of-syllabus', 'other']
        && isStrF(d, 'questionId', 200)
        && isStrF(d, 'questionText', 200)
        && isStrF(d, 'description', 1000)
        && d.get('flaggedForCorrection', null) == false
        && d.get('decidedBy', null) == null
        && d.get('decidedAt', null) == null
        && d.get('decisionNote', null) == null
        && onlyKeys(['type', 'reporterUid', 'status', 'questionId', 'questionText', 'errorType', 'description', 'flaggedForCorrection', 'decidedBy', 'decidedAt', 'decisionNote', 'createdAt', 'updatedAt']);
    }
    function validFeedbackContact(d) {
      return d.get('status', '') == 'pending'
        && isStrF(d, 'name', 100)
        && isStrF(d, 'message', 5000)
        && isOptStrF(d, 'email', 200)
        && onlyKeys(['type', 'reporterUid', 'status', 'name', 'message', 'email', 'createdAt', 'updatedAt']);
    }
    function validFeedbackReport(d) {
      return d.get('status', '') == 'open'
        && d.get('reason', '') in ['spam', 'abuse', 'copyright', 'personal-info', 'other']
        && d.get('targetType', '') in ['post', 'comment', 'socialPost', 'user', 'message']
        && isStrType(d, 'targetId')
        && isStrType(d, 'targetAuthorId')
        && isOptStrF(d, 'details', 2000)
        && onlyKeys(['type', 'reporterUid', 'status', 'reason', 'targetType', 'targetId', 'targetAuthorId', 'details', 'createdAt', 'updatedAt']);
    }
    function validFeedbackCreate(d) {
      return (d.get('type', '') == 'question-error' && validFeedbackQuestionError(d))
        || (d.get('type', '') == 'contact' && validFeedbackContact(d))
        || (d.get('type', '') == 'report' && validFeedbackReport(d));
    }
    function validFeedbackQuestionErrorUpdate(old, d) {
      return d.get('type', '') == old.get('type', '')
        && old.get('status', '') == 'pending'
        && d.get('status', '') in ['valid', 'invalid']
        && d.get('flaggedForCorrection', null) == (d.get('status', '') == 'valid')
        && d.get('decidedBy', null) == uid()
        && isTsType(d, 'decidedAt')
        && isOptStrF(d, 'decisionNote', 500)
        && changedKeys().hasOnly(['status', 'flaggedForCorrection', 'decidedBy', 'decidedAt', 'decisionNote', 'updatedAt']);
    }
    function validFeedbackUpdate(old, d) {
      return (old.get('type', '') == 'question-error' && validFeedbackQuestionErrorUpdate(old, d))
        || (old.get('type', '') == 'report' && d.get('type', '') == old.get('type', '') && d.get('reporterUid', null) == old.get('reporterUid', null));
    }
    match /feedback/{feedbackId} {
      allow read: if isModerator()
        || (signedIn() && resource.data.type == 'report' && resource.data.reporterUid == uid());
      allow create: if signedIn() && callerActive()
        && request.resource.data.reporterUid == uid()
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && validFeedbackCreate(request.resource.data);
      allow update: if isModerator() && validFeedbackUpdate(resource.data, request.resource.data);
      allow delete: if false;
    }
    match /qpgBoards/{boardId} {
      allow read: if signedIn() && (resource.data.ownerUid == uid() || isModerator() || resource.data.get('shareEnabled', false) == true);
      allow create: if signedIn() && callerActive()
        && request.resource.data.ownerUid == uid()
        && isStr(request.resource.data.title, 200)
        && isOptStrF(request.resource.data, 'subject', 100)
        && isOptStrF(request.resource.data, 'classLabel', 100)
        && isOptStrF(request.resource.data, 'setCode', 10)
        && request.resource.data.layout in ['separate', 'whole-paper']
        && request.resource.data.paperRef is map
        && request.resource.data.slides is list
        && request.resource.data.slides.size() >= 1
        && request.resource.data.slides.size() <= 120
        && request.resource.data.shareEnabled == false
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && onlyKeys(['ownerUid', 'ownerName', 'title', 'subject', 'classLabel', 'setCode', 'layout', 'paperRef', 'slides', 'shareEnabled', 'createdAt', 'updatedAt']);
      allow update: if signedIn() && callerActive()
        && (resource.data.ownerUid == uid() || isModerator())
        && request.resource.data.updatedAt is timestamp
        && changedKeys().hasOnly(['title', 'subject', 'classLabel', 'setCode', 'layout', 'slides', 'shareEnabled', 'updatedAt']);
      allow delete: if signedIn() && callerActive()
        && (resource.data.ownerUid == uid() || isModerator());
    }
    // qpgContributions/{contributionId}: teacher question submissions
    // (Phase 2, spec §3). DRAFT (pending_review) on create — never
    // auto-published, never auto-verified, never auto-awarded. Only a
    // moderator may decide (approve → points + coupon; reject →
    // reason required). The contributor reads only their own
    // submissions; the leaderboard reads qpgContributorStats, never
    // this collection. A submission claiming to be a board question
    // without a verifiable source is rejected at review (the client
    // validator blocks a bare claim at submit).
    // validQpgContributionCreate(d) — compaction 27 Nov 2026: the create allow below, extracted verbatim with request.resource.data -> d (pure substitution; semantics identical).
    function validQpgContributionCreate(d) {
      return signedIn() && callerActive()
        && d.contributorUid == uid()
        && isStr(d.contributorName, 100)
        && isOptStrF(d, 'institution', 200)
        && d.stream in ['general', 'madrasah']
        && isStr(d.classId, 100)
        && isStr(d.subjectId, 100)
        && isStr(d.chapterId, 200)
        && isStr(d.topic, 200)
        && d.type in ['mcq', 'cq', 'short', 'multi-completion', 'situation-set', 'picture-based']
        && isStr(d.questionText, 5000)
        && d.options is list
        && d.options.size() <= 4
        && isStr(d.explanation, 5000)
        && isOptStrF(d, 'source', 500)
        && d.difficulty in ['easy', 'medium', 'hard']
        && d.cognitiveLevel in ['unspecified', 'knowledge', 'comprehension', 'application', 'higher']
        && d.nature in ['unspecified', 'mathematical', 'theoretical']
        && d.ownWordingConfirmed == true
        && d.status == 'pending_review'
        && d.createdAt is timestamp
        && onlyKeys(['contributorUid', 'contributorName', 'institution', 'stream', 'classId', 'subjectId', 'chapterId', 'topic', 'type', 'questionText', 'options', 'correctAnswer', 'explanation', 'source', 'difficulty', 'cognitiveLevel', 'nature', 'ownWordingConfirmed', 'status', 'createdAt']);
    }
    match /qpgContributions/{contributionId} {
      allow read: if signedIn() && (resource.data.contributorUid == uid() || isModerator());
      allow create: if validQpgContributionCreate(request.resource.data);
      allow update: if isModerator()
        && resource.data.status == 'pending_review'
        && request.resource.data.status in ['approved', 'rejected']
        && request.resource.data.reviewedByUid == uid()
        && request.resource.data.reviewedAt is timestamp
        && (request.resource.data.status == 'approved'
          || request.resource.data.get('rejectReason', null) in ['wrong-answer', 'copied-verbatim', 'already-exists', 'off-syllabus', 'low-quality', 'board-claim-unverified'])
        && isOptTs(request.resource.data, 'couponExpiresAt')
        && changedKeys().hasOnly(['status', 'reviewedByUid', 'reviewedAt', 'rejectReason', 'rejectNote', 'pointsAwarded', 'couponCode', 'couponExpiresAt', 'couponUsedAt', 'couponUsedOrderId']);
      allow delete: if false;
    }
    // qpgContributorStats/{uid}: one doc per contributor (Phase 2,
    // spec §3). Public-to-signed-in read (the leaderboard — names +
    // institutions only, never phone/email). Created on first submit
    // (totalSubmitted 1, everything else 0); the contributor only
    // ever increments their own totalSubmitted by 1; the moderator
    // updates approved/points/level/rejected at decision time.
    match /qpgContributorStats/{statsUid} {
      allow read: if signedIn();
      allow create: if signedIn() && callerActive()
        && statsUid == uid()
        && request.resource.data.uid == uid()
        && request.resource.data.totalSubmitted == 1
        && request.resource.data.approved == 0
        && request.resource.data.rejected == 0
        && request.resource.data.points == 0
        && request.resource.data.level == 'নবীন'
        && request.resource.data.updatedAt is timestamp
        && onlyKeys(['uid', 'displayName', 'institution', 'totalSubmitted', 'approved', 'rejected', 'points', 'level', 'updatedAt']);
      // Contributor: only their own totalSubmitted +1 per submit.
      allow update: if signedIn() && callerActive()
        && statsUid == uid()
        && resource.data.uid == uid()
        && request.resource.data.totalSubmitted == resource.data.totalSubmitted + 1
        && request.resource.data.updatedAt is timestamp
        && changedKeys().hasOnly(['totalSubmitted', 'updatedAt']);
      // Moderator: the decide write (approved/points/level/rejected).
      allow update: if isModerator()
        && request.resource.data.updatedAt is timestamp
        && changedKeys().hasOnly(['totalSubmitted', 'approved', 'rejected', 'points', 'level', 'updatedAt']);
      allow delete: if false;
    }
    // qpgCustomOrders/{orderId}: Firestore-backed custom-paper
    // tracking (Phase 2, spec §6). TRACKING ONLY — fulfilment stays
    // HUMAN (owner/team builds the paper by hand; no delivery time
    // is promised). Buyer creates pending_payment at the fixed
    // ৳49/paper; only a moderator moves the status forward
    // (pending_payment → paid → building → delivered), one step at
    // a time, never backwards.
    // validQpgCustomOrderCreate(d) — compaction 27 Nov 2026: the create allow below, extracted verbatim with request.resource.data -> d (pure substitution; semantics identical).
    function validQpgCustomOrderCreate(d) {
      return signedIn() && callerActive()
        && d.uid == uid()
        && isStr(d.buyerName, 100)
        && isOptStrF(d, 'buyerWhatsapp', 20)
        && isStr(d.className, 100)
        && isStr(d.subject, 100)
        && isOptStrF(d, 'chapters', 1000)
        && isOptStrF(d, 'questionTypes', 1000)
        && d.totalMarks is int
        && d.totalMarks > 0
        && isOptStrF(d, 'markDistribution', 2000)
        && isOptStrF(d, 'examTitle', 200)
        && isOptStrF(d, 'institutionName', 200)
        && isStr(d.dateNeeded, 50)
        && isOptStrF(d, 'instructions', 2000)
        && d.priceBdt == 49
        && isOptStrF(d, 'trxId', 30)
        && d.status == 'pending_payment'
        && d.source in ['onsite', 'whatsapp']
        && d.submittedAt is timestamp
        && onlyKeys(['uid', 'buyerName', 'buyerWhatsapp', 'className', 'subject', 'chapters', 'questionTypes', 'totalMarks', 'markDistribution', 'examTitle', 'institutionName', 'dateNeeded', 'instructions', 'priceBdt', 'trxId', 'status', 'source', 'submittedAt']);
    }
    match /qpgCustomOrders/{orderId} {
      allow read: if signedIn() && (resource.data.uid == uid() || isModerator());
      allow create: if validQpgCustomOrderCreate(request.resource.data);
      allow update: if isModerator()
        && ((resource.data.status == 'pending_payment' && request.resource.data.status == 'paid')
          || (resource.data.status == 'paid' && request.resource.data.status == 'building')
          || (resource.data.status == 'building' && request.resource.data.status == 'delivered'))
        && request.resource.data.updatedByUid == uid()
        && isOptTs(request.resource.data, 'paidAt')
        && isOptTs(request.resource.data, 'deliveredAt')
        && changedKeys().hasOnly(['status', 'updatedByUid', 'paidAt', 'deliveredAt']);
      allow delete: if false;
    }

    // ---------- everything else: denied ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
