rules_version = '2';

// Eduvelto — Firestore Security Rules (Phase 2).
// Implements database-schema.md §5 + blueprint §4.7 principles.
// Governing idea: the client is untrusted; the rule is the enforcement.
// Deny by default: every match below allows explicitly, and anything not
// matched is denied. All writes require auth. No client may write
// reviewStatus "Published", a role, or a verificationStatus directly.
// NOTE: rules cannot strip fields from a read. The quiz answer key is
// therefore NEVER stored in the `quizzes` document a student fetches:
// the student projection (quizzes/{id}) carries questions + options
// only. The key lives in `quizKeys/{quizId}` (below), readable by a
// student only through a fresh submission receipt (quizReceipts) — the
// app creates the receipt at submit time and deletes it right after
// scoring. Honest limit (no server on the free Spark plan): the receipt
// gate stops casual access; a determined user with console access could
// forge a receipt. True server-side verification needs a Cloud Function
// (Blaze) — flagged for Phase 3.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function isOwner(id) { return signedIn() && uid() == id; }

    // Role is read from the caller's own users doc. `.data.get('role', '')`
    // (not `.data.role`): dot-access ERRORS when the doc/field is missing,
    // which turns a clean deny into a rules EVALUATION error — the client
    // then gets an opaque error instead of permission-denied, and lib code
    // that reads-then-checks (e.g. confirmParentLink's 'not-the-child')
    // can never run. A missing doc/field now yields '' (never a role).
    function callerRole() {
      return get(/databases/$(database)/documents/users/$(uid())).data.get('role', '');
    }
    // Suspension is enforced SERVER-side, not just in the UI (review
    // 20 Nov 2026: suspension used to hide the app only — a suspended
    // admin/moderator/teacher kept full Firestore powers via direct
    // calls). A suspended account is not active: every privileged
    // helper below, and every content create, requires it.
    // Missing isActive = active (only an explicit false suspends).
    function callerActive() {
      return get(/databases/$(database)/documents/users/$(uid())).data.get('isActive', true) != false;
    }
    function isAdmin() {
      return signedIn() && callerActive() && (callerRole() == 'admin' || callerRole() == 'owner');
    }
    // The Owner is the highest role (spec §3). isAdmin()/isModerator()/
    // isTeacher() already include 'owner' — the owner bypasses every admin
    // gate. isOwnerRole() is for OWNER-ONLY actions (owner-doc protection,
    // audit-log reads).
    function isOwnerRole() {
      return signedIn() && callerRole() == 'owner';
    }
    function isModerator() {
      return signedIn() && callerActive() && (callerRole() in ['moderator', 'admin', 'owner']);
    }
    function isTeacher() {
      return signedIn() && callerActive() && (callerRole() in ['teacher', 'admin', 'moderator', 'owner']);
    }
    // DASHBOARDS (Step 5/8, branch draft — NOT deployed): a guardian may
    // read a linked child's progress/bookmarks/results ONLY while the
    // parentLink is 'verified'. The link id is deterministic
    // `{guardianUid}_{childUid}`, so this is one exists() + one get().
    // exists() short-circuits: a missing link denies without erroring.
    // A guardian NEVER reads the child's users doc (email lives there)
    // and NEVER reads quizAttempts (detailed answers stay with the child).
    function isLinkedGuardian(studentId) {
      return signedIn() && callerActive()
        && exists(/databases/$(database)/documents/parentLinks/$(uid() + '_' + studentId))
        && get(/databases/$(database)/documents/parentLinks/$(uid() + '_' + studentId)).data.status == 'verified';
    }

    // ---------- validation helpers ----------
    function isStr(v, max) { return v is string && v.size() > 0 && v.size() <= max; }
    function isOptStr(v, max) { return v == null || (v is string && v.size() <= max); }
    function isDraftStatus(s) { return s in ['Not Started', 'In Progress', 'Under Review']; }
    function isPublished(d) { return d.get('reviewStatus', '') == 'Published'; }

    // ---------- users.verificationStatus ----------
    // OWNER DECISION 21 Nov 2026 — student identity verification is
    // REMOVED entirely. `users.verificationStatus` is ONLY the mirror of
    // a teacherVerifications record (teacher verification); it is NEVER
    // a student-verification state, and NO access decision for a student
    // may ever read it. The transitions below are exactly the four
    // writes admin.ts performs for the teacher flow:
    //   approve: absent/'pending' -> 'verified' (+ role becomes 'teacher')
    //   reject:  absent/'pending' -> 'rejected' (role stays student)
    //   revoke:  'verified' -> 'revoked' (+ role returns to 'student')
    //   reopen:  'rejected'/'revoked'/'verified' -> 'pending'
    // Anything else — in particular putting a fresh student into
    // 'pending' or 'verified' — is denied, so a student can never be
    // gated by a verification state again. Called from both the admin
    // and the owner update rules on /users/{userId} below.
    function validVerificationTransition() {
      return !('verificationStatus' in request.resource.data.diff(resource.data).affectedKeys())
        || (request.resource.data.verificationStatus == 'verified'
            && request.resource.data.role == 'teacher')
        || (request.resource.data.verificationStatus == 'pending'
            && (request.resource.data.role == 'teacher'
                || resource.data.get('verificationStatus', '') in ['rejected', 'revoked', 'verified']))
        || (request.resource.data.verificationStatus == 'rejected'
            && resource.data.get('verificationStatus', '') in ['pending', ''])
        || (request.resource.data.verificationStatus == 'revoked'
            && resource.data.get('verificationStatus', '') == 'verified');
    }

    // ---------- users ----------
    // A user reads/writes only their own doc. Role and verificationStatus
    // can NEVER be changed by the owner of the doc — only Admin/Owner.
    // isActive is also admin-only (suspension must not be self-reversible).
    // READ (review 20 Nov 2026): moderators no longer read every user's
    // email + education details in bulk — full records are owner/admin
    // only. Moderator access to user data is re-scoped when moderators
    // are onboarded (minimal per-case projection, audit-logged).
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      // DASHBOARDS (Step 5, branch draft): self-service roles are
      // student / teacher / parent ONLY — admin / moderator / owner can
      // never be self-assigned (the old rule allowed student only, so
      // teacher + guardian registration was impossible). A teacher or
      // guardian profile is created with verificationStatus 'pending'
      // (verification is a human Admin decision afterwards); a student
      // NEVER carries verificationStatus (no student verification exists
      // — owner decision 21 Nov 06:53 + 07:02, 100% free, manual only).
      // isActive is still never set at creation (missing = active).
      allow create: if isOwner(userId)
        && request.resource.data.role in ['student', 'teacher', 'parent']
        && (!('verificationStatus' in request.resource.data)
            || (request.resource.data.role in ['teacher', 'parent']
                && request.resource.data.verificationStatus == 'pending'))
        && !('isActive' in request.resource.data)
        && isStr(request.resource.data.displayName, 100)
        && request.resource.data.email is string
        && request.resource.data.language in ['bn', 'en']
        && isOptStr(request.resource.data.get('board', null), 200)
        && isOptStr(request.resource.data.get('institution', null), 200)
        && isOptStr(request.resource.data.get('academicSession', null), 50)
        && isOptStr(request.resource.data.get('curriculum', null), 200)
        && isOptStr(request.resource.data.get('classLevel', null), 100)
        && isOptStr(request.resource.data.get('department', null), 100)
        && isOptStr(request.resource.data.get('semester', null), 50)
        && isOptStr(request.resource.data.get('phone', null), 20)
        && isOptStr(request.resource.data.get('teachingLevel', null), 100)
        && isOptStr(request.resource.data.get('qualifications', null), 500)
        && (!('jobMode' in request.resource.data)
            || request.resource.data.jobMode in ['beginner', 'advanced'])
        && (!('subjects' in request.resource.data)
            || (request.resource.data.subjects is list
                && request.resource.data.subjects.size() <= 20))
        && (!('experienceYears' in request.resource.data)
            || (request.resource.data.experienceYears is number
                && request.resource.data.experienceYears >= 0
                && request.resource.data.experienceYears <= 60));
      allow update: if isOwner(userId)
        // The update may touch ONLY these fields; role, verificationStatus
        // and isActive are excluded, so they cannot change here.
        // DASHBOARDS (Step 5): the academic fields added are semester,
        // academicSession, curriculum, phone and experienceYears.
        // subjects / teachingLevel / qualifications are DELIBERATELY
        // absent: a teacher's approved subjects change ONLY through the
        // admin-decided change request (teacherChangeRequests) — a
        // teacher must never silently rewrite their own approved set.
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['displayName', 'educationType', 'board', 'institution',
                       'academicYear', 'academicSession', 'curriculum',
                       'program', 'department', 'classLevel', 'semester',
                       'phone', 'experienceYears', 'jobMode',
                       'language', 'lastActiveAt', 'updatedAt'])
        && isOptStr(request.resource.data.displayName, 100)
        && isOptStr(request.resource.data.get('phone', null), 20)
        && (!('jobMode' in request.resource.data)
            || request.resource.data.jobMode in ['beginner', 'advanced'])
        && (!('experienceYears' in request.resource.data)
            || (request.resource.data.experienceYears is number
                && request.resource.data.experienceYears >= 0
                && request.resource.data.experienceYears <= 60));
      // Admin/Owner change role / verificationStatus / isActive, and only
      // they may do so — and only to valid enum values.
      // OWNER PROTECTION (spec §3): a users doc whose role is 'owner' is
      // EXCLUDED here. No admin or moderator can change the owner's role,
      // isActive, email, or downgrade the owner account — only the owner
      // themselves may touch their own doc (owner rule below).
      // (Review 20 Nov 2026 — B1/S4 fixed:) the admin update has a field
      // allowlist now: an admin can touch ONLY role / verificationStatus /
      // isActive / suspendedReason / verifiedBy / verifiedAt / updatedAt.
      // 'owner' is REMOVED from the assignable role enum — no admin can
      // create a second owner by direct Firestore call (client code alone
      // never enforced this). Email, displayName and education fields
      // cannot be overwritten by an admin. verificationStatus may change
      // ONLY together with verifiedBy == the caller (the decision path in
      // admin.ts sets it) — an admin cannot silently verify anyone.
      allow update: if isAdmin()
        && resource.data.role != 'owner'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['role', 'verificationStatus', 'isActive', 'suspendedReason',
                       'verifiedBy', 'verifiedAt', 'updatedAt'])
        && (!('role' in request.resource.data)
            || request.resource.data.role in ['admin', 'moderator', 'teacher', 'student', 'parent'])
        && (!('verificationStatus' in request.resource.data)
            || request.resource.data.verificationStatus in ['pending', 'verified', 'rejected', 'revoked'])
        && validVerificationTransition()
        && (!('isActive' in request.resource.data) || request.resource.data.isActive is bool)
        && (!('suspendedReason' in request.resource.data)
            || request.resource.data.suspendedReason is string
            || request.resource.data.suspendedReason == null)
        && (!('verificationStatus' in request.resource.data.diff(resource.data).affectedKeys())
            || request.resource.data.verifiedBy == uid());
      // DASHBOARDS (Step 7, branch draft): applying an APPROVED teacher
      // change request. An Admin may set a teacher's approved subjects /
      // teachingLevel / classLevel — ONLY those three fields, and only on
      // a teacher's doc. The change-request document + the audit entry
      // are written in the SAME batch by admin.ts (decideTeacherChange-
      // Request); the rules permit the field change, the code enforces
      // the batch + audit. A teacher can never set these fields
      // themselves (the self-update allowlist excludes them).
      allow update: if isAdmin()
        && resource.data.role == 'teacher'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['subjects', 'teachingLevel', 'classLevel', 'updatedAt'])
        && (!('subjects' in request.resource.data)
            || (request.resource.data.subjects is list
                && request.resource.data.subjects.size() > 0
                && request.resource.data.subjects.size() <= 20))
        && isOptStr(request.resource.data.get('teachingLevel', null), 100)
        && isOptStr(request.resource.data.get('classLevel', null), 100);
      // The owner updates ANY user's doc (highest authority — this is
      // what lets the owner rename a user, test (i1)). The owner may
      // touch profile fields + the admin fields, but may NEVER create a
      // second owner: role 'owner' is excluded here too. Exactly one
      // Owner exists; a second owner is created only in the Firebase
      // console by the owner himself, never by a client rule.
      allow update: if isOwnerRole()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['displayName', 'educationType', 'board', 'institution',
                       'academicYear', 'program', 'department', 'classLevel',
                       'language', 'lastActiveAt', 'role', 'verificationStatus',
                       'isActive', 'suspendedReason', 'verifiedBy', 'verifiedAt',
                       'jobMode', 'updatedAt'])
        // Role may NEVER be *changed to* 'owner' — but the owner's own doc
        // already carries role 'owner', and request.resource.data is the
        // FULL post-update document, so 'role' in request.resource.data is
        // always true. Only check the enum when role is actually in the
        // affected keys (i.e. being changed). Same for verificationStatus.
        && (!('role' in request.resource.data.diff(resource.data).affectedKeys())
            || request.resource.data.role in ['admin', 'moderator', 'teacher', 'student', 'parent'])
        && (!('verificationStatus' in request.resource.data.diff(resource.data).affectedKeys())
            || request.resource.data.verificationStatus in ['pending', 'verified', 'rejected', 'revoked'])
        && validVerificationTransition()
        && (!('isActive' in request.resource.data) || request.resource.data.isActive is bool)
        && isOptStr(request.resource.data.displayName, 100);
      allow delete: if false; // accounts are suspended (isActive=false), never deleted by clients
    }

    // ---------- quizAttempts (sub-collection under the user) ----------
    // Immutable after submit: create only, never update/delete by anyone
    // except an Admin delete for support. Readable by the owner +
    // Moderator/Admin (a moderator must read a written attempt to mark it).
    // EXCEPTION (Step 4, written exams): a Moderator/Admin may update ONLY
    // the marking fields of a PENDING written attempt (markingStatus ==
    // 'pending') — that is how a teacher marks typed answers (per-question
    // marks + correct flags inside `answers`, and the totals). An MCQ
    // attempt (markingStatus 'auto') can never be rewritten, and no one
    // may touch quizId or the submitted answer text once submitted.
    match /users/{userId}/quizAttempts/{attemptId} {
      // Readable by the owner, and by Moderator/Admin — a moderator must
      // be able to read a written attempt to mark it (Step 4).
      allow read: if isOwner(userId) || isModerator();
      allow create: if isOwner(userId) && callerActive()
        && request.resource.data.quizId is string
        && request.resource.data.answers is list
        && request.resource.data.score is number
        && request.resource.data.totalMarks is number
        && request.resource.data.percentage is number;
      allow update: if isModerator()
        && resource.data.markingStatus == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['answers', 'marks', 'score', 'percentage', 'markingStatus', 'markedBy', 'markedAt']);
      allow delete: if false;
    }

    // ---------- quizKeys + quizReceipts (Step 4 answer-key protection) ----------
    // The key is readable by Moderator/Admin any time, and by a student
    // ONLY while a fresh submission receipt exists for them + this quiz
    // (created by the app at submit time, deleted right after scoring;
    // a receipt older than 10 minutes no longer opens the key).
    function hasFreshReceipt(quizId) {
      return signedIn() && callerActive()
        && get(/databases/$(database)/documents/quizReceipts/$(uid() + '_' + quizId)).data.createdAt
            > request.time - duration.value(10, 'm');
    }
    match /quizKeys/{quizId} {
      allow read: if isModerator() || hasFreshReceipt(quizId);
      allow create, update: if isModerator();
      allow delete: if isAdmin();
    }
    // Receipt id is `{uid}_{quizId}` — one per student per quiz. Only the
    // owning student may create/delete their own receipt; nobody may
    // update one (a receipt is single-use by design).
    match /quizReceipts/{receiptId} {
      allow read: if isOwner(receiptId.split('_')[0]) || isAdmin();
      allow create: if signedIn() && callerActive()
        && receiptId == uid() + '_' + request.resource.data.quizId
        && request.resource.data.userId == uid()
        && request.resource.data.quizId is string
        && request.resource.data.attemptId is string
        && request.resource.data.createdAt is timestamp;
      allow update: if false;
      allow delete: if isOwner(receiptId.split('_')[0]);
    }

    // ---------- studyPlans / progressSummaries (owner only) ----------
    match /studyPlans/{planId} {
      allow read: if signedIn() && (resource.data.userId == uid() || isAdmin());
      allow create: if signedIn() && callerActive() && request.resource.data.userId == uid()
        && isStr(request.resource.data.title, 200);
      allow update, delete: if signedIn() && callerActive() && resource.data.userId == uid();
    }
    match /progressSummaries/{summaryId} {
      // DASHBOARDS (Step 8): a guardian with a VERIFIED link reads the
      // linked child's summaries (weak/strong subjects, results).
      allow read: if signedIn() && (resource.data.userId == uid() || isAdmin()
        || isLinkedGuardian(resource.data.userId));
      allow create, update: if signedIn() && callerActive() && request.resource.data.userId == uid()
        && request.resource.data.attemptsCount is number
        && request.resource.data.averagePercentage is number;
      allow delete: if isAdmin();
    }

    // ---------- bookmarks / progress (Step 3) — owner-scoped only ----------
    // One bookmark = one write; unbookmark = one delete. One progress
    // document per student per subject (lessons read + practice counts).
    // userId can never be spoofed: every write must carry the caller's
    // own uid, and updates may not move the doc to another user.
    match /bookmarks/{bookmarkId} {
      // DASHBOARDS (Step 8): a guardian with a VERIFIED link reads the
      // linked child's bookmarks (learning history).
      allow read: if signedIn() && (resource.data.userId == uid() || isAdmin()
        || isLinkedGuardian(resource.data.userId));
      allow create: if signedIn() && callerActive() && request.resource.data.userId == uid()
        && isStr(request.resource.data.lessonId, 200)
        && isStr(request.resource.data.title, 200);
      allow update: if signedIn() && callerActive() && resource.data.userId == uid()
        && request.resource.data.userId == uid();
      allow delete: if signedIn() && callerActive() && resource.data.userId == uid();
    }
    match /progress/{progressId} {
      // DASHBOARDS (Step 8): a guardian with a VERIFIED link reads the
      // linked child's progress (lessons read, practice counts).
      allow read: if signedIn() && (resource.data.userId == uid() || isAdmin()
        || isLinkedGuardian(resource.data.userId));
      allow create: if signedIn() && callerActive() && request.resource.data.userId == uid()
        && isStr(request.resource.data.subject, 100);
      allow update: if signedIn() && callerActive() && resource.data.userId == uid()
        && request.resource.data.userId == uid();
      allow delete: if isAdmin();
    }

    // ---------- public content: directory, books, chapters, lessons, quizzes ----------
    // Public reads ONLY where reviewStatus == "Published". Teachers/Admins
    // may read their own drafts; moderators read all. Teachers create
    // drafts only; only Moderator/Admin can publish / remove / send back.
    function contentRead(d) {
      return isPublished(d)
        || isModerator()
        || (signedIn() && callerActive() && d.get('authorId', '') == uid())
        || (signedIn() && callerActive() && d.get('createdBy', '') == uid());
    }
    function contentCreate() {
      return isTeacher()
        && isDraftStatus(request.resource.data.reviewStatus)
        && isStr(request.resource.data.title, 200);
    }
    function contentUpdate(d) {
      // Moderator/Admin may move any status (publish, correct, remove).
      // An author may edit only their own draft, and may not publish it.
      return isModerator()
        || (signedIn() && callerActive() && d.get('authorId', '') == uid()
            && isDraftStatus(d.reviewStatus)
            && isDraftStatus(request.resource.data.reviewStatus))
        || (signedIn() && callerActive() && d.get('createdBy', '') == uid()
            && isDraftStatus(d.reviewStatus)
            && isDraftStatus(request.resource.data.reviewStatus));
    }

    match /educationDirectory/{docId} {
      allow read: if contentRead(resource.data);
      allow create: if isTeacher() && isDraftStatus(request.resource.data.reviewStatus);
      allow update: if contentUpdate(resource.data);
      allow delete: if isAdmin();
    }
    match /books/{bookId} {
      allow read: if contentRead(resource.data);
      allow create: if contentCreate() && isStr(request.resource.data.sourceUrl, 2000);
      allow update: if contentUpdate(resource.data);
      allow delete: if isAdmin();
    }
    match /chapters/{chapterId} {
      allow read: if contentRead(resource.data);
      allow create: if contentCreate();
      allow update: if contentUpdate(resource.data);
      allow delete: if isAdmin();
    }
    match /lessons/{lessonId} {
      allow read: if contentRead(resource.data);
      allow create: if contentCreate() && isStr(request.resource.data.body, 100000);
      allow update: if contentUpdate(resource.data);
      allow delete: if isAdmin();
    }
    match /quizzes/{quizId} {
      allow read: if contentRead(resource.data);
      allow create: if contentCreate() && request.resource.data.questions is list;
      allow update: if contentUpdate(resource.data);
      allow delete: if isAdmin();
    }

    // ---------- contact form messages ----------
    // Any signed-in, active user may send a message (their own userId,
    // bounded fields). Only owner/admin may read messages; the client
    // can never update or delete one (append-only; admins reply from
    // the dashboard by creating a new record).
    match /contactMessages/{messageId} {
      allow read: if isAdmin();
      allow create: if signedIn() && callerActive()
        && request.resource.data.userId == uid()
        && isStr(request.resource.data.name, 100)
        && isStr(request.resource.data.message, 5000)
        && isOptStr(request.resource.data.email, 200);
      allow update, delete: if false;
    }

    // ---------- community posts / comments / questions / answers ----------
    // Create with reviewStatus forced to "Under Review". Authors edit only
    // their own while still unreviewed. Only Moderator/Admin publish/remove.
    match /posts/{postId} {
      allow read: if isPublished(resource.data) || isModerator()
        || (signedIn() && resource.data.authorId == uid());
      allow create: if signedIn() && callerActive()
        && request.resource.data.authorId == uid()
        && request.resource.data.reviewStatus == 'Under Review'
        && isStr(request.resource.data.title, 200)
        && isStr(request.resource.data.body, 5000);
      allow update: if isModerator()
        || (signedIn() && callerActive() && resource.data.authorId == uid()
            && resource.data.reviewStatus == 'Under Review'
            && request.resource.data.reviewStatus == 'Under Review');
      allow delete: if isAdmin();
    }
    match /posts/{postId}/comments/{commentId} {
      allow read: if isPublished(resource.data) || isModerator()
        || (signedIn() && resource.data.authorId == uid());
      allow create: if signedIn() && callerActive()
        && request.resource.data.authorId == uid()
        && request.resource.data.reviewStatus == 'Under Review'
        && isStr(request.resource.data.body, 1000);
      allow update, delete: if isModerator();
    }
    match /questions/{questionId} {
      allow read: if isPublished(resource.data) || isModerator()
        || (signedIn() && resource.data.authorId == uid());
      allow create: if signedIn() && callerActive()
        && request.resource.data.authorId == uid()
        && request.resource.data.reviewStatus == 'Under Review'
        && isStr(request.resource.data.title, 200)
        && isStr(request.resource.data.body, 5000);
      allow update: if isModerator()
        || (signedIn() && callerActive() && resource.data.authorId == uid()
            && resource.data.reviewStatus == 'Under Review'
            && request.resource.data.reviewStatus == 'Under Review');
      allow delete: if isAdmin();
    }
    match /questions/{questionId}/answers/{answerId} {
      allow read: if isPublished(resource.data) || isModerator()
        || (signedIn() && resource.data.authorId == uid());
      allow create: if signedIn() && callerActive()
        && request.resource.data.authorId == uid()
        && request.resource.data.reviewStatus == 'Under Review'
        && isStr(request.resource.data.body, 5000);
      // isAccepted may be set only by the question author or a moderator.
      allow update: if isModerator()
        || (signedIn() && callerActive() && get(/databases/$(database)/documents/questions/$(questionId)).data.authorId == uid());
      allow delete: if isAdmin();
    }

    // ---------- reports / moderationQueue ----------
    match /reports/{reportId} {
      allow read: if signedIn() && (resource.data.reporterId == uid() || isModerator());
      // (Review 20 Nov 2026 — F16:) a report must name what was reported,
      // or moderators cannot find the offending content. targetType /
      // targetId / targetAuthorId are required.
      allow create: if signedIn() && callerActive()
        && request.resource.data.reporterId == uid()
        && request.resource.data.status == 'open'
        && request.resource.data.reason in ['spam', 'abuse', 'copyright', 'personal-info', 'other']
        && request.resource.data.targetType in ['post', 'comment', 'socialPost', 'user', 'message']
        && request.resource.data.targetId is string
        && request.resource.data.targetAuthorId is string
        && isOptStr(request.resource.data.details, 2000);
      allow update: if isModerator();
      allow delete: if false;
    }
    // (Review 20 Nov 2026 — F17:) the queue used to be an unvalidated
    // free-for-all — any moderator could delete a genuine abuse report.
    // Queue items now have a shape, a status enum, and no delete.
    match /moderationQueue/{itemId} {
      allow read: if isModerator();
      allow create: if isModerator()
        && request.resource.data.reportId is string
        && request.resource.data.status in ['open', 'reviewing', 'resolved', 'dismissed'];
      allow update: if isModerator()
        && request.resource.data.reportId is string
        && request.resource.data.status in ['open', 'reviewing', 'resolved', 'dismissed'];
      allow delete: if false;
    }

    // ---------- teacherVerifications ----------
    // Applicant creates their own PENDING record only. Status, checkedBy and
    // checkedAt changeable ONLY by Admin/Owner after the human check.
    // (Review 20 Nov 2026 — child safety F1–F3, security S1 — hardened:)
    // - Decisions are ADMIN/OWNER only now (moderators cannot mint
    //   verified teachers alone; the dashboard is owner-only).
    // - Only a PENDING record can be decided; a moderator/admin can never
    //   decide their OWN application (userId != uid).
    // - Only the decision fields may change (affectedKeys) — userId,
    //   fullName, institution and createdAt cannot be rewritten.
    // - A reason (min 10 chars) is REQUIRED for every decision.
    // - Approving (status 'verified') additionally requires the human
    //   checklist: checks.identity + checks.institution +
    //   checks.subject + checks.adult all true (identity checked,
    //   institution checked, subject/qualification checked, applicant is
    //   an adult). A one-tap approve of a fake teacher is impossible.
    // - Re-opening a decided record (back to 'pending') is a separate,
    //   explicit path with its own reason — decided records cannot be
    //   silently flipped back and forth.
    match /teacherVerifications/{recordId} {
      // `resource == null` first: a first-time applicant has NO record
      // yet, and the form/lib must be able to read that absence
      // (getMyTeacherApplication returns null). Without the guard,
      // `resource.data.userId` on a missing doc throws a Null value
      // error and the read is DENIED — no data leaks either way, since
      // a missing doc returns nothing.
      allow read: if signedIn() && (resource == null || resource.data.userId == uid() || isModerator());
      allow create: if signedIn() && callerActive()
        && recordId == 'tv_' + uid()
        && request.resource.data.userId == uid()
        && request.resource.data.status == 'pending'
        && isStr(request.resource.data.fullName, 100)
        && isStr(request.resource.data.institution, 200)
        && isOptStr(request.resource.data.get('post', null), 100)
        && isOptStr(request.resource.data.get('institutionContact', null), 100);
      // DASHBOARDS (Step 5): a REJECTED teacher may re-apply — the
      // applicant re-files their own record as 'pending' again (same
      // deterministic id). Only the application fields may change, and
      // the record must have been 'rejected'.
      allow update: if signedIn() && callerActive()
        && resource.data.userId == uid()
        && resource.data.status == 'rejected'
        && request.resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['teachingLevel', 'subjects', 'classes', 'institution',
                       'post', 'institutionContact',
                       'qualifications', 'experienceYears', 'verificationReason',
                       'evidenceRef', 'status', 'verificationStatus',
                       'submittedAt', 'updatedAt'])
        && isStr(request.resource.data.fullName, 100)
        && isStr(request.resource.data.institution, 200);
      allow update: if isAdmin()
        && resource.data.status == 'pending'
        && resource.data.userId != uid()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'checkedBy', 'checkedAt', 'reason', 'checks', 'updatedAt'])
        && request.resource.data.status in ['pending', 'verified', 'rejected', 'revoked']
        && request.resource.data.checkedBy == uid()
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 10
        && (request.resource.data.status != 'verified'
            || (request.resource.data.checks is map
                && request.resource.data.checks.get('identity', false) == true
                && request.resource.data.checks.get('institution', false) == true
                && request.resource.data.checks.get('subject', false) == true
                && request.resource.data.checks.get('adult', false) == true));
      allow update: if isAdmin()
        && resource.data.status == 'verified'
        && resource.data.userId != uid()
        && request.resource.data.status == 'revoked'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'checkedBy', 'checkedAt', 'reason', 'updatedAt'])
        && request.resource.data.checkedBy == uid()
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 10;
      allow update: if isAdmin()
        && resource.data.status in ['verified', 'rejected', 'revoked']
        && resource.data.userId != uid()
        && request.resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'checkedBy', 'checkedAt', 'reason', 'updatedAt'])
        && request.resource.data.checkedBy == uid()
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 10;
      allow delete: if isAdmin();
    }

    // ---------- teacherChangeRequests (Dashboards Step 7, branch draft) ----------
    // A verified teacher's subject/class change goes through here — the
    // request is PENDING until an Admin approves it, and the dashboard
    // keeps showing the OLD approved subjects until then.
    // - CREATE: the teacher files their own request (teacherUid == uid,
    //   status 'pending', ≥1 subject + ≥1 class, reason ≥10 chars).
    // - READ: the teacher + Admin/Owner (the admin dashboard decides it).
    // - UPDATE: Admin ONLY, pending -> approved / rejected, with a reason
    //   (≥10 chars) and decidedBy == the caller. The profile update
    //   (subjects/teachingLevel/classLevel) + this decision + the audit
    //   entry are ONE batch in admin.ts — the rules permit each half.
    // - DELETE: never (a decided request stays as the audit trail).
    match /teacherChangeRequests/{requestId} {
      allow read: if signedIn() && (resource.data.teacherUid == uid() || isAdmin());
      allow create: if signedIn() && callerActive()
        && request.resource.data.teacherUid == uid()
        && request.resource.data.status == 'pending'
        && request.resource.data.requestedSubjects is list
        && request.resource.data.requestedSubjects.size() > 0
        && request.resource.data.requestedSubjects.size() <= 20
        && request.resource.data.requestedClasses is list
        && request.resource.data.requestedClasses.size() > 0
        && request.resource.data.requestedClasses.size() <= 20
        && isOptStr(request.resource.data.get('requestedTeachingLevel', null), 100)
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 10;
      allow update: if isAdmin()
        && resource.data.status == 'pending'
        && resource.data.teacherUid != uid()
        && request.resource.data.status in ['approved', 'rejected']
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'decidedBy', 'decidedAt', 'decisionReason', 'updatedAt'])
        && request.resource.data.decidedBy == uid()
        && request.resource.data.decisionReason is string
        && request.resource.data.decisionReason.size() >= 10;
      allow delete: if false;
    }

    // ---------- health (Health v1, owner brief 20 Nov 23:51) ----------
    // Eduvelto Health: medicines, diseases, doctors, hospitals/pharmacies.
    // Safety (Blueprint v4, binding): the AI Doctor is NOT a doctor; no
    // diagnosis, no prescribing, no invented dosages. ALL health content
    // needs qualified professional review before it is Published — so
    // students read ONLY Published records, and a moderator may edit
    // drafts only, never publish. Publishing is an ADMIN action (the
    // dashboard's publish step confirms professional review happened).
    // A medicine record may NEVER carry a dosage field — the loader and
    // the rules both refuse it.
    function healthRead(d) {
      return isPublished(d) || isModerator();
    }
    function healthDraftCreate() {
      return isModerator() && isDraftStatus(request.resource.data.reviewStatus);
    }
    function healthUpdate(d) {
      // Moderator: edit own drafts only, never publish.
      // Admin: edit + publish (publish = review-confirmed step).
      return (isModerator()
              && isDraftStatus(d.reviewStatus)
              && isDraftStatus(request.resource.data.reviewStatus))
        || isAdmin();
    }
    function noDosage() { return !('dosage' in request.resource.data); }

    match /medicines/{medicineId} {
      allow read: if healthRead(resource.data);
      allow create: if healthDraftCreate() && noDosage()
        && isStr(request.resource.data.title, 100)
        && isStr(request.resource.data.titleBn, 100)
        && isStr(request.resource.data.useBn, 2000)
        && isStr(request.resource.data.useEn, 2000)
        && isStr(request.resource.data.formBn, 200)
        && isStr(request.resource.data.formEn, 200)
        && isStr(request.resource.data.sideEffectsBn, 2000)
        && isStr(request.resource.data.sideEffectsEn, 2000)
        && isStr(request.resource.data.warningsBn, 2000)
        && isStr(request.resource.data.warningsEn, 2000)
        && isStr(request.resource.data.source, 200)
        && request.resource.data.prescriptionOnly is bool;
      allow update: if healthUpdate(resource.data) && noDosage();
      allow delete: if isAdmin();
    }
    match /diseases/{diseaseId} {
      allow read: if healthRead(resource.data);
      allow create: if healthDraftCreate()
        && isStr(request.resource.data.title, 100)
        && isStr(request.resource.data.titleBn, 100)
        && isStr(request.resource.data.symptomsBn, 2000)
        && isStr(request.resource.data.symptomsEn, 2000)
        && isStr(request.resource.data.preventionBn, 2000)
        && isStr(request.resource.data.preventionEn, 2000)
        && isStr(request.resource.data.seeDoctorBn, 2000)
        && isStr(request.resource.data.seeDoctorEn, 2000)
        && isStr(request.resource.data.source, 200);
      allow update: if healthUpdate(resource.data);
      allow delete: if isAdmin();
    }
    match /facilities/{facilityId} {
      allow read: if healthRead(resource.data);
      allow create: if healthDraftCreate()
        && isStr(request.resource.data.title, 200)
        && isStr(request.resource.data.titleBn, 200)
        && request.resource.data.kind in ['hospital', 'clinic', 'pharmacy']
        && isStr(request.resource.data.areaBn, 100)
        && isStr(request.resource.data.areaEn, 100)
        && isStr(request.resource.data.source, 200);
      allow update: if healthUpdate(resource.data);
      allow delete: if isAdmin();
    }
    // Doctors: a doctor is visible to students ONLY when BOTH
    // verificationStatus == 'verified' AND reviewStatus == 'Published'.
    // Verification is a human check, ADMIN-only, mirroring
    // teacherVerifications: only a PENDING record can be decided, never
    // the verifier's own application (userId != uid), a reason (>= 10
    // chars) is required, and 'verified' additionally requires the
    // checklist identity + qualification + adult all true. Moderators
    // may edit pending drafts but may never verify or publish.
    match /doctors/{doctorId} {
      allow read: if (isPublished(resource.data)
              && resource.data.verificationStatus == 'verified')
        || isModerator();
      allow create: if healthDraftCreate()
        && request.resource.data.verificationStatus == 'pending'
        && isStr(request.resource.data.title, 100)
        && isStr(request.resource.data.titleBn, 100)
        && isStr(request.resource.data.qualificationBn, 500)
        && isStr(request.resource.data.qualificationEn, 500)
        && isStr(request.resource.data.specialityBn, 200)
        && isStr(request.resource.data.specialityEn, 200)
        && isStr(request.resource.data.workplaceBn, 200)
        && isStr(request.resource.data.workplaceEn, 200);
      // Moderator draft edit: pending + stays pending, stays a draft.
      allow update: if isModerator()
        && resource.data.verificationStatus == 'pending'
        && request.resource.data.verificationStatus == 'pending'
        && isDraftStatus(resource.data.reviewStatus)
        && isDraftStatus(request.resource.data.reviewStatus);
      // Admin verification decision (pending -> verified / rejected).
      allow update: if isAdmin()
        && resource.data.verificationStatus == 'pending'
        && resource.data.get('userId', '') != uid()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['verificationStatus', 'verifiedBy', 'verifiedAt', 'reason', 'checks', 'updatedAt'])
        && request.resource.data.verificationStatus in ['verified', 'rejected']
        && request.resource.data.verifiedBy == uid()
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 10
        && (request.resource.data.verificationStatus != 'verified'
            || (request.resource.data.checks is map
                && request.resource.data.checks.get('identity', false) == true
                && request.resource.data.checks.get('qualification', false) == true
                && request.resource.data.checks.get('adult', false) == true));
      // Admin revoke (verified -> revoked) with a reason.
      allow update: if isAdmin()
        && resource.data.verificationStatus == 'verified'
        && resource.data.get('userId', '') != uid()
        && request.resource.data.verificationStatus == 'revoked'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['verificationStatus', 'verifiedBy', 'verifiedAt', 'reason', 'updatedAt'])
        && request.resource.data.verifiedBy == uid()
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 10;
      // Admin general edit + publish (verification untouched here).
      allow update: if isAdmin()
        && !('verificationStatus' in request.resource.data.diff(resource.data).affectedKeys());
      allow delete: if isAdmin();
    }

    // ---------- social (design gated: Phase 3, only after moderator + consent gates) ----------
    match /socialProfiles/{userId} {
      allow read: if isOwner(userId) || isModerator()
        || (resource.data.isPublic == true && isPublished(resource.data));
      allow create, update: if isOwner(userId)
        && isOptStr(request.resource.data.bio, 300)
        // A user may never make their own profile public: public visibility
        // is Admin-approved only (age cannot be verified).
        && request.resource.data.isPublic == false;
      allow delete: if isAdmin();
    }
    match /friendships/{pairId} {
      allow read: if signedIn()
        && (resource.data.userA == uid() || resource.data.userB == uid() || isModerator());
      allow create: if signedIn() && callerActive()
        && (request.resource.data.userA == uid() || request.resource.data.userB == uid())
        && request.resource.data.status == 'pending'
        && request.resource.data.guardianApproved == false;
      // Acceptance requires guardianApproved == true; only the recipient
      // may accept, and nobody may set guardianApproved themselves —
      // that field may only become true via a Moderator/Admin update.
      allow update: if isModerator()
        || (signedIn() && callerActive() && resource.data.userB == uid()
            && request.resource.data.status in ['accepted', 'declined', 'blocked']
            && request.resource.data.guardianApproved == resource.data.guardianApproved);
      allow delete: if false;
    }
    match /follows/{followId} {
      allow read: if signedIn() && resource.data.followerId == uid();
      allow create: if signedIn() && callerActive() && request.resource.data.followerId == uid();
      allow delete: if signedIn() && resource.data.followerId == uid();
      allow update: if false;
    }
    match /socialPosts/{postId} {
      allow read: if isPublished(resource.data) || isModerator()
        || (signedIn() && resource.data.authorId == uid());
      allow create: if signedIn() && callerActive()
        && request.resource.data.authorId == uid()
        && request.resource.data.reviewStatus == 'Under Review'
        && isStr(request.resource.data.body, 1000);
      allow update: if isModerator()
        || (signedIn() && callerActive() && resource.data.authorId == uid()
            && resource.data.reviewStatus == 'Under Review'
            && request.resource.data.reviewStatus == 'Under Review');
      allow delete: if isAdmin();
    }
    match /socialPosts/{postId}/comments/{commentId} {
      allow read: if isPublished(resource.data) || isModerator();
      allow create: if signedIn() && callerActive()
        && request.resource.data.authorId == uid()
        && request.resource.data.reviewStatus == 'Under Review'
        && isStr(request.resource.data.body, 500);
      allow update, delete: if isModerator();
    }
    match /studyGroups/{groupId} {
      allow read: if isPublished(resource.data) || isModerator();
      allow create: if signedIn() && callerActive() && request.resource.data.reviewStatus == 'Under Review'
        && isStr(request.resource.data.name, 100) && isStr(request.resource.data.description, 500);
      allow update: if isModerator();
      allow delete: if isAdmin();
    }
    match /groupMemberships/{membershipId} {
      allow read: if signedIn() && (resource.data.userId == uid() || isModerator());
      allow create: if signedIn() && callerActive() && request.resource.data.userId == uid()
        && request.resource.data.status == 'pending';
      allow update: if isModerator();
      allow delete: if isAdmin();
    }
    match /institutionPages/{pageId} {
      allow read: if isPublished(resource.data) || isModerator();
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }
    match /notices/{noticeId} {
      allow read: if isPublished(resource.data) || isModerator();
      allow create: if isModerator()
        && request.resource.data.reviewStatus == 'Under Review'
        && isStr(request.resource.data.title, 200) && isStr(request.resource.data.body, 2000);
      allow update: if isModerator();
      allow delete: if isAdmin();
    }

    // ---------- games / competitions (Phase 3) ----------
    match /games/{gameId} {
      allow read: if isPublished(resource.data) || isModerator();
      allow create: if contentCreate();
      allow update: if contentUpdate(resource.data);
      allow delete: if isAdmin();
    }
    match /users/{userId}/gameAttempts/{attemptId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && callerActive() && request.resource.data.gameId is string
        && request.resource.data.score is number;
      allow update, delete: if false;
    }
    match /competitions/{competitionId} {
      allow read: if isPublished(resource.data) || isModerator();
      allow create: if isModerator();
      allow update: if isModerator();
      allow delete: if isAdmin();
    }
    match /competitions/{competitionId}/entries/{userId} {
      allow read: if isOwner(userId) || isModerator();
      allow create: if isOwner(userId) && callerActive() && request.resource.data.score is number;
      allow update, delete: if false;
    }
    match /leaderboardSnapshots/{snapshotId} {
      allow read: if true;
      allow write: if isModerator();
    }

    // ---------- rewards / certificates / passport (Phases 3–4) ----------
    // rewardBalances: NO direct client write to points, ever. The document
    // is read-only for the owner; balances are computed on read from the
    // user's own attempts until a safe server-side rule is proven in Phase 2.
    match /rewardBalances/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false;
    }
    match /achievements/{key} {
      allow read: if isPublished(resource.data) || isModerator();
      allow write: if isAdmin();
    }
    match /users/{userId}/userAchievements/{key} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && callerActive();
      allow update, delete: if false;
    }
    match /certificates/{certId} {
      allow read: if signedIn() && (resource.data.userId == uid() || isAdmin());
      allow write: if isModerator();
    }
    match /users/{userId}/passportEntries/{entryId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && callerActive();
      allow update, delete: if false;
    }

    // ---------- career / opportunities (Phase 4) ----------
    match /careerPaths/{pathId} {
      allow read: if isPublished(resource.data) || isModerator();
      allow create: if isTeacher() && isDraftStatus(request.resource.data.reviewStatus);
      allow update: if contentUpdate(resource.data);
      allow delete: if isAdmin();
    }
    match /opportunities/{oppId} {
      allow read: if isPublished(resource.data) || isModerator();
      allow create: if isModerator() && isDraftStatus(request.resource.data.reviewStatus);
      allow update: if isModerator();
      allow delete: if isAdmin();
    }

    // ---------- parent links / invites (Phase 4, gated on consent design G7) ----------
    // DASHBOARDS (Step 8, branch draft): the full link lifecycle.
    // - CREATE: the guardian creates the link (parentId must be their own
    //   uid; the id is deterministic `{guardianUid}_{childUid}` — one
    //   link per guardian+child; status starts 'pending').
    // - CONFIRM: the CHILD confirms (pending -> confirmed). Only the
    //   child may do this, and only from 'pending'.
    // - SNAPSHOT: the CHILD keeps the denormalized academic snapshot in
    //   sync when their class changes (ProfilePage) — only the snapshot
    //   fields, status untouched. This is how the guardian dashboard
    //   updates automatically WITHOUT reading the child's users doc.
    // - REVOKE: either party may revoke at any time (status 'revoked').
    // - ACTIVATE: ONLY an Admin activates (pending/confirmed ->
    //   'verified') after cross-checking the written information; the
    //   admin sets verifiedBy/At + the decision reason.
    // - REJECT: ONLY an Admin rejects (pending/confirmed -> 'rejected')
    //   with a reason >= 10 chars; a rejected link is a dead end — the
    //   guardian may request again (a new link overwrites it).
    //   A guardian NEVER reads the child's users doc or messages through
    //   this collection — the snapshot carries only name + academic
    //   fields, and the rules tests prove the users-doc read is denied.
    match /parentLinks/{linkId} {
      // `resource == null` first: reading a link that does not exist
      // (e.g. a stale id) must return "not found", not a permission
      // error — same Null-value guard as teacherVerifications above.
      allow read: if signedIn()
        && (resource == null || resource.data.parentId == uid() || resource.data.studentId == uid() || isAdmin());
      allow create: if signedIn() && callerActive()
        && linkId == uid() + '_' + request.resource.data.studentId
        && request.resource.data.parentId == uid()
        && request.resource.data.studentId is string
        && request.resource.data.studentId != uid()
        && request.resource.data.status == 'pending'
        && isStr(request.resource.data.guardianDisplayName, 100)
        && isStr(request.resource.data.relationship, 50)
        && isOptStr(request.resource.data.get('guardianContact', null), 20)
        && isStr(request.resource.data.childDisplayName, 100)
        && isStr(request.resource.data.childClassLevel, 100)
        && isOptStr(request.resource.data.get('childInstitution', null), 200)
        && isOptStr(request.resource.data.get('childEducationType', null), 50)
        && isOptStr(request.resource.data.get('childDepartment', null), 100)
        && isOptStr(request.resource.data.get('childProgram', null), 100)
        && isOptStr(request.resource.data.get('childBoard', null), 200);
      allow update: if signedIn() && callerActive()
        && resource.data.studentId == uid()
        && resource.data.status == 'pending'
        && request.resource.data.status == 'confirmed'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'confirmedAt', 'updatedAt']);
      // Child REJECTS the request (pending -> revoked) — the child may
      // also reject by using the revoke clause below; this clause is
      // the same path, kept separate for clarity in tests.
      allow update: if signedIn() && callerActive()
        && resource.data.studentId == uid()
        && request.resource.data.status == resource.data.status
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['childClassLevel', 'childDisplayName', 'childEducationType',
                       'childDepartment', 'childProgram', 'childBoard', 'updatedAt'])
        && isStr(request.resource.data.childDisplayName, 100)
        && isStr(request.resource.data.childClassLevel, 100);
      allow update: if signedIn() && callerActive()
        && (resource.data.parentId == uid() || resource.data.studentId == uid())
        && request.resource.data.status == 'revoked'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'revokedAt', 'updatedAt']);
      allow update: if isAdmin()
        && resource.data.status in ['pending', 'confirmed']
        && request.resource.data.status == 'verified'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'verifiedBy', 'verifiedAt', 'decidedBy', 'decisionReason', 'updatedAt'])
        && request.resource.data.verifiedBy == uid()
        && (request.resource.data.get('decidedBy', null) == null || request.resource.data.decidedBy == uid())
        && isOptStr(request.resource.data.get('decisionReason', null), 500);
      allow update: if isAdmin()
        && resource.data.status in ['pending', 'confirmed']
        && request.resource.data.status == 'rejected'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'decidedBy', 'decisionReason', 'rejectedAt', 'updatedAt'])
        && request.resource.data.decidedBy == uid()
        && isStr(request.resource.data.decisionReason, 500);
      allow update: if isAdmin()
        && resource.data.status in ['pending', 'confirmed', 'verified']
        && request.resource.data.status == 'revoked'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'revokedAt', 'updatedAt']);
      allow delete: if isAdmin();
    }
    match /parentInvites/{inviteId} {
      allow read: if signedIn() && (resource.data.studentId == uid() || isAdmin());
      allow create: if signedIn() && callerActive() && request.resource.data.studentId == uid()
        && request.resource.data.status == 'sent';
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ---------- gift catalogue / partnerships: empty / owner-only until funded ----------
    match /giftCatalogue/{giftId} {
      allow read: if resource.data.status == 'available' || isAdmin();
      allow write: if isAdmin();
    }
    match /giftRedemptions/{redemptionId} {
      allow read: if signedIn() && (resource.data.userId == uid() || isAdmin());
      allow create: if signedIn() && callerActive() && request.resource.data.userId == uid()
        && request.resource.data.status == 'requested';
      allow update: if isAdmin();
      allow delete: if false;
    }
    match /partnerships/{partnerId} {
      allow read, write: if isAdmin();
    }

    // ---------- adminActions (append-only audit log, spec §3) ----------
    // Admins/Owners record their own actions (actorId must be their own
    // uid). Readable by the owner ONLY. Entries are never updated or
    // deleted by anyone — the log is append-only.
    // (Review 20 Nov 2026 — security S3:) the action is now a fixed enum
    // (no forged "action" strings), only the known fields may be present,
    // and createdAt must be a real timestamp (no backdating). The client
    // writes the action + its audit entry in ONE batch (admin.ts), so an
    // action cannot happen with no audit trail.
    match /adminActions/{actionId} {
      allow create: if isAdmin()
        && request.resource.data.actorId == uid()
        && request.resource.data.action in [
             'user-suspend', 'user-reactivate', 'user-role-change',
             'teacher-verification-approved', 'teacher-verification-rejected',
             'teacher-verification-revoked', 'teacher-verification-reopened',
             'teacher-change-approved', 'teacher-change-rejected',
             'guardian-link-approved', 'guardian-link-rejected', 'guardian-link-revoked',
             'feature-enabled', 'feature-disabled',
             'backup-exported',
             'user-profile-viewed', 'user-messages-viewed',
             'support-message-sent', 'message-reported', 'message-blocked']
        && request.resource.data.keys().hasOnly(
             ['actorId', 'action', 'details', 'targetId', 'before', 'after', 'reason', 'createdAt'])
        && request.resource.data.createdAt is timestamp;
      // DASHBOARDS (Step 5): a user appends ONLY their own profile-change
      // audit entry (action 'profile-changed', actorId == targetId ==
      // their own uid), written in the SAME batch as the profile update
      // by profile.ts — the change and its audit trail succeed or fail
      // together. The log stays append-only: nobody may update or
      // delete an entry, and a user can never forge another action or
      // another user's entry.
      allow create: if signedIn() && callerActive()
        && request.resource.data.actorId == uid()
        && request.resource.data.targetId == uid()
        && request.resource.data.action == 'profile-changed'
        && request.resource.data.keys().hasOnly(
             ['actorId', 'action', 'details', 'targetId', 'before', 'after', 'createdAt'])
        && request.resource.data.details is string
        && request.resource.data.createdAt is timestamp;
      // DASHBOARDS (Step 8): guardian-link audit entries written by the
      // guardian / child themselves, in the SAME batch as the link
      // change (guardian.ts) — request, child confirmation, and a
      // guardian/child revoke each append one entry. actorId must be the
      // caller; targetId must be the parentLinks document id
      // (`{guardianUid}_{childUid}`), so an entry always names the link
      // it belongs to and nobody can forge another family's entry. The
      // admin's decision entries (approved/rejected/revoked) go through
      // the admin clause above.
      allow create: if signedIn() && callerActive()
        && request.resource.data.actorId == uid()
        && request.resource.data.action in [
             'guardian-link-requested', 'guardian-link-confirmed', 'guardian-link-revoked']
        && request.resource.data.targetId is string
        && request.resource.data.targetId.matches('^[^_]+_[^_]+$')
        && request.resource.data.keys().hasOnly(
             ['actorId', 'action', 'details', 'targetId', 'before', 'after', 'createdAt'])
        && request.resource.data.details is string
        && request.resource.data.createdAt is timestamp;
      allow read: if isOwnerRole();
      allow update, delete: if false;
    }

    // ---------- settings (dashboard-controlled toggles) ----------
    // (Review 20 Nov 2026 — security B4, cost F9, child safety F13:)
    // there was NO settings rule at all, so every feature toggle failed
    // with permission-denied. The dashboard could not work.
    // - settings/features: read by any signed-in user (plain booleans —
    //   NEVER put secrets, API keys or AdSense IDs in this doc); write by
    //   the OWNER ONLY, field allowlist = the 11 known flags + updatedAt,
    //   every flag value must be a boolean. Category C flags
    //   (live-classes, video-ads, paid-subscriptions) are additionally
    //   hard-blocked in admin.ts — the code refuses them, so even the
    //   owner cannot flip one by accident from the dashboard; enabling
    //   one needs a separate, explicitly-approved owner decision.
    // - settings/ads: the future home of the ad placement toggles
    //   (today they are localStorage-only — see lib/ads.ts). The
    //   bottom-banner is DELIBERATELY absent from this allowlist: the
    //   persistent banner can never be turned off (owner brief
    //   20 Nov 21:52), so there is no field for it to be stored in.
    match /settings/features {
      allow read: if signedIn();
      allow create: if isOwnerRole()
        && request.resource.data.keys().toSet().hasOnly(
             ['ai-teacher', 'video-uploads', 'comments', 'social', 'games',
              'health', 'career', 'offline-downloads', 'live-classes',
              'video-ads', 'paid-subscriptions', 'updatedAt'])
        && request.resource.data.get('ai-teacher', false) is bool
        && request.resource.data.get('video-uploads', false) is bool
        && request.resource.data.get('comments', false) is bool
        && request.resource.data.get('social', false) is bool
        && request.resource.data.get('games', false) is bool
        && request.resource.data.get('health', false) is bool
        && request.resource.data.get('career', false) is bool
        && request.resource.data.get('offline-downloads', false) is bool
        && request.resource.data.get('live-classes', false) is bool
        && request.resource.data.get('video-ads', false) is bool
        && request.resource.data.get('paid-subscriptions', false) is bool
        && request.resource.data.updatedAt is timestamp;
      allow update: if isOwnerRole()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['ai-teacher', 'video-uploads', 'comments', 'social', 'games',
                       'health', 'career', 'offline-downloads', 'live-classes',
                       'video-ads', 'paid-subscriptions', 'updatedAt'])
        && request.resource.data.get('ai-teacher', false) is bool
        && request.resource.data.get('video-uploads', false) is bool
        && request.resource.data.get('comments', false) is bool
        && request.resource.data.get('social', false) is bool
        && request.resource.data.get('games', false) is bool
        && request.resource.data.get('health', false) is bool
        && request.resource.data.get('career', false) is bool
        && request.resource.data.get('offline-downloads', false) is bool
        && request.resource.data.get('live-classes', false) is bool
        && request.resource.data.get('video-ads', false) is bool
        && request.resource.data.get('paid-subscriptions', false) is bool;
      allow delete: if false;
    }
    match /settings/ads {
      allow read: if signedIn();
      allow create, update: if isOwnerRole()
        && request.resource.data.keys().toSet().hasOnly(['in-feed', 'in-feed-2', 'updatedAt'])
        && request.resource.data.get('in-feed', true) is bool
        && request.resource.data.get('in-feed-2', true) is bool;
      allow delete: if false;
    }

    // ---------- messenger (owner decision 20 Nov 23:25 — private messaging
    // IS in the product, staged, with mandatory safeguards) ----------
    // Phase 1a — support messaging (owner/admin <-> any user): a user
    // opens their own support thread; owner/admin read and reply.
    // Messages are TEXT ONLY in Phase 1 (kind == 'text' — no voice/video
    // calls). Every message is logged; the owner can view any thread
    // (audit-logged from the dashboard). The rules below are LIVE.
    match /supportMessages/{threadId} {
      allow read: if signedIn() && (resource.data.userId == uid() || isAdmin());
      allow create: if signedIn() && callerActive()
        && request.resource.data.userId == uid()
        && request.resource.data.status in ['open', 'closed'];
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['open', 'closed'];
      allow delete: if false;
    }
    match /supportMessages/{threadId}/messages/{messageId} {
      allow read: if signedIn()
        && (get(/databases/$(database)/documents/supportMessages/$(threadId)).data.userId == uid() || isAdmin());
      allow create: if signedIn() && callerActive()
        && request.resource.data.senderId == uid()
        && request.resource.data.kind == 'text'
        && isStr(request.resource.data.body, 2000);
      allow update, delete: if false;
    }
    // Phase 1b — direct messages (student <-> student, teacher <->
    // student): RULES SCAFFOLD ONLY — client writes are DENIED until the
    // six mandatory safeguards from the 23:25 decision exist in code, AND
    // the privacy + messaging design proposal is explicitly approved by
    // the owner. PRIVACY BRIEF 21 Nov 00:17 (binding, supersedes the
    // 23:25 access model): NO routine access to private message content
    // for ANYONE — not the owner, not admins, not moderators, not
    // teachers, not guardians. Guardians must NOT read their children's
    // private messages; teachers must NOT read students' private
    // messages. That is why the read rule below is participants ONLY —
    // isAdmin() was deliberately REMOVED: no routine admin/owner read of
    // private DM content is possible, even at the rules level.
    // Exceptional access is allowed ONLY for a serious safety incident,
    // via a clearly documented, auditable process with Owner approval,
    // time-boxed, scoped, read-only, every read logged — never hidden or
    // unrestricted. No inbox-viewing feature is built until the design is
    // approved. Until the safeguards + approval land, DMs stay OFF and
    // this match proves it in the emulator tests.
    // The 23:25 decision SUPERSEDES the 13:19 "moderated groups only"
    // decision (DMs exist); the 00:17 brief supersedes the 23:25 ACCESS
    // model (nobody routinely reads them). Blueprint v4 §2.1 + the Phase
    // 2 plan social section must be updated to match both.
    match /directMessages/{threadId} {
      allow read: if signedIn() && uid() in resource.data.get('participants', []);
      allow create, update, delete: if false;
    }
    match /directMessages/{threadId}/messages/{messageId} {
      allow read: if signedIn()
        && uid() in get(/databases/$(database)/documents/directMessages/$(threadId)).data.get('participants', []);
      allow create, update, delete: if false;
    }

    // ---------- everything else: denied ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
