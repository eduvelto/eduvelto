    function validJobExamDefinitionRulesSnapshot(s, kind) {
      return s is map
        && s.get('questionCount', null) is int
        && s.get('questionCount', 0) >= 1 && s.get('questionCount', 0) <= 200
        && s.get('timeMinutes', null) is int
        && s.get('timeMinutes', 0) >= 1 && s.get('timeMinutes', 0) <= 600
        && (kind != 'daily'
            || (s.get('questionCount', 0) >= 20 && s.get('questionCount', 0) <= 30
                && s.get('timeMinutes', 0) >= 20 && s.get('timeMinutes', 0) <= 30))
        && s.get('marksPerQuestion', null) == 1
        && (s.get('negativeMarking', null) == null
            || s.get('negativeMarking', null) == 0
            || s.get('negativeMarking', null) == 0.25
            || s.get('negativeMarking', null) == 0.5)
        && s.get('negativeMarkingVerified', null) is bool
        && (s.get('passPercent', null) == null
            || (s.get('passPercent', null) is number
                && s.get('passPercent', 0) >= 0 && s.get('passPercent', 0) <= 100))
        && isStr(s.get('scoringConfigVersion', null), 100);
    }
    function validJobExamDefinition(d, mockId) {
      return d.get('examSlug', null) in jobExamSlugs()
        && d.get('examSlug', null) != 'it-professional'
        && isStr(d.get('titleBn', null), 200)
        && isStr(d.get('titleEn', null), 200)
        && d.get('kind', null) in ['daily', 'weekly', 'full']
        && isStr(d.get('bundleId', null), 200)
        && isStr(d.get('questionSetId', null), 200)
        && validJobExamDefinitionRulesSnapshot(d.get('rulesSnapshot', null), d.get('kind', null))
        && ((d.get('kind', null) == 'daily'
              && d.get('scheduleDate', null) is string
              && mockId == 'daily__' + d.get('scheduleDate', ''))
            || (d.get('kind', null) == 'weekly'
              && d.get('scheduleDate', null) is string
              && mockId.matches('^weekly__[0-9]{4}-W[0-9]{2}$'))
            || (d.get('kind', null) == 'full'
              && d.get('scheduleDate', null) == null
              && mockId.matches('^full__' + d.get('examSlug', '') + '__[0-9]+$')))
        && ((d.get('kind', null) == 'weekly'
              && d.get('examSlugCycle', null) in ['bcs', 'bank', 'primary-teacher', 'ntrca'])
            || (d.get('kind', null) != 'weekly' && d.get('examSlugCycle', null) == null))
        && d.get('status', null) in ['draft', 'published', 'archived']
        && d.get('retakeAllowed', null) is bool
        && (d.get('maxAttempts', null) == null
            || (d.get('maxAttempts', null) is int && d.get('maxAttempts', 0) >= 1))
        && (isOptTs(d, 'publishedAt'))
        && (isOptStrNoMax(d, 'publishedBy'))
        && (isOptTs(d, 'createdAt'))
        && (isOptTs(d, 'updatedAt'));
    }
    match /jobExamDefinitions/{mockId} {
      allow read: if resource.data.get('status', '') == 'published' || isModerator();
      allow create: if isModerator()
        && onlyKeys(['examSlug', 'titleBn', 'titleEn',
             'kind', 'bundleId', 'questionSetId', 'rulesSnapshot', 'scheduleDate', 'examSlugCycle',
             'status', 'retakeAllowed', 'maxAttempts', 'publishedAt', 'publishedBy',
             'createdAt', 'updatedAt'])
        && request.resource.data.get('status', '') == 'draft'
        && validJobExamDefinition(request.resource.data, mockId);
      allow update: if isModerator()
        && onlyKeys(['examSlug', 'titleBn', 'titleEn',
             'kind', 'bundleId', 'questionSetId', 'rulesSnapshot', 'scheduleDate', 'examSlugCycle',
             'status', 'retakeAllowed', 'maxAttempts', 'publishedAt', 'publishedBy',
             'createdAt', 'updatedAt'])
        && validJobExamDefinition(request.resource.data, mockId)
        && ((resource.data.get('status', '') == 'draft'
              && request.resource.data.get('status', '') in ['draft', 'published', 'archived'])
            || (resource.data.get('status', '') == 'published'
              && request.resource.data.get('status', '') in ['published', 'archived']
              && changedKeys()
                   .hasOnly(['titleBn', 'titleEn', 'status', 'retakeAllowed',
                             'maxAttempts', 'questionSetId', 'publishedAt', 'publishedBy', 'updatedAt']))
            || (resource.data.get('status', '') == 'archived'
              && request.resource.data.get('status', '') in ['archived', 'draft']));
      allow delete: if isAdmin();
    }
    function validJobQuestionSetManifest(d) {
      return d.get('examSlug', null) in jobExamSlugs()
        && d.get('examSlug', null) != 'it-professional'
        && isStr(d.get('mockId', null), 200)
        && d.get('version', null) is int && d.get('version', 0) >= 1
        && d.get('questionCount', null) is int
        && d.get('questionCount', 0) >= 1 && d.get('questionCount', 0) <= 200
        && d.get('questionRefs', null) is list
        && d.get('questionRefs', []).size() == d.get('questionCount', 0)
        && isStr(d.get('markingSchemeVersion', null), 100)
        && d.get('status', null) in ['draft', 'published', 'archived']
        && (isOptTs(d, 'publishedAt'))
        && (isOptStrNoMax(d, 'publishedBy'))
        && (isOptTs(d, 'createdAt'))
        && (isOptTs(d, 'updatedAt'));
    }
    match /jobQuestionSetManifests/{questionSetId} {
      allow read: if resource.data.get('status', '') == 'published' || isModerator();
      allow create: if isModerator()
        && onlyKeys(['examSlug', 'mockId', 'version',
             'questionCount', 'questionRefs', 'markingSchemeVersion', 'status',
             'publishedAt', 'publishedBy', 'createdAt', 'updatedAt'])
        && request.resource.data.get('status', '') == 'draft'
