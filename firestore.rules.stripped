    function quizReceiptData(quizId) {
      return get(/databases/$(database)/documents/quizReceipts/$(uid() + '_' + quizId)).data;
    }
    function quizReceiptAttemptData(attemptId) {
      return get(/databases/$(database)/documents/users/$(uid())/quizAttempts/$(attemptId)).data;
    }
    function hasFreshReceipt(quizId, receipt) {
      return signedIn() && callerActive()
        && receipt.createdAt > request.time - duration.value(10, 'm')
        && receipt.createdAt <= request.time
        && receipt.attemptId is string
        && exists(/databases/$(database)/documents/users/$(uid())/quizAttempts/$(receipt.attemptId))
        && quizReceiptAttemptData(receipt.attemptId).status == 'submitted'
        && quizReceiptAttemptData(receipt.attemptId).quizId == quizId
        && quizReceiptAttemptData(receipt.attemptId).userId == uid();
    }
    match /quizKeys/{quizId} {
      allow read: if isModerator()
        || (signedIn() && callerActive()
            && exists(/databases/$(database)/documents/quizReceipts/$(uid() + '_' + quizId))
            && hasFreshReceipt(quizId, quizReceiptData(quizId)));
      allow create, update: if isModerator();
      allow delete: if isAdmin();
    }
    function quizReceiptAttemptMatches(data, a) {
      return a.status == 'submitted'
        && a.quizId == data.get('quizId', '')
        && a.userId == uid();
    }
    match /quizReceipts/{receiptId} {
      allow read: if isOwner(receiptId.split('_')[0]) || isAdmin();
      allow create: if signedIn() && callerActive()
        && receiptId == uid() + '_' + request.resource.data.quizId
        && onlyKeys(['userId', 'quizId', 'attemptId', 'createdAt'])
        && request.resource.data.userId == uid()
        && request.resource.data.quizId is string
        && request.resource.data.quizId.size() <= 200
        && request.resource.data.attemptId is string
        && request.resource.data.attemptId.size() <= 200
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdAt <= request.time
        && request.resource.data.createdAt > request.time - duration.value(5, 'm')
        && exists(/databases/$(database)/documents/users/$(uid())/quizAttempts/$(request.resource.data.attemptId))
        && quizReceiptAttemptMatches(request.resource.data, get(/databases/$(database)/documents/users/$(uid())/quizAttempts/$(request.resource.data.attemptId)).data)
        && exists(/databases/$(database)/documents/quizzes/$(request.resource.data.quizId));
      allow update: if false;
      allow delete: if isOwner(receiptId.split('_')[0]);
