rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function isOwner(id) { return signedIn() && uid() == id; }
    function callerRole() {
      return get(/databases/$(database)/documents/users/$(uid())).data.get('role', '');
    }
    function callerActive() {
      return get(/databases/$(database)/documents/users/$(uid())).data.get('isActive', true) != false;
    }
    function isAdmin() {
      return signedIn() && callerActive() && callerRole() in ['admin', 'owner'];
    }
    function isOwnerRole() {
      return signedIn() && callerRole() == 'owner';
    }
    function isModerator() {
      return signedIn() && callerActive() && (callerRole() in ['moderator', 'admin', 'owner']);
    }
    function isTeacher() {
      return signedIn() && callerActive() && (callerRole() in ['teacher', 'admin', 'moderator', 'owner']);
    }
    function isVerifiedTeacher() {
      return signedIn() && callerActive() && callerRole() == 'teacher'
        && get(/databases/$(database)/documents/users/$(uid())).data.get('verificationStatus', '') == 'verified';
    }
    function callerVerificationStatus() {
      return get(/databases/$(database)/documents/users/$(uid())).data.get('verificationStatus', '');
    }
    function isVerifiedJobBankAuthor() {
      return signedIn()
        && isVerifiedJobBankAuthorFor(get(/databases/$(database)/documents/users/$(uid())).data);
    }
    function isVerifiedJobBankAuthorFor(d) {
      return d.get('isActive', true) != false
        && (d.get('role', '') in ['admin', 'moderator', 'owner']
            || (d.get('role', '') == 'teacher' && d.get('verificationStatus', '') == 'verified'));
    }
    function isLinkedGuardian(studentId) {
      return signedIn() && callerActive()
        && exists(/databases/$(database)/documents/parentLinks/$(uid() + '_' + studentId))
        && get(/databases/$(database)/documents/parentLinks/$(uid() + '_' + studentId)).data.status == 'verified';
    }
    function isStr(v, max) { return v is string && v.size() > 0 && v.size() <= max; }
    function isOptStr(v, max) { return v == null || (v is string && v.size() <= max); }
    function changedKeys() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function onlyKeys(keys) { return request.resource.data.keys().hasOnly(keys); }
    function reqBundleExists() { return exists(/databases/$(database)/documents/jobQuestionBundles/$(request.resource.data.get('bundleId', ''))); }
    function isOptTs(d, f) { return d.get(f, null) == null || d.get(f, null) is timestamp; }
    function isOptStrNoMax(d, f) { return d.get(f, null) == null || d.get(f, null) is string; }
    function sameCreator() { return request.resource.data.createdBy == resource.data.createdBy; }
    function adminOrOwnTeacher() { return isAdmin() || (isVerifiedTeacher() && resource.data.createdBy == uid()); }
    function ownCreate() { return signedIn() && callerActive() && request.resource.data.userId == uid(); }
    function ownExisting() { return signedIn() && callerActive() && resource.data.userId == uid(); }
    function reviewKeys() { return ['status', 'reviewStatus', 'verifiedBy', 'verifiedAt', 'updatedAt']; }
    function isDraftStatus(s) { return s in ['Not Started', 'In Progress', 'Under Review']; }
    function isPublished(d) { return d.get('reviewStatus', '') == 'Published'; }
    function jobCategoryIds() {
      return ['bcs-bpsc', 'govt', 'bank', 'primary-teacher',
              'ntrca-teacher', 'defence-police', 'autonomous',
              'ngo-private', 'it-professional', 'other-competitive'];
    }
    function jobExamSlugs() {
      return ['bcs', 'bank', 'primary-teacher', 'ntrca', 'dgfood',
              'bpsc-non-cadre', 'cag', 'bfsa', 'others', 'ministries',
              'defence', 'autonomous', 'private-ngo', 'it-professional'];
    }
    function canonicalJobSubjectIds() {
      return ['bcs__bangla', 'bcs__english', 'bcs__bangladesh-affairs',
              'bcs__international-affairs', 'bcs__geography',
              'bcs__general-science', 'bcs__computer-ict',
              'bcs__mathematical-reasoning', 'bcs__mental-ability',
              'bcs__ethics',
              'bank__bangla', 'bank__english', 'bank__math',
              'bank__general-knowledge', 'bank__computer',
              'primary-teacher__bangla', 'primary-teacher__english',
              'primary-teacher__math-science',
              'primary-teacher__general-knowledge',
              'ntrca__bangla', 'ntrca__english', 'ntrca__math',
              'ntrca__general-knowledge'];
    }
    function isJobExamReviewState(s) {
      return s in ['Not Started', 'In Progress', 'Under Review', 'Published'];
    }
    function jobExamStatesConsistent(d) {
      return (d.get('status', '') == 'published') == (d.get('reviewStatus', '') == 'Published');
    }
    function jobPatternStatuses() {
      return ['verified', 'last_verified', 'not_verified', 'not_applicable', 'scope_pending'];
    }
    function validJobRulesConfig(c) {
      return c == null || (c is map
        && (c.get('questionCount', null) == null
            || (c.get('questionCount', null) is int && c.get('questionCount', null) >= 1))
        && (c.get('timeMinutes', null) == null
            || (c.get('timeMinutes', null) is int && c.get('timeMinutes', null) >= 1))
        && (c.get('marksPerQuestion', null) == null
            || (c.get('marksPerQuestion', null) is int && c.get('marksPerQuestion', null) >= 1))
        && (c.get('negativeMarking', null) == null
            || (c.get('negativeMarking', null) is number && c.get('negativeMarking', null) >= 0
                && (c.get('marksPerQuestion', null) == null
                    || c.get('negativeMarking', null) < c.get('marksPerQuestion', null))))
        && (c.get('provisionalNegativeMarking', null) == null
            || (c.get('provisionalNegativeMarking', null) is number
                && c.get('provisionalNegativeMarking', null) >= 0))
        && (c.get('negativeMarkingVerified', null) == null
            || c.get('negativeMarkingVerified', null) is bool)
        && (c.get('negativeMarkingVerified', null) != false
            || c.get('negativeMarking', null) == null)
        && (c.get('passMark', null) == null
            || (c.get('passMark', null) is int && c.get('passMark', null) >= 0))
        && (c.get('passPercent', null) == null
            || (c.get('passPercent', null) is int && c.get('passPercent', null) >= 0
                && c.get('passPercent', null) <= 100))
        && (c.get('subjects', null) == null || c.get('subjects', null) is list)
        && (c.get('patternLabel', null) == null
            || c.get('patternLabel', null) in ['verified', 'last-verified-18th', 'circular-based'])
        && (c.get('patternStatus', null) == null
            || c.get('patternStatus', null) in jobPatternStatuses())
        && (c.get('patternStatus', null) != 'verified'
            || c.get('negativeMarkingVerified', null) != false)
        && (c.get('applicableCycle', null) == null || c.get('applicableCycle', null) is string)
        && (c.get('patternSource', null) == null || c.get('patternSource', null) is string)
        && (c.get('patternVerifiedAt', null) == null || c.get('patternVerifiedAt', null) is timestamp));
    }
    function lastHistoryEntry(hist) {
      return hist[hist.size() - 1];
    }
    function validJobRulesConfigHistoryChange(oldDoc, newDoc) {
      return newDoc.get('rulesConfigHistory', null) is list
        && ((newDoc.get('rulesConfigHistory', null) == oldDoc.get('rulesConfigHistory', null)
              && newDoc.get('rulesConfig', null) == oldDoc.get('rulesConfig', null))
            || (newDoc.get('rulesConfigHistory', null).size()
                  == oldDoc.get('rulesConfigHistory', []).size() + 1
                && newDoc.get('rulesConfigHistory', null).toSet()
                     .hasAll(oldDoc.get('rulesConfigHistory', []).toSet())
                && lastHistoryEntry(newDoc.get('rulesConfigHistory', null)) is map
                && lastHistoryEntry(newDoc.get('rulesConfigHistory', null))
                     .get('changedAt', null) is timestamp
                && lastHistoryEntry(newDoc.get('rulesConfigHistory', null))
                     .get('changedBy', null) == uid()
                && lastHistoryEntry(newDoc.get('rulesConfigHistory', null))
                     .get('reason', null) is string
                && lastHistoryEntry(newDoc.get('rulesConfigHistory', null))
                     .get('before', null) == oldDoc.get('rulesConfig', null)
                && lastHistoryEntry(newDoc.get('rulesConfigHistory', null))
                     .get('after', null) == newDoc.get('rulesConfig', null)
                && (lastHistoryEntry(newDoc.get('rulesConfigHistory', null))
                     .get('sourceCircular', null) == null
                    || lastHistoryEntry(newDoc.get('rulesConfigHistory', null))
                     .get('sourceCircular', null) is string)));
    }
    function isValidNuSubject(data) {
      return data.slug is string && data.slug.size() > 0
        && data.nameBn is string && data.nameBn.size() > 0
        && data.syllabusSource is string && data.syllabusSource.size() > 0
        && data.status in ['draft', 'published']
        && data.circularVersion is string && data.circularVersion.size() > 0
        && data.createdBy is string && data.createdBy.size() > 0
        && data.groupIds is list
        && data.groupIds.size() >= 1 && data.groupIds.size() <= 3
        && data.groupIds.hasOnly(['humanities', 'science', 'business'])
        && data.marks is int
        && data.isGroupBlock is bool
        && !('order' in data)
        && ((data.isGroupBlock == true && data.marks == 40
            && data.slug in ['group-humanities', 'group-science', 'group-business'])
          || (data.isGroupBlock == false && data.marks == 20
            && data.slug in ['bangla', 'english', 'general-knowledge']));
    }
    function isValidNuChapter(data) {
      return data.subjectId is string && data.subjectId.size() > 0
        && data.slug is string && data.slug.size() > 0
        && data.nameBn is string && data.nameBn.size() > 0
        && data.order is int && data.order >= 1
        && data.syllabusSource is string && data.syllabusSource.size() > 0
        && data.syllabusVerified is bool
        && data.status in ['draft', 'published']
        && data.circularVersion is string && data.circularVersion.size() > 0
        && data.createdBy is string && data.createdBy.size() > 0;
    }
    function isValidNuTopic(data) {
      return data.subjectId is string && data.subjectId.size() > 0
        && data.chapterId is string && data.chapterId.size() > 0
        && data.slug is string && data.slug.size() > 0
        && data.nameBn is string && data.nameBn.size() > 0
        && data.detailBn is string && data.detailBn.size() > 0
        && data.order is int && data.order >= 1
        && data.syllabusSource is string && data.syllabusSource.size() > 0
        && data.syllabusVerified is bool
        && data.status in ['draft', 'published']
        && data.circularVersion is string && data.circularVersion.size() > 0
        && data.createdBy is string && data.createdBy.size() > 0;
    }
    function isValidNuLesson(data) {
      return data.subjectId is string && data.subjectId.size() > 0
        && data.chapterId is string && data.chapterId.size() > 0
        && data.topicId is string && data.topicId.size() > 0
        && data.slug is string && data.slug.size() > 0
        && data.titleBn is string && data.titleBn.size() > 0
        && data.bodyBn is string && data.bodyBn.size() > 0
        && data.order is int && data.order >= 1
        && data.status in ['draft', 'published']
        && data.circularVersion is string && data.circularVersion.size() > 0
        && data.createdBy is string && data.createdBy.size() > 0;
    }
    function isValidNuQuestion(data) {
      return data.subjectId in ['bangla', 'english', 'general-knowledge']
        && data.chapterId is string && data.chapterId.size() > 0
        && data.topicId is string && data.topicId.size() > 0
        && data.groupIds is list && data.groupIds.size() >= 1 && data.groupIds.size() <= 3
        && data.groupIds.toSet().size() == data.groupIds.size()
        && data.groupIds.toSet().hasOnly(['humanities', 'science', 'business'])
        && data.questionText is string && data.questionText.size() > 0 && data.questionText.size() <= 2000
        && data.questionLang in ['bn', 'en']
        && data.options is list && data.options.size() == 4
        && data.options[0] is string && data.options[0].size() > 0
        && data.options[1] is string && data.options[1].size() > 0
        && data.options[2] is string && data.options[2].size() > 0
        && data.options[3] is string && data.options[3].size() > 0
        && data.options.toSet().size() == 4
        && data.difficulty in ['easy', 'medium', 'hard']
        && data.explanation is string && data.explanation.size() > 0
        && data.sourceType in ['original_practice', 'official_previous_year', 'adapted_hsc', 'unverified_source', 'imported_academic']
        && data.provenance is string && data.provenance.size() > 0
        && data.circularVersion is string && data.circularVersion.size() > 0
        && data.version is int && data.version >= 1
        && data.status in ['draft', 'submitted_for_review', 'under_review', 'approved', 'published', 'rejected', 'changes_requested', 'withdrawn']
        && !('correctOptionIndex' in data)
        && (!('examYear' in data) || (data.examYear is int && data.examYear >= 1900 && data.examYear <= 2100))
        && (data.sourceType == 'official_previous_year' || !('examYear' in data))
        && (data.sourceType != 'official_previous_year' || ('examYear' in data && data.examYear is int));
    }
    function isValidNuQuestionDraftKey(data) {
      return data.questionId is string && data.questionId.size() > 0
        && data.version is int && data.version >= 1
        && data.correctOptionIndex is int
        && data.correctOptionIndex >= 0 && data.correctOptionIndex <= 3
        && data.createdBy is string && data.createdBy.size() > 0
        && data.subjectId in ['bangla', 'english', 'general-knowledge']
        && data.groupIds is list && data.groupIds.size() >= 1
        && data.groupIds.toSet().hasOnly(['humanities', 'science', 'business']);
    }
    function isValidNuBundle(data) {
      return data.kind in ['topic', 'mock', 'daily']
        && data.groupId in ['humanities', 'science', 'business']
        && data.questions is list && data.questions.size() >= 1
        && data.questionCount is int && data.questionCount == data.questions.size()
        && data.questions[0] is map
        && data.questions[0].questionId is string
        && data.questions[0].version is int && data.questions[0].version >= 1
        && data.questions[0].options is list && data.questions[0].options.size() == 4
        && data.configSnapshot is map
        && data.configSnapshot.marking is map
        && data.configSnapshot.marking.correct == 1
        && data.configSnapshot.marking.incorrect == 0
        && data.configSnapshot.marking.unanswered == 0
        && data.configSnapshot.marking.negativeMarking == false
        && data.configSnapshot.totalQuestions is int
        && data.configSnapshot.totalQuestions == data.questionCount
        && data.status in ['draft', 'published', 'withdrawn']
        && data.version is int && data.version >= 1
        && data.sourceQuestionIds is list && data.sourceQuestionIds.size() == data.questionCount
        && ((data.kind == 'mock'
            && data.configSnapshot.totalQuestions == 100
            && data.configSnapshot.durationSeconds == 3600
            && data.configSnapshot.passMark == 35)
          || (data.kind == 'daily'
            && data.configSnapshot.totalQuestions >= 20
            && data.configSnapshot.totalQuestions <= 30
            && data.configSnapshot.durationSeconds is int
            && data.configSnapshot.durationSeconds >= 1200
            && data.configSnapshot.durationSeconds <= 1800)
          || (data.kind == 'topic'
            && data.configSnapshot.get('durationSeconds', null) == null
            && data.configSnapshot.get('passMark', null) == null));
    }
    function isNuQuestionTransitionAllowed(from, to) {
      return (from == 'draft' && to in ['submitted_for_review', 'withdrawn'])
        || (from == 'submitted_for_review' && to == 'under_review')
        || (from == 'under_review' && to in ['approved', 'rejected', 'changes_requested'])
        || (from == 'changes_requested' && to == 'submitted_for_review')
        || (from == 'approved' && to == 'published')
        || (from == 'published' && to == 'withdrawn');
    }
    function isNuQuestionTransitionActorOk(to) {
      return (to == 'submitted_for_review' && (isAdmin() || resource.data.createdBy == uid()))
        || (to == 'under_review' && (isAdmin() || isVerifiedTeacher())
            && resource.data.createdBy != uid()
            && request.resource.data.reviewedBy == uid())
        || (to in ['approved', 'rejected', 'changes_requested'] && (isAdmin() || isVerifiedTeacher())
            && resource.data.createdBy != uid()
            && resource.data.reviewedBy == uid()
            && request.resource.data.reviewedBy == uid())
        || (to == 'published' && isAdmin())
        || (to == 'withdrawn' && isAdmin());
    }
    function jobContentStatesConsistent(d) {
      return (d.get('status', '') == 'published') == (d.get('reviewStatus', '') == 'Published');
    }
    function isJobContentReviewState(s) {
      return s in ['Not Started', 'In Progress', 'Under Review', 'Published'];
    }
    function jobContentCreateCommon(d) {
      return d.get('status', '') == 'draft'
        && d.get('reviewStatus', '') == 'Not Started'
        && (d.get('authorId', null) == null || d.get('authorId', null) == uid())
        && d.get('verifiedBy', null) == null
        && d.get('verifiedAt', null) == null
        && (d.get('createdBy', null) == null || d.get('createdBy', null) == uid())
        && !('publishedAt' in d)
        && !('publishedBy' in d)
        && (isOptTs(d, 'createdAt'))
        && (isOptTs(d, 'updatedAt'));
    }
    function jobContentSecondEye(oldDoc, newDoc) {
      return (newDoc.get('verifiedBy', null) == oldDoc.get('verifiedBy', null)
          || newDoc.get('verifiedBy', null) == null
          || (newDoc.get('verifiedBy', null) == uid()
              && uid() != oldDoc.get('authorId', '')))
        && (newDoc.get('status', '') != 'published'
            || (newDoc.get('verifiedBy', null) is string
                && newDoc.get('verifiedBy', null) != oldDoc.get('authorId', '')
                && newDoc.get('verifiedAt', null) is timestamp));
    }
    function jobContentPublishTransition(oldDoc, newDoc) {
      return oldDoc.get('status', '') != 'published'
        || newDoc.get('status', '') != 'published'
        || (newDoc.get('status', '') == oldDoc.get('status', '')
            && newDoc.get('reviewStatus', '') == oldDoc.get('reviewStatus', '')
            && newDoc.get('verifiedBy', null) == oldDoc.get('verifiedBy', null)
            && newDoc.get('verifiedAt', null) == oldDoc.get('verifiedAt', null));
    }
    function isJobSubjectId(s) {
      return s is string && s.matches('^[a-z0-9-]+__[a-z0-9-]+$');
    }
    function isJobChapterId(s) {
      return s is string && s.matches('^[a-z0-9-]+__[a-z0-9-]+__[a-z0-9-]+$');
    }
    function isJobTopicId(s) {
      return s is string && s.matches('^[a-z0-9-]+__[a-z0-9-]+__[a-z0-9-]+__[a-z0-9-]+$');
    }
    function validJobSubject(d) {
      return d.get('examSlug', null) in jobExamSlugs()
        && d.get('examSlug', null) != 'it-professional'
        && isStr(d.get('nameBn', null), 100)
        && isStr(d.get('nameEn', null), 100)
        && d.get('order', null) is int && d.get('order', null) >= 1
        && (d.get('marks', null) == null
            || (d.get('marks', null) is int && d.get('marks', null) >= 0))
        && isOptStr(d.get('syllabusSource', null), 500)
        && (d.get('slug', null) == null
            || (d.get('slug', null) is string && d.get('slug', null).matches('^[a-z0-9-]+$')))
        && (isOptStrNoMax(d, 'applicableCycle'))
        && (isOptStrNoMax(d, 'configVersion'))
        && d.get('status', null) in ['draft', 'published']
        && isJobContentReviewState(d.get('reviewStatus', null))
        && jobContentStatesConsistent(d);
    }
    function validJobChapter(d) {
      return d.get('examSlug', null) in jobExamSlugs()
        && d.get('examSlug', null) != 'it-professional'
        && isJobSubjectId(d.get('subjectId', null))
        && isStr(d.get('nameBn', null), 200)
        && isStr(d.get('nameEn', null), 200)
        && isOptStr(d.get('descriptionBn', null), 1000)
        && isOptStr(d.get('descriptionEn', null), 1000)
        && d.get('order', null) is int && d.get('order', null) >= 1
        && d.get('status', null) in ['draft', 'published']
        && isJobContentReviewState(d.get('reviewStatus', null))
        && jobContentStatesConsistent(d);
    }
    function validJobTopic(d) {
      return d.get('examSlug', null) in jobExamSlugs()
        && d.get('examSlug', null) != 'it-professional'
        && isJobSubjectId(d.get('subjectId', null))
        && isJobChapterId(d.get('chapterId', null))
        && isStr(d.get('nameBn', null), 200)
        && isStr(d.get('nameEn', null), 200)
        && d.get('order', null) is int && d.get('order', null) >= 1
        && d.get('isCommon', null) is bool
        && (d.get('commonExams', null) == null
            || (d.get('commonExams', null) is list
                && d.get('commonExams', null).toSet().hasOnly(jobExamSlugs())))
        && (d.get('isCommon', null) != true
            || (d.get('commonExams', null) is list
                && d.get('commonExams', null).toSet().size() >= 3))
        && d.get('commonStatus', null) in ['preliminary', 'verified']
        && (d.get('questionTarget', null) == null
            || (d.get('questionTarget', null) is int && d.get('questionTarget', null) >= 0))
        && d.get('publishedQuestionCount', null) is int
        && d.get('publishedQuestionCount', null) >= 0
        && d.get('status', null) in ['draft', 'published']
        && isJobContentReviewState(d.get('reviewStatus', null))
        && jobContentStatesConsistent(d);
    }
    function validJobLesson(d) {
      return d.get('examSlug', null) in jobExamSlugs()
        && d.get('examSlug', null) != 'it-professional'
        && d.get('lessonType', null) in ['lesson', 'viva-question', 'viva-guide',
                                          'career-guide', 'cv-guide']
        && (d.get('lessonType', null) != 'lesson'
            || (isJobSubjectId(d.get('subjectId', null))
                && isJobChapterId(d.get('chapterId', null))
                && isJobTopicId(d.get('topicId', null))))
        && (isOptStrNoMax(d, 'subjectId'))
        && (isOptStrNoMax(d, 'chapterId'))
        && (isOptStrNoMax(d, 'topicId'))
        && isStr(d.get('titleBn', null), 200)
        && isStr(d.get('titleEn', null), 200)
        && isStr(d.get('body', null), 100000)
        && isOptStr(d.get('bodyEn', null), 100000)
        && d.get('order', null) is int && d.get('order', null) >= 1
        && d.get('status', null) in ['draft', 'published']
        && isJobContentReviewState(d.get('reviewStatus', null))
        && jobContentStatesConsistent(d);
    }
    function isJobQuestionReviewState(s) {
      return s in ['Not Started', 'In Progress', 'Under Review',
                   'Published', 'Rejected', 'Archived'];
    }
    function jobQuestionStatesConsistent(d) {
      return (d.get('status', '') == 'published')
          == (d.get('reviewStatus', '') == 'Published');
    }
    function jobQuestionCreateCommon(d) {
      return d.get('status', '') == 'draft'
        && d.get('reviewStatus', '') == 'Not Started'
        && (d.get('authorId', null) == null || d.get('authorId', null) == uid())
        && (d.get('createdBy', null) == null || d.get('createdBy', null) == uid())
        && d.get('verifiedBy', null) == null
        && d.get('verifiedAt', null) == null
        && d.get('reviewerId', null) == null
        && d.get('rejectionReason', null) == null
        && !('publishedAt' in d)
        && !('publishedBy' in d)
        && (isOptTs(d, 'createdAt'))
        && (isOptTs(d, 'updatedAt'));
    }
    function jobQuestionSecondEye(oldDoc, newDoc) {
      return (newDoc.get('verifiedBy', null) == oldDoc.get('verifiedBy', null)
          || newDoc.get('verifiedBy', null) == null
          || (newDoc.get('verifiedBy', null) == uid()
              && uid() != oldDoc.get('authorId', '')))
        && (newDoc.get('verifiedAt', null) == oldDoc.get('verifiedAt', null)
            || (newDoc.get('verifiedAt', null) is timestamp
                && newDoc.get('verifiedAt', null) <= request.time
                && newDoc.get('verifiedAt', null) > request.time - duration.value(5, 'm')))
        && (newDoc.get('status', '') != 'published'
            || (newDoc.get('verifiedBy', null) == uid()
                && newDoc.get('verifiedBy', null) != oldDoc.get('authorId', '')
                && newDoc.get('verifiedAt', null) is timestamp
                && newDoc.get('verifiedAt', null) <= request.time));
    }
    function jobQuestionTransition(oldDoc, newDoc) {
      return (newDoc.get('reviewStatus', '') == oldDoc.get('reviewStatus', '')
          || (oldDoc.get('reviewStatus', '') in ['Not Started', 'In Progress']
              && newDoc.get('reviewStatus', '') in ['Under Review', 'Rejected', 'Archived'])
          || (oldDoc.get('reviewStatus', '') == 'Under Review'
              && newDoc.get('reviewStatus', '') in ['Published', 'Rejected', 'Archived', 'Not Started'])
          || (oldDoc.get('reviewStatus', '') == 'Published'
              && newDoc.get('reviewStatus', '') in ['Not Started', 'Archived'])
          || (oldDoc.get('reviewStatus', '') == 'Rejected'
              && newDoc.get('reviewStatus', '') in ['Not Started', 'Archived'])
          || (oldDoc.get('reviewStatus', '') == 'Archived'
              && newDoc.get('reviewStatus', '') == 'Not Started'))
        && (newDoc.get('reviewStatus', '') != 'Published'
            || oldDoc.get('reviewStatus', '') == 'Under Review')
        && (newDoc.get('reviewStatus', '') != 'Rejected'
            || (newDoc.get('rejectionReason', null) is string
                && newDoc.get('rejectionReason', '').size() >= 10))
        && (oldDoc.get('status', '') != 'published'
            || newDoc.get('status', '') != 'draft'
            || newDoc.get('version', 0) == oldDoc.get('version', 0) + 1)
        && ((oldDoc.get('status', '') == 'published' && newDoc.get('status', '') == 'draft')
            || newDoc.get('version', 0) == oldDoc.get('version', 0));
    }
    function validJobQuestion(d) {
      return d.get('examSlug', null) in jobExamSlugs()
        && d.get('examSlug', null) != 'it-professional'
        && isJobSubjectId(d.get('subjectId', null))
        && isJobChapterId(d.get('chapterId', null))
        && isJobTopicId(d.get('topicId', null))
        && d.get('subjectId', '').matches('^' + d.get('examSlug', '') + '__[a-z0-9-]+$')
        && d.get('chapterId', '').matches('^' + d.get('subjectId', '') + '__[a-z0-9-]+$')
        && d.get('topicId', '').matches('^' + d.get('chapterId', '') + '__[a-z0-9-]+$')
        && isStr(d.get('questionText', null), 2000)
        && d.get('options', null) is list && d.get('options', null).size() == 4
        && d.get('correctLetter', null) in ['A', 'B', 'C', 'D']
        && isStr(d.get('explanation', null), 2000)
        && (d.get('whyWrong', null) == null || d.get('whyWrong', null) is map)
        && d.get('difficulty', null) in ['easy', 'medium', 'hard']
        && d.get('isPreviousYear', null) is bool
        && (d.get('isPreviousYear', null) != true
            || (d.get('examYear', null) is int
                && d.get('examYear', null) >= 1900 && d.get('examYear', null) <= 2100
                && d.get('sourceUrl', null) is string))
        && isStr(d.get('source', null), 500)
        && (isOptStrNoMax(d, 'sourceUrl'))
        && d.get('status', null) in ['draft', 'published']
        && isJobQuestionReviewState(d.get('reviewStatus', null))
        && jobQuestionStatesConsistent(d)
        && isStr(d.get('duplicateHash', null), 200)
        && d.get('version', null) is int && d.get('version', null) >= 1
        && (isOptStrNoMax(d, 'rejectionReason'))
        && (isOptStrNoMax(d, 'reviewerId'))
        && (isOptStrNoMax(d, 'configVersion'))
        && (isOptStrNoMax(d, 'bundleId'))
        && (isOptStrNoMax(d, 'duplicateOf'));
    }
    function validJobQuestionBundle(d) {
      return d.get('kind', null) in ['topic', 'mock', 'daily', 'weekly', 'previous']
        && d.get('examSlug', null) in jobExamSlugs()
        && d.get('examSlug', null) != 'it-professional'
        && (d.get('kind', null) != 'topic' || d.get('topicId', null) is string)
        && (d.get('kind', null) != 'mock' || d.get('mockId', null) is string)
        && (d.get('kind', null) != 'daily' || d.get('mockId', null) is string)
        && (d.get('kind', null) != 'weekly' || d.get('mockId', null) is string)
        && (d.get('kind', null) != 'previous' || d.get('year', null) is int)
        && isStr(d.get('titleBn', null), 200)
        && isStr(d.get('titleEn', null), 200)
        && d.get('questions', null) is list
        && d.get('questions', null).size() <= 200
        && d.get('questionCount', null) is int
        && d.get('questionCount', null) >= 1
        && d.get('questionCount', null) <= 200
        && d.get('questionCount', null) == d.get('questions', null).size()
        && d.get('sourceQuestionIds', null) is list
        && d.get('status', null) in ['draft', 'published']
        && isJobQuestionReviewState(d.get('reviewStatus', null))
        && jobQuestionStatesConsistent(d)
        && (isOptStrNoMax(d, 'configVersion'))
        && (d.get('bundleVersion', null) == null
            || (d.get('bundleVersion', null) is int && d.get('bundleVersion', null) >= 1));
    }
    function validJobQuestionKey(d, bundleId) {
      return d.get('bundleId', null) == bundleId
        && d.get('answers', null) is list
        && d.get('answers', null).size() >= 1
        && d.get('answers', null).size() <= 200
        && (isOptStrNoMax(d, 'configVersion'))
        && (isOptTs(d, 'createdAt'))
        && (isOptTs(d, 'updatedAt'));
    }
    function jobKeyMatchesBundle(d, bundleId, bundle) {
      return bundle.questionCount == d.get('answers', []).size()
        && d.get('configVersion', null) is string
        && bundle.get('configVersion', null) == d.get('configVersion', null);
    }
    function isPracticeJobBundle(bundle) {
      return signedIn() && callerActive()
        && bundle.kind == 'topic'
        && bundle.status == 'published';
    }
    function jobReceiptData(bundleId) {
      return get(/databases/$(database)/documents/jobReceipts/$(uid() + '_' + bundleId)).data;
    }
    function jobReceiptAttemptData(attemptId) {
      return get(/databases/$(database)/documents/users/$(uid())/jobAttempts/$(attemptId)).data;
    }
    function jobReceiptExamAttemptData(attemptId) {
      return get(/databases/$(database)/documents/users/$(uid())/jobExamAttempts/$(attemptId)).data;
    }
    function jobReceiptExamSessionData(attemptId) {
      return get(/databases/$(database)/documents/users/$(uid())/jobExamSessions/$(attemptId)).data;
    }
    function hasFreshJobReceipt(bundleId, receipt, bundle) {
      return signedIn() && callerActive()
        && receipt.createdAt > request.time - duration.value(10, 'm')
        && receipt.createdAt <= request.time + duration.value(5, 'm')
        && receipt.attemptId is string
        && ((bundle.kind in ['mock', 'daily', 'weekly']
              && receipt.purpose == 'exam_review'
              && ((exists(/databases/$(database)/documents/users/$(uid())/jobExamAttempts/$(receipt.attemptId))
                    && jobReceiptExamAttemptData(receipt.attemptId).status == 'submitted'
                    && jobReceiptExamAttemptData(receipt.attemptId).bundleId == bundleId
                    && jobReceiptExamAttemptData(receipt.attemptId).userId == uid()
                    && jobReceiptExamAttemptData(receipt.attemptId).kind == 'mock')
                  || (exists(/databases/$(database)/documents/users/$(uid())/jobExamSessions/$(receipt.attemptId))
                    && jobReceiptExamSessionData(receipt.attemptId).status == 'submitted'
                    && jobReceiptExamSessionData(receipt.attemptId).bundleId == bundleId
                    && jobReceiptExamSessionData(receipt.attemptId).kind == 'mock')))
            || (bundle.kind in ['topic', 'previous']
              && receipt.purpose == 'practice_review'
              && exists(/databases/$(database)/documents/users/$(uid())/jobAttempts/$(receipt.attemptId))
              && jobReceiptAttemptData(receipt.attemptId).status == 'submitted'
              && jobReceiptAttemptData(receipt.attemptId).bundleId == bundleId
              && jobReceiptAttemptData(receipt.attemptId).userId == uid()
              && jobReceiptAttemptData(receipt.attemptId).kind == 'practice'));
    }
    function validJobPracticeAttemptAnchor(data, a) {
      return a.status == 'submitted'
        && a.bundleId == data.get('bundleId', '')
        && a.userId == uid()
        && a.kind == 'practice'
        && a.bundleVersion == data.get('bundleVersion', null);
    }
    function validJobExamAttemptAnchor(data, a) {
      return a.status == 'submitted'
        && a.bundleId == data.get('bundleId', '')
        && a.userId == uid()
        && a.kind == 'mock'
        && a.bundleVersion == data.get('bundleVersion', null);
    }
    function validJobExamSessionAnchor(data, s) {
      return s.status == 'submitted'
        && s.bundleId == data.get('bundleId', '')
        && s.kind == 'mock'
        && s.bundleVersion == data.get('bundleVersion', null);
    }
    function validJobReceiptAnchor(data) {
      return (((data.get('purpose', '') == 'practice_review')
              && exists(/databases/$(database)/documents/users/$(uid())/jobAttempts/$(data.get('attemptId', '')))
              && validJobPracticeAttemptAnchor(data, get(/databases/$(database)/documents/users/$(uid())/jobAttempts/$(data.get('attemptId', ''))).data))
            || ((data.get('purpose', '') == 'exam_review')
              && ((exists(/databases/$(database)/documents/users/$(uid())/jobExamAttempts/$(data.get('attemptId', '')))
                    && validJobExamAttemptAnchor(data, get(/databases/$(database)/documents/users/$(uid())/jobExamAttempts/$(data.get('attemptId', ''))).data))
                  || (exists(/databases/$(database)/documents/users/$(uid())/jobExamSessions/$(data.get('attemptId', '')))
                    && validJobExamSessionAnchor(data, get(/databases/$(database)/documents/users/$(uid())/jobExamSessions/$(data.get('attemptId', ''))).data)))));
    }
    function jobBundleData(bundleId) {
      return get(/databases/$(database)/documents/jobQuestionBundles/$(bundleId)).data;
    }
    function jobSessionDataAfter(userId, sessionId) {
      return getAfter(/databases/$(database)/documents/users/$(userId)/jobSessions/$(sessionId)).data;
    }
    function jobBundleKindFitsAttemptKind(bundleKind, kind) {
      return kind == 'practice' && bundleKind in ['topic', 'previous'];
    }
    function jobExamDefinitionData(definitionId) {
      return get(/databases/$(database)/documents/jobExamDefinitions/$(definitionId)).data;
    }
    function jobManifestData(questionSetId) {
      return get(/databases/$(database)/documents/jobQuestionSetManifests/$(questionSetId)).data;
    }
    function jobExamSessionDataAfter(userId, sessionId) {
      return getAfter(/databases/$(database)/documents/users/$(userId)/jobExamSessions/$(sessionId)).data;
    }
    function validJobAttemptCore(d, attemptId) {
        return d.get('answers', null) is list
        && d.get('answers', []).size() >= 1
        && d.get('score', null) is number
        && d.get('totalMarks', null) is number && d.get('totalMarks', 0) > 0
        && d.get('score', 0) <= d.get('totalMarks', 0)
        && d.get('score', 0) >= -d.get('totalMarks', 0)
        && d.get('clientCalculatedScore', null) == d.get('score', null)
        && d.get('negativeDeduction', null) is number
        && d.get('negativeDeduction', -1) >= 0
        && d.get('negativeMarkingUsed', null) is number
        && (d.get('negativeMarkingUsed', -1) == 0
            || d.get('negativeMarkingUsed', -1) == 0.25
            || d.get('negativeMarkingUsed', -1) == 0.5)
        && d.get('negativeDeduction', -1)
             == d.get('wrongCount', 0) * d.get('negativeMarkingUsed', -1)
        && isStr(d.get('markingSchemeVersion', null), 100)
        && d.get('bundleVersion', null) is int && d.get('bundleVersion', 0) >= 1
        && d.get('correctCount', null) is int && d.get('correctCount', -1) >= 0
        && d.get('wrongCount', null) is int && d.get('wrongCount', -1) >= 0
        && d.get('unansweredCount', null) is int && d.get('unansweredCount', -1) >= 0
        && d.get('correctCount', 0) + d.get('wrongCount', 0) + d.get('unansweredCount', 0)
             == d.get('answers', []).size()
        && d.get('accuracy', null) is number
        && d.get('accuracy', -1) >= 0 && d.get('accuracy', 101) <= 100
        && d.get('percentage', null) is number
        && d.get('percentage', -101) >= -100 && d.get('percentage', 101) <= 100
        && d.get('timeSpentSeconds', null) is number
        && d.get('timeSpentSeconds', -1) >= 0
        && d.get('startedAt', null) is timestamp
        && d.get('submittedAt', null) is timestamp
        && d.get('startedAt', null) <= d.get('submittedAt', null)
        && d.get('submittedAt', null) <= request.time
        && d.get('status', '') == 'submitted'
        && d.get('markingStatus', '') == 'auto'
        && d.get('resultLabel', '') == 'practice'
        && d.get('trustLevel', '') == 'unverified'
        && d.get('resultType', '') == 'practice'
        && d.get('submissionIntegrity', '') == 'client_calculated'
        && d.get('serverVerifiedScore', null) == null
        && (d.get('audit', null) == null || d.get('audit', null) is map)
        && (d.get('answerHashes', null) == null || d.get('answerHashes', null) is list)
        && (d.get('anomalyFlags', null) == null || d.get('anomalyFlags', null) is list)
        && d.get('sessionId', '') == attemptId;
    }
    function validJobAttemptCreate(d, userId, attemptId, bundle, sessAfter) {
      return d.keys().hasOnly(['userId', 'kind', 'mockId', 'bundleId',
             'examSlug', 'subjectId', 'topicId', 'answers', 'score',
             'totalMarks', 'negativeDeduction', 'negativeMarkingUsed',
             'markingSchemeVersion', 'bundleVersion', 'correctCount',
             'wrongCount', 'unansweredCount', 'accuracy', 'percentage',
             'timeSpentSeconds', 'startedAt', 'submittedAt', 'status',
             'markingStatus', 'resultLabel', 'clientCalculatedScore',
             'serverVerifiedScore', 'trustLevel', 'resultType',
             'sessionId', 'audit', 'answerHashes', 'anomalyFlags',
             'submissionIntegrity'])
        && d.keys().hasAll(['userId', 'kind', 'mockId', 'bundleId',
             'examSlug', 'subjectId', 'topicId', 'answers', 'score',
             'totalMarks', 'negativeDeduction', 'negativeMarkingUsed',
             'markingSchemeVersion', 'bundleVersion', 'correctCount',
             'wrongCount', 'unansweredCount', 'accuracy', 'percentage',
             'timeSpentSeconds', 'startedAt', 'submittedAt', 'status',
             'markingStatus', 'resultLabel', 'clientCalculatedScore',
             'trustLevel', 'resultType', 'sessionId',
             'submissionIntegrity'])
        && d.get('userId', '') == userId
        && d.get('kind', null) == 'practice'
        && d.get('mockId', null) == null
        && d.get('bundleId', null) is string
        && (d.get('subjectId', null) == null
            || (d.get('subjectId', null) is string && d.get('subjectId', '').size() <= 200))
        && (d.get('topicId', null) == null
            || (d.get('topicId', null) is string && d.get('topicId', '').size() <= 200))
                && validJobAttemptCore(d, attemptId)
        && bundle.status == 'published'
        && bundle.examSlug == d.get('examSlug', null)
        && jobBundleKindFitsAttemptKind(bundle.kind, d.get('kind', null))
        && d.get('answers', []).size() <= bundle.questionCount
        && bundle.get('bundleVersion', null) == d.get('bundleVersion', null)
        && sessAfter.status == 'submitted'
        && sessAfter.bundleId == d.get('bundleId', '')
        && sessAfter.kind == d.get('kind', null)
        && sessAfter.examSlug == d.get('examSlug', null)
        && sessAfter.mockId == d.get('mockId', null)
        && sessAfter.questionRefs.size() == d.get('answers', []).size();
