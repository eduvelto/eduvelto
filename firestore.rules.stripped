      allow create: if isModerator()
        && !('correctLetter' in request.resource.data)
        && !('explanation' in request.resource.data)
        && !('correctText' in request.resource.data)
        && (request.resource.data.get('kind', '') != 'topic'
            || bundleId == 'topic__' + request.resource.data.get('topicId', ''))
        && (request.resource.data.get('kind', '') != 'mock'
            || bundleId == 'mock__' + request.resource.data.get('mockId', ''))
        && (request.resource.data.get('kind', '') != 'daily'
            || bundleId == 'daily__' + request.resource.data.get('mockId', ''))
        && (request.resource.data.get('kind', '') != 'weekly'
            || bundleId == 'weekly__' + request.resource.data.get('mockId', ''))
        && onlyKeys(['kind', 'examSlug',
             'topicId', 'mockId', 'year', 'titleBn', 'titleEn',
             'questions', 'questionCount', 'status', 'reviewStatus',
             'publishedAt', 'publishedBy', 'sourceQuestionIds',
             'configVersion', 'bundleVersion', 'createdAt', 'updatedAt'])
        && validJobQuestionBundle(request.resource.data);
      allow update: if isModerator()
        && !('correctLetter' in request.resource.data)
        && !('explanation' in request.resource.data)
        && !('correctText' in request.resource.data)
        && (request.resource.data.get('kind', '') != 'topic'
            || bundleId == 'topic__' + request.resource.data.get('topicId', ''))
        && (request.resource.data.get('kind', '') != 'mock'
            || bundleId == 'mock__' + request.resource.data.get('mockId', ''))
        && (request.resource.data.get('kind', '') != 'daily'
            || bundleId == 'daily__' + request.resource.data.get('mockId', ''))
        && (request.resource.data.get('kind', '') != 'weekly'
            || bundleId == 'weekly__' + request.resource.data.get('mockId', ''))
        && validJobQuestionBundle(request.resource.data)
        && (resource.data.get('status', '') != 'published'
            || changedKeys()
                 .hasOnly(['titleBn', 'titleEn', 'status', 'reviewStatus',
                           'publishedAt', 'publishedBy', 'updatedAt']));
      allow delete: if isAdmin();
    }
    match /circulars/{circularId} {
      allow read: if resource.data.get('reviewStatus', '') == 'published' || isModerator();
      allow create: if isModerator()
        && onlyKeys(['examSlug', 'postTitleBn', 'postTitleEn', 'circularNumber', 'publishedDate', 'applicationDeadline', 'deadlinePrecision', 'totalPosts', 'eligibilitySummaryBn', 'eligibilitySummaryEn', 'officialUrl', 'applyUrl', 'copyStatus', 'copyTextExcerpt', 'reviewStatus', 'verifiedBy', 'verifiedAt', 'examDate', 'applicationStartDate', 'authorId', 'createdAt', 'updatedAt', 'verificationChecklist', 'reviewNote', 'lastEditedBy'])
        && request.resource.data.get('reviewStatus', '') in ['draft', 'in-review', 'verified', 'rejected'];
      allow update: if isModerator()
        && onlyKeys(['examSlug', 'postTitleBn', 'postTitleEn', 'circularNumber', 'publishedDate', 'applicationDeadline', 'deadlinePrecision', 'totalPosts', 'eligibilitySummaryBn', 'eligibilitySummaryEn', 'officialUrl', 'applyUrl', 'copyStatus', 'copyTextExcerpt', 'reviewStatus', 'verifiedBy', 'verifiedAt', 'examDate', 'applicationStartDate', 'authorId', 'createdAt', 'updatedAt', 'verificationChecklist', 'reviewNote', 'lastEditedBy'])
        && request.resource.data.get('reviewStatus', '') in ['draft', 'in-review', 'verified', 'published', 'rejected']
        && (request.resource.data.get('reviewStatus', '') != 'published'
          || resource.data.get('reviewStatus', '') == 'published'
          || resource.data.get('reviewStatus', '') == 'verified'
            && resource.data.get('authorId', '') != ''
            && resource.data.get('authorId', '') != uid()
            && request.resource.data.get('authorId', '') == resource.data.get('authorId', '')
            && request.resource.data.get('verifiedBy', null) == resource.data.get('verifiedBy', null)
            && request.resource.data.get('verifiedAt', null) == resource.data.get('verifiedAt', null)
            && request.resource.data.get('verificationChecklist', null) == resource.data.get('verificationChecklist', null));
      allow delete: if isAdmin();
    }
    match /jobReports/{reportId} {
      allow read: if signedIn() && (resource.data.reporterId == uid() || isModerator());
      allow create: if signedIn() && callerActive()
        && request.resource.data.reporterId == uid()
        && request.resource.data.status == 'open'
        && request.resource.data.reason in ['wrong-answer', 'wrong-explanation', 'wrong-info', 'wrong-deadline', 'wrong-post-count', 'broken-link', 'new-extension', 'wrong-organization', 'duplicate', 'other']
        && request.resource.data.targetType in ['jobQuestion', 'jobLesson', 'jobCircular', 'jobMock']
        && request.resource.data.targetId is string
        && request.resource.data.targetAuthorId is string
        && isOptStr(request.resource.data.details, 2000)
        && onlyKeys(['reporterId', 'targetType', 'targetId', 'targetAuthorId', 'reason', 'details', 'suggestedValue', 'evidenceUrl', 'status', 'priority', 'resolvedBy', 'resolvedAt', 'resolutionNote', 'createdAt', 'updatedAt']);
      allow update: if isModerator()
        && changedKeys()
             .hasOnly(['status', 'priority', 'resolvedBy', 'resolvedAt', 'resolutionNote', 'updatedAt'])
        && request.resource.data.status in ['open', 'investigating', 'resolved', 'dismissed'];
      allow delete: if false;
    }
    match /jobCorrections/{correctionId} {
      allow read: if signedIn() && (resource.data.requesterId == uid() || isModerator());
      allow create: if signedIn() && callerActive()
        && request.resource.data.requesterId == uid()
        && request.resource.data.status == 'pending'
        && request.resource.data.targetType in ['jobQuestion', 'jobLesson', 'jobCircular', 'jobMock']
        && isStr(request.resource.data.whatsWrong, 2000)
        && isStr(request.resource.data.proposedFix, 2000)
        && isStr(request.resource.data.source, 500)
        && onlyKeys(['requesterId', 'targetType', 'targetId', 'whatsWrong', 'proposedFix', 'source', 'status', 'decidedBy', 'decidedAt', 'decisionReason', 'createdAt', 'updatedAt']);
      allow update: if isModerator()
        && resource.data.status == 'pending'
        && request.resource.data.status in ['accepted', 'rejected']
        && changedKeys()
             .hasOnly(['status', 'decidedBy', 'decidedAt', 'decisionReason', 'updatedAt'])
        && request.resource.data.decidedBy == uid()
        && request.resource.data.decisionReason is string
        && request.resource.data.decisionReason.size() >= 10;
      allow delete: if false;
    }
    match /circularHistory/{historyId} {
      allow read: if isModerator();
      allow create: if isModerator()
        && onlyKeys(['circularId', 'fieldChanged', 'previousValue', 'newValue', 'sourceId', 'changedBy', 'changedAt', 'note'])
        && request.resource.data.fieldChanged in ['applicationDeadline', 'officialUrl', 'applyUrl', 'totalPosts', 'reviewStatus', 'examDate', 'applicationStartDate', 'duplicateOf', 'correctionOf', 'extensionOf', 'relatedTo']
        && request.resource.data.changedBy == uid()
        && request.resource.data.circularId is string
        && request.resource.data.changedAt is timestamp;
      allow update, delete: if false;
    }
    match /approvedDomains/{domainId} {
      allow read: if isModerator();
      allow create, update: if isAdmin()
        && onlyKeys(['domain', 'organization', 'examSlugs', 'addedBy', 'createdAt', 'updatedAt', 'status'])
        && isStr(request.resource.data.domain, 200)
        && isStr(request.resource.data.organization, 200)
        && request.resource.data.get('status', 'active') in ['active', 'watch', 'deprecated'];
      allow delete: if isAdmin();
    }
    match /jobQuestionKeys/{bundleId} {
      allow read: if isModerator()
        || (signedIn() && callerActive()
            && ((exists(/databases/$(database)/documents/jobReceipts/$(uid() + '_' + bundleId))
                 && exists(/databases/$(database)/documents/jobQuestionBundles/$(bundleId))
                 && hasFreshJobReceipt(bundleId, jobReceiptData(bundleId), jobBundleData(bundleId)))
                || (exists(/databases/$(database)/documents/jobQuestionBundles/$(bundleId))
                 && isPracticeJobBundle(jobBundleData(bundleId)))));
      allow create: if isModerator()
        && onlyKeys(['bundleId', 'answers',
             'configVersion', 'createdAt', 'updatedAt'])
        && validJobQuestionKey(request.resource.data, bundleId)
        && exists(/databases/$(database)/documents/jobQuestionBundles/$(bundleId))
        && jobKeyMatchesBundle(request.resource.data, bundleId,
             jobBundleData(bundleId));
      allow update: if false;
      allow delete: if isAdmin();
    }
    match /jobReceipts/{receiptId} {
      allow read: if (signedIn() && resource.data.get('userId', '') == uid()) || isAdmin();
      allow create: if signedIn() && callerActive()
        && receiptId == uid() + '_' + request.resource.data.get('bundleId', '')
        && onlyKeys(['userId', 'bundleId',
             'attemptId', 'createdAt', 'purpose', 'bundleVersion'])
        && request.resource.data.get('userId', '') == uid()
        && request.resource.data.get('bundleId', null) is string
        && request.resource.data.get('bundleId', '').size() <= 200
        && request.resource.data.get('attemptId', null) is string
        && request.resource.data.get('attemptId', '').size() <= 200
        && request.resource.data.get('purpose', null) in ['practice_review', 'exam_review']
        && request.resource.data.get('bundleVersion', null) is int
        && request.resource.data.get('bundleVersion', 0) >= 1
        && request.resource.data.get('createdAt', null) is timestamp
        && request.resource.data.get('createdAt', null) <= request.time
        && request.resource.data.get('createdAt', null) > request.time - duration.value(5, 'm')
        && validJobReceiptAnchor(request.resource.data)
        && reqBundleExists()
        && get(/databases/$(database)/documents/jobQuestionBundles/$(request.resource.data.get('bundleId', ''))).data.status == 'published';
      allow update: if signedIn() && callerActive()
        && receiptId == uid() + '_' + request.resource.data.get('bundleId', '')
        && request.resource.data.get('userId', '') == uid()
        && resource.data.get('userId', '') == uid()
        && resource.data.get('bundleId', '') == request.resource.data.get('bundleId', '')
        && onlyKeys(['userId', 'bundleId',
             'attemptId', 'createdAt', 'purpose', 'bundleVersion'])
        && request.resource.data.get('bundleId', null) is string
        && request.resource.data.get('bundleId', '').size() <= 200
        && request.resource.data.get('attemptId', null) is string
        && request.resource.data.get('attemptId', '').size() <= 200
        && request.resource.data.get('purpose', null) in ['practice_review', 'exam_review']
        && request.resource.data.get('bundleVersion', null) is int
        && request.resource.data.get('bundleVersion', 0) >= 1
        && request.resource.data.get('createdAt', null) is timestamp
        && request.resource.data.get('createdAt', null) <= request.time
        && request.resource.data.get('createdAt', null) > request.time - duration.value(5, 'm')
        && validJobReceiptAnchor(request.resource.data)
        && reqBundleExists()
        && get(/databases/$(database)/documents/jobQuestionBundles/$(request.resource.data.get('bundleId', ''))).data.status == 'published';
      allow delete: if isAdmin();
    }
    match /users/{userId}/jobAttempts/{attemptId} {
      allow read: if isOwner(userId) || isModerator();
      allow create: if isOwner(userId) && callerActive()
        && reqBundleExists()
        && exists(/databases/$(database)/documents/users/$(userId)/jobSessions/$(attemptId))
        && validJobAttemptCreate(request.resource.data, userId, attemptId,
             jobBundleData(request.resource.data.get('bundleId', '')),
             jobSessionDataAfter(userId, attemptId));
      allow update, delete: if false;
    }
    match /users/{userId}/jobSessions/{sessionId} {
      allow read: if isOwner(userId) || isModerator();
      allow create: if isOwner(userId) && callerActive()
        && reqBundleExists()
        && validJobSessionCreate(request.resource.data,
             jobBundleData(request.resource.data.get('bundleId', '')));
      allow update: if isOwner(userId) && callerActive()
        && resource.data.get('status', '') == 'in-progress'
        && changedKeys()
             .hasOnly(['answers', 'currentQuestion', 'lastSyncedAt',
                       'updatedAt', 'status', 'submittedAt', 'revision'])
        && validJobSessionUpdate(request.resource.data, resource.data);
      allow delete: if false;
    }
    match /users/{userId}/jobExamAttempts/{attemptId} {
      allow read: if isOwner(userId) || isModerator();
      allow create: if isOwner(userId) && callerActive()
        && reqBundleExists()
        && exists(/databases/$(database)/documents/users/$(userId)/jobExamSessions/$(attemptId))
        && validJobExamAttemptCreate(request.resource.data, userId, attemptId,
             jobBundleData(request.resource.data.get('bundleId', '')),
             jobExamSessionDataAfter(userId, attemptId));
      allow update, delete: if false;
    }
    match /users/{userId}/jobExamSessions/{sessionId} {
      allow read: if isOwner(userId) || isModerator();
      allow create: if isOwner(userId) && callerActive()
        && reqBundleExists()
        && exists(/databases/$(database)/documents/jobQuestionSetManifests/$(request.resource.data.get('questionSetId', '')))
        && exists(/databases/$(database)/documents/jobExamDefinitions/$(request.resource.data.get('definitionId', '')))
        && validJobExamSessionCreate(request.resource.data, sessionId,
             jobBundleData(request.resource.data.get('bundleId', '')),
             jobManifestData(request.resource.data.get('questionSetId', '')),
             jobExamDefinitionData(request.resource.data.get('definitionId', '')),
             getAfter(/databases/$(database)/documents/jobExamUserLocks/$(uid() + '_' + request.resource.data.get('examSlug', ''))).data);
      allow update: if isOwner(userId) && callerActive()
        && resource.data.get('status', '') == 'in-progress'
        && changedKeys()
             .hasOnly(['answers', 'currentQuestion', 'lastSyncedAt',
                       'updatedAt', 'endsAt', 'clientEndsAtMillis',
                       'status', 'submittedAt', 'revision'])
        && validJobExamSessionUpdate(request.resource.data, resource.data);
      allow delete: if false;
    }
    function validJobExamAuditLog(d, userId) {
      return d.keys().hasOnly(['uid', 'event', 'examSlug', 'mockId',
              'sessionId', 'bundleId', 'createdAt', 'detail'])
        && d.get('uid', '') == userId
        && d.get('event', '') in ['mock_started', 'mock_submitted',
             'mock_abandoned', 'mock_submit_failed']
        && d.get('examSlug', null) is string
        && d.get('examSlug', '').size() > 0
        && d.get('examSlug', '').size() <= 200
        && d.get('mockId', null) is string
        && d.get('mockId', '').size() > 0
        && d.get('mockId', '').size() <= 200
        && d.get('sessionId', null) is string
        && d.get('sessionId', '').size() > 0
        && d.get('sessionId', '').size() <= 200
        && d.get('bundleId', null) is string
        && d.get('bundleId', '').size() > 0
        && d.get('bundleId', '').size() <= 200
        && (d.get('detail', null) == null
            || (d.get('detail', null) is string
                && d.get('detail', '').size() <= 500))
        && d.get('createdAt', null) is timestamp
        && d.get('createdAt', null) <= request.time
        && d.get('createdAt', null) > request.time - duration.value(5, 'm');
    }
    match /users/{userId}/jobExamAuditLogs/{logId} {
      allow read: if isOwner(userId) || isModerator();
      allow create: if isOwner(userId) && callerActive()
        && validJobExamAuditLog(request.resource.data, userId);
      allow update: if false;
      allow delete: if isAdmin();
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
