        && request.resource.data.score <= request.resource.data.totalMarks
        && request.resource.data.percentage is number
        && request.resource.data.percentage >= 0
        && request.resource.data.percentage <= 100
        && exists(/databases/$(database)/documents/quizzes/$(request.resource.data.quizId))
        && request.resource.data.answers.size() <= get(/databases/$(database)/documents/quizzes/$(request.resource.data.quizId)).data.questions.size()
        && ((get(/databases/$(database)/documents/quizzes/$(request.resource.data.quizId)).data.totalMarks is number
            && get(/databases/$(database)/documents/quizzes/$(request.resource.data.quizId)).data.totalMarks > 0
            && request.resource.data.totalMarks == get(/databases/$(database)/documents/quizzes/$(request.resource.data.quizId)).data.totalMarks)
          || (!(get(/databases/$(database)/documents/quizzes/$(request.resource.data.quizId)).data.totalMarks is number
