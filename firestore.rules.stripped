                     && resource.data.get('createdAt', null) is timestamp
                     && resource.data.get('durationSeconds', null) is int
                     && request.time > resource.data.get('createdAt', null)
                          + duration.value(resource.data.get('durationSeconds', 0), 's')
                          + duration.value(15, 'm')))
                && exists(/databases/$(database)/documents/jobExamDefinitions/$(request.resource.data.get('definitionId', '')))
                && validJobExamUserLock(request.resource.data, lockId,
                     jobExamDefinitionData(request.resource.data.get('definitionId', '')))));
      allow delete: if false;
    }
    match /jobQuestions/{questionId} {
