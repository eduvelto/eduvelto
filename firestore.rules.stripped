    function validJobSessionUpdateCore(d, old) {
      return d.get('status', '') in ['in-progress', 'submitted', 'abandoned']
        && ((d.get('status', '') == 'submitted' && d.get('submittedAt', null) is timestamp)
            || (d.get('status', '') != 'submitted' && d.get('submittedAt', null) == null))
        && d.get('answers', null) is map
