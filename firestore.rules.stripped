            || (resource.data.get('status', '') == 'archived'
              && request.resource.data.get('status', '') in ['archived', 'draft']));
      allow delete: if isAdmin();
    }
    function validJobExamUserLock(d, lockId, def) {
      return d.keys().hasOnly(['uid', 'examSlug', 'mockId', 'definitionId',
             'activeSessionId', 'status', 'durationSeconds', 'createdAt', 'updatedAt'])
        && d.keys().hasAll(['uid', 'examSlug', 'mockId', 'definitionId',
             'activeSessionId', 'status', 'durationSeconds', 'createdAt', 'updatedAt'])
        && d.get('uid', '') == uid()
        && lockId == uid() + '_' + d.get('examSlug', '')
        && d.get('examSlug', null) in jobExamSlugs()
        && d.get('mockId', null) is string && d.get('mockId', '').size() > 0
        && d.get('definitionId', null) is string && d.get('definitionId', '').size() > 0
        && d.get('activeSessionId', null) is string && d.get('activeSessionId', '').size() > 0
        && d.get('status', '') == 'in_progress'
        && d.get('durationSeconds', null) is int
        && d.get('durationSeconds', 0) >= 60 && d.get('durationSeconds', 0) <= 7200
        && d.get('createdAt', null) is timestamp
        && d.get('createdAt', null) <= request.time
        && d.get('createdAt', null) > request.time - duration.value(5, 'm')
        && d.get('updatedAt', null) is timestamp
        && def.get('status', null) == 'published'
        && def.get('rulesSnapshot', null) is map
        && def.get('rulesSnapshot', null).get('timeMinutes', null) is int
        && d.get('durationSeconds', 0)
             == def.rulesSnapshot.timeMinutes * 60
        && def.get('examSlug', null) == d.get('examSlug', null);
    }
    function jobExamUserLockIsReleasable(lock) {
      return lock.status == 'terminal'
        || request.time > lock.createdAt
             + duration.value(lock.durationSeconds, 's')
             + duration.value(15, 'm');
    }
    match /jobExamUserLocks/{lockId} {
      allow read: if (signedIn() && resource.data.get('uid', '') == uid()) || isModerator();
      allow create: if signedIn() && callerActive()
        && exists(/databases/$(database)/documents/jobExamDefinitions/$(request.resource.data.get('definitionId', '')))
        && validJobExamUserLock(request.resource.data, lockId,
             jobExamDefinitionData(request.resource.data.get('definitionId', '')))
        && (!exists(/databases/$(database)/documents/jobExamUserLocks/$(lockId))
            || jobExamUserLockIsReleasable(get(/databases/$(database)/documents/jobExamUserLocks/$(lockId)).data));
      allow update: if signedIn() && callerActive()
        && resource.data.get('uid', '') == uid()
        && ((changedKeys().hasOnly(['status', 'updatedAt'])
             && resource.data.get('status', '') == 'in_progress'
             && request.resource.data.get('status', '') == 'terminal'
             && getAfter(/databases/$(database)/documents/users/$(uid())/jobExamSessions/$(resource.data.get('activeSessionId', ''))).data.status in ['submitted', 'abandoned'])
            || ((resource.data.get('status', '') == 'terminal'
