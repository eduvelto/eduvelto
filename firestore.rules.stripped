             'currentQuestion', 'lastSyncedAt', 'clientEndsAtMillis',
             'submittedAt', 'createdAt', 'updatedAt', 'revision'])
        && d.keys().hasAll(['kind', 'mockId', 'bundleId', 'examSlug',
             'status', 'startedAt', 'endsAt', 'questionRefs', 'answers',
             'currentQuestion', 'lastSyncedAt', 'clientEndsAtMillis',
             'submittedAt', 'createdAt', 'updatedAt', 'revision'])
        && d.get('kind', null) == 'practice'
        && d.get('mockId', null) == null
        && d.get('bundleId', null) is string
        && d.get('status', '') == 'in-progress'
        && d.get('startedAt', null) is timestamp
        && d.get('endsAt', null) == null
        && d.get('questionRefs', null) is list
        && d.get('questionRefs', []).size() >= 1
        && d.get('answers', null) is map
        && d.get('answers', {}).size() == d.get('questionRefs', []).size()
        && d.get('currentQuestion', null) is int && d.get('currentQuestion', 0) >= 1
        && string(d.get('currentQuestion', 0)) in d.get('answers', {}).keys()
        && d.get('lastSyncedAt', null) is timestamp
        && d.get('revision', null) is int && d.get('revision', 0) == 1
        && d.get('lastSyncedAt', null) is timestamp
        && d.get('clientEndsAtMillis', null) == null
        && d.get('submittedAt', null) == null
        && d.get('createdAt', null) is timestamp
