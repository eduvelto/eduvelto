      allow delete: if false;
    }
    match /supportMessages/{threadId} {
      allow read: if signedIn() && (resource.data.userId == uid() || isAdmin());
      allow create: if signedIn() && callerActive()
        && request.resource.data.userId == uid()
        && request.resource.data.status in ['open', 'closed'];
      allow update: if isAdmin()
        && changedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['open', 'closed'];
      allow delete: if false;
    }
    match /supportMessages/{threadId}/messages/{messageId} {
      allow read: if signedIn()
        && (get(/databases/$(database)/documents/supportMessages/$(threadId)).data.userId == uid() || isAdmin());
      allow create: if signedIn() && callerActive()
        && request.resource.data.senderId == uid()
        && request.resource.data.kind == 'text'
        && isStr(request.resource.data.body, 2000);
      allow update, delete: if false;
    }
    match /directMessages/{threadId} {
      allow read: if signedIn() && uid() in resource.data.get('participants', []);
      allow create, update, delete: if false;
    }
    match /directMessages/{threadId}/messages/{messageId} {
      allow read: if signedIn()
        && uid() in get(/databases/$(database)/documents/directMessages/$(threadId)).data.get('participants', []);
      allow create, update, delete: if false;
    }
    match /jobCategories/{categoryId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && isStr(request.resource.data.nameBn, 100)
        && isStr(request.resource.data.nameEn, 100)
        && request.resource.data.order is int
        && request.resource.data.order >= 1
        && request.resource.data.order <= 10
        && request.resource.data.hubSlugs is list
        && request.resource.data.hubSlugs.size() >= 1
        && request.resource.data.hubSlugs.toSet().hasOnly(jobExamSlugs())
        && isStr(request.resource.data.accent, 20)
        && request.resource.data.status in ['active', 'inactive'];
      allow delete: if false;
    }
    match /jobExams/{examSlug} {
      allow read: if resource.data.get('status', '') == 'published'
        || (signedIn() && resource.data.get('authorId', '') == uid())
        || isModerator();
      allow create: if isModerator()
        && request.resource.data.slug == examSlug
        && request.resource.data.categoryId in jobCategoryIds()
        && request.resource.data.tier in [1, 2, 3]
        && isDraftStatus(request.resource.data.reviewStatus)
        && request.resource.data.status == 'draft'
        && isStr(request.resource.data.nameBn, 100)
        && validJobRulesConfig(request.resource.data.rulesConfig)
        && (!('rulesConfigHistory' in request.resource.data)
            || request.resource.data.rulesConfigHistory == [])
        && (!('authorId' in request.resource.data)
            || request.resource.data.authorId == uid())
        && (!('createdBy' in request.resource.data)
            || request.resource.data.createdBy is string)
        && request.resource.data.patternStatus in jobPatternStatuses()
        && (request.resource.data.applicableCycle == null
            || request.resource.data.applicableCycle is string)
        && request.resource.data.get('scopeStatus', 'defined') in ['defined', 'scope_pending']
        && (!('createdAt' in request.resource.data) || request.resource.data.createdAt is timestamp)
        && (!('updatedAt' in request.resource.data) || request.resource.data.updatedAt is timestamp);
      allow update: if isModerator()
        && request.resource.data.get('rulesConfig', null) == resource.data.get('rulesConfig', null)
        && request.resource.data.get('rulesConfigHistory', null) == resource.data.get('rulesConfigHistory', null)
        && changedKeys()
             .hasOnly(['nameBn', 'nameEn', 'fullBn', 'fullEn', 'orgBn', 'orgEn',
                       'stepsBn', 'stepsEn', 'officialUrl', 'accent', 'accentSoft',
                       'accentDeep', 'descriptionBn', 'descriptionEn',
                       'syllabusSource', 'reviewStatus', 'updatedAt'])
        && isDraftStatus(resource.data.reviewStatus)
        && isDraftStatus(request.resource.data.reviewStatus)
        && request.resource.data.status == 'draft'
        && isStr(request.resource.data.nameBn, 100)
        && isOptStr(request.resource.data.get('nameEn', null), 100)
        && isOptStr(request.resource.data.get('fullBn', null), 200)
        && isOptStr(request.resource.data.get('fullEn', null), 200)
        && isOptStr(request.resource.data.get('orgBn', null), 200)
        && isOptStr(request.resource.data.get('orgEn', null), 200)
        && isOptStr(request.resource.data.get('stepsBn', null), 200)
        && isOptStr(request.resource.data.get('stepsEn', null), 200)
        && (request.resource.data.get('officialUrl', null) == null
            || request.resource.data.get('officialUrl', null) is string)
        && isOptStr(request.resource.data.get('accent', null), 20)
        && isOptStr(request.resource.data.get('accentSoft', null), 20)
        && isOptStr(request.resource.data.get('accentDeep', null), 20)
        && isOptStr(request.resource.data.get('descriptionBn', null), 500)
        && isOptStr(request.resource.data.get('descriptionEn', null), 500)
        && (request.resource.data.get('syllabusSource', null) == null
            || request.resource.data.get('syllabusSource', null) is string)
        && (!('updatedAt' in request.resource.data) || request.resource.data.updatedAt is timestamp);
      allow update: if isAdmin()
        && request.resource.data.get('rulesConfig', null) != resource.data.get('rulesConfig', null)
        && validJobRulesConfig(request.resource.data.rulesConfig)
        && validJobRulesConfigHistoryChange(resource.data, request.resource.data)
        && request.resource.data.get('rulesConfigHistory', null) is list
        && request.resource.data.status == resource.data.status
        && request.resource.data.reviewStatus == resource.data.reviewStatus
        && request.resource.data.slug == resource.data.slug
        && request.resource.data.categoryId == resource.data.categoryId
        && request.resource.data.tier == resource.data.tier
        && request.resource.data.get('authorId', null) == resource.data.get('authorId', null)
        && request.resource.data.get('createdBy', null) == resource.data.get('createdBy', null)
        && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null)
        && request.resource.data.get('scopeStatus', 'defined') == resource.data.get('scopeStatus', 'defined')
        && request.resource.data.get('patternStatus', null) == resource.data.get('patternStatus', null)
        && request.resource.data.get('applicableCycle', null) == resource.data.get('applicableCycle', null)
        && (!('updatedAt' in request.resource.data) || request.resource.data.updatedAt is timestamp);
      allow update: if isAdmin()
        && request.resource.data.get('rulesConfig', null) == resource.data.get('rulesConfig', null)
        && request.resource.data.get('rulesConfigHistory', null) == resource.data.get('rulesConfigHistory', null)
        && request.resource.data.slug == examSlug
        && request.resource.data.categoryId in jobCategoryIds()
        && request.resource.data.tier in [1, 2, 3]
        && isJobExamReviewState(request.resource.data.reviewStatus)
        && request.resource.data.status in ['draft', 'published']
        && jobExamStatesConsistent(request.resource.data)
        && request.resource.data.get('authorId', null) == resource.data.get('authorId', null)
        && request.resource.data.get('createdBy', null) == resource.data.get('createdBy', null)
        && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null)
        && (!('patternStatus' in request.resource.data)
            || request.resource.data.patternStatus in jobPatternStatuses())
        && (request.resource.data.get('applicableCycle', null) == null
            || request.resource.data.get('applicableCycle', null) is string)
        && request.resource.data.get('scopeStatus', 'defined') in ['defined', 'scope_pending']
        && isStr(request.resource.data.nameBn, 100)
        && isOptStr(request.resource.data.get('nameEn', null), 100)
        && isOptStr(request.resource.data.get('fullBn', null), 200)
        && isOptStr(request.resource.data.get('fullEn', null), 200)
        && isOptStr(request.resource.data.get('orgBn', null), 200)
        && isOptStr(request.resource.data.get('orgEn', null), 200)
        && isOptStr(request.resource.data.get('stepsBn', null), 200)
        && isOptStr(request.resource.data.get('stepsEn', null), 200)
        && (request.resource.data.get('officialUrl', null) == null
            || request.resource.data.get('officialUrl', null) is string)
        && isOptStr(request.resource.data.get('accent', null), 20)
        && isOptStr(request.resource.data.get('accentSoft', null), 20)
        && isOptStr(request.resource.data.get('accentDeep', null), 20)
        && isOptStr(request.resource.data.get('descriptionBn', null), 500)
        && isOptStr(request.resource.data.get('descriptionEn', null), 500)
        && (request.resource.data.get('syllabusSource', null) == null
            || request.resource.data.get('syllabusSource', null) is string)
        && (!('updatedAt' in request.resource.data) || request.resource.data.updatedAt is timestamp);
      allow delete: if isAdmin();
    }
    function isPracticeNuBundle(bundleId) {
      return exists(/databases/$(database)/documents/nuQuestionBundles/$(bundleId))
        && get(/databases/$(database)/documents/nuQuestionBundles/$(bundleId)).data.get('kind', '') == 'topic';
    }
    function hasFreshNuReceipt(bundleId) {
      return exists(/databases/$(database)/documents/nuReceipts/$(uid() + '_' + bundleId))
        && get(/databases/$(database)/documents/nuReceipts/$(uid() + '_' + bundleId)).data.userId == uid()
        && get(/databases/$(database)/documents/nuReceipts/$(uid() + '_' + bundleId)).data.attemptId is string
        && exists(/databases/$(database)/documents/users/$(uid())/nuAttempts/$(get(/databases/$(database)/documents/nuReceipts/$(uid() + '_' + bundleId)).data.attemptId))
        && get(/databases/$(database)/documents/users/$(uid())/nuAttempts/$(get(/databases/$(database)/documents/nuReceipts/$(uid() + '_' + bundleId)).data.attemptId)).data.status == 'submitted'
        && get(/databases/$(database)/documents/users/$(uid())/nuAttempts/$(get(/databases/$(database)/documents/nuReceipts/$(uid() + '_' + bundleId)).data.attemptId)).data.bundleId == bundleId
        && get(/databases/$(database)/documents/users/$(uid())/nuAttempts/$(get(/databases/$(database)/documents/nuReceipts/$(uid() + '_' + bundleId)).data.attemptId)).data.userId == uid()
        && get(/databases/$(database)/documents/nuReceipts/$(uid() + '_' + bundleId)).data.createdAt is timestamp
        && get(/databases/$(database)/documents/nuReceipts/$(uid() + '_' + bundleId)).data.createdAt <= request.time
        && request.time < get(/databases/$(database)/documents/nuReceipts/$(uid() + '_' + bundleId)).data.createdAt + duration.value(10, 'm');
    }
    match /nuExamConfigs/{configId} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.examType in ['NU_ADMISSION', 'NU_DAILY']
        && request.resource.data.questionMode == 'MCQ'
        && request.resource.data.marking is map
        && request.resource.data.marking.correct == 1
        && request.resource.data.marking.incorrect == 0
        && request.resource.data.marking.unanswered == 0
        && request.resource.data.marking.negativeMarking == false
        && request.resource.data.vivaEnabled == false
        && request.resource.data.officialRankEnabled == false
        && request.resource.data.configVersion is int
        && request.resource.data.configVersion >= 1
        && request.resource.data.circularVersion is string
        && request.resource.data.status in ['draft', 'published', 'withdrawn']
        && ((request.resource.data.examType == 'NU_ADMISSION'
            && request.resource.data.totalQuestions == 100
            && request.resource.data.durationSeconds == 3600
            && request.resource.data.sections is map
            && request.resource.data.sections.bangla == 20
            && request.resource.data.sections.english == 20
            && request.resource.data.sections.generalKnowledge == 20
            && request.resource.data.sections.groupSubjects == 40
            && request.resource.data.sections.groupSubjectsDetail == null)
          || (request.resource.data.examType == 'NU_DAILY'
            && request.resource.data.totalQuestions is int
            && request.resource.data.totalQuestions >= 20
            && request.resource.data.totalQuestions <= 30
            && request.resource.data.durationSeconds is int
            && request.resource.data.durationSeconds >= 1200
            && request.resource.data.durationSeconds <= 1800));
      allow delete: if false;
    }
    match /nuCircularConfigs/{admissionId} {
      allow read: if resource.data.status in ['published', 'historical', 'superseded'] || isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.status in ['draft', 'verified', 'published', 'historical', 'superseded']
        && request.resource.data.academicSession is string
        && request.resource.data.sourceType == 'official_circular';
      allow delete: if false;
    }
    match /nuInstitutions/{institutionId} {
      allow read: if resource.data.status == 'active' || isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.slug is string
        && request.resource.data.officialUrl is string;
      allow delete: if false;
    }
    match /nuGroups/{groupId} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.slug in ['humanities', 'science', 'business']
        && request.resource.data.institutionId is string
        && request.resource.data.examConfigId is string
        && request.resource.data.circularVersion is string;
      allow delete: if false;
    }
    match /nuSubjects/{subjectId} {
      allow read: if signedIn() && (resource.data.status == 'published' || isAdmin()
        || (isVerifiedTeacher() && resource.data.createdBy == uid()));
      allow create: if (isAdmin() || (isVerifiedTeacher() && request.resource.data.createdBy == uid()))
        && request.resource.data.status == 'draft'
        && isValidNuSubject(request.resource.data);
      allow update: if adminOrOwnTeacher()
        && resource.data.status != 'published'
        && !(request.resource.data.status == 'published' && !isAdmin())
        && sameCreator()
        && isValidNuSubject(request.resource.data);
      allow delete: if false;
    }
    match /nuChapters/{chapterId} {
      allow read: if signedIn() && (resource.data.status == 'published' || isAdmin()
        || (isVerifiedTeacher() && resource.data.createdBy == uid()));
      allow create: if (isAdmin() || (isVerifiedTeacher() && request.resource.data.createdBy == uid()))
        && request.resource.data.status == 'draft'
        && isValidNuChapter(request.resource.data);
      allow update: if adminOrOwnTeacher()
        && resource.data.status != 'published'
        && !(request.resource.data.status == 'published' && !isAdmin())
        && sameCreator()
        && isValidNuChapter(request.resource.data);
      allow delete: if false;
    }
    match /nuTopics/{topicId} {
      allow read: if signedIn() && (resource.data.status == 'published' || isAdmin()
        || (isVerifiedTeacher() && resource.data.createdBy == uid()));
      allow create: if (isAdmin() || (isVerifiedTeacher() && request.resource.data.createdBy == uid()))
        && request.resource.data.status == 'draft'
        && isValidNuTopic(request.resource.data);
      allow update: if adminOrOwnTeacher()
        && resource.data.status != 'published'
        && !(request.resource.data.status == 'published' && !isAdmin())
        && sameCreator()
        && isValidNuTopic(request.resource.data);
      allow delete: if false;
    }
    match /nuLessons/{lessonId} {
      allow read: if signedIn() && (resource.data.status == 'published' || isAdmin()
        || (isVerifiedTeacher() && resource.data.createdBy == uid()));
      allow create: if (isAdmin() || (isVerifiedTeacher() && request.resource.data.createdBy == uid()))
        && request.resource.data.status == 'draft'
        && isValidNuLesson(request.resource.data);
      allow update: if adminOrOwnTeacher()
        && resource.data.status != 'published'
        && !(request.resource.data.status == 'published' && !isAdmin())
        && sameCreator()
        && isValidNuLesson(request.resource.data);
      allow delete: if false;
    }
    match /nuQuestions/{questionId} {
      allow read: if isAdmin() || (isVerifiedTeacher() && resource.data.createdBy == uid());
      allow create: if (isAdmin() || isVerifiedTeacher())
        && request.resource.data.status == 'draft'
        && request.resource.data.version == 1
        && request.resource.data.createdBy == uid()
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdAt == request.time
        && isValidNuQuestion(request.resource.data);
      allow update: if adminOrOwnTeacher()
        && resource.data.status in ['draft', 'changes_requested']
        && request.resource.data.status == resource.data.status
        && request.resource.data.version == resource.data.version
        && sameCreator()
        && changedKeys().hasOnly(
             ['questionText', 'questionLang', 'options', 'difficulty',
              'explanation', 'sourceType', 'provenance', 'examYear',
              'groupIds', 'subjectId', 'chapterId', 'topicId',
              'circularVersion', 'updatedAt'])
        && isValidNuQuestion(request.resource.data);
      allow update: if isNuQuestionTransitionAllowed(resource.data.status, request.resource.data.status)
        && isNuQuestionTransitionActorOk(request.resource.data.status)
        && request.resource.data.version == resource.data.version
        && sameCreator()
        && changedKeys().hasOnly(
             ['status', 'reviewedBy', 'reviewedAt', 'publishedAt', 'updatedAt'])
        && (request.resource.data.status != 'submitted_for_review'
            || (exists(/databases/$(database)/documents/nuQuestionDraftKeys/$(questionId))
                && get(/databases/$(database)/documents/nuQuestionDraftKeys/$(questionId)).data.version == resource.data.version))
        && (request.resource.data.status != 'under_review'
            || (request.resource.data.reviewedBy == uid() && request.resource.data.reviewedAt is timestamp))
        && (request.resource.data.status != 'published'
            || (isValidNuQuestion(request.resource.data)
                && request.resource.data.reviewedBy is string
                && request.resource.data.reviewedAt is timestamp));
      allow delete: if false;
    }
    match /nuQuestionDraftKeys/{questionId} {
      allow read: if isAdmin() || (isVerifiedTeacher() && resource.data.createdBy == uid())
        || (isVerifiedTeacher()
            && exists(/databases/$(database)/documents/nuQuestions/$(questionId))
            && get(/databases/$(database)/documents/nuQuestions/$(questionId)).data.status == 'under_review'
            && get(/databases/$(database)/documents/nuQuestions/$(questionId)).data.reviewedBy == uid());
      allow create: if (isAdmin() || isVerifiedTeacher())
        && request.resource.data.questionId == questionId
        && request.resource.data.createdBy == uid()
        && isValidNuQuestionDraftKey(request.resource.data)
        && exists(/databases/$(database)/documents/nuQuestions/$(questionId))
        && get(/databases/$(database)/documents/nuQuestions/$(questionId)).data.status == 'draft'
        && get(/databases/$(database)/documents/nuQuestions/$(questionId)).data.version == request.resource.data.version;
      allow update: if adminOrOwnTeacher()
        && request.resource.data.questionId == questionId
        && request.resource.data.version == resource.data.version
        && sameCreator()
        && isValidNuQuestionDraftKey(request.resource.data)
        && exists(/databases/$(database)/documents/nuQuestions/$(questionId))
        && get(/databases/$(database)/documents/nuQuestions/$(questionId)).data.status == 'draft'
        && get(/databases/$(database)/documents/nuQuestions/$(questionId)).data.version == request.resource.data.version;
      allow delete: if false;
    }
    match /nuQuestionBundles/{bundleId} {
      allow read: if (signedIn() && resource.data.status == 'published') || isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.bundleId == bundleId
        && isValidNuBundle(request.resource.data);
      allow delete: if false;
    }
    match /nuQuestionKeys/{bundleId} {
      allow read: if isAdmin()
        || (signedIn() && isPracticeNuBundle(bundleId))
        || (signedIn() && hasFreshNuReceipt(bundleId));
      allow create, update: if isAdmin()
        && request.resource.data.bundleId == bundleId
        && request.resource.data.questionVersion is int && request.resource.data.questionVersion >= 1
        && request.resource.data.keys is list && request.resource.data.keys.size() >= 1
        && request.resource.data.keys[0] is map
        && request.resource.data.keys[0].questionId is string
        && request.resource.data.keys[0].version is int && request.resource.data.keys[0].version >= 1
        && request.resource.data.keys[0].correctOptionIndex is int
        && request.resource.data.keys[0].correctOptionIndex >= 0 && request.resource.data.keys[0].correctOptionIndex <= 3
        && exists(/databases/$(database)/documents/nuQuestionBundles/$(bundleId))
        && request.resource.data.questionVersion == get(/databases/$(database)/documents/nuQuestionBundles/$(bundleId)).data.version;
      allow delete: if false;
    }
    match /nuReceipts/{receiptId} {
      allow read: if (signedIn() && resource.data.userId == uid()) || isAdmin();
      allow create: if signedIn() && callerActive()
        && receiptId == uid() + '_' + request.resource.data.bundleId
        && onlyKeys(['userId', 'bundleId', 'attemptId', 'createdAt'])
        && request.resource.data.userId == uid()
        && request.resource.data.bundleId is string
        && request.resource.data.bundleId.size() <= 200
        && request.resource.data.attemptId is string
        && request.resource.data.attemptId.size() <= 200
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdAt <= request.time
        && request.resource.data.createdAt > request.time - duration.value(5, 'm')
        && exists(/databases/$(database)/documents/users/$(uid())/nuAttempts/$(request.resource.data.attemptId))
        && get(/databases/$(database)/documents/users/$(uid())/nuAttempts/$(request.resource.data.attemptId)).data.status == 'submitted'
        && get(/databases/$(database)/documents/users/$(uid())/nuAttempts/$(request.resource.data.attemptId)).data.bundleId == request.resource.data.bundleId
        && !exists(/databases/$(database)/documents/nuReceipts/$(receiptId));
      allow update: if false;
      allow delete: if resource.data.userId == uid();
    }
    match /users/{uid}/nuAttempts/{attemptId} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid)
        && request.resource.data.userId == uid
        && request.resource.data.status == 'not_started'
        && request.resource.data.kind in ['practice', 'mock', 'daily']
        && request.resource.data.questionIds is list
        && request.resource.data.startedAt == request.time
        && request.resource.data.configSnapshot is map
        && ((request.resource.data.kind == 'mock'
            && request.resource.data.questionIds.size() == 100
            && request.resource.data.configSnapshot.totalQuestions == 100
            && request.resource.data.configSnapshot.durationSeconds == 3600
            && request.resource.data.deadlineAt is timestamp
            && request.resource.data.deadlineAt > request.time
            && request.resource.data.deadlineAt <= request.time + duration.value(3600, 's'))
          || (request.resource.data.kind == 'daily'
            && request.resource.data.questionIds.size() >= 20
            && request.resource.data.questionIds.size() <= 30
            && request.resource.data.configSnapshot.totalQuestions >= 20
            && request.resource.data.configSnapshot.totalQuestions <= 30
            && request.resource.data.configSnapshot.durationSeconds >= 1200
            && request.resource.data.configSnapshot.durationSeconds <= 1800
            && request.resource.data.deadlineAt is timestamp
            && request.resource.data.deadlineAt > request.time
            && request.resource.data.deadlineAt <= request.time + duration.value(request.resource.data.configSnapshot.durationSeconds, 's'))
          || (request.resource.data.kind == 'practice'
            && request.resource.data.questionIds.size() >= 1
            && request.resource.data.questionIds.size() <= 100));
      allow update: if isOwner(uid)
        && resource.data.status != 'submitted'
        && request.time <= resource.data.deadlineAt
        && request.resource.data.questionIds == resource.data.questionIds
        && request.resource.data.configSnapshot == resource.data.configSnapshot
        && (request.resource.data.status != 'submitted'
            || request.resource.data.submittedAt == request.time)
        && changedKeys().hasOnly(
            ['answers', 'score', 'percentage', 'correctCount', 'wrongCount',
             'unansweredCount', 'status', 'submittedAt', 'updatedAt']);
      allow delete: if false;
    }
    match /users/{uid}/nuSessions/{sessionId} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && onlyKeys(['attemptId', 'status', 'startedAt',
             'deadlineAt', 'lastSavedAt', 'answers', 'deviceInfo', 'updatedAt'])
        && request.resource.data.attemptId is string
        && request.resource.data.status in ['in_progress', 'submitted']
        && request.resource.data.startedAt is timestamp
        && request.resource.data.deadlineAt is timestamp
        && request.resource.data.updatedAt is timestamp;
      allow update: if isOwner(uid)
        && changedKeys()
             .hasOnly(['status', 'lastSavedAt', 'answers', 'deviceInfo', 'updatedAt'])
        && request.resource.data.status in ['in_progress', 'submitted'];
      allow delete: if isOwner(uid) && resource.data.status == 'submitted';
    }
    match /nuReviews/{reviewId} {
      allow read: if isAdmin() || (signedIn() && resource.data.reviewerId == uid());
      allow create: if (isAdmin() || isVerifiedTeacher())
        && request.resource.data.reviewerId == uid()
        && request.resource.data.questionId is string
        && request.resource.data.decision in ['approved', 'rejected', 'changes_requested']
        && (!('reason' in request.resource.data)
            || request.resource.data.reason is string)
