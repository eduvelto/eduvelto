# Dependencies / build output
node_modules/
dist/
dist-ssr/
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
firebase-debug.log
ui-debug.log

# Firebase
.firebase/
firestore-debug.log

# Environment + secrets — NEVER commit these
.env
.env.*
!.env.example

# Service-account keys — NEVER commit. Client config (apiKey etc.) is
# public-by-design, but service-account JSON must never enter the repo.
*-service-account*.json
service-account*.json
**/*service-account*.json
firebase-adminsdk-*.json
*.pem
*.key

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Worktree-local (never commit): the node_modules symlink and tsc build info
node_modules
# TypeScript incremental build info (regenerated by every build)
tsconfig.tsbuildinfo
