{
  "name": "eduvelto",
  "private": true,
  "version": "0.1.0",
  "description": "Eduvelto — free digital education platform for Bangladesh (Vite + React + Firebase Spark). Tagline: শেখো, এগিয়ে যাও, স্বপ্ন গড়ো / Learn, Grow, Achieve.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "postbuild": "node scripts/check-dist-size.mjs",
    "preview": "vite preview",
    "test:rules": "JAVA_TOOL_OPTIONS=\"-Djava.net.preferIPv4Stack=true\" firebase emulators:exec --only firestore,auth \"vitest run emulator-tests/\"",
    "test:unit": "vitest run src/lib/__tests__/ --environment node",
    "emulators": "JAVA_TOOL_OPTIONS=\"-Djava.net.preferIPv4Stack=true\" firebase emulators:start --only firestore,auth",
    "prerender": "vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "build:pages": "npm run build && npm run prerender -- --books-file scripts/fixtures/books.json && node scripts/check-dist-size.mjs",
    "backup": "node scripts/backup-firestore.mjs",
    "audit": "node scripts/audit-site.mjs"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/push-notifications": "^8.1.3",
    "@capacitor/share": "^8.0.3",
    "@neslinesli93/qpdf-wasm": "0.3.1",
    "docx": "^9.16.0",
    "firebase": "11.10.0",
    "heic2any": "0.0.4",
    "html2canvas": "^1.4.1",
    "jsbarcode": "^3.12.3",
    "jspdf": "^4.2.1",
    "jsqr": "^1.4.0",
    "onnxruntime-web": "^1.31.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "5.4.624",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "react-router-dom": "^6.28.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "firebase-tools": "^13.28.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.3",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^2.1.8"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.0"
  }
}
