{
  "name": "eduvelto",
  "private": true,
  "version": "0.1.0",
  "description": "Eduvelto — free digital education platform for Bangladesh (Vite + React + Firebase Spark). Tagline: শেখো, এগিয়ে যাও, স্বপ্ন গড়ো / Learn, Grow, Achieve.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test:rules": "JAVA_TOOL_OPTIONS=\"-Djava.net.preferIPv4Stack=true\" firebase emulators:exec --only firestore,auth \"vitest run emulator-tests/\"",
    "emulators": "JAVA_TOOL_OPTIONS=\"-Djava.net.preferIPv4Stack=true\" firebase emulators:start --only firestore,auth"
  },
  "dependencies": {
    "firebase": "11.10.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "firebase-tools": "^13.28.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.3",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^2.1.8"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.0"
  }
}
