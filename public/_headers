# Cloudflare Pages headers (P0-1 + small-items cache fix).
# firebase.json headers do NOT apply on Pages — this file is the live one.
# Values mirror firebase.json (which is dead config for production).
# Hashed Vite assets are content-addressed, so 1y + immutable is safe.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/*.js
  Cache-Control: public, max-age=31536000
/*.css
  Cache-Control: public, max-age=31536000
/*.png
  Cache-Control: public, max-age=86400
/*.jpg
  Cache-Control: public, max-age=86400
/*.jpeg
  Cache-Control: public, max-age=86400
/*.svg
  Cache-Control: public, max-age=86400
/*.webp
  Cache-Control: public, max-age=86400
/*.ico
  Cache-Control: public, max-age=86400
/*.woff
  Cache-Control: public, max-age=86400
/*.woff2
  Cache-Control: public, max-age=86400
/*.html
  Cache-Control: no-cache
/*.json
  Cache-Control: no-cache
/*.xml
  Cache-Control: no-cache
/*.txt
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
